# Copiar a .env y reemplazar cada marcador CLAVE_N por el valor real.
#
# IMPORTANTE: las variables SIN prefijo PUBLIC_ son secretas y solo viven en
# las funciones de servidor. En produccion hay que cargarlas tambien en el
# panel de Vercel (Settings > Environment Variables): el .env local solo
# aplica al desarrollo local.

# URL publica del stock proxy (ver propuesta de diseno, seccion 6)
PUBLIC_STOCK_PROXY_URL=https://stock.plantaspanama.com/v1

# Numero de WhatsApp del negocio (formato internacional, sin +)
PUBLIC_WHATSAPP_NUMBER=50765673062

# Order API (vivero-rose-order-api). Las funciones de servidor de Astro son
# las unicas que la llaman con la key; el navegador nunca la ve.
# CLAVE_5 debe ser la misma que ORDER_API_KEY en el .env del order-api.
ORDER_API_URL=https://pedidos.plantaspanama.com
ORDER_API_KEY=CLAVE_5

# Bandera del pago con tarjeta (Wompi). No es secreta: solo decide si el
# checkout muestra la opcion de tarjeta. En 0 (o ausente), produccion queda
# igual que siempre: tarjeta "Proximamente" y cero flujo de Wompi en la
# pagina. Se enciende con 1, primero en el entorno Preview de Vercel para
# probar en sandbox y recien despues en Production. Las llaves de Wompi NUNCA
# van aqui: viven en el .env del order-api, que arma el enlace de pago.
PUBLIC_WOMPI_ACTIVO=0

# Cloudinary (fotos de productos). Solo las usa scripts/fotos.py en la
# maquina local para subir fotos y regenerar src/data/fotos.json: NO hacen
# falta en Vercel (el sitio solo arma URLs publicas con el cloud name que
# queda dentro de fotos.json). Salen del panel de Cloudinary > Settings >
# API Keys.
CLOUDINARY_CLOUD_NAME=CLAVE_7
CLOUDINARY_API_KEY=CLAVE_8
CLOUDINARY_API_SECRET=CLAVE_9

# Llave de Google Maps (Places API New + Maps JavaScript API), restringida al
# dominio en Google Cloud. Es PUBLIC_ a proposito: viaja al navegador, la
# proteccion es la restriccion de dominio y los topes de cuota. SIN esta
# variable el checkout funciona igual que siempre, solo que sin autocompletado
# ni mapa. En produccion se carga en el panel de Vercel.
PUBLIC_GOOGLE_MAPS_KEY=CLAVE_6
