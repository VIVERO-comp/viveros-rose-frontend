---
// Carrito segun el diseno "Carrito" (claude.ai/design): cabecera minima,
// lineas en tarjetas blancas con control de cantidad en pastilla, opcion de
// regalo, sugerencias del catalogo y resumen pegajoso. La logica del carrito
// (localStorage) sigue siendo src/lib/cart.ts, sin cambios.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { compareAtPrice, esComprable, formatPrice, precioVigente } from '../data/products';
import { productosPublicados } from '../lib/catalogo-build';

// Catalogo publicado (con los precios reales de Odoo inyectados en build),
// no products.ts crudo: asi las sugerencias y el mapa de ahorros usan el
// precio verdadero y no el placeholder.
const catalogo = await productosPublicados();

// Sugerencias "Va bien con": candidatos del catalogo real, con los que ya
// tienen foto primero, y solo COMPRABLES (un producto "Proximamente" no se
// puede sugerir para agregar). En build no hay stock (available estatico es
// 0, por eso antes esta lista salia siempre vacia y el titulo quedaba
// flotando); se renderizan ocultos y el stock del proxy decide en el
// cliente cuales de estos se muestran (hasta 3). El diseno original sugeria
// sustrato/abono/matera, pero esos accesorios no existen en el catalogo ni
// en Odoo.
const suggestions = catalogo
  .filter(esComprable)
  .sort((a, b) => Number(Boolean(b.image)) - Number(Boolean(a.image)))
  .slice(0, 6);

// Precio regular por SKU de los productos en oferta, para mostrar el ahorro
// en cada linea del carrito.
const compareMap = Object.fromEntries(
  catalogo
    .map((p) => [p.sku, compareAtPrice(p)] as const)
    .filter(([, compare]) => compare !== null),
);
---

<Base
  noindex
  title="Carrito"
  description="Revisa las plantas de tu carrito antes de finalizar la compra. Entrega a domicilio en la ciudad de Panamá y confirmación del pedido por WhatsApp."
  chrome="minimal"
  minimalLinkHref="/plantas"
  minimalLinkLabel="Seguir comprando"
>
  <section class="section">
    <div class="container cart-container" data-compare-map={JSON.stringify(compareMap)}>
      <h1>Tu carrito</h1>
      <p class="count-label" data-count-label>Sin artículos</p>

      <div class="cart-grid">
        <div class="cart-col">
          <!-- Sellos de confianza arriba de la lista (estructura tipo checkout). -->
          <div class="cart-trust" data-cart-trust hidden>
            <span><Icon name="package" size={16} class="trust-icon" /> Empaque seguro</span>
            <span><Icon name="shield-check" size={16} class="trust-icon" /> Satisfacción del cliente</span>
            <span><Icon name="truck" size={16} class="trust-icon" /> Entrega 24–48 h</span>
          </div>

          <div class="empty-card" data-cart-empty hidden>
            <p class="empty-title">Tu carrito está vacío</p>
            <p class="empty-text">Agrega plantas del catálogo y aparecerán aquí.</p>
            <a href="/plantas" class="btn btn--green">Ver plantas</a>
          </div>

          <div class="cart-items" data-cart-items></div>

          <div class="gift-card" data-gift-card hidden>
            <label class="gift-check">
              <input type="checkbox" data-gift-toggle />
              <Icon name="gift" size={17} class="gift-icon" /> Es un regalo: agregar tarjeta con mensaje
            </label>
            <textarea
              data-gift-note
              placeholder="Escribe el mensaje para la tarjeta"
              hidden
            ></textarea>
          </div>

          <div class="addons" data-addons hidden>
            <p class="addons-title">Va bien con</p>
            <div class="addons-grid">
              {suggestions.map((p) => (
                <div class="addon-card" data-addon-card data-sku={p.sku} hidden>
                  {p.image ? (
                    <div class="addon-photo addon-photo--img" style={`background-image: url('${p.image}');`} aria-hidden="true" />
                  ) : (
                    <!-- FOTO PENDIENTE: producto {p.sku} — bloque de minimo 360×260 px -->
                    <div class="addon-photo" data-medidas="Foto · 360×260" aria-hidden="true">{p.emoji}</div>
                  )}
                  <div class="addon-info">
                    <p class="addon-name">{p.name}</p>
                    <p class="addon-price">{formatPrice(precioVigente(p))}</p>
                    <button
                      type="button"
                      class="addon-add"
                      data-addon-add
                      data-sku={p.sku}
                      data-name={p.name}
                      data-price={precioVigente(p)}
                      data-slug={p.slug}
                      data-category={p.category}
                      data-emoji={p.emoji}
                      data-image={p.image}
                    >Agregar</button>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <aside class="summary" data-summary hidden>
          <!-- En movil el resumen queda arriba y colapsable; en escritorio el
               script lo mantiene siempre abierto y la barra de toggle se oculta. -->
          <details class="summary-details" data-summary-details open>
            <summary class="summary-toggle">
              <span>Resumen del pedido</span>
              <strong data-toggle-total>$0.00</strong>
            </summary>
            <div class="summary-body">
              <p class="summary-title">Resumen</p>
              <!-- Lineas del pedido: foto (emoji por ahora), cantidad y precio. -->
              <div class="summary-items" data-summary-lines></div>
              <!-- Codigo de descuento: aun no hay backend de cupones. -->
              <div class="discount-row">
                <input type="text" placeholder="Código de descuento" disabled title="No disponible por ahora" />
                <button type="button" disabled title="No disponible por ahora">Aplicar</button>
              </div>
              <div class="summary-rows">
                <div class="summary-row"><span>Subtotal</span><span data-cart-total>$0.00</span></div>
                <div class="summary-row" data-savings-row hidden>
                  <span>Ahorro</span><span class="savings" data-cart-savings>$0.00</span>
                </div>
                <div class="summary-row"><span>Envío</span><span class="muted" data-shipping-label>Se calcula al pagar</span></div>
              </div>
              <div class="summary-total">
                <span>Total</span>
                <strong data-cart-grand-total>$0.00</strong>
              </div>
              <a href="/checkout" class="btn btn--green summary-cta">Ir a pagar</a>
              <p class="summary-note">Impuestos y envío se calculan al pagar.</p>
            </div>
          </details>
        </aside>
      </div>
    </div>
  </section>
</Base>

<script>
  import { addToCart, cartCount, cartTotal, getCart, removeFromCart, setQty } from '../lib/cart';
  import { fetchStock } from '../lib/stock';

  const GIFT_KEY = 'pp-gift-v1';

  // Cuantas sugerencias de "Va bien con" quedaron visibles tras consultar el
  // stock real. Arranca en 0: la seccion no aparece hasta saber que hay algo
  // que sugerir (antes el titulo salia flotando sobre una grilla vacia).
  let sugerenciasVisibles = 0;

  const money = (n: number) => `$${n.toFixed(2)}`;

  // Precio de lista por SKU (promo de exterior), embebido en build.
  const compareMap: Record<string, number> = JSON.parse(
    document.querySelector<HTMLElement>('[data-compare-map]')?.dataset.compareMap ?? '{}',
  );

  function render() {
    const items = getCart();
    const empty = document.querySelector<HTMLElement>('[data-cart-empty]');
    const list = document.querySelector<HTMLElement>('[data-cart-items]');
    const summary = document.querySelector<HTMLElement>('[data-summary]');
    const giftCard = document.querySelector<HTMLElement>('[data-gift-card]');
    const addons = document.querySelector<HTMLElement>('[data-addons]');
    const countLabel = document.querySelector<HTMLElement>('[data-count-label]');

    const count = cartCount();
    if (countLabel) {
      countLabel.textContent =
        count === 0 ? 'Sin artículos' : count === 1 ? '1 artículo' : `${count} artículos`;
    }

    const hasItems = items.length > 0;
    empty?.toggleAttribute('hidden', hasItems);
    summary?.toggleAttribute('hidden', !hasItems);
    giftCard?.toggleAttribute('hidden', !hasItems);
    addons?.toggleAttribute('hidden', !hasItems || sugerenciasVisibles === 0);
    document.querySelector<HTMLElement>('[data-cart-trust]')?.toggleAttribute('hidden', !hasItems);

    // Lineas del resumen: miniatura con cantidad y total por linea.
    const summaryLines = document.querySelector<HTMLElement>('[data-summary-lines]');
    if (summaryLines) {
      summaryLines.innerHTML = items
        .map((i) => {
          const contenido = i.image
            ? `<i class="summary-qty">${i.qty}</i>`
            : `${i.emoji}<i class="summary-qty">${i.qty}</i>`;
          const estilo = i.image
            ? ` style="background-image: url('${i.image}'); background-size: cover; background-position: center;"`
            : '';
          return `
            <div class="summary-item">
              <span class="summary-thumb" aria-hidden="true"${estilo}>${contenido}</span>
              <span class="summary-item-name">${i.name}</span>
              <span class="summary-item-line">${money(i.price * i.qty)}</span>
            </div>`;
        })
        .join('');
    }

    if (list) {
      list.innerHTML = '';
      for (const item of items) {
        const compare = compareMap[item.sku];
        const hasDiscount = typeof compare === 'number' && compare > item.price;
        const row = document.createElement('div');
        row.className = 'cart-line';
        // Con foto real se muestra la foto; sin foto queda el emoji.
        const thumb = item.image
          ? `<span class="line-emoji" aria-hidden="true" style="background-image: url('${item.image}'); background-size: cover; background-position: center;"></span>`
          : `<span class="line-emoji" aria-hidden="true">${item.emoji}</span>`;
        row.innerHTML = `
          ${thumb}
          <div class="line-info">
            <a href="/plantas/${item.category}/${item.slug}">${item.name}</a>
            <span class="line-price">${money(item.price)} c/u</span>
            ${
              hasDiscount
                ? `<span class="line-discount">Ahorras ${money((compare - item.price) * item.qty)}</span>`
                : ''
            }
            <div class="line-controls">
              <div class="qty-pill">
                <button type="button" data-dec="${item.sku}" aria-label="Quitar uno">–</button>
                <span>${item.qty}</span>
                <button type="button" data-inc="${item.sku}" aria-label="Agregar uno">+</button>
              </div>
              <button type="button" class="line-remove" data-remove="${item.sku}">Eliminar</button>
            </div>
          </div>
          <span class="line-amounts">
            ${hasDiscount ? `<span class="line-compare">${money(compare * item.qty)}</span>` : ''}
            <strong class="line-total">${money(item.price * item.qty)}</strong>
          </span>
        `;
        list.appendChild(row);
      }

      list.querySelectorAll<HTMLButtonElement>('[data-dec]').forEach((btn) =>
        btn.addEventListener('click', () => {
          const item = getCart().find((i) => i.sku === btn.dataset.dec);
          if (item) setQty(item.sku, item.qty - 1);
          render();
        })
      );
      list.querySelectorAll<HTMLButtonElement>('[data-inc]').forEach((btn) =>
        btn.addEventListener('click', () => {
          const item = getCart().find((i) => i.sku === btn.dataset.inc);
          if (item) setQty(item.sku, item.qty + 1);
          render();
        })
      );
      list.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach((btn) =>
        btn.addEventListener('click', () => {
          removeFromCart(btn.dataset.remove!);
          render();
        })
      );
    }

    const subtotal = cartTotal();
    const savings = items.reduce((sum, i) => {
      const compare = compareMap[i.sku];
      return sum + (typeof compare === 'number' && compare > i.price ? (compare - i.price) * i.qty : 0);
    }, 0);
    const totalEl = document.querySelector<HTMLElement>('[data-cart-total]');
    const grandEl = document.querySelector<HTMLElement>('[data-cart-grand-total]');
    const shipEl = document.querySelector<HTMLElement>('[data-shipping-label]');
    const savingsRow = document.querySelector<HTMLElement>('[data-savings-row]');
    const savingsEl = document.querySelector<HTMLElement>('[data-cart-savings]');
    if (totalEl) totalEl.textContent = money(subtotal);
    if (grandEl) grandEl.textContent = money(subtotal);
    const toggleTotal = document.querySelector<HTMLElement>('[data-toggle-total]');
    if (toggleTotal) toggleTotal.textContent = money(subtotal);
    if (savingsRow) savingsRow.hidden = savings <= 0;
    if (savingsEl) savingsEl.textContent = `– ${money(savings)}`;
    if (shipEl) {
      // Envio estandar fijo ($3); sin regla de "gratis desde $50" por ahora.
      shipEl.textContent = subtotal === 0 ? '—' : 'Se calcula al pagar';
    }

    // Estado de las sugerencias segun el carrito.
    document.querySelectorAll<HTMLButtonElement>('[data-addon-add]').forEach((btn) => {
      const inCart = getCart().some((i) => i.sku === btn.dataset.sku);
      btn.textContent = inCart ? 'Agregado' : 'Agregar';
      btn.disabled = inCart;
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-addon-add]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const d = btn.dataset;
      addToCart({
        sku: d.sku!,
        name: d.name!,
        price: Number(d.price),
        slug: d.slug!,
        category: d.category!,
        emoji: d.emoji!,
        image: d.image || undefined,
      });
      render();
    })
  );

  // "Va bien con": el stock real del proxy decide cuales candidatos se
  // muestran (hasta 3). Sin proxy configurado se muestran los primeros 3 tal
  // cual; la validacion definitiva de stock ocurre igual en el checkout.
  async function filtrarSugerencias() {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-addon-card]'));
    if (cards.length === 0) return;
    const items = await fetchStock(cards.map((c) => c.dataset.sku!));
    const bySku = items ? new Map(items.map((i) => [i.sku, i.available])) : null;
    const enCarrito = new Set(getCart().map((i) => i.sku));
    let visibles = 0;
    for (const card of cards) {
      const disponible = bySku ? (bySku.get(card.dataset.sku!) ?? 0) > 0 : true;
      const mostrar = disponible && !enCarrito.has(card.dataset.sku!) && visibles < 3;
      card.hidden = !mostrar;
      if (mostrar) visibles += 1;
    }
    sugerenciasVisibles = visibles;
    render();
  }

  filtrarSugerencias();

  // Nota de regalo: se guarda en localStorage para usarla en el checkout.
  const giftToggle = document.querySelector<HTMLInputElement>('[data-gift-toggle]');
  const giftNote = document.querySelector<HTMLTextAreaElement>('[data-gift-note]');
  try {
    const saved = JSON.parse(localStorage.getItem(GIFT_KEY) ?? 'null');
    if (saved && giftToggle && giftNote) {
      giftToggle.checked = !!saved.on;
      giftNote.value = saved.note ?? '';
      giftNote.hidden = !saved.on;
    }
  } catch {
    // sin nota guardada
  }
  function saveGift() {
    if (!giftToggle || !giftNote) return;
    giftNote.hidden = !giftToggle.checked;
    localStorage.setItem(GIFT_KEY, JSON.stringify({ on: giftToggle.checked, note: giftNote.value }));
  }
  giftToggle?.addEventListener('change', saveGift);
  giftNote?.addEventListener('input', saveGift);

  // Resumen colapsable solo en movil: en escritorio queda siempre abierto.
  const resumen = document.querySelector<HTMLDetailsElement>('[data-summary-details]');
  const escritorio = window.matchMedia('(min-width: 861px)');
  if (resumen) {
    resumen.open = escritorio.matches;
    escritorio.addEventListener('change', (e) => {
      resumen.open = e.matches;
    });
  }

  render();
</script>

<style is:global>
  .cart-container { max-width: 74rem; }

  .cart-container h1 { font-weight: 400; margin-bottom: 0.2rem; }

  .count-label {
    color: var(--ink-soft);
    margin: 0 0 2.3rem;
  }

  .cart-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(300px, 1fr);
    gap: 2.9rem;
    align-items: start;
  }

  @media (max-width: 860px) {
    .cart-grid { grid-template-columns: 1fr; }
    /* En movil el resumen se apila arriba, colapsado. */
    .summary { order: -1; }
  }

  .cart-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.7rem;
    justify-content: center;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.85rem 1.15rem;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 18px;
  }

  .cart-trust span {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cart-trust .trust-icon { color: var(--green-deep); flex: none; }

  .cart-col {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    min-width: 0;
  }

  .empty-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 2.9rem;
    text-align: center;
  }

  .empty-title { font-size: 1.25rem; font-weight: 600; margin: 0 0 0.55rem; }
  .empty-text { color: var(--ink-soft); margin: 0 0 1.4rem; }

  .cart-items {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .cart-line {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 1.15rem;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1.15rem;
    align-items: start;
  }

  /* Hueco de foto de la linea (diseno: 104px, radio 12px).
     FOTO PENDIENTE: miniatura de producto — cuadrada, minimo 300×300 px. */
  .line-emoji {
    width: 104px;
    height: 104px;
    border-radius: 12px;
    background: var(--surface-2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.2rem;
  }

  /* En pantallas angostas la tarjeta se compacta para que el control de
     cantidad y "Eliminar" quepan completos. */
  @media (max-width: 560px) {
    .cart-line { padding: 0.85rem; gap: 0.85rem; }
    .line-emoji { width: 72px; height: 72px; font-size: 1.7rem; }
    .line-controls { flex-wrap: wrap; gap: 0.55rem 0.85rem; }
  }

  .line-info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .line-info a { color: var(--ink); font-weight: 600; font-size: 1.05rem; }

  .line-price { font-size: 0.82rem; color: var(--ink-soft); }

  .line-controls {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 0.55rem;
  }

  .qty-pill {
    display: flex;
    align-items: center;
    border: 1px solid rgba(27, 42, 31, 0.2);
    border-radius: 999px;
    overflow: hidden;
    background: #ffffff;
  }

  .qty-pill button {
    width: 36px;
    height: 36px;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-size: 1.05rem;
    cursor: pointer;
  }

  .qty-pill button {
    transition: background 120ms ease, transform 160ms var(--ease-out);
  }

  .qty-pill button:hover { background: var(--bg); }

  /* Se toca muchas veces seguidas: solo un apreton corto, nada mas. */
  .qty-pill button:active { transform: scale(0.92); }

  @media (prefers-reduced-motion: reduce) {
    .qty-pill button:active { transform: none; }
  }

  .qty-pill span {
    min-width: 28px;
    text-align: center;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .line-remove {
    border: 0;
    background: transparent;
    font-size: 0.82rem;
    color: var(--ink-soft);
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
  }

  .line-remove:hover { color: var(--red); }

  .line-discount {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--green-deep);
  }

  .line-amounts {
    text-align: right;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .line-compare {
    font-size: 13px;
    color: rgba(27, 42, 31, 0.5);
    text-decoration: line-through;
    font-variant-numeric: tabular-nums;
  }

  .line-total { font-size: 1.05rem; font-variant-numeric: tabular-nums; }

  .gift-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 1.4rem;
  }

  .gift-check {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.95rem;
    font-weight: 400;
    margin: 0;
    cursor: pointer;
  }

  .gift-check input {
    width: 18px;
    height: 18px;
    accent-color: var(--green-deep);
    padding: 0;
  }

  .gift-card textarea {
    margin-top: 0.85rem;
    min-height: 86px;
    resize: vertical;
  }

  .addons-title {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0.55rem 0 0.85rem;
  }

  .addons-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.85rem;
  }

  .addon-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .addon-photo {
    position: relative;
    height: 130px;
    background: linear-gradient(160deg, var(--green-tint), var(--surface-2));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
  }

  .addon-photo--img {
    background-size: cover;
    background-position: center;
  }

  .addon-photo[data-medidas]::after {
    content: attr(data-medidas);
    position: absolute;
    right: 8px;
    bottom: 8px;
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(27, 42, 31, 0.5);
    background: rgba(238, 245, 240, 0.85);
    padding: 2px 7px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .addon-info {
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .addon-name { font-size: 0.88rem; font-weight: 600; line-height: 1.35; margin: 0; }
  .addon-price { font-size: 0.88rem; margin: 0; }

  .addon-add {
    margin-top: 0.3rem;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.82rem;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgba(27, 42, 31, 0.25);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .addon-add:hover { background: var(--bg); }
  .addon-add:disabled { opacity: 0.55; cursor: default; }

  /* Resumen */
  .summary {
    background: #ffffff;
