    .summary-toggle { display: flex; }
    .summary-title { display: none; }
    .summary-details[open] .summary-body { margin-top: 1.15rem; }

    /* Mismo despliegue que el resumen del checkout: entra fundiendose y
       bajando apenas; el cierre de details es instantaneo y esta bien asi. */
    .summary-details[open] .summary-body {
      animation: resumen-entra 260ms var(--ease-out) both;
    }
  }

  @keyframes resumen-entra {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
