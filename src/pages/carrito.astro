  /* Barra del colapsable (solo movil). */
  .summary-toggle {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    cursor: pointer;
    font-weight: 600;
    list-style: none;
  }

  .summary-toggle::-webkit-details-marker { display: none; }

  .summary-toggle > span {
    display: flex;
    align-items: center;
