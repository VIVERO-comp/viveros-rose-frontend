    transform: translateY(-2px) rotate(45deg);
    transition: transform 240ms var(--ease-out);
  }

  .summary-details[open] .summary-toggle > span::after {
    transform: translateY(2px) rotate(-135deg);
  }

  @media (max-width: 860px) {
