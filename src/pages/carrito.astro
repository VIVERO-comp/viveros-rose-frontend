  }

  .summary-toggle > span::after {
    content: '';
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--ink-soft);
    border-bottom: 2px solid var(--ink-soft);
    /* El ajuste vertical va en el transform (no en margin) para que el giro
