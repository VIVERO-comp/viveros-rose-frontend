---
// Home del handoff (Home Plantas Panama.dc.html): hero con acuarela, franja
// de garantias, "Recien del vivero", tarjetas de interior/patio, colecciones
// y tipos, banda del quiz, "Las mas vendidas", paisajismo,
// guias y newsletter. El catalogo sigue siendo src/data/products.ts
// y las tarjetas conservan su StockBadge conectado al stock proxy.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import NewsletterBand from '../components/NewsletterBand.astro';
import ProductCard from '../components/ProductCard.astro';
import { collections } from '../data/collections';
import { esComprable } from '../data/products';
import { guides } from '../data/guides';
import { ventasTotales } from '../data/ventas';
import { productosPublicados } from '../lib/catalogo-build';
import { ENVIO_GRATIS_DESDE } from '../lib/envio';
import { whatsappLink } from '../lib/site';

// Catalogo publicado: sin los archivados en Odoo (src/lib/catalogo-build.ts).
const products = await productosPublicados();

// Si un slug curado desaparece del catalogo (p.ej. al re-importar de Odoo o
// al archivarse el producto), se omite en vez de romper el build.
const bySlugs = (slugs: string[]) =>
  slugs.map((slug) => products.find((p) => p.slug === slug)).filter((p) => p !== undefined);

// Selecciones curadas del diseno (productos reales del catalogo). La grilla
// de tarjetas es de 4 columnas fijas, asi que cada seccion completa SIEMPRE
// sus 4 puestos: si un slug curado ya no existe (lavanda quedo archivada en
// Odoo y dejaba un hueco en la fila), se rellena con otros productos del
// catalogo. Dentro de cada fila van primero los productos que ya tienen foto
// real, para que la portada no abra con puros huecos de "foto pendiente".
const usados = new Set<string>();
const filaDeCuatro = (slugs: string[]) => {
  const curados = bySlugs(slugs).filter((p) => !usados.has(p.slug));
  const relleno = products.filter((p) => !usados.has(p.slug) && !curados.includes(p));
  const candidatos = [
    ...curados.filter((p) => p.image),
    ...relleno.filter((p) => p.image),
    ...curados.filter((p) => !p.image),
    ...relleno.filter((p) => !p.image),
  ];
  const fila = candidatos.slice(0, 4);
  for (const p of fila) usados.add(p.slug);
  return fila;
};

const featured = filaDeCuatro(['monstera-deliciosa', 'rosa', 'lavanda', 'ficus-lyrata']);

// "Las mas vendidas" reales: los 4 con mas unidades vendidas (ventas.ts)
// que se puedan comprar hoy. Directo, sin la preferencia por foto de
// filaDeCuatro: aqui el ranking es el contenido de la fila.
const bestsellers = products
  .filter((p) => ventasTotales(p) > 0 && esComprable(p) && p.available > 0 && !usados.has(p.slug))
  .sort((a, b) => ventasTotales(b) - ventasTotales(a))
  .slice(0, 4);
// La grilla es de 4 puestos fijos: si las ventas reales no alcanzan (p. ej.
// un mas vendido quedo archivado o sin stock), se completa con otros
// comprables con stock, primero los que ya tienen foto.
if (bestsellers.length < 4) {
  const relleno = products.filter(
    (p) => esComprable(p) && p.available > 0 && !usados.has(p.slug) && !bestsellers.includes(p),
  );
  bestsellers.push(
    ...[...relleno.filter((p) => p.image), ...relleno.filter((p) => !p.image)].slice(
      0,
      4 - bestsellers.length,
    ),
  );
}
for (const p of bestsellers) usados.add(p.slug);

const colName = (slug: string) => collections.find((c) => c.slug === slug)!.name;

// Tiles de "Compra por coleccion" (referencia "Shop By Collection" de The
// Sill: visual redondeado arriba y nombre debajo, 6 por fila en escritorio).
// El emoji es el visual provisional hasta tener fotos por coleccion; cuando
// existan, agregar `image: '/ruta.jpg'` al tile y la foto reemplaza al emoji.
interface HomeTile {
  label: string;
  slug: string;
  emoji: string;
  image?: string; // foto del tile; si falta, el visual es el emoji
}

const collectionTiles: HomeTile[] = [
  { label: 'Fáciles de cuidar', slug: 'faciles', emoji: '🪴', image: '/fotos_colecciones/faciles.jpeg' },
  { label: 'Poca luz', slug: 'poca-luz', emoji: '🌿', image: '/fotos_colecciones/poca-luz.jpeg' },
  { label: 'Sol pleno', slug: 'jardin', emoji: '☀️', image: '/fotos_colecciones/jardin.jpeg' },
  { label: 'Aptas para mascotas', slug: 'pet-friendly', emoji: '🐶', image: '/fotos_colecciones/pet-friendly.jpeg' },
  { label: 'Para interiores', slug: 'interior', emoji: '🛋️', image: '/fotos_colecciones/interior.jpeg' },
  { label: 'Para regalar', slug: 'regalar', emoji: '🎁', image: '/fotos_colecciones/regalar.jpeg' },
];

// Tiles de "Compra por tipo". Veraneras y frutales se quitaron porque el
// catalogo de Odoo aun no los tiene; reponerlos cuando existan.
const typeTiles: HomeTile[] = [
  { label: 'Rosales', slug: 'rosales', emoji: '🌹', image: '/fotos_colecciones/rosales.jpeg' },
  { label: 'Palmas', slug: 'palmas', emoji: '🌴', image: '/fotos_colecciones/palmas.jpeg' },
  { label: 'Crotos', slug: 'crotos', emoji: '🍃', image: '/fotos_colecciones/crotos.jpeg' },
  { label: 'Florales', slug: 'florales', emoji: '🌺', image: '/fotos_colecciones/florales.jpeg' },
  { label: 'Cactus y suculentas', slug: 'suculentas', emoji: '🌵', image: '/fotos_colecciones/suculentas.jpeg' },
  { label: 'Hierbas de cocina', slug: 'hierbas', emoji: '🌱', image: '/fotos_colecciones/hierbas.jpeg' },
];

const mainGuide = guides[0];
const otherGuides = guides.slice(1);

const paisajismoMessage = whatsappLink('Hola, quiero cotizar un proyecto de paisajismo.');
---

<Base
  title="Plantas del vivero, entregadas en tu casa"
  description="Vivero propio en Panamá. Compra plantas cultivadas por nosotros, con entrega en la ciudad de Panamá y asesoría por WhatsApp."
>
  <section class="hero">
    <div class="hero-photo" style="background-image: url('/fotos_homepage/hero_bolsa.jpg'); background-size: cover; background-position: right center;" aria-hidden="true"></div>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-content">
      <div class="container">
        <div class="hero-copy">
          <p class="hero-kicker">Vivero propio en Panamá</p>
          <h1>
            Plantas para tu hogar, <span class="hero-underline"> enviadas </span> hasta tu puerta!
          </h1>
          <p class="hero-sub">
            Plantas cultivadas en nuestro propio vivero, entrega en la ciudad de Panamá y asesoría
            por WhatsApp con la gente que las siembra.
          </p>
          <div class="hero-ctas">
            <a
              href={whatsappLink('Hola, vengo de plantaspanama.com y tengo una consulta.')}
              class="btn btn--green hero-btn"
              target="_blank"
              rel="noopener"
            >
              <Icon name="message-circle" size={18} /> Escríbenos por WhatsApp
            </a>
            <a href="/plantas" class="btn hero-btn hero-btn--light">
              <Icon name="leaf" size={18} /> Comprar plantas
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="assurance-band">
    <div class="container assurance-grid">
      <div><Icon name="truck" size={22} class="assurance-icon" /><span>{ENVIO_GRATIS_DESDE === null ? 'Directo del vivero' : `Envío gratis desde $${ENVIO_GRATIS_DESDE}`}</span></div>
      <div><Icon name="clock" size={22} class="assurance-icon" /><span>Entrega en 24–72 h</span></div>
      <div><Icon name="message-square" size={22} class="assurance-icon" /><span>Asesoría por WhatsApp</span></div>
      <div><Icon name="sprout" size={22} class="assurance-icon" /><span>Guía de cuidado incluida</span></div>
    </div>
  </section>

  <section id="catalogo" class="container home-section home-section--first">
    <div class="section-head">
      <h2>Recién del vivero</h2>
      <a href="/plantas?c=recien" class="see-all">Ver todo</a>
    </div>
    <div class="cards-4">
      {featured.map((p) => <ProductCard product={p} />)}
    </div>
  </section>

  <section class="container home-section--tight">
    <div class="duo-grid">
      <a href="/plantas/interior" class="duo-card">
        <div class="duo-photo" style="background-image: url('/fotos_homepage/interior.webp'); background-size: cover; background-position: center;" aria-hidden="true"></div>
        <div class="duo-overlay" aria-hidden="true"></div>
        <div class="duo-copy">
          <p class="duo-kicker">Conoce más</p>
          <h3>Interior</h3>
          <p class="duo-sub">Follaje para apartamentos con luz filtrada y aire acondicionado.</p>
        </div>
      </a>
      <a href="/plantas/exterior" class="duo-card">
        <div class="duo-photo" style="background-image: url('/fotos_homepage/patio.jpg'); background-size: cover; background-position: center;" aria-hidden="true"></div>
        <div class="duo-overlay" aria-hidden="true"></div>
        <div class="duo-copy">
          <p class="duo-kicker">Conoce más</p>
          <h3>Patio y jardín</h3>
          <p class="duo-sub">Especies de sol pleno que aguantan la lluvia y el calor del istmo.</p>
        </div>
      </a>
    </div>
  </section>

  <section class="container home-section">
    <hr class="section-rule" />
    <h2 class="tiles-title">Compra por colección</h2>
    <div class="tiles-6">
      {collectionTiles.map((t) => (
        <a href={`/plantas?c=${t.slug}`} class="tile">
          <span
            class="tile-visual"
            style={t.image ? `background-image: url('${t.image}'); background-size: cover; background-position: center;` : undefined}
            aria-hidden="true"
          >{t.image ? '' : t.emoji}</span>
          <span class="tile-name">{t.label}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container home-section--tight">
    <h2 class="tiles-title">Compra por tipo de planta</h2>
    <div class="tiles-6">
      {typeTiles.map((t) => (
        <a href={`/plantas?c=${t.slug}`} class="tile">
          <span
            class="tile-visual"
            style={t.image ? `background-image: url('${t.image}'); background-size: cover; background-position: center;` : undefined}
            aria-hidden="true"
          >{t.image ? '' : t.emoji}</span>
          <span class="tile-name">{t.label}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="quiz-band">
    <div class="container quiz-grid">
      <!-- La foto del quiz mide 400x342: se muestra a tamano natural (se
           pixelaba estirada) y flota suave; sin JS la tarjeta queda visible. -->
      <div class="quiz-photo" aria-hidden="true">
        <img src="/fotos_homepage/quiz_foto.jpg" alt="Ilustración en acuarela de un signo de interrogación formado por arbustos en un jardín" width="400" height="342" loading="lazy" />
      </div>
      <div class="quiz-card">
        <h2>Encuentra tu planta ideal</h2>
        <p>
          Tres preguntas: cuánta luz tienes, cuánto espacio y cuánto tiempo quieres dedicarle. Te
          decimos qué hay disponible hoy.
        </p>
        <a href="/quiz" class="btn btn--green quiz-btn">Hacer el test</a>
      </div>
    </div>
  </section>

  <script>
    // Revela la tarjeta del quiz al entrar en pantalla. La clase js-reveal se
    // agrega aqui para que sin JavaScript la tarjeta nunca quede oculta.
    const banda = document.querySelector('.quiz-band');
    const tarjeta = document.querySelector('.quiz-card');
    const prefiereQuieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (banda && tarjeta && !prefiereQuieto && 'IntersectionObserver' in window) {
      banda.classList.add('js-reveal');
      const observador = new IntersectionObserver(
        (entradas) => {
          if (entradas[0].isIntersecting) {
            tarjeta.classList.add('is-visible');
            observador.disconnect();
          }
        },
        { threshold: 0.35 },
      );
      observador.observe(tarjeta);
    }
  </script>

  <section class="container home-section">
    <div class="section-head">
      <h2>Las más vendidas</h2>
      <a href="/plantas?c=mas-vendidas" class="see-all">Ver todo</a>
    </div>
    <div class="cards-4">
      {bestsellers.map((p) => <ProductCard product={p} />)}
    </div>
  </section>

  <section id="paisajismo" class="container home-section--tight">
    <!-- Banda oscura dividida como la de mayoristas: texto a la izquierda y
         foto de un trabajo propio recortada en diagonal a la derecha. -->
    <div class="paisajismo-band">
      <div class="paisajismo-photo" style="background-image: url('/fotos_homepage/paisajismo_trabajo.jpg'); background-size: cover; background-position: center 60%;" aria-hidden="true"></div>
      <div class="paisajismo-inner">
        <p class="kicker kicker--light">Paisajismo</p>
        <h2 class="paisajismo-title">Jardines que sembramos nosotros</h2>
        <p class="paisajismo-copy">
          Diseñamos, sembramos y mantenemos jardines residenciales y comerciales con material del propio
          vivero. Cotizamos en sitio y entregamos un plan de mantenimiento por temporada.
        </p>
        <a href={paisajismoMessage} class="btn btn--green paisajismo-btn" target="_blank" rel="noopener">
          <Icon name="message-circle" size={16} /> Cotizar por WhatsApp
        </a>
      </div>
    </div>
  </section>

  <section class="container home-section">
    <div class="section-head">
      <h2>Guías de cuidado</h2>
      <a href="/guia" class="see-all">Ver todas</a>
    </div>
    <div class="guides-grid">
      <a href={`/guia/${mainGuide.slug}`} class="guide-main">
        <div class="guide-photo" style="background-image: url('/fotos_homepage/guia_de_cuidado.jpg'); background-size: cover; background-position: center;" aria-hidden="true"></div>
        <h3>{mainGuide.title}</h3>
        <p>{mainGuide.excerpt}</p>
      </a>
      <div class="guides-side">
        <p class="guides-side-kicker">Últimas guías</p>
        {
          otherGuides.map((g) => (
            <a href={`/guia/${g.slug}`} class="guide-row">
              <div
                class="guide-thumb"
                style={`background-image: url('${g.photo}'); background-size: cover; background-position: center;`}
                aria-hidden="true"
              />
              <div>
                <h4>{g.title}</h4>
                <p class="guide-row-excerpt">{g.excerpt}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <NewsletterBand />
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    height: 620px;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: #f0e9dc;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    background: linear-gradient(150deg, #f5efe3, #ece4d4 70%);
  }

  /* La foto es clara (fondo beige): el velo solo refuerza un poco el lado
     izquierdo para que el texto oscuro no compita con la foto. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(240, 233, 220, 0.85) 0%,
      rgba(240, 233, 220, 0.45) 45%,
      rgba(240, 233, 220, 0) 75%
    );
  }

  .hero-content {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
  }

  /* El contenedor es hijo de un flex: sin width 100% se encoge al contenido
     y el texto del hero queda centrado; el diseno lo lleva a la izquierda. */
  .hero-content .container { width: 100%; }

  .hero-copy { max-width: 600px; color: var(--ink); }

  .hero-kicker {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green-dark);
    margin: 0 0 18.4px;
  }

  .hero h1 {
    font-weight: 400;
    font-size: clamp(34px, 5vw, 62px);
    line-height: 1.06;
    letter-spacing: -0.015em;
    margin: 0 0 18.4px;
    color: var(--ink);
  }

  .hero-underline {
    color: var(--green-dark);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .hero-sub {
    font-size: 17px;
    line-height: 1.6;
    color: rgba(27, 42, 31, 0.78);
    max-width: 34rem;
    margin: 0 0 27.6px;
  }

  .hero-ctas { display: flex; gap: 13.8px; flex-wrap: wrap; }

  .hero-btn { font-size: 16px; padding: 15px 28px; }

  .hero-btn--light {
    background: #ffffff;
    border-color: rgba(27, 42, 31, 0.25);
    color: #16321f;
  }

  .hero-btn--light:hover { border-color: rgba(27, 42, 31, 0.5); color: #16321f; }

  /* Franja de garantias */
  .assurance-band {
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }

  .assurance-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 27.6px;
    padding-top: 27.6px;
    padding-bottom: 27.6px;
  }

  .assurance-grid > div {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 9.2px;
    text-align: center;
    font-size: 17px;
  }

  .assurance-grid :global(.assurance-icon) { color: var(--green); }

  /* Secciones */
  .home-section { padding-top: 73.6px; }
  .home-section--first { padding-top: 73.6px; }
  .home-section--tight { padding-top: 55px; }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 27.6px;
    margin-bottom: 27.6px;
  }

  .section-head h2,
  .tiles-title { font-size: 36px; margin: 0; }

  .tiles-title { margin-bottom: 27.6px; }

  .see-all {
    font-size: 13px;
    text-decoration: underline;
    color: var(--green-deep);
    white-space: nowrap;
  }

  .section-rule {
    height: 1px;
    border: 0;
    margin: 0 0 36.8px;
    background: var(--line);
  }

  .section-rule--after { margin: 36.8px 0 0; }

  .cards-4 {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18.4px;
  }

  /* Interior / Patio */
  .duo-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 27.6px;
  }

  .duo-card {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-photo);
    overflow: hidden;
    outline: 1px solid var(--line);
    background: var(--surface-2);
    color: #eef5f0;
  }

  .duo-card:hover { text-decoration: none; color: #eef5f0; }
  .duo-card:hover h3 { text-decoration: underline; }

  .duo-photo { position: absolute; inset: 0; background: var(--surface-2); }

  .duo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(27, 42, 31, 0.94) 0%,
      rgba(27, 42, 31, 0.9) 30%,
      rgba(27, 42, 31, 0.8) 48%,
      rgba(27, 42, 31, 0.35) 72%,
      rgba(27, 42, 31, 0) 100%
    );
    pointer-events: none;
  }

  .duo-copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 27.6px;
    display: flex;
    flex-direction: column;
    gap: 9.2px;
  }

  .duo-kicker {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0;
  }

  .duo-copy h3 {
    font-weight: 600;
    font-size: 32px;
    line-height: 1.1;
    margin: 0;
    color: #eef5f0;
  }

  .duo-sub {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.82);
    margin: 0;
    max-width: 28rem;
  }

  /* Tiles de coleccion y tipo (referencia "Shop By Collection" de The Sill):
     visual cuadrado con esquinas redondeadas y el nombre centrado debajo. */
  .tiles-6 {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 18.4px;
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: var(--ink);
    font-size: 15px;
    font-weight: 500;
  }

  .tile:hover {
    text-decoration: none;
    color: var(--ink);
  }

  .tile:hover .tile-name { text-decoration: underline; }

  .tile-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-photo);
    overflow: hidden;
    outline: 1px solid rgba(27, 42, 31, 0.12);
    background: linear-gradient(160deg, var(--green-tint), var(--surface-2));
    font-size: clamp(40px, 4vw, 56px);
  }

  .tile-name { text-align: center; }

  /* Banda del quiz: fondo verde oscuro, como las bandas de mayoristas. */
  .quiz-band {
    margin-top: 73.6px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--card-dark);
    overflow: hidden;
  }

  .quiz-grid {
    display: grid;
    grid-template-columns: 1fr minmax(0, 460px);
    align-items: center;
    gap: clamp(27.6px, 5vw, 73.6px);
    padding-top: 64px;
    padding-bottom: 64px;
  }

  .quiz-photo { display: flex; justify-content: center; }

  .quiz-photo img {
    width: min(400px, 100%);
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-photo);
    background: #fff;
    box-shadow: 0 18px 40px rgba(27, 42, 31, 0.14);
    transform: rotate(-2deg);
    animation: quiz-float 4s ease-in-out infinite;
  }

  @keyframes quiz-float {
    0%,
    100% {
      transform: rotate(-2deg) translateY(0);
    }
    50% {
      transform: rotate(-2deg) translateY(-26px);
    }
  }

  .quiz-card {
    max-width: 460px;
    background: var(--bg);
    border: 1px solid var(--line);
    padding: 36.8px;
  }

  /* Estado previo al reveal: solo cuando el script agrego js-reveal. */
