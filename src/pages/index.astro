---
// Home del handoff (Home Plantas Panama.dc.html): hero con acuarela, franja
// de garantias, "Recien del vivero", tarjetas de interior/patio, colecciones
// y tipos, banda del quiz, "Las mas vendidas", Club Vivero Rose, paisajismo,
// resenas, guias y newsletter. El catalogo sigue siendo src/data/products.ts
// y las tarjetas conservan su StockBadge conectado al stock proxy.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import NewsletterBand from '../components/NewsletterBand.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
import { collections } from '../data/collections';
import { guides } from '../data/guides';
import { whatsappLink } from '../lib/site';

const bySlug = (slug: string) => products.find((p) => p.slug === slug)!;

// Selecciones curadas del diseno (productos reales del catalogo).
const featured = ['rosa-roja', 'veranera-fucsia', 'aglaonema-silver-bay', 'monstera-deliciosa'].map(bySlug);
const bestsellers = ['ixora-roja', 'palma-areca', 'ficus-lyrata', 'mango-calidad'].map(bySlug);

const colName = (slug: string) => collections.find((c) => c.slug === slug)!.name;

// Tiles de "Compra por coleccion" (copia del diseno, filtros reales).
const collectionTiles = [
  { label: 'Fáciles de cuidar', slug: 'faciles' },
  { label: 'Poca luz', slug: 'poca-luz' },
  { label: 'Sol pleno', slug: 'jardin' },
  { label: 'Cercas vivas', slug: 'palmas' },
  { label: 'Frutales de patio', slug: 'frutales' },
  { label: 'Para regalar', slug: 'mas-vendidas' },
];

// Tiles de "Compra por tipo" (el diseno lista suculentas, pero el catalogo
// actual no tiene: se muestra Florales en su lugar).
const typeTiles = [
  { label: 'Rosales', slug: 'rosales' },
  { label: 'Veraneras', slug: 'veraneras' },
  { label: 'Palmas', slug: 'palmas' },
  { label: 'Crotos', slug: 'crotos' },
  { label: 'Frutales', slug: 'frutales' },
  { label: 'Florales', slug: 'florales' },
];

const reviews = [
  {
    text: 'Pedí seis chavelitas para la entrada y llegaron al día siguiente, con la tierra húmeda y sin una hoja rota. Me escribieron por WhatsApp para coordinar la hora.',
    author: 'Marisol A. — Costa del Este',
  },
  {
    text: 'Compré un ficus mediano para la oficina. Venía con la guía de riego pegada a la maceta, que es justo lo que necesitaba porque nunca sé cuánta agua ponerle.',
    author: 'Javier R. — Bella Vista',
  },
  {
    text: 'Hicieron el diseño de la bordura del jardín y volvieron al mes a revisar. Es la primera vez que las plantas que compro sobreviven la temporada seca.',
    author: 'Ana L. — Clayton',
  },
];

const mainGuide = guides[0];
const otherGuides = guides.slice(1);

// El "test de la planta ideal" no tiene backend: la promesa del diseno
// ("te decimos que hay disponible hoy") se cumple por WhatsApp.
const quizMessage = whatsappLink(
  'Hola, quiero ayuda para elegir una planta. Luz que tengo: ___ · Espacio: ___ · Tiempo para cuidarla: ___',
);
const clubMessage = whatsappLink('Hola, quiero unirme al Club Vivero Rose.');
const paisajismoMessage = whatsappLink('Hola, quiero cotizar un proyecto de paisajismo.');
---

<Base
  title="Plantas del vivero, entregadas en tu casa"
  description="Vivero real en Panamá. Compra plantas online con inventario actualizado, entrega en la ciudad de Panamá y asesoría por WhatsApp."
>
  <section class="hero">
    <!-- FOTO PENDIENTE: hero acuarela — a lo ancho, minimo 1920×620 px -->
    <div class="hero-photo" data-medidas="Foto hero · 1920×620" aria-hidden="true"></div>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-content">
      <div class="container">
        <div class="hero-copy">
          <p class="hero-kicker">Vivero propio en Panamá</p>
          <h1>
            Plantas del vivero, <span class="hero-underline">entregadas</span> en tu casa
          </h1>
          <p class="hero-sub">
            Inventario real actualizado cada día, entrega en la ciudad de Panamá y asesoría por
            WhatsApp con la gente que siembra las plantas.
          </p>
          <div class="hero-ctas">
            <a
              href={whatsappLink('Hola, vengo de plantaspanama.com y tengo una consulta.')}
              class="btn btn--green hero-btn"
              target="_blank"
              rel="noopener"
            >
              <Icon name="message-circle" size={18} /> Escríbenos por WhatsApp
            </a>
            <a href="/plantas" class="btn hero-btn hero-btn--light">
              <Icon name="leaf" size={18} /> Comprar plantas
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="assurance-band">
    <div class="container assurance-grid">
      <div><Icon name="truck" size={22} class="assurance-icon" /><span>Directo del vivero</span></div>
      <div><Icon name="clock" size={22} class="assurance-icon" /><span>Entrega en 24–48 h</span></div>
      <div><Icon name="message-square" size={22} class="assurance-icon" /><span>Asesoría por WhatsApp</span></div>
      <div><Icon name="sprout" size={22} class="assurance-icon" /><span>Guía de cuidado incluida</span></div>
    </div>
  </section>

  <section id="catalogo" class="container home-section home-section--first">
    <div class="section-head">
      <h2>Recién del vivero</h2>
      <a href="/plantas?c=recien" class="see-all">Ver todo</a>
    </div>
    <div class="cards-4">
      {featured.map((p) => <ProductCard product={p} />)}
    </div>
  </section>

  <section class="container home-section--tight">
    <div class="duo-grid">
      <a href="/plantas/interior" class="duo-card">
        <!-- FOTO PENDIENTE: banda interior — 16:10, minimo 1200×750 px -->
        <div class="duo-photo" data-medidas="Foto 16:10 · 1200×750" aria-hidden="true"></div>
        <div class="duo-overlay" aria-hidden="true"></div>
        <div class="duo-copy">
          <p class="duo-kicker">Conoce más</p>
          <h3>Interior</h3>
          <p class="duo-sub">Follaje para apartamentos con luz filtrada y aire acondicionado.</p>
        </div>
      </a>
      <a href="/plantas/exterior" class="duo-card">
        <!-- FOTO PENDIENTE: banda patio y jardin — 16:10, minimo 1200×750 px -->
        <div class="duo-photo" data-medidas="Foto 16:10 · 1200×750" aria-hidden="true"></div>
        <div class="duo-overlay" aria-hidden="true"></div>
        <div class="duo-copy">
          <p class="duo-kicker">Conoce más</p>
          <h3>Patio y jardín</h3>
          <p class="duo-sub">Especies de sol pleno que aguantan la lluvia y el calor del istmo.</p>
        </div>
      </a>
    </div>
  </section>

  <section class="container home-section">
    <hr class="section-rule" />
    <h2 class="tiles-title">Compra por colección</h2>
    <div class="tiles-6">
      {collectionTiles.map((t) => <a href={`/plantas?c=${t.slug}`} class="tile">{t.label}</a>)}
    </div>
  </section>

  <section class="container home-section--tight">
    <h2 class="tiles-title">Compra por tipo de planta</h2>
    <div class="tiles-6">
      {typeTiles.map((t) => <a href={`/plantas?c=${t.slug}`} class="tile">{t.label}</a>)}
    </div>
  </section>

  <section class="quiz-band">
    <!-- FOTO PENDIENTE: banda del quiz (acuarela) — a lo ancho, minimo 1920×460 px -->
    <div class="quiz-photo" data-medidas="Foto banda · 1920×460" aria-hidden="true"></div>
    <div class="quiz-content">
      <div class="container quiz-align">
        <div class="quiz-card">
          <h2>Encuentra tu planta ideal</h2>
          <p>
            Tres preguntas: cuánta luz tienes, cuánto espacio y cuánto tiempo quieres dedicarle. Te
            decimos qué hay disponible hoy.
          </p>
          <a href={quizMessage} class="btn btn--green" target="_blank" rel="noopener">Hacer el test</a>
        </div>
      </div>
    </div>
  </section>

  <section class="container home-section">
    <div class="section-head">
      <h2>Las más vendidas</h2>
      <a href="/plantas?c=mas-vendidas" class="see-all">Ver todo</a>
    </div>
    <div class="cards-4">
      {bestsellers.map((p) => <ProductCard product={p} />)}
    </div>
  </section>

  <section class="container home-section">
    <hr class="section-rule" />
    <div class="club-grid">
      <!-- FOTO PENDIENTE: club vivero rose — apaisada, minimo 800×560 px -->
      <div class="club-photo" data-medidas="Foto · 800×560" aria-hidden="true"></div>
      <div>
        <p class="kicker">Programa de lealtad</p>
        <h2>Club Vivero Rose</h2>
        <p class="club-copy">
          Recordatorios de riego según la temporada, precios de socio en cada pedido y aviso
          anticipado cuando sale una tanda nueva del vivero.
        </p>
        <a href={clubMessage} class="btn btn--green" target="_blank" rel="noopener">Quiero unirme</a>
      </div>
    </div>
    <hr class="section-rule section-rule--after" />
  </section>

  <section id="paisajismo" class="container home-section--tight">
    <p class="kicker">Paisajismo</p>
    <h2 class="paisajismo-title">Jardines que sembramos nosotros</h2>
    <p class="paisajismo-copy">
      Diseñamos, sembramos y mantenemos jardines residenciales y comerciales con material del propio
      vivero. Cotizamos en sitio y entregamos un plan de mantenimiento por temporada.
    </p>
    <a href={paisajismoMessage} class="btn btn--green paisajismo-btn" target="_blank" rel="noopener">
      <Icon name="message-circle" size={16} /> Cotizar por WhatsApp
    </a>
  </section>

  <section class="reviews-band">
    <div class="container reviews-inner">
      <h2>Lo que dicen los clientes</h2>
      <div class="reviews-grid">
        {
          reviews.map((r) => (
            <figure class="review-card">
              <div class="review-stars" aria-label="5 estrellas">★★★★★</div>
              <blockquote>{r.text}</blockquote>
              <figcaption>{r.author}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container home-section">
    <div class="section-head">
      <h2>Guías de cuidado</h2>
      <a href="/guia" class="see-all">Ver todas</a>
    </div>
    <div class="guides-grid">
      <a href={`/guia/${mainGuide.slug}`} class="guide-main">
        <!-- FOTO PENDIENTE: guia principal — apaisada, minimo 1000×560 px -->
        <div class="guide-photo" data-medidas="Foto · 1000×560" aria-hidden="true"></div>
        <h3>{mainGuide.title}</h3>
        <p>{mainGuide.excerpt}</p>
      </a>
      <div class="guides-side">
        <p class="guides-side-kicker">Últimas guías</p>
        {
          otherGuides.map((g) => (
            <a href={`/guia/${g.slug}`} class="guide-row">
              <!-- FOTO PENDIENTE: miniatura de guia — cuadrada, minimo 200×200 px -->
              <div class="guide-thumb" data-medidas="200×200" aria-hidden="true" />
              <div>
                <h4>{g.title}</h4>
                <p class="guide-row-excerpt">{g.excerpt}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <NewsletterBand />
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    height: 620px;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: var(--card-dark);
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    background: linear-gradient(150deg, #2a4432, var(--card-dark) 70%);
  }

  .hero-photo::after {
    content: attr(data-medidas);
    position: absolute;
    right: 14px;
    top: 14px;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(238, 245, 240, 0.65);
    background: rgba(27, 42, 31, 0.55);
    padding: 2px 8px;
    border-radius: 999px;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(27, 42, 31, 0.88) 0%,
      rgba(27, 42, 31, 0.7) 45%,
      rgba(27, 42, 31, 0.42) 100%
    );
  }

  .hero-content {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
  }

  .hero-copy { max-width: 600px; color: #eef5f0; }

  .hero-kicker {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0 0 18.4px;
  }

  .hero h1 {
    font-weight: 400;
    font-size: clamp(34px, 5vw, 62px);
    line-height: 1.06;
    letter-spacing: -0.015em;
    margin: 0 0 18.4px;
    color: #eef5f0;
  }

  .hero-underline {
    color: var(--green-light);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .hero-sub {
    font-size: 17px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.86);
    max-width: 34rem;
    margin: 0 0 27.6px;
  }

  .hero-ctas { display: flex; gap: 13.8px; flex-wrap: wrap; }

  .hero-btn { font-size: 16px; padding: 15px 28px; }

  .hero-btn--light {
    background: #f4f7f1;
    border-color: #f4f7f1;
    color: #16321f;
  }

  .hero-btn--light:hover { background: #ffffff; color: #16321f; }

  /* Franja de garantias */
  .assurance-band {
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }

  .assurance-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 27.6px;
    padding-top: 27.6px;
    padding-bottom: 27.6px;
  }

  .assurance-grid > div {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 9.2px;
    text-align: center;
    font-size: 17px;
  }

  .assurance-grid :global(.assurance-icon) { color: var(--green); }

  /* Secciones */
  .home-section { padding-top: 73.6px; }
  .home-section--first { padding-top: 73.6px; }
  .home-section--tight { padding-top: 55px; }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 27.6px;
    margin-bottom: 27.6px;
  }

  .section-head h2,
  .tiles-title { font-size: 36px; margin: 0; }

  .tiles-title { margin-bottom: 27.6px; }

  .see-all {
    font-size: 13px;
    text-decoration: underline;
    color: var(--green-deep);
    white-space: nowrap;
  }

  .section-rule {
    height: 1px;
    border: 0;
    margin: 0 0 36.8px;
    background: var(--line);
  }

  .section-rule--after { margin: 36.8px 0 0; }

  .cards-4 {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18.4px;
  }

  /* Interior / Patio */
  .duo-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 27.6px;
  }

  .duo-card {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-photo);
    overflow: hidden;
    outline: 1px solid var(--line);
    background: var(--surface-2);
    color: #eef5f0;
  }

  .duo-card:hover { text-decoration: none; color: #eef5f0; }
  .duo-card:hover h3 { text-decoration: underline; }

  .duo-photo { position: absolute; inset: 0; background: var(--surface-2); }

  .duo-photo::after {
    content: attr(data-medidas);
    position: absolute;
    right: 12px;
    top: 12px;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(27, 42, 31, 0.5);
    background: rgba(238, 245, 240, 0.85);
    padding: 2px 8px;
    border-radius: 999px;
  }

  .duo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(27, 42, 31, 0.94) 0%,
      rgba(27, 42, 31, 0.9) 30%,
      rgba(27, 42, 31, 0.8) 48%,
      rgba(27, 42, 31, 0.35) 72%,
      rgba(27, 42, 31, 0) 100%
    );
    pointer-events: none;
  }

  .duo-copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 27.6px;
    display: flex;
    flex-direction: column;
    gap: 9.2px;
  }

  .duo-kicker {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0;
  }

  .duo-copy h3 {
    font-weight: 600;
    font-size: 32px;
    line-height: 1.1;
    margin: 0;
    color: #eef5f0;
  }

  .duo-sub {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.82);
    margin: 0;
    max-width: 28rem;
  }

  /* Tiles de coleccion y tipo */
  .tiles-6 {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 18.4px;
  }

  .tile {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 96px;
    padding: 18.4px 13.8px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--bg);
    color: var(--ink);
    font-size: 15px;
    font-weight: 500;
  }

  .tile:hover {
    background: var(--surface-2);
    text-decoration: none;
    color: var(--ink);
  }

  /* Banda del quiz */
  .quiz-band {
    margin-top: 73.6px;
    position: relative;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    height: 460px;
    overflow: hidden;
    background: #f4f7f1;
  }

  .quiz-photo { position: absolute; inset: 0; background: var(--green-tint); }

  .quiz-photo::after {
    content: attr(data-medidas);
    position: absolute;
    left: 14px;
    top: 14px;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(27, 42, 31, 0.5);
    background: rgba(238, 245, 240, 0.85);
    padding: 2px 8px;
    border-radius: 999px;
  }

  .quiz-content {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
  }

  .quiz-align { width: 100%; display: flex; justify-content: flex-end; }

  .quiz-card {
    max-width: 420px;
    background: var(--bg);
    border: 1px solid var(--line);
    padding: 36.8px;
  }

  .quiz-card h2 {
    font-size: 32px;
    line-height: 1.1;
    margin: 0 0 13.8px;
  }

  .quiz-card p {
    font-size: 15px;
    line-height: 1.6;
    color: rgba(27, 42, 31, 0.75);
    margin: 0 0 22px;
  }

  /* Club */
  .club-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 55px;
    align-items: center;
  }

  .club-photo {
    position: relative;
    border-radius: var(--radius-photo);
    overflow: hidden;
    outline: 1px solid rgba(27, 42, 31, 0.12);
    background: var(--surface-2);
    min-height: 280px;
  }

  .club-photo::after {
    content: attr(data-medidas);
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(27, 42, 31, 0.5);
    background: rgba(238, 245, 240, 0.85);
    padding: 2px 8px;
    border-radius: 999px;
  }

  .kicker {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green-deep);
    margin: 0 0 13.8px;
  }

  .club-grid h2 { font-size: 36px; line-height: 1.1; margin: 0 0 13.8px; }

  .club-copy {
    font-size: 16px;
    line-height: 1.65;
    color: rgba(27, 42, 31, 0.75);
    max-width: 38rem;
    margin-bottom: 9.2px;
  }

  /* Paisajismo */
  .paisajismo-title {
    font-weight: 400;
    font-size: clamp(32px, 4vw, 46px);
    line-height: 1.08;
    margin: 0 0 18.4px;
  }

  .paisajismo-copy {
    font-size: 16px;
    line-height: 1.65;
    color: rgba(27, 42, 31, 0.75);
    max-width: 34rem;
  }

  .paisajismo-btn { margin-top: 13.8px; }

  /* Resenas */
  .reviews-band {
    background: var(--surface-2);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-top: 73.6px;
  }

  .reviews-inner { padding-top: 55px; padding-bottom: 55px; }
  .reviews-inner h2 { font-size: 36px; margin: 0 0 36.8px; }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 27.6px;
  }

  .review-card {
    margin: 0;
    padding: 27.6px;
    border: 1px solid var(--line);
    background: var(--bg);
    display: flex;
    flex-direction: column;
    gap: 13.8px;
  }

  .review-stars { color: var(--green); letter-spacing: 0.2em; font-size: 13px; }

  .review-card blockquote {
    margin: 0;
    font-size: 15px;
    line-height: 1.65;
  }

  .review-card figcaption {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  /* Guias */
  .guides-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 36.8px;
    padding-bottom: 73.6px;
  }

  .guide-main { display: block; color: var(--ink); }
  .guide-main:hover { text-decoration: none; color: var(--ink); }
  .guide-main:hover h3 { text-decoration: underline; }

  .guide-photo {
    position: relative;
    border-radius: var(--radius-photo);
    overflow: hidden;
