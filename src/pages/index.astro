---
// Home segun el diseno "Home Plantas Panama" (claude.ai/design).
// Los enlaces del diseno se adaptaron a las rutas reales del sitio y las
// fotos son placeholders marcados con sus medidas.
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { categories, products } from '../data/products';
import { guides } from '../data/guides';
import { whatsappLink } from '../lib/site';

const featured = products.filter((p) => p.available > 0).slice(0, 4);
const bestsellers = products
  .filter((p) => !featured.some((f) => f.sku === p.sku))
  .slice(0, 4);

const [mainGuide, ...otherGuides] = guides;

const reviews = [
  {
    text: 'Pedí seis chavelitas para la entrada y llegaron al día siguiente, con la tierra húmeda y sin una hoja rota. Me escribieron por WhatsApp para coordinar la hora.',
    author: 'Marisol A. — Costa del Este',
  },
  {
    text: 'Compré un ficus mediano para la oficina. Venía con la guía de riego pegada a la maceta, que es justo lo que necesitaba porque nunca sé cuánta agua ponerle.',
    author: 'Javier R. — Bella Vista',
  },
  {
    text: 'Hicieron el diseño de la bordura del jardín y volvieron al mes a revisar. Es la primera vez que las plantas que compro sobreviven la temporada seca.',
    author: 'Ana L. — Clayton',
  },
];
---

<Base
  title="Plantas con entrega a domicilio en Panamá"
  description="Vivero real en Panamá. Compra plantas de interior, exterior, florales y frutales online, con entrega a domicilio y asesoría por WhatsApp."
>
  <section class="hero">
    <!-- FOTO PENDIENTE: hero-acuarela.jpg — banda a lo ancho, minimo 1920×620 px -->
    <div class="hero-photo" data-medidas="Foto hero · 1920×620" aria-hidden="true"></div>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="hero-eyebrow">Vivero propio en Panamá</span>
        <h1>
          Plantas del vivero, <span class="hero-accent">entregadas</span> en tu casa
        </h1>
        <p class="hero-lead">
          Inventario real actualizado cada día, entrega en la ciudad de Panamá y
          asesoría por WhatsApp con la gente que siembra las plantas.
        </p>
        <div class="hero-ctas">
          <a href={whatsappLink('Hola, vengo de plantaspanama.com y tengo una consulta.')} class="btn btn--green" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" /></svg>
            Escríbenos por WhatsApp
          </a>
          <a href="/plantas" class="btn btn--light">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" /><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" /></svg>
            Comprar plantas
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="trust-band">
    <div class="container trust-row">
      <div class="trust-item">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2" /><path d="M15 18H9" /><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14" /><circle cx="17" cy="18" r="2" /><circle cx="7" cy="18" r="2" /></svg>
        <span>Directo del vivero</span>
      </div>
      <div class="trust-item">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
        <span>Entrega en 24–48 h</span>
      </div>
      <div class="trust-item">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
        <span>Asesoría por WhatsApp</span>
      </div>
      <div class="trust-item">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 20h10" /><path d="M10 20c5.5-2.5.8-6.4 3-10" /><path d="M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4.2 2.8-.5 4.4 0 5.5.8z" /><path d="M14.1 6a7 7 0 0 0-1.1 4c1.9-.1 3.3-.6 4.3-1.4 1-1 1.6-2.3 1.7-4.6-2.7.1-4 1-4.9 2z" /></svg>
        <span>Guía de cuidado incluida</span>
      </div>
    </div>
  </section>

  <section id="catalogo" class="section">
    <div class="container">
      <div class="section-head">
        <h2>Recién del vivero</h2>
        <a href="/plantas" class="see-all">Ver todo</a>
      </div>
      <div class="grid grid--4">
        {featured.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container duo-grid">
      <a href="/plantas/interior" class="duo-card">
        <!-- FOTO PENDIENTE: banner interior — proporcion 16:10, minimo 1000×625 px -->
        <div class="duo-photo" data-medidas="Foto 16:10 · 1000×625" aria-hidden="true"></div>
        <div class="duo-scrim" aria-hidden="true"></div>
        <div class="duo-copy">
          <span class="tag-eyebrow">Conoce más</span>
          <h3>Interior</h3>
          <p>Follaje para apartamentos con luz filtrada y aire acondicionado.</p>
        </div>
      </a>
      <a href="/plantas/exterior" class="duo-card">
        <!-- FOTO PENDIENTE: banner patio y jardin — proporcion 16:10, minimo 1000×625 px -->
        <div class="duo-photo" data-medidas="Foto 16:10 · 1000×625" aria-hidden="true"></div>
        <div class="duo-scrim" aria-hidden="true"></div>
        <div class="duo-copy">
          <span class="tag-eyebrow">Conoce más</span>
          <h3>Patio y jardín</h3>
          <p>Especies de sol pleno que aguantan la lluvia y el calor del istmo.</p>
        </div>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <hr class="rule" />
      <h2>Compra por categoría</h2>
      <div class="tile-grid">
        {categories.map((cat) => (
          <a href={`/plantas/${cat.slug}`} class="cat-tile">{cat.name}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="quiz-band">
    <!-- FOTO PENDIENTE: quiz-banda.png — banda a lo ancho, minimo 1920×460 px -->
    <div class="quiz-photo" data-medidas="Foto banda · 1920×460" aria-hidden="true"></div>
    <div class="container quiz-inner">
      <div class="quiz-card">
        <h2>Encuentra tu planta ideal</h2>
        <p>
          Cuéntanos cuánta luz tienes, cuánto espacio y cuánto tiempo quieres
          dedicarle. Te decimos qué hay disponible hoy en el vivero.
        </p>
        <a
          href={whatsappLink('Hola, quiero ayuda para elegir una planta. Les cuento cuánta luz y espacio tengo.')}
          class="btn btn--green"
          target="_blank"
          rel="noopener"
        >Ayúdame a elegir</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Las más vendidas</h2>
        <a href="/plantas" class="see-all">Ver todo</a>
      </div>
      <div class="grid grid--4">
        {bestsellers.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <hr class="rule" />
      <div class="club-grid">
        <figure class="club-figure">
          <!-- FOTO PENDIENTE: imagen del club — bloque de minimo 620×420 px -->
          <div class="club-photo" data-medidas="Foto · 620×420" aria-hidden="true"></div>
        </figure>
        <div>
          <span class="eyebrow">Programa de lealtad</span>
          <h2>Club Vivero Rose</h2>
          <p class="lead">
            Recordatorios de riego según la temporada, precios de socio en cada
            pedido y aviso anticipado cuando sale una tanda nueva del vivero.
          </p>
          <a
            href={whatsappLink('Hola, quiero unirme al Club Vivero Rose.')}
            class="btn btn--green"
            target="_blank"
            rel="noopener"
          >Quiero unirme</a>
        </div>
      </div>
      <hr class="rule rule--bottom" />
    </div>
  </section>

  <section id="paisajismo" class="section--tight">
    <div class="container">
      <span class="eyebrow">Paisajismo</span>
      <h2 class="pais-title">Jardines que sembramos nosotros</h2>
      <p class="lead">
        Diseñamos, sembramos y mantenemos jardines residenciales y comerciales
        con material del propio vivero. Cotizamos en sitio y entregamos un plan
        de mantenimiento por temporada.
      </p>
      <div class="pais-ctas">
        <a href={whatsappLink('Hola, quiero cotizar un proyecto de paisajismo.')} class="btn btn--green" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" /></svg>
          Cotizar por WhatsApp
        </a>
        <a href="/paisajismo" class="btn btn--ghost">Ver proyectos</a>
      </div>
    </div>
  </section>

  <section class="reviews-band">
    <div class="container">
      <h2>Lo que dicen los clientes</h2>
      <div class="reviews-grid">
        {reviews.map((r) => (
          <figure class="review-card">
            <div class="stars" aria-label="5 estrellas">★★★★★</div>
            <blockquote>{r.text}</blockquote>
            <figcaption>{r.author}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Guías de cuidado</h2>
        <a href="/guia" class="see-all">Ver todas</a>
      </div>
      <div class="guides-grid">
        <a href={`/guia/${mainGuide.slug}`} class="guide-main">
          <!-- FOTO PENDIENTE: guia principal — bloque de minimo 740×420 px -->
          <div class="guide-photo" data-medidas="Foto · 740×420" aria-hidden="true"></div>
          <h3>{mainGuide.title}</h3>
          <p>{mainGuide.excerpt}</p>
        </a>
        <div class="guides-side">
          <span class="tag-eyebrow tag-eyebrow--soft">Últimas guías</span>
          {otherGuides.map((g) => (
            <a href={`/guia/${g.slug}`} class="guide-mini">
              <!-- FOTO PENDIENTE: miniatura de guia — cuadrada, minimo 96×96 px -->
              <div class="guide-thumb" data-medidas="96×96" aria-hidden="true"></div>
              <div>
                <h4>{g.title}</h4>
                <p>{g.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="news-band">
    <div class="container news-inner">
      <p class="news-copy">Recibe lo que sale del vivero, avisos de temporada y ofertas.</p>
      <form class="news-form" data-news-form>
        <input type="email" name="email" placeholder="Tu correo" required aria-label="Tu correo" />
        <button type="submit" class="btn btn--green">Suscribirme</button>
      </form>
    </div>
  </section>
</Base>

<script>
  import { whatsappLink } from '../lib/site';

  // Sin backend de newsletter todavia: la suscripcion llega por WhatsApp.
  const form = document.querySelector('[data-news-form]') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = (form.elements.namedItem('email') as HTMLInputElement).value;
    window.open(
      whatsappLink(`Hola, quiero recibir novedades del vivero. Mi correo: ${email}`),
      '_blank',
      'noopener'
    );
  });
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    height: 620px;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: var(--card-dark);
    display: flex;
    align-items: center;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    background: linear-gradient(150deg, #2a4432, var(--card-dark) 70%);
  }

  .hero-photo::after {
    content: attr(data-medidas);
    position: absolute;
    right: 14px;
    top: 14px;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(238, 245, 240, 0.65);
    background: rgba(27, 42, 31, 0.55);
    padding: 2px 8px;
    border-radius: 999px;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(27, 42, 31, 0.88) 0%, rgba(27, 42, 31, 0.7) 45%, rgba(27, 42, 31, 0.42) 100%);
  }

  .hero-inner {
    position: relative;
    width: 100%;
  }

  .hero-copy {
    max-width: 600px;
    color: #eef5f0;
  }

  .hero-eyebrow {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 1.15rem;
  }

  .hero-copy h1 { color: #eef5f0; margin-bottom: 1.15rem; }

  .hero-accent {
    color: #8ce6a8;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .hero-lead {
    font-size: 1.1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.86);
    max-width: 34rem;
    margin-bottom: 1.7rem;
  }

  .hero-ctas {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .btn--light {
    background: #f4f7f1;
    border-color: #f4f7f1;
    color: #16321f;
  }

  .btn--light:hover { background: #ffffff; color: #16321f; }

  @media (max-width: 700px) {
    .hero { height: auto; padding: 4rem 0; }
  }

  /* Banda de confianza */
  .trust-band {
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }

  .trust-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.7rem;
    padding-top: 1.7rem;
    padding-bottom: 1.7rem;
  }

  .trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    text-align: center;
    font-size: 1.05rem;
  }

  .trust-item svg { color: var(--green); }

  @media (max-width: 800px) {
    .trust-row { grid-template-columns: repeat(2, 1fr); }
  }

  /* Encabezados de seccion */
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.7rem;
    flex-wrap: wrap;
    margin-bottom: 1.7rem;
  }

  .section-head h2 { margin: 0; }

  .see-all {
    font-size: 0.82rem;
    text-decoration: underline;
    color: var(--green-deep);
  }

  .rule {
    height: 1px;
    border: 0;
    margin: 0 0 2.3rem;
    background: var(--line);
  }

  .rule--bottom { margin: 2.3rem 0 0; }

  /* Banners interior / patio */
  .duo-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.7rem;
  }

  @media (max-width: 800px) {
    .duo-grid { grid-template-columns: 1fr; }
  }

  .duo-card {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: 24px;
    overflow: hidden;
    outline: 1px solid var(--line);
    background: var(--surface-2);
    color: #eef5f0;
    text-decoration: none;
  }

  .duo-card:hover { text-decoration: none; color: #eef5f0; }
  .duo-card:hover h3 { text-decoration: underline; }

  .duo-photo {
    position: absolute;
    inset: 0;
    background: linear-gradient(150deg, var(--green-tint), var(--surface-2));
  }

  .duo-photo::after {
    content: attr(data-medidas);
    position: absolute;
    right: 12px;
    top: 12px;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(27, 42, 31, 0.5);
    background: rgba(238, 245, 240, 0.85);
    padding: 2px 8px;
    border-radius: 999px;
  }

  .duo-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(27, 42, 31, 0.94) 0%, rgba(27, 42, 31, 0.9) 30%, rgba(27, 42, 31, 0.8) 48%, rgba(27, 42, 31, 0.35) 72%, rgba(27, 42, 31, 0) 100%);
    pointer-events: none;
  }

  .duo-copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.7rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .tag-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .tag-eyebrow--soft { color: var(--ink-soft); }

  .duo-copy h3 {
    font-size: 2rem;
    line-height: 1.1;
    margin: 0;
    color: #eef5f0;
  }

  .duo-copy p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.82);
    margin: 0;
    max-width: 28rem;
  }

  /* Teselas de categoria */
  .tile-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.15rem;
  }

  @media (max-width: 800px) {
    .tile-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .cat-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 96px;
    padding: 1.15rem 0.85rem;
    border: 1px solid rgba(27, 42, 31, 0.2);
    border-radius: var(--radius-lg);
    background: var(--bg);
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .cat-tile:hover {
    background: var(--surface-2);
    color: var(--ink);
    text-decoration: none;
  }

  /* Banda del quiz */
  .quiz-band {
    position: relative;
    margin-top: 2.3rem;
    min-height: 460px;
    display: flex;
    align-items: center;
    overflow: hidden;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  .quiz-photo {
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, var(--green-tint), var(--surface) 55%, var(--surface-2));
  }

  .quiz-photo::after {
    content: attr(data-medidas);
    position: absolute;
    left: 14px;
    top: 14px;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(27, 42, 31, 0.5);
    background: rgba(238, 245, 240, 0.85);
    padding: 2px 8px;
    border-radius: 999px;
  }

  .quiz-inner {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: flex-end;
    padding-top: 2.3rem;
    padding-bottom: 2.3rem;
  }

  .quiz-card {
    max-width: 420px;
    background: var(--bg);
    border: 1px solid var(--line);
    padding: 2.3rem;
  }

  .quiz-card p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-soft);
    margin-bottom: 1.4rem;
  }

  /* Club */
  .club-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 3.4rem;
    align-items: center;
  }

  @media (max-width: 800px) {
    .club-grid { grid-template-columns: 1fr; gap: 1.7rem; }
  }

  .club-figure { margin: 0; }

  .club-photo {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    outline: 1px solid rgba(27, 42, 31, 0.12);
    background: linear-gradient(160deg, var(--green-tint), var(--surface-2));
    min-height: 280px;
  }

  .club-photo::after {
    content: attr(data-medidas);
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(27, 42, 31, 0.5);
    background: rgba(238, 245, 240, 0.85);
    padding: 2px 8px;
    border-radius: 999px;
  }

  /* Paisajismo */
  .pais-title {
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 2.9rem);
  }

  .pais-ctas {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-top: 0.85rem;
  }

  /* Resenas */
  .reviews-band {
    background: var(--surface-2);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-top: 3.5rem;
    padding: 3.4rem 0;
  }

  .reviews-band h2 { margin-bottom: 2.3rem; }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.7rem;
  }

  @media (max-width: 800px) {
    .reviews-grid { grid-template-columns: 1fr; }
  }

  .review-card {
    margin: 0;
    padding: 1.7rem;
    border: 1px solid var(--line);
