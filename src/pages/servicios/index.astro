---
// Indice de servicios: navbar completo del sitio y un hero oscuro compacto
// (mismo lenguaje que el catalogo, mas bajo), con las tres tarjetas que
// abren cada mini pagina. Las mini paginas si van sin navbar (chrome bare).
import Base from '../../layouts/Base.astro';
import ObraBand from '../../components/ObraBand.astro';
import ServiceContact from '../../components/ServiceContact.astro';
import { services } from '../../data/services';
---

<Base
  title="Servicios de paisajismo"
  description="Diseño de jardines, mantenimiento y proyectos comerciales en Panamá, con material de nuestro propio vivero."
  whatsappMessage="Hola, me interesa una cotización de paisajismo."
>
  <section class="svc-hero">
    <div class="svc-hero-photo" style="background-image: url('/fotos_servicios/banda_servicios.jpeg'); background-size: cover; background-position: center;" aria-hidden="true"></div>
    <div class="svc-hero-scrim" aria-hidden="true"></div>
    <div class="container svc-hero-inner">
      <p class="svc-crumb"><a href="/">Inicio</a> / Servicios</p>
      <h1>Servicios</h1>
      <p class="svc-sub">
        Diseñamos, sembramos y mantenemos áreas verdes en toda la ciudad de Panamá.
      </p>
    </div>
  </section>

  <section class="container services-grid-wrap">
    <div class="services-grid">
      {
        services.map((s) => (
          <a href={`/servicios/${s.slug}`} class="service-card">
            <div
              class="service-photo"
              style={`background-image: url('/fotos_servicios/${s.slug}.jpeg'); background-size: cover; background-position: center;`}
              aria-hidden="true"
            />
            <div class="service-copy">
              <h2>{s.name}</h2>
              <p>{s.cardLine}</p>
              <span class="btn btn--green service-btn">Ver el servicio</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <ObraBand />

  <ServiceContact />
</Base>

<style>
  /* Hero compacto: mismo lenguaje que el hero del catalogo, mas bajo. */
  .svc-hero {
    position: relative;
    height: 220px;
    overflow: hidden;
    display: flex;
    align-items: center;
    background: var(--card-dark);
    border-bottom: 1px solid var(--line);
  }

  .svc-hero-photo {
    position: absolute;
    inset: 0;
    background: linear-gradient(150deg, #2a4432, var(--card-dark) 70%);
  }

  .svc-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(27, 42, 31, 0.72), rgba(27, 42, 31, 0.25));
  }

  .svc-hero-inner { position: relative; width: 100%; }

  .svc-crumb {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8ce6a8;
    margin: 0 0 0.55rem;
  }

  .svc-crumb a { color: #8ce6a8; }

  .svc-hero h1 {
    color: #eef5f0;
    font-weight: 600;
    font-size: clamp(2rem, 4vw, 2.9rem);
    margin: 0;
  }

  .svc-sub {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    margin: 0.55rem 0 0;
    max-width: 38rem;
  }

  /* Tarjetas de servicios */
  .services-grid-wrap { padding-top: 2.3rem; padding-bottom: 74px; }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 27.6px;
  }

  @media (max-width: 768px) {
    .services-grid { grid-template-columns: 1fr; }
  }

  .service-card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-cart);
    overflow: hidden;
    color: var(--ink);
  }

  .service-card:hover { text-decoration: none; color: var(--ink); border-color: var(--green); }
  .service-card:hover h2 { text-decoration: underline; }

  .service-photo {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--surface-2);
  }

  .service-copy {
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 9.2px;
    flex: 1;
  }

  .service-copy h2 { font-size: 22px; font-weight: 600; margin: 0; }

  .service-copy p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
    flex: 1;
  }

  .service-btn {
    justify-content: center;
    align-self: flex-start;
    font-size: 15px;
    padding: 12px 24px;
  }
</style>
