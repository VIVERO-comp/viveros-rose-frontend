---
// Rastreo de pedidos con el lenguaje visual de "Pedidos" (claude.ai/design).
// El diseno muestra un historial por cuenta; la tienda v1 no tiene cuentas,
// asi que se conserva el buscador publico: el numero de pedido es la
// credencial y se consulta al backend (GET /api/orders/{orderNumber}) desde
// el cliente cuando este desplegado.
import Base from '../../layouts/Base.astro';
import { whatsappLink } from '../../lib/site';

const steps = [
  { key: 'recibido', title: 'Pedido recibido', detail: 'Registramos tu pedido y coordinamos el pago por WhatsApp.' },
  { key: 'preparando', title: 'En preparación en el vivero', detail: 'Pago confirmado: seleccionamos y empacamos tus plantas.' },
  { key: 'en-camino', title: 'En ruta', detail: 'Va en camino a tu dirección.' },
  { key: 'entregado', title: 'Entregado', detail: 'Pedido entregado.' },
];
---

<Base
  noindex
  title="Rastrear pedido"
  description="Consulta el estado de tu pedido con tu número de orden, sin necesidad de crear cuenta. Sigue el avance desde el vivero hasta la entrega."
  chrome="minimal"
  minimalLinkHref="/"
  minimalLinkLabel="Volver al inicio"
>
  <section class="section">
    <div class="container tracking-container">
      <h1>Tus pedidos</h1>
      <p class="page-sub">Sigue el estado de cada entrega del vivero.</p>

      <form class="tracking-form">
        <div class="field">
          <label for="order-number">Número de pedido</label>
          <input
            type="text"
            id="order-number"
            name="order-number"
            placeholder="VR-549301"
            required
          />
          <p class="help">Está en el mensaje de WhatsApp con el que confirmaste tu compra.</p>
        </div>
        <!-- Verificacion para numeros correlativos escritos a mano: el
             enlace del correo trae su token y no la necesita. Se muestra
             solo cuando el backend responde verification_required. -->
        <div class="field" data-verify-field hidden>
          <label for="order-phone">WhatsApp del pedido</label>
          <input type="tel" id="order-phone" name="order-phone" placeholder="6567-3062" />
          <p class="help">
            Por seguridad, confirma el número de WhatsApp con el que hiciste el pedido.
          </p>
        </div>
        <button type="submit" class="btn btn--green">Consultar estado</button>
      </form>

      <div class="tracking-result" hidden>
        <div class="result-head">
          <p class="result-title">Pedido <span data-result-number></span></p>
        </div>
        <ol class="status-steps">
          {steps.map((s) => (
            <li data-step={s.key}>
              <span class="step-dot" aria-hidden="true"></span>
              <span class="step-copy">
                <span class="step-title">{s.title}</span>
                <span class="step-detail">{s.detail}</span>
              </span>
            </li>
          ))}
        </ol>
        <p class="tracking-delay" data-result-delay hidden>
          Tu entrega está tardando más de lo previsto. Ya lo tenemos en la mira;
          si quieres detalles, escríbenos por WhatsApp.
        </p>
        <p class="tracking-message" data-result-message></p>
        <div class="result-actions">
          <a class="btn btn--green" data-result-calificar hidden>
            Calificar la entrega
          </a>
          <a class="btn btn--whatsapp" data-result-whatsapp target="_blank" rel="noopener">
            Preguntar por mi pedido
          </a>
        </div>
      </div>

      <p class="lost-link">
        ¿Perdiste tu número de pedido? Escríbenos por
        <a href={whatsappLink('Hola, perdí mi número de pedido y quiero recuperarlo.')} target="_blank" rel="noopener">WhatsApp</a>
        con el correo que usaste al comprar.
      </p>
    </div>
  </section>
</Base>

<script>
  import { whatsappLink } from '../../lib/site';

  const form = document.querySelector<HTMLFormElement>('.tracking-form');
  const input = document.querySelector<HTMLInputElement>('#order-number');
  const verifyField = document.querySelector<HTMLElement>('[data-verify-field]');
  const phoneInput = document.querySelector<HTMLInputElement>('#order-phone');
  const result = document.querySelector<HTMLElement>('.tracking-result');
  const numberEl = document.querySelector<HTMLElement>('[data-result-number]');
  const messageEl = document.querySelector<HTMLElement>('[data-result-message]');
  const delayEl = document.querySelector<HTMLElement>('[data-result-delay]');
  const waLink = document.querySelector<HTMLAnchorElement>('[data-result-whatsapp]');
  // La puerta a calificar (y dejar propina): solo con el pedido entregado.
  // El WhatsApp del repartidor ya no lleva la URL, asi que esta es la via.
  const calificarLink = document.querySelector<HTMLAnchorElement>('[data-result-calificar]');

  // Estados del order-api -> paso del recorrido visual. Los pasos anteriores
  // al actual tambien se marcan: es un progreso, no un unico punto.
  const PASO_POR_ESTADO: Record<string, string> = {
    Recibido: 'recibido',
    Preparando: 'preparando',
    'En camino': 'en-camino',
    Entregado: 'entregado',
  };
  const ORDEN_PASOS = ['recibido', 'preparando', 'en-camino', 'entregado'];

  function pintarProgreso(estado: string) {
    document.querySelectorAll('.status-steps li').forEach((li) => li.classList.remove('active'));
    const paso = PASO_POR_ESTADO[estado];
    if (!paso) return;
    for (const clave of ORDEN_PASOS) {
      document.querySelector(`[data-step="${clave}"]`)?.classList.add('active');
      if (clave === paso) break;
    }
  }

  // Odoo entrega fechas UTC sin zona ("2026-08-24 18:30:00"): se convierten
  // a hora de Panama para mostrarlas.
  function formatearFecha(fecha: string): string {
    const utc = new Date(fecha.replace(' ', 'T') + 'Z');
    if (Number.isNaN(utc.getTime())) return fecha;
    return utc.toLocaleString('es-PA', {
      timeZone: 'America/Panama',
      day: 'numeric',
      month: 'long',
      hour: 'numeric',
      minute: '2-digit',
    });
  }

  async function lookup(orderNumber: string) {
    if (numberEl) numberEl.textContent = orderNumber;
    if (waLink) {
      waLink.href = whatsappLink(`Hola, quiero información de mi pedido ${orderNumber}.`);
    }

    // El numero correlativo (VR-549301) es enumerable, asi que solo no
    // alcanza: el enlace del correo o de la pagina de exito trae un token
    // (?t=), y quien escribe el numero a mano confirma su WhatsApp. Los
    // numeros viejos (VR-fecha-codigo) entran solos, como siempre.
    const credenciales = new URLSearchParams();
    if (token) credenciales.set('t', token);
    const telefono = phoneInput?.value.trim();
    if (telefono) credenciales.set('tel', telefono);
    const sufijo = credenciales.size > 0 ? `?${credenciales.toString()}` : '';

    try {
      const res = await fetch(`/api/orders/${encodeURIComponent(orderNumber)}${sufijo}`);
      if (res.ok) {
        const data = await res.json();
        pintarProgreso(data.estado);
        // El aviso ambar de retraso lo enciende la revision periodica del
        // order-api (y Abraham lo apaga a mano cuando lo resuelve).
        if (delayEl) delayEl.hidden = !(data.retraso && data.estado !== 'Entregado');
        if (messageEl) {
          messageEl.textContent =
            data.estado === 'Cancelado'
              ? 'Este pedido fue cancelado. Si crees que es un error, escríbenos:'
              : data.estado === 'Entregado' && data.entregado_en
                ? `Entregado el ${formatearFecha(data.entregado_en)}.`
                : `Estado actual: ${data.estado}`;
        }
        if (calificarLink) {
          calificarLink.hidden = data.estado !== 'Entregado';
          calificarLink.href = `/calificar?n=${encodeURIComponent(orderNumber)}`;
        }
        result?.removeAttribute('hidden');
        return;
      }
      if (res.status === 403) {
        // El backend pide verificar: se muestra el campo de WhatsApp y no
        // se pinta ningun resultado (no sabemos si el pedido existe).
        if (verifyField) verifyField.hidden = false;
        if (telefono === undefined || telefono === '') {
          phoneInput?.focus();
        }
        result?.setAttribute('hidden', '');
        return;
      }
      if (res.status === 404) {
        pintarProgreso('');
        if (delayEl) delayEl.hidden = true;
        if (calificarLink) calificarLink.hidden = true;
        if (messageEl) {
          messageEl.textContent = verifyField && !verifyField.hidden
            ? 'No encontramos un pedido con ese número y ese WhatsApp. Revisa ambos o escríbenos:'
            : 'No encontramos un pedido con ese número. Revisa que esté completo o escríbenos:';
        }
        result?.removeAttribute('hidden');
        return;
      }
    } catch {
      // sin conexion con el backend: cae al mensaje de WhatsApp
    }

    pintarProgreso('');
    if (delayEl) delayEl.hidden = true;
    if (calificarLink) calificarLink.hidden = true;
    if (messageEl) {
      messageEl.textContent =
        'No pudimos consultar el estado en este momento. Consulta por WhatsApp con un solo clic:';
    }
    result?.removeAttribute('hidden');
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const value = input?.value.trim();
    if (value) lookup(value);
  });

  // Soporta llegar con ?n=VR-... desde el correo o la pagina de exito; el
  // enlace de un pedido correlativo trae ademas su token en ?t=.
  const llegada = new URLSearchParams(window.location.search);
  const token = llegada.get('t')?.trim() ?? '';
  const prefill = llegada.get('n');
  if (prefill && input) {
    input.value = prefill;
    lookup(prefill);
  }
</script>

<style>
  /* El colchon de abajo deja que el final de la tarjeta quede por encima
     del boton flotante de WhatsApp (56px + su margen) al llegar al fondo. */
  .tracking-container { max-width: 44rem; padding-bottom: 6rem; }

  /* Los botones del resultado nunca se tocan entre si, apilados o en fila. */
  .result-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.15rem;
  }

  h1 { font-weight: 400; margin-bottom: 0.2rem; }

  .page-sub {
    color: var(--ink-soft);
    margin: 0 0 2.3rem;
  }

  .tracking-form {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 1.7rem;
    margin-bottom: 1.4rem;
  }

  .tracking-result {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 1.7rem;
    margin-bottom: 1.4rem;
  }

  .result-title { font-size: 1.25rem; font-weight: 600; margin: 0 0 1.15rem; }

  .status-steps {
    list-style: none;
    padding: 1.15rem;
    margin: 0 0 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    background: var(--green-tint);
    border: 1px solid rgba(21, 102, 47, 0.25);
    border-radius: 14px;
  }

  .status-steps li {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 0.85rem;
    align-items: start;
  }

  .step-dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #ffffff;
    border: 2px solid rgba(27, 42, 31, 0.25);
    margin-top: 2px;
  }

  .status-steps li.active .step-dot {
    background: var(--green-deep);
    border-color: var(--green-deep);
  }

  .step-title {
    display: block;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .status-steps li.active .step-title { color: var(--ink); }

  .step-detail {
    display: block;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }

  .tracking-delay {
    background: var(--amber-bg);
    color: var(--amber-text);
    border-radius: 14px;
    padding: 0.85rem 1.1rem;
    font-size: 0.92rem;
    margin: 0 0 1.15rem;
  }

  .tracking-message { color: var(--ink-soft); }

  .lost-link {
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
</style>
