  /* -- confirmacion de exito (gancho que se dibuja) ----------------------- */

  .exito {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: rgba(238, 245, 240, 0.96);
