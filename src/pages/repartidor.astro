  .app .pantalla-entrando {
    opacity: 0;
    transform: translateY(8px);
  }

  .app [data-vista-detalle] {
    transition: opacity 220ms var(--ease-drawer), transform 220ms var(--ease-drawer);
  }

  .app .detalle-entrando {
    opacity: 0;
    transform: translateX(28px);
