    /* pathLength="1": el dasharray normalizado dibuja el trazo al animar
       el offset de 1 a 0, sin medir la geometria real. */
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .exito--activa .exito-circulo {
    animation: exito-trazo 420ms var(--ease-out) forwards;
  }

  .exito--activa .exito-gancho {
