---
// Portal del repartidor. Se siente app, no pagina: tres pantallas (Inicio,
// Pedidos, Notificaciones) con navegacion fija abajo, movil primero y para
// usarse con una mano en la calle. Instalable (manifest + service worker).
//
// La credencial sigue siendo el enlace personal ...?clave=... que genera
// Odoo: se guarda en el navegador y todas las llamadas salen por las
// funciones de servidor de este sitio (la clave nunca queda en HTML servido
// a otros; la pagina es estatica y los datos llegan por fetch).
//
// Pantallas:
//   INICIO  saludo, tarjeta de ganancias de hoy (pagos sellados en Odoo +
//           propinas registradas al calificar), pendientes y recientes.
//   PEDIDOS la lista de siempre: mis entregas, disponibles, los de otros;
//           detalle -> agarrar -> WhatsApp -> foto de entrega.
//   AVISOS  historial de avisos agrupado por dia, con el activador de
//           Web Push arriba.
import Base from '../layouts/Base.astro';
import { products } from '../data/products';

// La foto del catalogo por SKU, para pintar las lineas del pedido sin que
// viajen binarios de Odoo (el emoji es el respaldo de siempre).
const FOTOS_CATALOGO = Object.fromEntries(
  products.map((p) => [p.sku, { image: p.image ?? null, emoji: p.emoji }]),
);
---

<Base
  noindex
  title="Repartos"
  description="Portal del repartidor de Vivero Rose."
  chrome="bare"
  manifest="/manifest-repartidor.webmanifest"
>
  <div class="app">
    <!-- Estados globales: valen para cualquier pantalla. -->
    <div class="globales">
      <!-- Sin clave: solo se entra con el enlace personal. La app instalada
           en iPhone no comparte lo guardado por Safari y abre /repartidor
           pelado, asi que el enlace tambien se puede pegar a mano una vez. -->
      <div class="tarjeta aviso-sin-clave" data-sin-clave hidden>
        <p><strong>Falta tu enlace personal.</strong></p>
        <p>
          Abre el enlace de repartidor que te mandaron por WhatsApp (termina en
          <code>?clave=…</code>), o pégalo aquí:
        </p>
        <form class="form-clave" data-form-clave>
          <input
            type="text"
            data-input-clave
            placeholder="Pega aquí tu enlace o tu clave"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
          />
          <button type="submit" class="btn btn--green">Entrar</button>
        </form>
        <p class="field-error" data-error-clave hidden>Pega el enlace completo o la clave.</p>
        <p class="suave">Si no tienes el enlace, pide que te lo reenvíen desde el vivero.</p>
      </div>

      <!-- El resumen o la lista respondieron 401: clave vieja (se genero un
           enlace mas nuevo) o la clave del dueno, que solo sirve para avisos. -->
      <div class="tarjeta" data-modo-dueno hidden>
        <p><strong>Esta clave no abre el portal de pedidos.</strong></p>
        <p>
          Si eres repartidor, se generó un enlace más nuevo y este quedó viejo:
          pide el enlace vigente (en Odoo se copia del campo de la ficha, sin
          volver a generar) y
          <button type="button" class="enlace-boton" data-usar-otro>úsalo aquí</button>.
        </p>
        <p>
          Si este es el enlace del dueño, es normal: solo sirve para recibir los
          avisos de pedidos nuevos y retrasos en este teléfono — actívalos abajo.
        </p>
        <div class="banda-push" data-banda-push-dueno hidden>
          <p>Activa los avisos para que te suene el teléfono cuando pase algo.</p>
          <button class="btn btn--green" data-activar-push-dueno type="button">Activar avisos</button>
        </div>
        <p class="push-estado" data-push-estado-dueno hidden></p>
      </div>

      <p class="instalar-pista" data-instalar hidden>
        Instala esta página como app: en el menú del navegador elige
        <strong>“Agregar a pantalla de inicio”</strong>.
        <button class="cerrar-pista" data-cerrar-instalar type="button" aria-label="Cerrar">✕</button>
      </p>

      <p class="portal-mensaje" data-mensaje hidden></p>
    </div>

    <!-- Pantalla 1: INICIO -->
    <section class="pantalla" data-pantalla="inicio">
      <header class="inicio-head">
        <p class="kicker">VIVERO ROSE · REPARTOS</p>
        <h1 class="saludo">Hola<span data-nombre></span></h1>
        <p class="estrellas" data-estrellas hidden></p>
      </header>

      <!-- Tocar la tarjeta abre el corte de la semana. -->
      <button class="tarjeta-ganancias" type="button" data-abrir-semana aria-expanded="false">
        <p class="ganancias-etiqueta">Ganado hoy</p>
        <p class="ganancias-monto" data-ganado-hoy>—</p>
        <p class="ganancias-detalle">
          <span data-entregas-hoy>—</span>
          <span class="ganancias-propinas" data-propinas-hoy hidden></span>
        </p>
        <p class="ganancias-toca"><span data-semana-pista>Toca para ver la semana</span> <span class="chevron" data-chevron>▾</span></p>
      </button>
      <div class="desglose" data-desglose hidden></div>

      <h2 class="bloque-titulo">Por entregar hoy</h2>
      <div class="pendientes">
        <button class="pendiente-card" type="button" data-ir-pedidos>
          <span class="pendiente-numero" data-mios>—</span>
          <span class="pendiente-nombre">Mis entregas</span>
        </button>
        <button class="pendiente-card pendiente-card--choco" type="button" data-ir-pedidos>
          <span class="pendiente-numero" data-disponibles>—</span>
          <span class="pendiente-nombre">Disponibles</span>
        </button>
      </div>

      <h2 class="bloque-titulo">Entregas recientes</h2>
      <div data-recientes><p class="cargando">Cargando…</p></div>
    </section>

    <!-- Pantalla 2: PEDIDOS -->
    <section class="pantalla" data-pantalla="pedidos" hidden>
      <header class="pantalla-head">
        <h1>Pedidos</h1>
        <button class="btn btn--ghost btn-refrescar" data-refrescar type="button">Actualizar</button>
      </header>

      <div data-vista-lista>
        <div data-lista></div>
      </div>

      <div data-vista-detalle hidden>
        <button class="volver" data-volver type="button">← Todos los pedidos</button>
        <div data-detalle></div>
      </div>
    </section>

    <!-- Pantalla 3: NOTIFICACIONES -->
    <section class="pantalla" data-pantalla="avisos" hidden>
      <header class="pantalla-head">
        <h1>Notificaciones</h1>
      </header>

      <div class="banda-push" data-banda-push hidden>
        <p>Activa los avisos para que te suene el teléfono cuando haya un pedido listo.</p>
        <button class="btn btn--green" data-activar-push type="button">Activar avisos</button>
      </div>
      <p class="push-estado" data-push-estado hidden></p>

      <div data-avisos><p class="cargando">Cargando…</p></div>
    </section>
  </div>

  <!-- Confirmacion de exito al confirmar un pedido: el circulo se dibuja
       con el gancho en el centro (~600 ms) y despues se ve el detalle.
       CSS/SVG puro; con prefers-reduced-motion no se muestra. -->
  <div class="exito" data-exito hidden>
    <svg viewBox="0 0 72 72" aria-hidden="true">
      <circle class="exito-circulo" cx="36" cy="36" r="30" pathLength="1"/>
      <path class="exito-gancho" d="M23 37.5 L32.5 47 L50 27" pathLength="1"/>
    </svg>
    <p class="exito-texto">Pedido confirmado</p>
  </div>

  <!-- Navegacion fija abajo, alcanzable con el pulgar. -->
  <nav class="tabs" data-tabs aria-label="Pantallas">
    <button class="tab tab--activa" type="button" data-tab="inicio" aria-label="Inicio">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
      <span>Inicio</span>
    </button>
    <button class="tab" type="button" data-tab="pedidos" aria-label="Pedidos">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8.5 12 3 3 8.5v7L12 21l9-5.5v-7Z"/><path d="M3 8.5 12 14l9-5.5"/><path d="M12 14v7"/></svg>
      <span>Pedidos</span>
    </button>
    <button class="tab" type="button" data-tab="avisos" aria-label="Notificaciones">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 9a6 6 0 1 0-12 0c0 6-2 7-2 7h16s-2-1-2-7"/><path d="M10.3 20a2 2 0 0 0 3.4 0"/></svg>
      <span>Avisos</span>
      <span class="tab-globito" data-globito-avisos hidden></span>
    </button>
  </nav>
</Base>

<script is:inline define:vars={{ FOTOS_CATALOGO }}>
  window.FOTOS_CATALOGO = FOTOS_CATALOGO;
</script>

<script>
  import { decidirTrasNoDisponible } from '../lib/repartidor';

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const listaEl = $('[data-lista]');
  const detalleEl = $('[data-detalle]');
  const vistaLista = $('[data-vista-lista]');
  const vistaDetalle = $('[data-vista-detalle]');
  const mensajeEl = $('[data-mensaje]');
  const recientesEl = $('[data-recientes]');
  const avisosEl = $('[data-avisos]');

  const FOTOS: Record<string, { image: string | null; emoji: string }> =
    (window as any).FOTOS_CATALOGO ?? {};

  const ETIQUETA_ESTADO: Record<string, string> = {
    listo: 'Listo para salir',
    saliendo: 'Saliendo',
    en_camino: 'En camino',
    entregado: 'Entregado',
  };

  // -- credencial -----------------------------------------------------------

  const parametros = new URLSearchParams(location.search);
  const claveUrl = parametros.get('clave');
  if (claveUrl) {
    localStorage.setItem('vr_clave_repartidor', claveUrl);
    // La clave no se queda en la barra ni en el historial compartible.
    history.replaceState(null, '', '/repartidor');
  }
  const clave = claveUrl || localStorage.getItem('vr_clave_repartidor') || '';

  // Nombre del repartidor (lo devuelve el resumen o la lista): saludo del
  // inicio y "Agarraste el pedido" en los avisos.
  let nombreRepartidor = '';

  // Mapa numero -> es_mio de la ultima lista, para pintar el detalle.
  const esMio = new Map<string, boolean>();

  function mensaje(texto: string) {
    mensajeEl.textContent = texto;
    mensajeEl.hidden = !texto;
  }

  function escapar(texto: string): string {
    const div = document.createElement('div');
    div.textContent = texto;
    return div.innerHTML;
  }

  const dinero = (centavos: number) => `$${(centavos / 100).toFixed(2)}`;

  // Odoo devuelve fechas UTC sin zona ("2026-08-24 14:00:00").
  function fechaOdoo(valor: string): Date {
    return new Date(valor.replace(' ', 'T') + 'Z');
  }

  const hora = (fecha: Date) =>
    fecha.toLocaleTimeString('es-PA', { hour: 'numeric', minute: '2-digit' });

  // Odoo 19 guarda la nota como HTML (<p>, <br>): se convierte a texto plano
  // conservando los saltos de linea, sin ejecutar nada del HTML.
  function notaComoTexto(nota: string): string {
    const html = nota.replace(/<br\s*\/?>/gi, '\n').replace(/<\/p>\s*<p[^>]*>/gi, '\n');
    const doc = new DOMParser().parseFromString(html, 'text/html');
    return (doc.body.textContent ?? '').trim();
  }

  // La direccion viaja en la nota que armo el checkout, en la linea
  // "Entrega: ...". De ahi sale el boton "Como llegar"; si no esta, el boton
  // simplemente no se pinta.
  function extraerDireccion(nota: string): string | null {
    const linea = nota
      .split('\n')
      .find((l) => l.trim().toLowerCase().startsWith('entrega:'));
    if (!linea) return null;
    return linea.slice(linea.indexOf(':') + 1).trim() || null;
  }

  function usarNombre(nombre: string) {
    nombreRepartidor = nombre;
    const pila = nombre.trim().split(/\s+/)[0];
    $('[data-nombre]').textContent = pila ? `, ${pila}` : '';
  }

  // La misma respuesta 401 para el resumen, la lista y los avisos: clave del
  // dueno (solo sirve para push) o clave vieja.
  function manejar401() {
    $('[data-modo-dueno]').hidden = false;
    $('[data-banda-push-dueno]').hidden = Boolean(localStorage.getItem('vr_push_activado'));
    document.querySelectorAll<HTMLElement>('.pantalla, .tabs').forEach((el) => {
      el.hidden = true;
      el.style.display = el.classList.contains('tabs') ? 'none' : '';
    });
  }

  // -- pantallas y navegacion -----------------------------------------------

  type Pantalla = 'inicio' | 'pedidos' | 'avisos';
  let pantallaActual: Pantalla = 'inicio';

  // Entrada breve (opacity/transform): la clase de arranque se aplica, el
  // reflow forzado la hace contar y al quitarla la transicion corre. Es
  // sincrono a proposito: con requestAnimationFrame, un navegador que
  // congele frames (pestana tapada, jank) dejaria la pantalla invisible.
  function animarEntrada(el: HTMLElement, clase: string) {
    el.classList.add(clase);
    void el.offsetWidth;
    el.classList.remove(clase);
  }

  const CARGADORES: Record<Pantalla, () => void> = {
    inicio: cargarInicio,
    pedidos: cargarLista,
    avisos: cargarAvisos,
  };

  function cambiarPantalla(destino: Pantalla) {
    mensaje('');
    document.querySelectorAll<HTMLElement>('[data-tab]').forEach((tab) => {
      tab.classList.toggle('tab--activa', tab.getAttribute('data-tab') === destino);
    });
    document.querySelectorAll<HTMLElement>('[data-pantalla]').forEach((pantalla) => {
      const activa = pantalla.getAttribute('data-pantalla') === destino;
      if (activa && pantalla.hidden) {
        pantalla.hidden = false;
        animarEntrada(pantalla, 'pantalla-entrando');
      } else if (!activa) {
        pantalla.hidden = true;
      }
    });
    // Cada pantalla se refresca al entrar (tambien al re-tocar su tab): en la
    // calle los datos cambian rapido y no hay boton mas simple que ese.
    pantallaActual = destino;
    window.scrollTo(0, 0);
    // Entrar a Avisos marca todo como visto y apaga el globito de la
    // pestana; en las demas se revisa si llego algo nuevo.
    if (destino === 'avisos') {
      localStorage.setItem('vr_avisos_visto', new Date().toISOString());
      pintarGlobitoAvisos(0);
    } else if (clave) {
      revisarAvisosNuevos();
    }
    if (clave) CARGADORES[destino]();
  }

  document.querySelectorAll<HTMLElement>('[data-tab]').forEach((tab) => {
    tab.addEventListener('click', () => cambiarPantalla(tab.getAttribute('data-tab') as Pantalla));
  });
  document.querySelectorAll<HTMLElement>('[data-ir-pedidos]').forEach((boton) => {
    boton.addEventListener('click', () => cambiarPantalla('pedidos'));
  });

  // Tocar la tarjeta de ganancias abre (o cierra) el corte de la semana.
  const botonSemana = $('[data-abrir-semana]');
  botonSemana.addEventListener('click', () => {
    const desgloseEl = $('[data-desglose]');
    const abrir = desgloseEl.hidden;
    if (abrir) {
      desgloseEl.hidden = false;
      animarEntrada(desgloseEl, 'pantalla-entrando');
    } else {
      desgloseEl.hidden = true;
    }
    botonSemana.setAttribute('aria-expanded', String(abrir));
    $('[data-chevron]').classList.toggle('chevron--abierto', abrir);
    $('[data-semana-pista]').textContent = abrir
      ? 'Ocultar la semana'
      : 'Toca para ver la semana';
  });

  // -- globito de la pestana Avisos ----------------------------------------

  // Cuenta los avisos posteriores a la ultima vez que se abrio la pestana.
  // No es critico: si la red falla, simplemente no se pinta.
  function pintarGlobitoAvisos(nuevos: number) {
    const globito = $('[data-globito-avisos]');
    globito.hidden = nuevos <= 0;
    globito.textContent = nuevos > 9 ? '9+' : String(nuevos);
  }

  async function revisarAvisosNuevos() {
    try {
      const res = await fetch(`/api/repartidor/avisos?clave=${encodeURIComponent(clave)}`);
      if (!res.ok) return;
      const avisos = (await res.json()).avisos ?? [];
      const visto = localStorage.getItem('vr_avisos_visto');
      const corte = visto ? new Date(visto).getTime() : 0;
      pintarGlobitoAvisos(
        avisos.filter((a: any) => new Date(a.creado_en).getTime() > corte).length,
      );
    } catch {
      // sin red no hay globito, nada mas
    }
  }

  // -- pantalla INICIO ------------------------------------------------------

  // La clave puede ser la del panel de admin (enlace /admin pegado aqui, o
  // un admin que abrio /repartidor): se prueba contra el panel con la clave
  // SOLO en el header, y si entra se le manda a su pagina.
  async function esClaveDeAdmin(): Promise<boolean> {
    try {
      const res = await fetch('/api/admin/resumen?periodo=hoy', {
        headers: { 'X-Clave-Admin': clave },
      });
      return res.ok;
    } catch {
      return false;
    }
  }

  async function cargarInicio() {
    try {
      const res = await fetch(`/api/repartidor/resumen?clave=${encodeURIComponent(clave)}`);
      if (res.status === 401) {
        if (await esClaveDeAdmin()) {
          localStorage.setItem('vr_clave_admin', clave);
          location.replace('/admin');
          return;
        }
        manejar401();
        return;
      }
      if (!res.ok) throw new Error();
      pintarInicio(await res.json());
    } catch {
      recientesEl.innerHTML = '';
      mensaje('No pudimos cargar tu resumen. Revisa tu señal e intenta de nuevo.');
    }
  }

  // Fecha local "YYYY-MM-DD" -> Hoy / Ayer / "vie 22 ago".
  function etiquetaFecha(fechaIso: string): string {
    const [a, m, d] = fechaIso.split('-').map(Number);
    const fecha = new Date(a, m - 1, d);
    const hoy = new Date();
    hoy.setHours(0, 0, 0, 0);
    const dias = Math.round((hoy.getTime() - fecha.getTime()) / 86400000);
    if (dias === 0) return 'Hoy';
    if (dias === 1) return 'Ayer';
    return fecha.toLocaleDateString('es-PA', { weekday: 'short', day: 'numeric', month: 'short' });
  }

  // El corte de la semana: cuanto hay que pagarle al repartidor (los pagos
  // sellados; las propinas van aparte porque ya las recibio directo).
  function pintarDesglose(semana: any) {
    const desgloseEl = $('[data-desglose]');
    if (!semana || !semana.entregas) {
      desgloseEl.innerHTML =
        '<div class="tarjeta vacio"><p>Sin entregas esta semana todavía.</p></div>';
      return;
    }
    const filas = (semana.dias ?? [])
      .map(
        (dia: any) => `
        <p class="corte-dia">
          <span>${escapar(etiquetaFecha(dia.fecha))}</span>
          <span class="suave">${dia.entregas === 1 ? '1 entrega' : `${dia.entregas} entregas`}</span>
          <span class="corte-monto">${dinero(dia.pago_centavos)}${
            dia.propinas_centavos > 0 ? ` <em>+${dinero(dia.propinas_centavos)}</em>` : ''
          }</span>
        </p>`,
      )
      .join('');
    desgloseEl.innerHTML = `
      <div class="tarjeta corte">
        <p class="corte-total"><span>Esta semana</span><strong>${dinero(semana.pago_centavos)}</strong></p>
        <p class="suave">${semana.entregas === 1 ? '1 entrega' : `${semana.entregas} entregas`}${
          semana.propinas_centavos > 0 ? ` · ${dinero(semana.propinas_centavos)} en propinas` : ''
        } · desde el ${escapar(etiquetaFecha(semana.desde))}</p>
        ${filas ? `<div class="corte-dias">${filas}</div>` : ''}
      </div>`;
  }

  function pintarInicio(datos: any) {
    usarNombre(datos.repartidor ?? '');

    const pago = datos.hoy?.pago_centavos ?? 0;
    const propinas = datos.hoy?.propinas_centavos ?? 0;
    const entregas = datos.hoy?.entregas ?? 0;
    $('[data-ganado-hoy]').textContent = dinero(pago + propinas);
    $('[data-entregas-hoy]').textContent =
      entregas === 1 ? '1 entrega hoy' : `${entregas} entregas hoy`;
    const propinasEl = $('[data-propinas-hoy]');
    propinasEl.hidden = propinas <= 0;
    propinasEl.textContent = propinas > 0 ? `· ${dinero(propinas)} en propinas` : '';

    const calificacion = datos.calificacion;
    const estrellasEl = $('[data-estrellas]');
    estrellasEl.hidden = !calificacion;
    if (calificacion) {
      estrellasEl.textContent = `★ ${calificacion.promedio.toFixed(1)} · ${
        calificacion.cantidad === 1
          ? '1 calificación'
          : `${calificacion.cantidad} calificaciones`
      }`;
    }

    pintarDesglose(datos.semana);

    $('[data-mios]').textContent = String(datos.pendientes?.mios ?? 0);
    $('[data-disponibles]').textContent = String(datos.pendientes?.disponibles ?? 0);

    const recientes = datos.recientes ?? [];
    if (!recientes.length) {
      recientesEl.innerHTML =
        '<div class="tarjeta vacio"><p>Aún no tienes entregas.</p>' +
        '<p class="suave">Cuando entregues tu primer pedido aparecerá aquí.</p></div>';
      return;
    }
    recientesEl.innerHTML = recientes
      .map((entrega: any) => {
        const cuando = entrega.entregado_en
          ? fechaOdoo(entrega.entregado_en).toLocaleDateString('es-PA', {
              day: 'numeric',
              month: 'short',
            }) + ` · ${hora(fechaOdoo(entrega.entregado_en))}`
          : '';
        return `
        <div class="tarjeta reciente">
          <span class="reciente-datos">
            <span class="reciente-cliente">${escapar(entrega.cliente ?? 'Cliente')}</span>
            <span class="suave">${escapar(entrega.numero)}${cuando ? ' · ' + cuando : ''}</span>
          </span>
          <span class="reciente-montos">
            <span class="reciente-pago">${dinero(entrega.pago_centavos ?? 0)}</span>
            ${
              entrega.propina_centavos > 0
                ? `<span class="chip chip--propina">+${dinero(entrega.propina_centavos)} propina</span>`
                : ''
            }
          </span>
        </div>`;
      })
      .join('');
  }

  // -- pantalla PEDIDOS: lista ----------------------------------------------

  async function cargarLista() {
    vistaDetalle.hidden = true;
    vistaLista.hidden = false;
    listaEl.innerHTML = '<p class="cargando">Cargando pedidos…</p>';
    try {
      const res = await fetch(`/api/repartidor/pedidos?clave=${encodeURIComponent(clave)}`);
      if (res.status === 401) {
        listaEl.innerHTML = '';
        manejar401();
        return;
      }
      if (!res.ok) throw new Error();
      const datos = await res.json();
      usarNombre(datos.repartidor ?? '');
      esMio.clear();
      for (const p of datos.pedidos) esMio.set(p.numero, p.es_mio);
      pintarLista(datos.pedidos);
    } catch {
      listaEl.innerHTML = '';
      mensaje('No pudimos cargar los pedidos. Revisa tu señal y toca “Actualizar”.');
    }
  }

  function pintarLista(pedidos: any[]) {
    if (!pedidos.length) {
      listaEl.innerHTML =
        '<div class="tarjeta vacio"><p>No hay pedidos para salir ahora mismo.</p>' +
        '<p class="suave">Cuando un pedido quede listo te llegará un aviso (si los activaste).</p></div>';
      return;
    }
    const mios = pedidos.filter((p) => p.es_mio);
    const libres = pedidos.filter((p) => !p.repartidor);
    const deOtros = pedidos.filter((p) => p.repartidor && !p.es_mio);
    listaEl.innerHTML = [
      bloque('Mis entregas', mios),
      bloque('Disponibles', libres),
      bloque('Los llevan otros', deOtros),
    ].join('');
    listaEl.querySelectorAll('[data-numero]').forEach((el) =>
      el.addEventListener('click', () => abrirDetalle(el.getAttribute('data-numero')!)),
    );
  }

  function bloque(titulo: string, pedidos: any[]): string {
    if (!pedidos.length) return '';
    return (
      `<h2 class="bloque-titulo">${titulo}</h2>` +
      pedidos
        .map(
          (p) => `
        <button class="tarjeta pedido-card" data-numero="${escapar(p.numero)}" type="button">
          <span class="pedido-linea1">
            <span class="pedido-numero">${escapar(p.numero)}</span>
            <span class="chip chip--${p.estado_entrega}">${ETIQUETA_ESTADO[p.estado_entrega] ?? p.estado_entrega}</span>
          </span>
          <span class="pedido-linea2">
            <span>${escapar(p.cliente ?? 'Cliente')}${p.ciudad ? ' · ' + escapar(p.ciudad) : ''}</span>
            <span class="pedido-total">$${Number(p.total).toFixed(2)}</span>
          </span>
          ${p.con_retraso ? '<span class="chip chip--retraso">Con retraso</span>' : ''}
          ${p.repartidor && !p.es_mio ? `<span class="suave">Lo lleva ${escapar(p.repartidor)}</span>` : ''}
        </button>`,
        )
        .join('')
    );
  }

  // -- pantalla PEDIDOS: detalle --------------------------------------------

  async function abrirDetalle(numero: string) {
    vistaLista.hidden = true;
    vistaDetalle.hidden = false;
    // El detalle entra desde la derecha, como una sub-pantalla.
    animarEntrada(vistaDetalle, 'detalle-entrando');
    window.scrollTo(0, 0);
    detalleEl.innerHTML = '<p class="cargando">Cargando pedido…</p>';
    try {
      const res = await fetch(
        `/api/repartidor/pedidos/${encodeURIComponent(numero)}?clave=${encodeURIComponent(clave)}`,
      );
      if (!res.ok) throw new Error();
      pintarDetalle(await res.json());
    } catch {
      detalleEl.innerHTML =
        '<div class="tarjeta"><p>No pudimos cargar este pedido. Vuelve a la lista e intenta de nuevo.</p></div>';
    }
  }

  function fotoItem(sku: string | null): string {
    const ficha = sku ? FOTOS[sku] : null;
    if (ficha?.image) {
      return `<img class="item-foto" src="${ficha.image}" alt="" loading="lazy" />`;
    }
    return `<span class="item-foto item-emoji">${ficha?.emoji ?? '🪴'}</span>`;
  }

  // Mensaje de contacto con el detalle de lo pedido, para que el cliente
  // sepa de que pedido le hablan sin buscar el numero.
  function textoContacto(p: any): string {
    const resumen = (p.items ?? [])
      .map((item: any) => `${item.cantidad}× ${item.descripcion}`)
      .join(', ');
    return (
      `Hola${p.cliente?.nombre ? ' ' + p.cliente.nombre : ''}! Soy ${nombreRepartidor || 'tu repartidor'}, ` +
      `de Vivero Rose, sobre tu pedido ${p.numero}${resumen ? ` (${resumen})` : ''}:`
    );
  }

  function enlaceWhatsApp(telefono: string | null, texto: string): string | null {
    if (!telefono) return null;
    let digitos = telefono.replace(/\D/g, '');
    if (digitos.length === 8) digitos = '507' + digitos;
    if (digitos.length < 10) return null;
    return `https://wa.me/${digitos}?text=${encodeURIComponent(texto)}`;
  }

  function pintarDetalle(p: any, whatsappServidor?: string | null) {
    // Con whatsappServidor definido venimos de "agarrar": el pedido es mio.
    const mio = whatsappServidor !== undefined ? true : esMio.get(p.numero) ?? false;
    const entregado = p.estado_entrega === 'entregado';
    const deOtro = p.repartidor && !mio && !entregado;

    const items = (p.items ?? [])
      .map(
        (item: any) => `
        <li class="item">
          ${fotoItem(item.sku)}
          <span class="item-nombre">${escapar(item.descripcion)}</span>
          <span class="item-cant">× ${item.cantidad}</span>
        </li>`,
      )
      .join('');

    const telefono = p.cliente?.telefono ?? null;
    const waCamino =
      whatsappServidor ??
      enlaceWhatsApp(
        telefono,
        `Hola${p.cliente?.nombre ? ' ' + p.cliente.nombre : ''}! Soy ${nombreRepartidor || 'tu repartidor'}, de Vivero Rose. ` +
          `Tu pedido ${p.numero} va en camino. Puedes seguirlo aqui: ${location.origin}/pedido?n=${p.numero}`,
      );
    const notaTexto = p.nota ? notaComoTexto(p.nota) : '';
    const direccion = extraerDireccion(notaTexto);
    // Navegacion de un toque: con el punto exacto que marco el cliente si
    // existe, y con el texto de la direccion si no. Waze o Google Maps son
    // enlaces universales: abren la app instalada, gratis y sin llave.
    const destinoNav = p.ubicacion
      ? `${p.ubicacion.lat},${p.ubicacion.lng}`
      : direccion
        ? `${direccion}, Panamá`
        : null;
    const navUrls = destinoNav
      ? {
          waze: p.ubicacion
            ? `https://waze.com/ul?ll=${encodeURIComponent(destinoNav)}&navigate=yes`
            : `https://waze.com/ul?q=${encodeURIComponent(destinoNav)}&navigate=yes`,
          gmaps: `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(destinoNav)}`,
        }
      : null;
    const waContacto = telefono ? enlaceWhatsApp(telefono, textoContacto(p)) : null;
    // Problemas en la calle (no contesta, direccion mala, se rompio algo):
    // directo al WhatsApp del vivero con el numero del pedido ya escrito.
    const waProblema = `https://wa.me/50765673062?text=${encodeURIComponent(
      `Hola, soy ${nombreRepartidor || 'el repartidor'}. Problema con el pedido ${p.numero}: `,
    )}`;
    const botonesContacto = [
      telefono ? `<a class="btn btn--ghost" href="tel:${escapar(telefono)}">Llamar</a>` : '',
      waContacto
        ? `<a class="btn btn--ghost" href="${waContacto}" target="_blank" rel="noopener">WhatsApp</a>`
        : '',
    ]
      .filter(Boolean)
      .join('');

    detalleEl.innerHTML = `
      <div class="tarjeta">
        <p class="pedido-linea1">
          <span class="pedido-numero">${escapar(p.numero)}</span>
          <span class="chip chip--${p.estado_entrega}">${ETIQUETA_ESTADO[p.estado_entrega] ?? p.estado_entrega}</span>
        </p>
        <p class="detalle-cliente">${escapar(p.cliente?.nombre ?? 'Cliente')}${p.cliente?.ciudad ? ' · ' + escapar(p.cliente.ciudad) : ''}</p>
        ${botonesContacto ? `<p class="detalle-contacto">${botonesContacto}</p>` : ''}
        ${telefono ? '' : '<p class="suave">El pedido no tiene teléfono; la dirección va en la nota.</p>'}
        ${notaTexto ? `<pre class="detalle-nota">${escapar(notaTexto)}</pre>` : ''}
        ${
          navUrls
            ? `<div class="nav-zona">
                 <button class="btn btn--green btn-grande" type="button" data-navegar>🧭 Ir a la dirección</button>
                 <div class="nav-opciones" data-nav-opciones hidden>
                   <a class="btn btn--ghost" href="${navUrls.waze}" target="_blank" rel="noopener" data-nav-app="waze">Waze</a>
                   <a class="btn btn--ghost" href="${navUrls.gmaps}" target="_blank" rel="noopener" data-nav-app="gmaps">Google Maps</a>
                 </div>
                 <button class="nav-otra" type="button" data-nav-otra hidden>Usar otra app de navegación</button>
               </div>`
            : ''
        }
        <ul class="items">${items}</ul>
        <p class="detalle-total">Total: <strong>$${Number(p.total).toFixed(2)}</strong></p>
        ${p.repartidor && !mio ? `<p class="suave">Lo lleva ${escapar(p.repartidor)}.</p>` : ''}
        <a class="problema" href="${waProblema}" target="_blank" rel="noopener">⚠️ Avisar un problema al vivero</a>
      </div>
      <div class="acciones" data-acciones></div>
    `;

    const acciones = detalleEl.querySelector<HTMLElement>('[data-acciones]')!;

    // Navegacion: la primera vez se elige Waze o Google Maps; la eleccion se
    // recuerda y los siguientes toques van directo (un solo toque en la
    // calle). "Usar otra app" reabre la eleccion.
    const zonaNav = detalleEl.querySelector<HTMLElement>('.nav-zona');
    if (zonaNav && navUrls) {
      const botonNav = zonaNav.querySelector<HTMLButtonElement>('[data-navegar]')!;
      const opciones = zonaNav.querySelector<HTMLElement>('[data-nav-opciones]')!;
      const otraApp = zonaNav.querySelector<HTMLElement>('[data-nav-otra]')!;
      const preferida = () => localStorage.getItem('vr_nav_app') as 'waze' | 'gmaps' | null;
      const abrirOpciones = () => {
        opciones.hidden = false;
        otraApp.hidden = true;
        animarEntrada(opciones, 'pantalla-entrando');
      };
      if (preferida()) otraApp.hidden = false;
      botonNav.addEventListener('click', () => {
        const app = preferida();
        if (app && navUrls[app]) window.open(navUrls[app], '_blank', 'noopener');
        else abrirOpciones();
      });
      otraApp.addEventListener('click', abrirOpciones);
      opciones.querySelectorAll<HTMLElement>('[data-nav-app]').forEach((enlace) => {
        enlace.addEventListener('click', () => {
          localStorage.setItem('vr_nav_app', enlace.getAttribute('data-nav-app')!);
          opciones.hidden = true;
          otraApp.hidden = false;
        });
      });
    }

    if (entregado) {
      acciones.innerHTML = '<p class="hecho">✅ Entregado</p>';
      return;
    }
    if (deOtro) return;

    if (!p.repartidor) {
      const boton = document.createElement('button');
      boton.className = 'btn btn--green btn-grande';
      boton.type = 'button';
      boton.textContent = 'Confirmar pedido';
      boton.addEventListener('click', () => agarrar(p.numero, boton));
      acciones.appendChild(boton);
      return;
    }

    // Es mio y sigue en la calle: avisar y entregar con foto.
    if (waCamino) {
      const wa = document.createElement('a');
      wa.className = 'btn btn--whatsapp btn-grande';
      wa.href = waCamino;
      wa.target = '_blank';
      wa.rel = 'noopener';
      wa.textContent = 'Avisar “va en camino” por WhatsApp';
      acciones.appendChild(wa);
    }
    acciones.insertAdjacentHTML(
      'beforeend',
      `<label class="btn btn--primary btn-grande btn-foto">
         📷 Entregar con foto
         <input type="file" accept="image/*" capture="environment" data-foto hidden />
       </label>
       <p class="suave foto-pista">La foto de la entrega es la prueba: sin foto el pedido no queda entregado.</p>
       <p class="foto-estado" data-foto-estado hidden></p>`,
    );
    acciones
      .querySelector<HTMLInputElement>('[data-foto]')!
      .addEventListener('change', (e) => subirFoto(p, e.target as HTMLInputElement));
  }

  // La confirmacion de exito: se pinta el detalle debajo, el gancho se
  // dibuja encima (~600 ms) y el velo se va solo. Con motricidad reducida
  // no hay velo: el detalle aparece directo.
  function animarExito(alTerminar: () => void) {
    alTerminar();
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const velo = $('[data-exito]');
    velo.hidden = false;
    void velo.offsetWidth; // el reflow arranca las animaciones de trazo
    velo.classList.add('exito--activa');
    setTimeout(() => {
      velo.classList.add('exito--saliendo');
      setTimeout(() => {
        velo.hidden = true;
        velo.classList.remove('exito--activa', 'exito--saliendo');
      }, 200);
    }, 950);
  }

  async function agarrar(numero: string, boton: HTMLButtonElement) {
    boton.disabled = true;
    boton.textContent = 'Confirmando…';
    try {
      const res = await fetch(`/api/repartidor/pedidos/${encodeURIComponent(numero)}/agarrar`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ clave }),
      });
      const datos = await res.json();
      if (res.ok) {
        esMio.set(numero, true);
        animarExito(() => pintarDetalle(datos.pedido, datos.whatsapp ?? null));
        return;
      }
      if (res.status === 409 && datos.error === 'ya_agarrado') {
        mensaje('Otro repartidor lo confirmó primero. La lista se actualizó.');
        volverALista();
        return;
      }
      if (res.status === 409 && datos.error === 'not_available') {
        // Quiza el agarrar anterior SI entro y la respuesta se perdio por
        // la senal: se refresca el detalle y se decide con el, en vez de
        // dar el error generico de senal por un pedido que ya es suyo.
        const resDetalle = await fetch(
          `/api/repartidor/pedidos/${encodeURIComponent(numero)}?clave=${encodeURIComponent(clave)}`,
        );
        if (!resDetalle.ok) throw new Error();
        const detalle = await resDetalle.json();
        const decision = decidirTrasNoDisponible(detalle, datos.message);
        esMio.set(numero, decision.esMio);
        mensaje(decision.mensaje);
        if (decision.esMio) pintarDetalle(detalle);
        else volverALista();
        return;
      }
      throw new Error();
    } catch {
      boton.disabled = false;
      boton.textContent = 'Confirmar pedido';
      mensaje('No se pudo confirmar el pedido. Revisa tu señal e intenta de nuevo.');
    }
  }

  // -- foto de entrega ------------------------------------------------------

  // Las fotos de celular pesan 2–8 MB y las funciones de Vercel cortan cerca
  // de 4.5 MB: se comprime en el navegador (~1600 px, JPEG 80%) antes de
  // subir. Si el navegador no puede, sube la original y el limite lo pone el
  // servidor.
  async function comprimir(archivo: File): Promise<Blob> {
    try {
      const bitmap = await createImageBitmap(archivo);
      const escala = Math.min(1, 1600 / Math.max(bitmap.width, bitmap.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(bitmap.width * escala);
      canvas.height = Math.round(bitmap.height * escala);
      canvas.getContext('2d')!.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      const blob = await new Promise<Blob | null>((listo) =>
        canvas.toBlob(listo, 'image/jpeg', 0.8),
      );
      return blob ?? archivo;
    } catch {
      return archivo;
    }
  }

  async function subirFoto(p: any, input: HTMLInputElement) {
    const archivo = input.files?.[0];
    if (!archivo) return;
    const estado = detalleEl.querySelector<HTMLElement>('[data-foto-estado]')!;
    estado.hidden = false;
    estado.textContent = 'Subiendo la foto…';
    try {
      const foto = await comprimir(archivo);
      // Binario crudo con la clave en un header: un multipart desde el
      // navegador muere en el 403 del chequeo CSRF de Astro tras el proxy
      // de Vercel (el multipart hacia el order-api lo arma la funcion).
      const res = await fetch(`/api/repartidor/pedidos/${encodeURIComponent(p.numero)}/foto`, {
        method: 'POST',
        headers: {
          'Content-Type': foto.type || 'image/jpeg',
          'X-Clave-Repartidor': clave,
        },
        body: foto,
      });
      const datos = await res.json();
      if (!res.ok) throw new Error(datos.message);
      const acciones = detalleEl.querySelector<HTMLElement>('[data-acciones]')!;
      acciones.innerHTML =
        '<p class="hecho">✅ Entregado. ¡Buen trabajo!</p>' +
        (datos.whatsapp
          ? `<a class="btn btn--whatsapp btn-grande" href="${datos.whatsapp}" target="_blank" rel="noopener">
               Avisar “entregado” y pedir la calificación
             </a>`
          : '');
    } catch {
      estado.textContent =
        'La foto no subió (¿mala señal?). Vuelve a tocar “Entregar con foto”: reintentar es seguro.';
      input.value = '';
    }
  }

  function volverALista() {
    cargarLista();
  }

  // -- pantalla AVISOS ------------------------------------------------------

  const TITULO_AVISO: Record<string, (a: any) => string> = {
    pedido_listo: () => 'Pedido nuevo listo para salir',
    agarrado: (a) =>
      a.detalle === nombreRepartidor
        ? 'Confirmaste el pedido'
        : `${a.detalle ?? 'Otro repartidor'} confirmó el pedido`,
    retraso: () => 'Pedido con retraso',
  };

  const ICONO_AVISO: Record<string, string> = {
    pedido_listo: '📦',
    agarrado: '🤝',
    retraso: '⏰',
  };

  function etiquetaDia(fecha: Date): string {
    const hoy = new Date();
    hoy.setHours(0, 0, 0, 0);
    const dia = new Date(fecha);
    dia.setHours(0, 0, 0, 0);
    const dias = Math.round((hoy.getTime() - dia.getTime()) / 86400000);
    if (dias === 0) return 'Hoy';
    if (dias === 1) return 'Ayer';
    return fecha.toLocaleDateString('es-PA', { weekday: 'long', day: 'numeric', month: 'long' });
  }

  async function cargarAvisos() {
    mostrarBandaPush();
    try {
      const res = await fetch(`/api/repartidor/avisos?clave=${encodeURIComponent(clave)}`);
      if (res.status === 401) {
        avisosEl.innerHTML = '';
        manejar401();
        return;
      }
      if (!res.ok) throw new Error();
      pintarAvisos((await res.json()).avisos ?? []);
    } catch {
      avisosEl.innerHTML = '';
      mensaje('No pudimos cargar los avisos. Revisa tu señal e intenta de nuevo.');
    }
  }

  function pintarAvisos(avisos: any[]) {
    if (!avisos.length) {
      avisosEl.innerHTML =
        '<div class="tarjeta vacio"><p>Sin avisos por ahora.</p>' +
        '<p class="suave">Aquí verás los pedidos nuevos, los que confirma cada quien y los retrasos.</p></div>';
      return;
    }
    // Vienen del mas nuevo al mas viejo: se agrupan por dia conservando el orden.
    const grupos: { etiqueta: string; avisos: any[] }[] = [];
    for (const aviso of avisos) {
      const etiqueta = etiquetaDia(new Date(aviso.creado_en));
      const ultimo = grupos[grupos.length - 1];
      if (ultimo && ultimo.etiqueta === etiqueta) ultimo.avisos.push(aviso);
      else grupos.push({ etiqueta, avisos: [aviso] });
    }
    avisosEl.innerHTML = grupos
      .map(
        (grupo) =>
          `<h2 class="bloque-titulo">${escapar(grupo.etiqueta)}</h2>` +
          grupo.avisos
            .map((aviso) => {
              const titulo = (TITULO_AVISO[aviso.tipo] ?? (() => aviso.tipo))(aviso);
              const extra =
                aviso.tipo === 'pedido_listo' && aviso.detalle ? ` · ${aviso.detalle}` : '';
              return `
              <div class="tarjeta aviso aviso--${aviso.tipo}">
                <span class="aviso-icono">${ICONO_AVISO[aviso.tipo] ?? '🔔'}</span>
                <span class="aviso-datos">
                  <span class="aviso-titulo">${escapar(titulo)}</span>
                  <span class="suave">${escapar(aviso.numero)}${escapar(extra)}</span>
                </span>
                <span class="aviso-hora">${hora(new Date(aviso.creado_en))}</span>
              </div>`;
            })
            .join(''),
      )
      .join('');
  }

  // -- avisos push ----------------------------------------------------------

  function mostrarBandaPush() {
    const soporta = 'serviceWorker' in navigator && 'PushManager' in window;
    if (!soporta || localStorage.getItem('vr_push_activado')) return;
    $('[data-banda-push]').hidden = false;
  }

  function base64aBytes(base64: string): Uint8Array {
    const relleno = '='.repeat((4 - (base64.length % 4)) % 4);
    const crudo = atob((base64 + relleno).replace(/-/g, '+').replace(/_/g, '/'));
    return Uint8Array.from(crudo, (c) => c.charCodeAt(0));
  }

  // La misma activacion sirve para el repartidor (pantalla de avisos) y para
  // el dueno (tarjeta del 401): cambia donde se pinta el resultado.
  async function activarAvisos(estado: HTMLElement, banda: HTMLElement) {
    estado.hidden = false;
    try {
      const permiso = await Notification.requestPermission();
      if (permiso !== 'granted') {
        estado.textContent = 'Los avisos quedaron bloqueados en el navegador.';
        return;
      }
      const registro = await navigator.serviceWorker.register('/sw-avisos.js');
      await navigator.serviceWorker.ready;
      const resClave = await fetch('/api/push/clave-publica');
      if (!resClave.ok) {
        estado.textContent = 'Los avisos no están configurados todavía en el servidor.';
        return;
      }
      const { clave_publica } = await resClave.json();
      const suscripcion = await registro.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: base64aBytes(clave_publica),
      });
      const res = await fetch('/api/push/suscribir', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ clave, suscripcion: suscripcion.toJSON() }),
      });
      if (res.status === 401) {
        estado.textContent = 'Esta clave no puede recibir avisos: pide un enlace nuevo.';
        return;
      }
      if (!res.ok) throw new Error();
      localStorage.setItem('vr_push_activado', '1');
      banda.hidden = true;
      estado.textContent = '✅ Avisos activados en este teléfono.';
    } catch {
      estado.textContent = 'No se pudieron activar los avisos. Intenta de nuevo.';
    }
  }

  // -- enlace pegado a mano -------------------------------------------------

  // Acepta el enlace completo del WhatsApp o la clave sola.
  function extraerClave(texto: string): string {
    const limpio = texto.trim();
    try {
      const url = new URL(limpio);
      return url.searchParams.get('clave')?.trim() ?? '';
    } catch {
      return limpio;
    }
  }

  $('[data-form-clave]').addEventListener('submit', (e) => {
    e.preventDefault();
    const input = $('[data-input-clave]') as unknown as HTMLInputElement;
    const nueva = extraerClave(input.value);
    if (!nueva) {
      $('[data-error-clave]').hidden = false;
      return;
    }
    localStorage.setItem('vr_clave_repartidor', nueva);
    // Recarga limpia: el arranque lee la clave guardada.
    location.replace('/repartidor');
  });

  $('[data-usar-otro]').addEventListener('click', () => {
    // La clave guardada quedo vieja: se descarta y se pide la nueva.
    localStorage.removeItem('vr_clave_repartidor');
    $('[data-modo-dueno]').hidden = true;
    $('[data-sin-clave]').hidden = false;
    ($('[data-input-clave]') as unknown as HTMLInputElement).focus();
  });

  // -- arranque -------------------------------------------------------------

  $('[data-refrescar]').addEventListener('click', cargarLista);
  $('[data-volver]').addEventListener('click', volverALista);
  $('[data-activar-push]').addEventListener('click', () =>
    activarAvisos($('[data-push-estado]'), $('[data-banda-push]')),
  );
  $('[data-activar-push-dueno]').addEventListener('click', () =>
    activarAvisos($('[data-push-estado-dueno]'), $('[data-banda-push-dueno]')),
  );
  $('[data-cerrar-instalar]').addEventListener('click', () => {
    localStorage.setItem('vr_instalar_visto', '1');
    $('[data-instalar]').hidden = true;
  });

  // El globito rojo del icono se apaga al abrir (o volver a) la app: los
  // avisos ya se vieron, y los que sigan en el centro de notificaciones se
  // recogen para que el conteo del service worker vuelva a cero.
  function limpiarGlobito() {
    (navigator as any).clearAppBadge?.().catch(() => {});
    navigator.serviceWorker
      ?.getRegistration('/sw-avisos.js')
      .then((registro) =>
        registro?.getNotifications().then((avisos) => avisos.forEach((a) => a.close())),
      )
      .catch(() => {});
  }
  limpiarGlobito();
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) limpiarGlobito();
  });

  const instalada = window.matchMedia('(display-mode: standalone)').matches;
  if (!instalada && !localStorage.getItem('vr_instalar_visto')) {
    $('[data-instalar]').hidden = false;
  }

  if (!clave) {
    $('[data-sin-clave]').hidden = false;
    document.querySelectorAll<HTMLElement>('.pantalla').forEach((el) => (el.hidden = true));
    ($('[data-tabs]') as HTMLElement).style.display = 'none';
  } else {
    cargarInicio();
    revisarAvisosNuevos();
  }
</script>

<!-- Global a proposito: las pantallas se inyectan con innerHTML y el CSS
