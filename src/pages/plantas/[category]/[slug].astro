---
// Pagina de producto del handoff (Producto.dc.html): galeria con miniaturas,
// panel con variantes, acordeones, guia de cuidado y "Va bien con…".
// La logica integrada se conserva: StockBadge con data-sku (stock proxy),
// catalogo en src/data/products.ts y carrito en src/lib/cart.
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import ProductCard from '../../../components/ProductCard.astro';
import StockBadge from '../../../components/StockBadge.astro';
import {
  compareAtPrice,
  esComprable,
  formatPrice,
  getCategory,
  precioVigente,
  type Product,
} from '../../../data/products';
import { collections, factsOf } from '../../../data/collections';
import { productosPublicados } from '../../../lib/catalogo-build';
import { COLORES_MACETA, fotosDe, macetasDe, manoDe, urlFoto, type ColorMaceta } from '../../../lib/fotos';
import { SITE } from '../../../lib/site';

// Solo los productos activos en Odoo generan pagina: un archivado no esta en
// productosPublicados, asi que su URL da 404 (src/lib/catalogo-build.ts).
export async function getStaticPaths() {
  return (await productosPublicados()).map((product) => ({
    params: { category: product.category, slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const publicados = await productosPublicados();
const category = getCategory(product.category)!;
const soldOut = product.available <= 0;
// Estado inicial de precios (build, con los precios reales de catalogo-build);
// el proxy los refresca en vivo con la misma regla (precioVista).
const compareAt = soldOut ? null : compareAtPrice(product);
const vigente = precioVigente(product);
const comprable = esComprable(product);
const whatsappMessage = `Hola, me interesa "${product.name}" (${product.sku}) que vi en plantaspanama.com.`;

// "Va bien con…": prioriza la misma categoria. No se filtra por available:
// en los datos estaticos siempre es 0 (los badges de las tarjetas ya pintan
// el stock real del proxy).
const related = publicados
  .filter((p) => p.slug !== product.slug)
  .sort((a, b) => Number(b.category === product.category) - Number(a.category === product.category))
  .slice(0, 5);

// Fotos reales de la galeria, desde Cloudinary (scripts/fotos.py mantiene el
// orden: principal, hover, adicionales). Cada foto en dos tamanos: miniatura
// cuadrada para la tira y grande para el visor principal. La grande viaja
// entera (c_fit, sin recorte de Cloudinary) y el visor 4:5 la llena con
// cover: solo se pierde un poco de arriba y de abajo, nunca los lados.
// Sin fotos no hay tira ni flechas ni contador: solo el marco con el emoji
// (las guias de desarrollo — cajas numeradas, medidas — no se publican).
const fotosGaleria = fotosDe(product.sku).map((hash) => ({
  mini: urlFoto(product.sku, hash, { ancho: 160, ratio: '1:1' }),
  grande: urlFoto(product.sku, hash, { ancho: 960, completa: true }),
}));

// Fotos de la planta en maceta de color: van SIEMPRE despues de las fotos
// normales (posiciones 2, 3, 4…). Si el producto aun no tiene foto principal,
// la posicion 1 es el marco con el emoji (reservada para cuando se tome) y
// las macetas la siguen. Cada color del selector salta a su foto.
const NOMBRE_COLOR: Record<ColorMaceta, string> = {
  beige: 'Beige',
  gris: 'Gris',
  marron: 'Marrón',
};
const SWATCH_MACETA: Record<ColorMaceta, string> = {
  beige: '#d9c6a8',
  gris: '#454545',
  marron: '#5a3a33',
};
const macetas = macetasDe(product.sku);
const fotosMaceta = COLORES_MACETA.filter((c) => macetas[c]).map((color) => ({
  color,
  mini: urlFoto(product.sku, macetas[color]!, { ancho: 160, ratio: '1:1' }),
  grande: urlFoto(product.sku, macetas[color]!, { ancho: 960, completa: true }),
}));
const conMarcador = fotosGaleria.length === 0 && fotosMaceta.length > 0;
const totalGaleria = (conMarcador ? 1 : fotosGaleria.length) + fotosMaceta.length;

// Similares del carrusel "Te podrian gustar": solo productos que comparten
// coleccion con este ('all' no cuenta porque abarca todo el catalogo),
// ordenados por cuantas colecciones comparten. El desempate usa una semilla
// del SKU para no quedar en orden alfabetico. No se filtra por available:
// en los datos estaticos siempre es 0 y el stock real lo pinta el proxy.
const coleccionesDe = (p: Product) =>
  collections.filter((c) => c.slug !== 'all' && c.test(factsOf(p)));
const coleccionesDelProducto = new Set(coleccionesDe(product).map((c) => c.slug));
const semillaSku = (sku: string) =>
  [...sku].reduce((suma, letra) => (suma * 31 + letra.charCodeAt(0)) % 997, 7);
const similares = publicados
  .filter((p) => p.slug !== product.slug)
  .map((p) => ({
    p,
    comunes: coleccionesDe(p).filter((c) => coleccionesDelProducto.has(c.slug)).length,
  }))
  .filter((x) => x.comunes > 0)
  .sort((a, b) => b.comunes - a.comunes || semillaSku(a.p.sku) - semillaSku(b.p.sku))
  .slice(0, 9)
  .map((x) => x.p);

const SIZES = [
  { key: 'S', label: 'Pequeña — matera 6"' },
  { key: 'M', label: 'Mediana — matera 8"' },
  { key: 'L', label: 'Grande — matera 10"' },
  { key: 'XL', label: 'Extra grande — matera 14"' },
];

const POT_COLORS = [
  { key: 'coco', swatch: '#efe7dc' },
  { key: 'piedra', swatch: '#b9b7b1' },
  { key: 'terracota', swatch: '#c9765a' },
  { key: 'arena', swatch: '#dcb98a' },
];

// Detalle de luz derivado del texto real del catalogo (sin inventar por planta).
const light = product.care.light;
const lightDetail = /baja/i.test(light)
  ? 'Aguanta pasillos, baños y oficinas con luz de vidrio polarizado. Mientras menos luz, menos riego.'
  : /indirecta/i.test(light)
    ? 'Cerca de una ventana con luz filtrada. Evita el sol directo del mediodía sobre las hojas.'
    : 'En Panamá funciona mejor el sol de la mañana; la tarde fuerte puede quemar el follaje.';

const waterDetailByDifficulty: Record<string, string> = {
  Facil: 'Riega cuando las primeras dos pulgadas de tierra estén secas. Perdona el olvido de una semana.',
  Media: 'Riega al pie, no sobre las hojas, temprano en la mañana. En verano puede necesitar riego diario.',
  Exigente: 'Mantén el sustrato húmedo sin encharcar y revísalo cada dos días. No tolera secarse por completo.',
};

const careRows = [
  { key: 'luz', icon: 'sun', label: 'Luz', value: product.care.light, detail: lightDetail },
  {
    key: 'riego',
    icon: 'droplets',
    label: 'Riego',
    value: product.care.water,
    detail: waterDetailByDifficulty[product.care.difficulty],
  },
  {
    key: 'humedad',
    icon: 'waves',
    label: 'Humedad',
    value: 'Media–alta',
    detail:
      'Tolera bien la humedad del istmo si tiene circulación de aire. Evita rincones cerrados sin ventilación.',
  },
  {
    key: 'temp',
    icon: 'thermometer',
    label: 'Temperatura',
    value: '18–32 °C',
    detail:
      'Sin problemas en clima panameño todo el año. Si vive con aire acondicionado, aléjala de la salida de aire.',
  },
  {
    key: 'suelo',
    icon: 'shovel',
    label: 'Suelo',
    value: 'Bien drenado',
    detail: 'Mezcla de tierra negra con arena y materia orgánica. El agua estancada pudre la raíz.',
  },
  {
    key: 'abono',
    icon: 'sprout',
    label: 'Abono',
    value: 'Cada 3 semanas',
    detail: 'Abono granulado de liberación lenta durante la temporada de crecimiento.',
  },
  {
    key: 'poda',
    icon: 'scissors',
    label: 'Poda',
    value: 'Mensual',
    detail: 'Corta hojas secas y ramas cruzadas para mantener la forma y estimular brotes nuevos.',
  },
  {
    key: 'trasplante',
    icon: 'flower-2',
    label: 'Trasplante',
    value: 'Cada 2 años',
    detail: 'Pasa a una matera dos pulgadas más ancha al inicio de la temporada de lluvias.',
  },
] as const;

// La descripcion va bajo la foto del producto (columna izquierda del hero),
// no en un acordeon.
const descripcion = `${product.description} Cultivada en nuestro vivero en Ciudad de Panamá y entregada en matera de vivero, lista para sembrar o pasar a una matera decorativa. La despachamos con el cepellón húmedo y protegido para que llegue igual que salió del vivero.`;

const accordions = [
  {
    key: 'cuidado',
    title: 'Guía de cuidado',
    open: false,
    body: `${lightDetail} ${waterDetailByDifficulty[product.care.difficulty]} El detalle completo, riego por riego, está más abajo en la guía de cuidado.`,
  },
  {
    key: 'envio',
    title: 'Entrega y satisfacción',
    open: false,
    body: 'Entregamos en Ciudad de Panamá en 24 a 48 horas (envío estándar $3.00; también hay entrega express y retiro gratis en el vivero). Fuera de la ciudad coordinamos por WhatsApp. Si la planta llega dañada, mándanos una foto y la reponemos.',
  },
];

const careTitle = `Cuidado de ${product.name.replace(/\s*\(.*\)$/, '').toLowerCase()}`;

// Foto del circulo de cuidado: la de la mano sosteniendo la planta si existe
// (scripts/fotos.py la marca), si no la principal. Recorte cuadrado centrado
// en el sujeto (g_auto): en un circulo no cabe la foto entera.
const hashCuidado = manoDe(product.sku) ?? fotosDe(product.sku)[0];
const fotoCuidado = hashCuidado
  ? urlFoto(product.sku, hashCuidado, { ancho: 640, ratio: '1:1' })
  : product.image;
---

<Base title={product.name} description={product.description} whatsappMessage={whatsappMessage}>
  <div class="container product-hero">
    <div class:list={['gallery', { 'gallery--sin-fotos': !totalGaleria }]}>
      {totalGaleria > 0 && (
        <div class="thumbs" data-thumbs>
          {conMarcador && (
            <button class="thumb thumb--emoji active" data-thumb aria-label="Ver foto 1">
              {product.emoji}
            </button>
          )}
          {fotosGaleria.map((foto, i) => (
            <button
              class:list={['thumb', 'thumb--foto', { active: i === 0 }]}
              data-thumb
              data-foto={foto.grande}
              style={`background-image: url('${foto.mini}'); background-size: cover; background-position: center;`}
              aria-label={`Ver foto ${i + 1}`}
            />
          ))}
          {fotosMaceta.map((foto) => (
            <button
              class="thumb thumb--foto"
              data-thumb
              data-foto={foto.grande}
              data-color-maceta={foto.color}
              style={`background-image: url('${foto.mini}'); background-size: cover; background-position: center;`}
              aria-label={`Ver foto en maceta ${NOMBRE_COLOR[foto.color].toLowerCase()}`}
            />
          ))}
        </div>
      )}
      <div class="main-photo">
        <div
          class="main-photo-ph"
          data-main-photo
          style={
            fotosGaleria.length
              ? `background-image: url('${fotosGaleria[0].grande}'); background-size: cover; background-position: center;`
              : undefined
          }
        >
          {!fotosGaleria.length && <span data-main-emoji>{product.emoji}</span>}
          {totalGaleria > 0 && (
            <span class="main-photo-num" data-main-num>Foto 1 de {totalGaleria}</span>
          )}
        </div>
        <div class="soldout-stamp" data-soldout-stamp hidden={!soldOut || !comprable}>Agotado</div>
        {totalGaleria > 1 && (
          <>
            <button class="photo-arrow photo-arrow--prev" data-gallery-prev aria-label="Foto anterior">
              <Icon name="chevron-left" size={20} />
            </button>
            <button class="photo-arrow photo-arrow--next" data-gallery-next aria-label="Foto siguiente">
              <Icon name="chevron-right" size={20} />
            </button>
          </>
        )}
      </div>
    </div>

    <div class="panel-col">
      <nav class="breadcrumb" aria-label="Miga de pan">
        <a href="/" aria-label="Inicio"><Icon name="home" size={15} /></a>
        <span>›</span>
        <a href={`/plantas/${category.slug}`}>{category.name}</a>
      </nav>

      <h1>{product.name}</h1>
      {product.scientificName && <div class="scientific">{product.scientificName}</div>}

      <div class="price-row">
        <div class="price-group">
          <StockBadge sku={product.sku} available={product.available} comprable={comprable} />
          <span class="compare" data-price-compare hidden={!comprable || !compareAt}>
            {compareAt ? formatPrice(compareAt) : ''}
          </span>
          <span class="price" data-price-current hidden={!comprable}>{formatPrice(vigente)}</span>
          <span class="price price-soon" data-price-soon hidden={comprable}>Próximamente</span>
        </div>
        <button
          class="fav-btn"
          type="button"
          aria-label={`Guardar ${product.name} en favoritos`}
          data-fav-btn
        >
          <Icon name="heart" size={18} />
        </button>
      </div>

      <hr class="rule" />

      <div class="variant-head">
        <div class="variant-title">Tamaño — Mediana — matera 8"</div>
        <button class="size-guide" type="button" disabled title="No disponible por ahora">
          Guía de tamaños <Icon name="ruler" size={15} />
        </button>
      </div>
      <div class="sizes">
        {
          SIZES.map((s) => (
            <button
              class:list={['size-circle', { active: s.key === 'M' }]}
              disabled={s.key !== 'M'}
              title={s.key !== 'M' ? 'No disponible por ahora' : s.label}
            >
              {s.key}
            </button>
          ))
        }
      </div>

      <div class="variant-title variant-title--gap">Maceta — Sin maceta</div>
      <div class="pots">
        <button class="pot active" type="button" title="Sin maceta">
          <span class="pot-circle"><Icon name="sprout" size={20} /></span>
          <span>Sin maceta</span>
        </button>
        <button class="pot" disabled title="No disponible por ahora">
          <span class="pot-circle"><Icon name="flower-2" size={20} /></span>
          <span>De vivero</span>
        </button>
        <button class="pot" disabled title="No disponible por ahora">
          <span class="pot-circle"><Icon name="cup-soda" size={20} /></span>
          <span>Cerámica</span>
        </button>
      </div>

      <div class="variant-title variant-title--gap">Color de maceta — De vivero</div>
      <div class="pot-colors">
        {
          // Con fotos de maceta, cada circulo salta a la foto de su color en
          // la galeria (solo vista previa: la maceta sigue sin poderse
          // comprar). Sin fotos, quedan los circulos bloqueados de siempre.
          fotosMaceta.length > 0
            ? fotosMaceta.map((foto) => (
                <button
                  class="pot-color pot-color--foto"
                  type="button"
                  data-color-maceta-btn={foto.color}
                  title={`Ver en maceta ${NOMBRE_COLOR[foto.color].toLowerCase()}`}
                  aria-label={`Ver foto en maceta ${NOMBRE_COLOR[foto.color].toLowerCase()}`}
                  style={`background: ${SWATCH_MACETA[foto.color]};`}
                />
              ))
            : POT_COLORS.map((c) => (
                <button
                  class="pot-color"
                  disabled
                  title="No disponible por ahora"
                  aria-label={`Color ${c.key}`}
                  style={`background: linear-gradient(to top left, transparent calc(50% - 1px), rgba(27,42,31,0.55) calc(50% - 1px), rgba(27,42,31,0.55) calc(50% + 1px), transparent calc(50% + 1px)), ${c.swatch};`}
                />
              ))
        }
      </div>

      <div class="assurances">
        <div><Icon name="gift" size={18} class="assure-icon" /> Opciones de regalo disponibles en el carrito</div>
        <div><Icon name="shield-check" size={18} class="assure-icon" /> Satisfacción del cliente: llega sana o la reponemos</div>
        {
          product.petFriendly !== undefined && (
            <div>
              <Icon name={product.petFriendly ? 'paw-print' : 'alert-triangle'} size={18} class="assure-icon" />
              {product.petFriendly
                ? 'Apta para hogares con mascotas'
                : 'No apta para mascotas: mantenla fuera de su alcance'}
            </div>
          )
        }
      </div>

      <!-- Se renderizan AMBOS estados del panel y un script los alterna con
           el stock real del proxy (evento stock-actualizado de StockBadge):
           el build estatico siempre trae available=0 y no puede decidir.
           Sin precio real ("Proximamente") el estado de agotado NO se
           muestra: seria contradictorio, y el boton deshabilitado ya dice
           todo. Misma regla en el script de abajo y en StockBadge. -->
      <div class="cta-block" data-cta-block hidden={soldOut && comprable}>
        <button
          class="cta-add add-to-cart"
          disabled={!comprable}
          data-sku={product.sku}
          data-name={product.name}
          data-price={vigente}
          data-slug={product.slug}
          data-category={product.category}
          data-emoji={product.emoji}
          data-image={product.image}
          data-label={comprable ? `Agregar al carrito — ${formatPrice(vigente)}` : 'Próximamente'}
        >
          {comprable ? `Agregar al carrito — ${formatPrice(vigente)}` : 'Próximamente'}
        </button>
      </div>
      <div class="soldout-box" data-soldout-box hidden={!soldOut || !comprable}>
        <div class="soldout-title">Esta planta está agotada</div>
        <p>
          Sembramos tandas nuevas cada mes. Déjanos tu correo y te avisamos apenas vuelva al
          vivero.
        </p>
        <form data-notify-form data-wa={SITE.whatsappNumber} data-product={`${product.name} (${product.sku})`}>
          <input type="email" name="email" placeholder="Tu correo" required />
          <button type="submit">Avísame</button>
        </form>
        <a href="#similares" class="soldout-link">Ver plantas similares disponibles</a>
      </div>

      <div class="shipping-line">
        <Icon name="truck" size={18} class="assure-icon" />
        <span data-shipping-out hidden={!soldOut || !comprable}>Sembramos tandas nuevas cada mes</span>
        <span data-shipping-in hidden={soldOut && comprable}>Entrega en Ciudad de Panamá en 24–48 h</span>
      </div>

      <script>
        // Panel de compra segun el stock Y los precios REALES: la misma
        // fuente (stock proxy, via el evento de StockBadge) que pinta el
        // badge de arriba. Asi la ficha no puede decir "En stock" y
        // "agotada" a la vez, ni mostrar un precio distinto del que cobra
        // el checkout.
        import { precioVista, type StockItem } from '../../../lib/stock';

        document.addEventListener('stock-actualizado', (event) => {
          const badge = document.querySelector<HTMLElement>('.price-group [data-stock-badge]');
          const sku = badge?.dataset.sku;
          if (!sku) return;
          const items = (event as CustomEvent<{ items: StockItem[] }>).detail.items;
          const item = items.find((i) => i.sku === sku);
          if (!item) return;
          const agotado = item.available <= 0;
          // Sin precio real ("Proximamente") no se muestra NADA de agotado:
          // la misma regla que el estado de build. Si el proxy no trajo
          // precio (fallback degradado), manda lo que decidio el build (se
          // lee del DOM: "Proximamente" oculto = comprable).
          const pv = precioVista(item);
          const comprable = pv
            ? pv.comprable
            : document.querySelector<HTMLElement>('[data-price-soon]')!.hidden;
          const mostrarAgotado = agotado && comprable;
          document.querySelector<HTMLElement>('[data-soldout-stamp]')!.hidden = !mostrarAgotado;
          document.querySelector<HTMLElement>('[data-cta-block]')!.hidden = mostrarAgotado;
          document.querySelector<HTMLElement>('[data-soldout-box]')!.hidden = !mostrarAgotado;
          document.querySelector<HTMLElement>('[data-shipping-out]')!.hidden = !mostrarAgotado;
          document.querySelector<HTMLElement>('[data-shipping-in]')!.hidden = mostrarAgotado;

          // Precios en vivo. Sin precio del proxy se conserva el build.
          if (!pv) return;
          const fmt = (n: number) => `$${n.toFixed(2)}`;
          const grupo = document.querySelector<HTMLElement>('.price-group')!;
          const actual = grupo.querySelector<HTMLElement>('[data-price-current]')!;
          const tachado = grupo.querySelector<HTMLElement>('[data-price-compare]')!;
          const proximamente = grupo.querySelector<HTMLElement>('[data-price-soon]')!;
          proximamente.hidden = pv.comprable;
          actual.hidden = !pv.comprable;
          actual.textContent = fmt(pv.vigente);
          tachado.hidden = agotado || !pv.comprable || pv.regular === null;
          if (pv.regular !== null) tachado.textContent = fmt(pv.regular);

          const boton = document.querySelector<HTMLButtonElement>('.add-to-cart');
          if (!boton) return;
          boton.disabled = !pv.comprable;
          const etiqueta = pv.comprable ? `Agregar al carrito — ${fmt(pv.vigente)}` : 'Próximamente';
          boton.dataset.label = etiqueta;
          boton.textContent = etiqueta;
          if (pv.comprable) boton.dataset.price = String(pv.vigente);
        });
      </script>
    </div>

    <!-- Descripcion bajo la foto (columna izquierda); en movil las columnas
         se apilan y queda despues del panel de compra por orden natural. -->
    <div class="panel-desc">
      <h2>Descripción</h2>
      <p>{descripcion}</p>
    </div>
  </div>

  <!-- Slider "Te podrian gustar": 3 tarjetas visibles y flechas para pasar
       a las siguientes; el enlace del agotado baja hasta aqui. -->
  {
    similares.length > 0 && (
      <section id="similares" class="container similares-section">
        <h2 class="similares-title">Te podrían gustar</h2>
        <div class="carrusel" data-carrusel aria-roledescription="carrusel" aria-label="Plantas similares">
          <!-- Fila plana de tarjetas iguales (como el catalogo): la ventana
               es un scroller nativo con snap, las flechas pasan de pagina y
               en tactil se desliza con el dedo. Los puntos (uno por pagina)
               los pinta el script segun cuantas tarjetas caben. -->
          <div class="carrusel-ventana" data-ventana tabindex="0">
            {similares.map((p) => (
              <div class="lamina" data-lamina>
                <ProductCard product={p} />
              </div>
            ))}
          </div>
          <button type="button" class="sim-arrow sim-arrow--prev" data-sim-prev aria-label="Anterior">
            <Icon name="chevron-left" size={20} />
          </button>
          <button type="button" class="sim-arrow sim-arrow--next" data-sim-next aria-label="Siguiente">
            <Icon name="chevron-right" size={20} />
          </button>
          <div class="similares-dots" data-sim-dots role="tablist" aria-label="Página del carrusel"></div>
        </div>
      </section>
    )
  }

  <section class="container accordion-section">
    {
      accordions.map((acc) => (
        <div class="acc">
          <button class="acc-toggle" data-acc-toggle aria-expanded={acc.open ? 'true' : 'false'}>
            {acc.title}
            <span class="when-closed"><Icon name="chevron-down" size={20} class="acc-chev" /></span>
            <span class="when-open"><Icon name="chevron-up" size={20} class="acc-chev" /></span>
          </button>
          <div class="acc-body" hidden={!acc.open}>
            {acc.body}
          </div>
        </div>
      ))
    }
    <hr class="rule rule--flush" />
  </section>

  <section class="container care-section">
    <h2>{careTitle}</h2>
    <div class="care-grid">
      <div
        class="care-photo"
        style={
          fotoCuidado
            ? `background-image: url('${fotoCuidado}'); background-size: cover; background-position: center;`
            : undefined
        }
      >
        {fotoCuidado ? '' : product.emoji}
      </div>
      <div>
        {
          careRows.map((row) => (
            <div class="care-row">
              <button class="care-toggle" data-acc-toggle aria-expanded="false">
                <Icon name={row.icon} size={20} class="care-icon" />
                <span class="care-label">{row.label}</span>
                <span class="care-value">{row.value}</span>
                <span class="when-closed"><Icon name="chevron-down" size={18} class="acc-chev" /></span>
                <span class="when-open"><Icon name="chevron-up" size={18} class="acc-chev" /></span>
              </button>
              <div class="care-detail" hidden>
                {row.detail}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Solo se pinta si hay disponibles: hoy el catalogo estatico tiene todo
       en 0, pero al conectar el stock-proxy volvera a traer resultados. -->
  {
    related.length > 0 && (
      <section class="container related-section">
        <h2>Va bien con…</h2>
        <div class="related-grid">
          {related.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
      </section>
    )
  }

</Base>

<script>
  import { addToCart } from '../../../lib/cart';
  import { esFavorito, recordarVisto, toggleFavorito } from '../../../lib/preferencias';

  // Galeria: miniatura activa y flechas en bucle. Si la miniatura trae foto
  // real (data-foto), se intercambia tambien la imagen principal; sin
  // data-foto es el marcador de la foto principal pendiente (vuelve al
  // emoji). Los circulos de color de maceta saltan a la foto de su color y
  // se marcan cuando la galeria pasa por ella (por click, flecha o thumb).
  const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-thumb]'));
  const mainNum = document.querySelector<HTMLElement>('[data-main-num]');
  const mainPhoto = document.querySelector<HTMLElement>('[data-main-photo]');
  const mainEmoji = document.querySelector<HTMLElement>('[data-main-emoji]');
  const colorBtns = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-color-maceta-btn]'),
  );
  let current = 0;

  function selectPhoto(index: number) {
    current = (index + thumbs.length) % thumbs.length;
    thumbs.forEach((t, i) => t.classList.toggle('active', i === current));
    if (mainNum) mainNum.textContent = `Foto ${current + 1} de ${thumbs.length}`;
    const foto = thumbs[current]?.dataset.foto;
    if (mainPhoto) {
      mainPhoto.style.backgroundImage = foto ? `url('${foto}')` : '';
      if (foto) {
        mainPhoto.style.backgroundSize = 'cover';
        mainPhoto.style.backgroundPosition = 'center';
      }
    }
    if (mainEmoji) mainEmoji.hidden = !!foto;
    const color = thumbs[current]?.dataset.colorMaceta;
    colorBtns.forEach((b) => b.classList.toggle('active', b.dataset.colorMacetaBtn === color));
  }

  thumbs.forEach((t, i) => t.addEventListener('click', () => selectPhoto(i)));
  document.querySelector('[data-gallery-prev]')?.addEventListener('click', () => selectPhoto(current - 1));
  document.querySelector('[data-gallery-next]')?.addEventListener('click', () => selectPhoto(current + 1));
  colorBtns.forEach((b) =>
    b.addEventListener('click', () => {
      const idx = thumbs.findIndex((t) => t.dataset.colorMaceta === b.dataset.colorMacetaBtn);
      if (idx >= 0) selectPhoto(idx);
    }),
  );

  // Carrusel de similares: fila plana de tarjetas iguales sobre un scroller
  // nativo con snap (deslizar con el dedo sale gratis y es interrumpible).
  // Las flechas avanzan una pagina completa (las tarjetas que caben en la
  // ventana) y los puntos marcan la pagina actual.
  const carrusel = document.querySelector<HTMLElement>('[data-carrusel]');
  if (carrusel) {
    const ventana = carrusel.querySelector<HTMLElement>('[data-ventana]')!;
    const laminas = Array.from(ventana.querySelectorAll<HTMLElement>('[data-lamina]'));
    // Copia completa de las tarjetas al final: el loop es infinito y SIEMPRE
    // avanza en la misma direccion. Al asentarse el scroll sobre los clones,
    // el corrector lo devuelve al punto identico de la zona real (mismos
    // pixeles, salto invisible). Los clones no reciben foco ni clicks.
    const clones = laminas.map((l) => {
      const c = l.cloneNode(true) as HTMLElement;
      c.setAttribute('aria-hidden', 'true');
      c.setAttribute('inert', '');
      c.removeAttribute('data-lamina');
      return c;
    });
    ventana.append(...clones);
    const prev = carrusel.querySelector<HTMLButtonElement>('[data-sim-prev]');
    const next = carrusel.querySelector<HTMLButtonElement>('[data-sim-next]');
    const puntos = carrusel.querySelector<HTMLElement>('[data-sim-dots]');
    const quieto = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Ancho de un "paso" (tarjeta + hueco) medido del layout real.
    const paso = () =>
      laminas.length > 1
        ? laminas[1].offsetLeft - laminas[0].offsetLeft
        : laminas[0]?.offsetWidth || 1;
    const porPagina = () => Math.max(1, Math.round(ventana.clientWidth / paso()));
    const totalPaginas = () => Math.ceil(laminas.length / porPagina());
    // Ancho de la zona real (donde empiezan los clones): el modulo con el
    // total de paginas hace que los puntos marquen bien aunque el scroll
    // este momentaneamente sobre los clones.
    const anchoReal = () => clones[0].offsetLeft - laminas[0].offsetLeft;
    const paginaActual = () => {
      const total = totalPaginas();
      const pagina = Math.round(ventana.scrollLeft / (paso() * porPagina()));
      return ((pagina % total) + total) % total;
    };

    const pintar = () => {
      const total = totalPaginas();
      const actual = paginaActual();
      if (puntos && puntos.childElementCount !== total) {
        puntos.replaceChildren(
          ...Array.from({ length: total }, (_, i) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.setAttribute('role', 'tab');
            b.setAttribute('aria-label', `Ir a la página ${i + 1}`);
            b.addEventListener('click', () => irA(i));
            return b;
          }),
        );
        // Con una sola pagina no hay nada que pasar: ni puntos ni flechas.
        const deMas = total <= 1;
        puntos.hidden = deMas;
        if (prev) prev.hidden = deMas;
        if (next) next.hidden = deMas;
      }
      puntos
        ?.querySelectorAll('button')
        .forEach((b, i) => b.setAttribute('aria-selected', i === actual ? 'true' : 'false'));
    };

    const irA = (pagina: number) => {
      const destino = Math.min(Math.max(pagina, 0), totalPaginas() - 1) * porPagina();
      ventana.scrollTo({
        left: laminas[destino]?.offsetLeft ?? 0,
        behavior: quieto.matches ? 'auto' : 'smooth',
      });
    };

    // El carrusel es circular y cada flecha se mueve SIEMPRE en su propia
    // direccion: nunca se ve "regresar" por encima de las tarjetas.
    const avanzar = (delta: number) => {
      const total = totalPaginas();
      const destino = paginaActual() + delta;
      if (destino >= total) {
        // De la ultima pagina se sigue de largo hacia los clones; el
        // corrector de abajo lo recoloca en la pagina 1 real al asentarse.
        ventana.scrollTo({
          left: clones[0].offsetLeft,
          behavior: quieto.matches ? 'auto' : 'smooth',
        });
      } else if (destino < 0) {
        // Desde la primera pagina hacia atras: salto invisible a su copia
        // clonada (mismos pixeles) y desde ahi retrocede animado hasta la
        // ultima pagina, tambien en su misma direccion.
        ventana.scrollLeft += anchoReal();
        irA(total - 1);
      } else {
        irA(destino);
      }
    };

    prev?.addEventListener('click', () => avanzar(-1));
    next?.addEventListener('click', () => avanzar(1));

    carrusel.addEventListener('keydown', (ev: KeyboardEvent) => {
      if (ev.key === 'ArrowLeft') { ev.preventDefault(); avanzar(-1); }
      if (ev.key === 'ArrowRight') { ev.preventDefault(); avanzar(1); }
    });

    // Repintar al hacer scroll (throttle por rAF) y al cambiar el ancho.
    // Ademas, cuando el scroll se asienta sobre los clones (por flecha o por
    // deslizar con el dedo), teletransportar al punto identico de la zona
    // real: nadie lo nota y el loop puede seguir hacia adelante por siempre.
    let pendiente = 0;
    let asentado = 0;
    ventana.addEventListener('scroll', () => {
      if (!pendiente) {
        pendiente = requestAnimationFrame(() => { pendiente = 0; pintar(); });
      }
      clearTimeout(asentado);
      asentado = window.setTimeout(() => {
        const real = anchoReal();
        if (ventana.scrollLeft >= real - 1) ventana.scrollLeft -= real;
      }, 120);
    });
    window.addEventListener('resize', pintar);

    pintar();
  }

  // Acordeones y filas de cuidado: apertura independiente, sin exclusivos.
  document.querySelectorAll<HTMLButtonElement>('[data-acc-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const body = btn.nextElementSibling as HTMLElement | null;
      if (!body) return;
      const willOpen = body.hidden;
      body.hidden = !willOpen;
      // La clase de entrada solo al abrir con clic: los acordeones abiertos
      // por defecto no deben animar durante la carga de la pagina.
      body.classList.toggle('acc-entra', willOpen);
      btn.classList.toggle('open', willOpen);
      btn.setAttribute('aria-expanded', String(willOpen));
    });
  });
  // Estado inicial de los abiertos por defecto (Descripcion).
  document.querySelectorAll<HTMLButtonElement>('[data-acc-toggle][aria-expanded="true"]').forEach((btn) => {
    btn.classList.add('open');
  });

  // Agregar al carrito con confirmacion de 1.6 s (diseno).
  const addBtn = document.querySelector<HTMLButtonElement>('.add-to-cart');
  addBtn?.addEventListener('click', () => {
    const d = addBtn.dataset;
    addToCart({
      sku: d.sku!,
      name: d.name!,
      price: Number(d.price),
      slug: d.slug!,
      category: d.category!,
      emoji: d.emoji!,
      image: d.image || undefined,
    });
    addBtn.textContent = 'Agregado al carrito ✓';
    setTimeout(() => {
      addBtn.textContent = d.label!;
    }, 1600);
  });

  // Vistos recientemente y corazon de favoritos (panel de cuenta del header).
  // Los datos del producto salen del boton de agregar, que ya los trae todos.
  if (addBtn) {
    const d = addBtn.dataset;
    const producto = {
      sku: d.sku!,
      name: d.name!,
      price: Number(d.price),
      slug: d.slug!,
      category: d.category!,
      emoji: d.emoji!,
      image: d.image || undefined,
    };
    recordarVisto(producto);
    const favBtn = document.querySelector<HTMLButtonElement>('[data-fav-btn]');
    if (favBtn) {
      favBtn.classList.toggle('activo', esFavorito(producto.sku));
      favBtn.addEventListener('click', () => {
        favBtn.classList.toggle('activo', toggleFavorito(producto));
      });
    }
  }

  // Producto agotado: el aviso de disponibilidad se coordina por WhatsApp
  // (no hay backend de correos todavia).
  const notifyForm = document.querySelector<HTMLFormElement>('[data-notify-form]');
  notifyForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const email = (notifyForm.querySelector('input[name="email"]') as HTMLInputElement).value;
    const msg = `Hola, avísenme cuando "${notifyForm.dataset.product}" vuelva a estar disponible. Mi correo: ${email}`;
    window.open(
      `https://wa.me/${notifyForm.dataset.wa}?text=${encodeURIComponent(msg)}`,
      '_blank',
      'noopener',
    );
  });
</script>

<style>
  /* Bloque superior */
  .product-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 460px);
    /* La fila 1 mide lo que mide la galeria; el resto del panel derecho cae
       en la fila 2, donde la descripcion arranca pegada a la foto. */
    grid-template-rows: auto 1fr;
    gap: 46px;
    align-items: start;
    padding-top: 27.6px;
    /* poco aire abajo: "Te podrian gustar" va pegado al bloque del producto */
    padding-bottom: 18.4px;
  }

  .gallery {
    display: grid;
    /* El carril de miniaturas se angosta junto con la ventana (25vw - 148px
       es el ancho con el que tres miniaturas cuadradas caben exactamente al
       costado de la foto 1:1), asi TODAS se achican parejas en vez de quedar
       fijas en 88px y desbordar de a una. */
    --carril: clamp(48px, 25vw - 148px, 88px);
    grid-template-columns: var(--carril) minmax(0, 1fr);
    gap: 14px;
    position: relative;
  }

  /* Absoluto sobre el carril: si fuera parte de la fila del grid, la fila
     creceria hasta las miniaturas; asi la altura la manda SOLO la foto y las
     miniaturas se reparten esa altura en partes iguales. */
  .thumbs {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--carril);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    min-height: 0;
    overflow-y: auto;
    padding-bottom: 2px;
  }

  .thumb {
    /* Base 88px pero con permiso de encoger: si hay mas miniaturas que
       altura de foto, todas ceden por igual (siempre cuadradas). */
    flex: 0 1 88px;
    min-height: 36px;
    padding: 0;
    cursor: pointer;
    width: auto;
    max-width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 14px;
    overflow: hidden;
    background: var(--surface-2);
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .thumb.active { border: 2px solid var(--green); }

  /* Producto sin fotos: no hay carril de miniaturas, el marco del emoji
     ocupa todo el ancho de la columna. */
  .gallery--sin-fotos { grid-template-columns: minmax(0, 1fr); }
  .gallery--sin-fotos .main-photo { grid-column: 1; }

  .main-photo {
    /* Con las miniaturas fuera de flujo, la foto se auto-colocaria en la
       columna del carril; va explicita en la segunda. Marco cuadrado (como
       la tarjeta en produccion); la foto viaja entera y el navegador centra
       el recorte — el ajuste fino por foto se hace en la herramienta. */
    grid-column: 2;
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-photo);
    overflow: hidden;
    background: var(--surface-2);
    outline: 1px solid rgba(27, 42, 31, 0.12);
  }

  .main-photo-ph {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 5rem;
    background: var(--surface-2);
  }

  /* Miniaturas con foto real: sin numero, la imagen llena el boton. */
  .thumb--foto { overflow: hidden; }

  /* Marcador de la foto principal pendiente: el emoji como miniatura 1. */
  .thumb--emoji { font-size: 1.9rem; }

  /* Carrusel de similares: fila plana de tarjetas del tamano del catalogo
     (4 por pagina en escritorio, 2 en movil), flechas en los bordes y
     puntos por pagina debajo, como los carruseles de tienda clasicos. */
  .similares-section { padding-top: 0; }

  .similares-title { font-size: 27px; margin: 0 0 1.15rem; }

  .carrusel {
    position: relative;
    padding-bottom: 2.1rem;
  }

  /* Scroller nativo con snap: interrumpible, con inercia en tactil, y sin
     barra visible (las flechas y el dedo son el control). */
  .carrusel-ventana {
    display: flex;
    gap: 1.15rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .carrusel-ventana::-webkit-scrollbar { display: none; }

  .carrusel-ventana:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 4px;
    border-radius: var(--radius-lg);
  }

  .lamina {
    /* Un poco mas chicas que las del catalogo: cinco por pagina. */
    flex: 0 0 calc((100% - 4 * 1.15rem) / 5);
    min-width: 0;
    scroll-snap-align: start;
  }

  .sim-arrow {
    position: absolute;
    /* Centrado sobre la zona de la foto (la tarjeta es foto 4:5 + texto). */
    top: calc((100% - 2.1rem) / 2);
    transform: translateY(-50%);
    z-index: 4;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: #ffffff;
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(27, 42, 31, 0.18);
    transition: background 150ms ease, opacity 150ms ease, transform 160ms var(--ease-out);
  }

  .sim-arrow:hover { background: var(--bg); }

  /* La flecha ya vive con translateY(-50%): la presion lo conserva. */
  .sim-arrow:active { transform: translateY(-50%) scale(0.94); }

  .sim-arrow[hidden] { display: none; }

  .sim-arrow--prev { left: -8px; }
  .sim-arrow--next { right: -8px; }

  .similares-dots {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
  }

  .similares-dots[hidden] { display: none; }

  .similares-dots :global(button) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 0;
    padding: 0;
    background: var(--line-strong);
    cursor: pointer;
    transition: background 150ms ease, transform 200ms var(--ease-out);
  }

  .similares-dots :global(button[aria-selected='true']) {
    background: var(--green-deep);
    transform: scale(1.35);
  }

  @media (max-width: 768px) {
    /* En movil manda el dedo: dos tarjetas por pagina con un asomo de la
       tercera (invita a deslizar) y sin flechas. */
    .carrusel-ventana { gap: 0.7rem; }
    .lamina { flex-basis: calc((100% - 2 * 0.7rem) / 2.35); }
    .sim-arrow { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sim-arrow:active { transform: translateY(-50%); }
  }

  .main-photo-num {
    position: absolute;
    top: 12px;
    right: 14px;
    font-size: 11px;
    color: rgba(27, 42, 31, 0.5);
    font-variant-numeric: tabular-nums;
  }

  .soldout-stamp {
    position: absolute;
    top: 16px;
    left: 16px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 7px 14px;
    border-radius: 999px;
    background: rgba(27, 42, 31, 0.85);
    color: #eef5f0;
  }

  .photo-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 0;
    background: rgba(255, 255, 255, 0.9);
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .photo-arrow:hover { background: #ffffff; }
  .photo-arrow--prev { left: 14px; }
  .photo-arrow--next { right: 14px; }

  /* Panel derecho */
  .breadcrumb {
    font-size: 12px;
    color: rgba(27, 42, 31, 0.6);
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
  }

  .breadcrumb a { color: rgba(27, 42, 31, 0.6); display: inline-flex; }

  h1 {
    font-size: 40px;
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .scientific {
    font-size: 15px;
    font-style: italic;
    color: var(--ink-soft);
    margin-top: 6px;
  }

  .price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 18.4px;
  }

  .price-group {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  .compare {
    font-size: 17px;
    color: rgba(27, 42, 31, 0.5);
    text-decoration: line-through;
    font-variant-numeric: tabular-nums;
  }

  /* Sin precio real en Odoo: "Próximamente" ocupa el lugar del precio. */
  .price-soon {
    color: var(--ink-faint);
  }

  .price-group [hidden] {
    display: none;
  }

  /* Corazon de favoritos junto al precio. */
  .fav-btn {
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 50%;
    border: 1px solid rgba(27, 42, 31, 0.2);
    background: #ffffff;
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .fav-btn:hover { border-color: var(--green-deep); color: var(--green-deep); }

  .fav-btn.activo { color: var(--green-deep); border-color: var(--green-deep); }

  .fav-btn.activo :global(svg) { fill: currentColor; }

  .price { font-size: 26px; font-weight: 600; font-variant-numeric: tabular-nums; }

  .rule { height: 1px; border: 0; background: var(--line); margin: 22px 0; }
  .rule--flush { margin: 0; }

  /* Variantes */
  .variant-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .variant-title { font-size: 15px; font-weight: 600; }
  .variant-title--gap { margin-top: 22px; }

  .size-guide {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-ui);
    font-size: 13px;
    color: var(--green-deep);
    background: transparent;
    border: 0;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .size-guide:disabled { cursor: not-allowed; }

  .sizes { display: flex; gap: 12px; margin-top: 12px; flex-wrap: wrap; }

  .size-circle {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    font-family: var(--font-ui);
    font-size: 14px;
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--line-strong);
    cursor: pointer;
