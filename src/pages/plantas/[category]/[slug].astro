---
// Pagina de producto del handoff (Producto.dc.html): galeria con miniaturas,
// panel con variantes, acordeones, guia de cuidado, "Va bien con…" y resenas.
// La logica integrada se conserva: StockBadge con data-sku (stock proxy),
// catalogo en src/data/products.ts y carrito en src/lib/cart.
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import ProductCard from '../../../components/ProductCard.astro';
import StockBadge from '../../../components/StockBadge.astro';
import { compareAtPrice, formatPrice, getCategory, products } from '../../../data/products';
import { SITE } from '../../../lib/site';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { category: product.category, slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const category = getCategory(product.category)!;
const soldOut = product.available <= 0;
const lowStock = !soldOut && product.available <= 5;
const compareAt = soldOut ? null : compareAtPrice(product);
const whatsappMessage = `Hola, me interesa "${product.name}" (${product.sku}) que vi en plantaspanama.com.`;

// "Va bien con…": prioriza la misma categoria y excluye agotadas (diseno).
const related = products
  .filter((p) => p.slug !== product.slug && p.available > 0)
  .sort((a, b) => Number(b.category === product.category) - Number(a.category === product.category))
  .slice(0, 5);

const GALLERY_SIZE = 5;

// Fotos reales de la galeria (principal + la de estudio del hover + las
// adicionales). Si el producto aun no tiene fotos, quedan los huecos.
const fotosGaleria = [product.image, product.imageHover, ...(product.gallery ?? [])].filter(
  (f): f is string => Boolean(f),
);

// Fotos "de clientes" del bloque de resenas: primero las adicionales (tomas
// de ambiente) y luego el resto de la galeria, hasta seis.
const fotosResenas = [...(product.gallery ?? []), product.image, product.imageHover]
  .filter((f): f is string => Boolean(f))
  .slice(0, 6);

// Similares para el slider "Te podrian gustar": misma categoria primero,
// 9 en total (tres paginas de tres tarjetas). No se filtra por available
// porque en los datos estaticos siempre es 0: el stock real lo pinta el
// proxy en el navegador sobre cada tarjeta.
const similares = products
  .filter((p) => p.slug !== product.slug)
  .sort((a, b) => Number(b.category === product.category) - Number(a.category === product.category))
  .slice(0, 9);

const SIZES = [
  { key: 'S', label: 'Pequeña — matera 6"' },
  { key: 'M', label: 'Mediana — matera 8"' },
  { key: 'L', label: 'Grande — matera 10"' },
  { key: 'XL', label: 'Extra grande — matera 14"' },
];

const POT_COLORS = [
  { key: 'coco', swatch: '#efe7dc' },
  { key: 'piedra', swatch: '#b9b7b1' },
  { key: 'terracota', swatch: '#c9765a' },
  { key: 'arena', swatch: '#dcb98a' },
];

// Detalle de luz derivado del texto real del catalogo (sin inventar por planta).
const light = product.care.light;
const lightDetail = /baja/i.test(light)
  ? 'Aguanta pasillos, baños y oficinas con luz de vidrio polarizado. Mientras menos luz, menos riego.'
  : /indirecta/i.test(light)
    ? 'Cerca de una ventana con luz filtrada. Evita el sol directo del mediodía sobre las hojas.'
    : 'En Panamá funciona mejor el sol de la mañana; la tarde fuerte puede quemar el follaje.';

const waterDetailByDifficulty: Record<string, string> = {
  Facil: 'Riega cuando las primeras dos pulgadas de tierra estén secas. Perdona el olvido de una semana.',
  Media: 'Riega al pie, no sobre las hojas, temprano en la mañana. En verano puede necesitar riego diario.',
  Exigente: 'Mantén el sustrato húmedo sin encharcar y revísalo cada dos días. No tolera secarse por completo.',
};

const careRows = [
  { key: 'luz', icon: 'sun', label: 'Luz', value: product.care.light, detail: lightDetail },
  {
    key: 'riego',
    icon: 'droplets',
    label: 'Riego',
    value: product.care.water,
    detail: waterDetailByDifficulty[product.care.difficulty],
  },
  {
    key: 'humedad',
    icon: 'waves',
    label: 'Humedad',
    value: 'Media–alta',
    detail:
      'Tolera bien la humedad del istmo si tiene circulación de aire. Evita rincones cerrados sin ventilación.',
  },
  {
    key: 'temp',
    icon: 'thermometer',
    label: 'Temperatura',
    value: '18–32 °C',
    detail:
      'Sin problemas en clima panameño todo el año. Si vive con aire acondicionado, aléjala de la salida de aire.',
  },
  {
    key: 'suelo',
    icon: 'shovel',
    label: 'Suelo',
    value: 'Bien drenado',
    detail: 'Mezcla de tierra negra con arena y materia orgánica. El agua estancada pudre la raíz.',
  },
  {
    key: 'abono',
    icon: 'sprout',
    label: 'Abono',
    value: 'Cada 3 semanas',
    detail: 'Abono granulado de liberación lenta durante la temporada de crecimiento.',
  },
  {
    key: 'poda',
    icon: 'scissors',
    label: 'Poda',
    value: 'Mensual',
    detail: 'Corta hojas secas y ramas cruzadas para mantener la forma y estimular brotes nuevos.',
  },
  {
    key: 'trasplante',
    icon: 'flower-2',
    label: 'Trasplante',
    value: 'Cada 2 años',
    detail: 'Pasa a una matera dos pulgadas más ancha al inicio de la temporada de lluvias.',
  },
] as const;

const accordions = [
  {
    key: 'desc',
    title: 'Descripción',
    open: true,
    body: `${product.description} Cultivada en nuestro vivero de Juan Díaz y entregada en matera de vivero, lista para sembrar o pasar a una matera decorativa. La despachamos con el cepellón húmedo y protegido para que llegue igual que salió del vivero.`,
  },
  {
    key: 'cuidado',
    title: 'Guía de cuidado',
    open: false,
    body: `${lightDetail} ${waterDetailByDifficulty[product.care.difficulty]} El detalle completo, riego por riego, está más abajo en la guía de cuidado.`,
  },
  {
    key: 'envio',
    title: 'Entrega y garantía',
    open: false,
    body: 'Entregamos en Ciudad de Panamá en 24 a 48 horas (envío estándar $3.00; también hay entrega express y retiro gratis en el vivero). Fuera de la ciudad coordinamos por WhatsApp. Si la planta llega dañada, mándanos una foto dentro de los primeros 30 días y la reponemos.',
  },
  {
    key: 'resenas',
    title: 'Reseñas y fotos de clientes (4.8 de 128 reseñas)',
    open: false,
    body: 'Las reseñas verificadas y las fotos que nos envían los clientes están al final de la página.',
  },
];

const careTitle = `Cuidado de ${product.name.replace(/\s*\(.*\)$/, '').toLowerCase()}`;

const ratingBars = [
  { stars: '5★', pct: 88 },
  { stars: '4★', pct: 7 },
  { stars: '3★', pct: 3 },
  { stars: '2★', pct: 1 },
  { stars: '1★', pct: 1 },
];

const reviews = [
  {
    n: 5,
    date: 'hace 4 días',
    name: 'Marielena C.',
    text: 'Llegó impecable a Costa del Este, bien empacada y en muy buen estado. Se ve exactamente como en las fotos.',
    gift: 'No',
    level: 'Principiante',
    place: 'Terraza',
  },
  {
    n: 5,
    date: 'hace 2 semanas',
    name: 'José R.',
    text: 'Compré seis para la jardinera del frente y todas pegaron. El equipo me explicó por WhatsApp cómo prepararle el suelo, buenísima atención.',
    gift: 'No',
    level: 'Jardinera',
    place: 'Jardín',
  },
  {
    n: 4,
    date: 'hace 1 mes',
    name: 'Ana P.',
    text: 'La regalé para el cumpleaños de mi mamá con la tarjeta personalizada. Le encantó. Le quito una estrella porque llegó al final de la ventana de entrega.',
    gift: 'Sí',
    level: 'Intermedia',
    place: 'Balcón',
  },
];

const STAR_PATH =
  'M12 2.6l2.9 5.9 6.5.95-4.7 4.58 1.11 6.47L12 17.45 6.19 20.5l1.11-6.47-4.7-4.58 6.5-.95z';
---

<Base title={product.name} description={product.description} whatsappMessage={whatsappMessage}>
  <div class="container product-hero">
    <div class="gallery">
      <div class="thumbs" data-thumbs>
        {
          fotosGaleria.length
            ? fotosGaleria.map((foto, i) => (
                <button
                  class:list={['thumb', 'thumb--foto', { active: i === 0 }]}
                  data-thumb={i}
                  data-foto={foto}
                  style={`background-image: url('${foto}'); background-size: cover; background-position: center;`}
                  aria-label={`Ver foto ${i + 1}`}
                />
              ))
            : Array.from({ length: GALLERY_SIZE }, (_, i) => (
                <button
                  class:list={['thumb', { active: i === 0 }]}
                  data-thumb={i}
                  aria-label={`Ver foto ${i + 1}`}
                >
                  <span class="thumb-num">{i + 1}</span>
                </button>
              ))
        }
      </div>
      <div class="main-photo">
        <div
          class="main-photo-ph"
          data-medidas={fotosGaleria.length ? undefined : 'Foto cuadrada · 1200×1200'}
          data-main-photo
          style={
            fotosGaleria.length
              ? `background-image: url('${fotosGaleria[0]}'); background-size: cover; background-position: center;`
              : undefined
          }
        >
          {fotosGaleria.length ? '' : product.emoji}
          <span class="main-photo-num" data-main-num>Foto 1 de {fotosGaleria.length || GALLERY_SIZE}</span>
        </div>
        {soldOut && <div class="soldout-stamp">Agotado</div>}
        <button class="photo-arrow photo-arrow--prev" data-gallery-prev aria-label="Foto anterior">
          <Icon name="chevron-left" size={20} />
        </button>
        <button class="photo-arrow photo-arrow--next" data-gallery-next aria-label="Foto siguiente">
          <Icon name="chevron-right" size={20} />
        </button>
      </div>
    </div>

    <div class="panel-col">
      <nav class="breadcrumb" aria-label="Miga de pan">
        <a href="/" aria-label="Inicio"><Icon name="home" size={15} /></a>
        <span>›</span>
        <a href={`/plantas/${category.slug}`}>{category.name}</a>
      </nav>

      <h1>{product.name}</h1>
      {product.scientificName && <div class="scientific">{product.scientificName}</div>}

      <div class="price-row">
        <div class="price-group">
          <StockBadge sku={product.sku} available={product.available} />
          {compareAt && <span class="compare">{formatPrice(compareAt)}</span>}
          <span class="price">{formatPrice(product.price)}</span>
        </div>
        <a href="#resenas" class="rating-link">
          <span class="stars stars--sm" aria-hidden="true">
            {Array.from({ length: 5 }, () => (
              <svg viewBox="0 0 24 24" width="15" height="15"><path d={STAR_PATH} /></svg>
            ))}
          </span>
          <span>128 reseñas</span>
        </a>
      </div>

      {
        lowStock && (
          <div class="low-stock">
            <Icon name="alert-circle" size={17} />
            Quedan {product.available}
            {product.available === 1 ? ' unidad en el vivero' : ' unidades en el vivero'}
          </div>
        )
      }

      <hr class="rule" />

      <div class="variant-head">
        <div class="variant-title">Tamaño — Mediana — matera 8"</div>
        <button class="size-guide" type="button" disabled title="No disponible por ahora">
          Guía de tamaños <Icon name="ruler" size={15} />
        </button>
      </div>
      <div class="sizes">
        {
          SIZES.map((s) => (
            <button
              class:list={['size-circle', { active: s.key === 'M' }]}
              disabled={s.key !== 'M'}
              title={s.key !== 'M' ? 'No disponible por ahora' : s.label}
            >
              {s.key}
            </button>
          ))
        }
      </div>

      <div class="variant-title variant-title--gap">Maceta — De vivero</div>
      <div class="pots">
        <button class="pot" disabled title="No disponible por ahora">
          <span class="pot-circle"><Icon name="flower-2" size={20} /></span>
          <span>De vivero</span>
        </button>
        <button class="pot" disabled title="No disponible por ahora">
          <span class="pot-circle"><Icon name="cup-soda" size={20} /></span>
          <span>Cerámica</span>
        </button>
      </div>

      <div class="variant-title variant-title--gap">Color de maceta — De vivero</div>
      <div class="pot-colors">
        {
          POT_COLORS.map((c) => (
            <button
              class="pot-color"
              disabled
              title="No disponible por ahora"
              aria-label={`Color ${c.key}`}
              style={`background: linear-gradient(to top left, transparent calc(50% - 1px), rgba(27,42,31,0.55) calc(50% - 1px), rgba(27,42,31,0.55) calc(50% + 1px), transparent calc(50% + 1px)), ${c.swatch};`}
            />
          ))
        }
      </div>

      <div class="assurances">
        <div><Icon name="gift" size={18} class="assure-icon" /> Opciones de regalo disponibles en el carrito</div>
        <div><Icon name="shield-check" size={18} class="assure-icon" /> Garantía de 30 días: llega sana o la reponemos</div>
        {
          product.petFriendly !== undefined && (
            <div>
              <Icon name={product.petFriendly ? 'paw-print' : 'alert-triangle'} size={18} class="assure-icon" />
              {product.petFriendly
                ? 'Apta para hogares con mascotas'
                : 'No apta para mascotas: mantenla fuera de su alcance'}
            </div>
          )
        }
      </div>

      {
        !soldOut ? (
          <div class="cta-block">
            <button class="cta-outline" type="button" disabled title="No disponible por ahora">
              <Icon name="pencil" size={16} /> Personalizar tarjeta (+$5.00)
            </button>
            <button
              class="cta-add add-to-cart"
              data-sku={product.sku}
              data-name={product.name}
              data-price={product.price}
              data-slug={product.slug}
              data-category={product.category}
              data-emoji={product.emoji}
              data-label={`Agregar al carrito — ${formatPrice(product.price)}`}
            >
              Agregar al carrito — {formatPrice(product.price)}
            </button>
          </div>
        ) : (
          <div class="soldout-box">
            <div class="soldout-title">Esta planta está agotada</div>
            <p>
              Sembramos tandas nuevas cada mes. Déjanos tu correo y te avisamos apenas vuelva al
              vivero.
            </p>
            <form data-notify-form data-wa={SITE.whatsappNumber} data-product={`${product.name} (${product.sku})`}>
              <input type="email" name="email" placeholder="Tu correo" required />
              <button type="submit">Avísame</button>
            </form>
            <a href="#similares" class="soldout-link">Ver plantas similares disponibles</a>
          </div>
        )
      }

      <div class="shipping-line">
        <Icon name="truck" size={18} class="assure-icon" />
        {soldOut ? 'Sembramos tandas nuevas cada mes' : 'Entrega en Ciudad de Panamá en 24–48 h'}
      </div>
    </div>
  </div>

  <!-- Slider "Te podrian gustar": 3 tarjetas visibles y flechas para pasar
       a las siguientes; el enlace del agotado baja hasta aqui. -->
  {
    similares.length > 0 && (
      <section id="similares" class="container similares-section">
        <h2 class="similares-title">Te podrían gustar</h2>
        <div class="similares-wrap">
          <button type="button" class="sim-arrow sim-arrow--prev" data-sim-prev aria-label="Ver anteriores">
            <Icon name="chevron-left" size={20} />
          </button>
          <div class="similares-track" data-sim-track>
            {similares.map((p) => (
              <div class="similares-item">
                <ProductCard product={p} />
              </div>
            ))}
          </div>
          <button type="button" class="sim-arrow sim-arrow--next" data-sim-next aria-label="Ver siguientes">
            <Icon name="chevron-right" size={20} />
          </button>
        </div>
        <div class="similares-dots" data-sim-dots></div>
      </section>
    )
  }

  <section class="container accordion-section">
    {
      accordions.map((acc) => (
        <div class="acc">
          <button class="acc-toggle" data-acc-toggle aria-expanded={acc.open ? 'true' : 'false'}>
            {acc.title}
            <span class="when-closed"><Icon name="chevron-down" size={20} class="acc-chev" /></span>
            <span class="when-open"><Icon name="chevron-up" size={20} class="acc-chev" /></span>
          </button>
          <div class="acc-body" hidden={!acc.open}>
            {acc.body}
          </div>
        </div>
      ))
    }
    <hr class="rule rule--flush" />
  </section>

  <section class="container care-section">
    <h2>{careTitle}</h2>
    <div class="care-grid">
      <div
        class="care-photo"
        data-medidas={product.image ? undefined : 'Foto cuadrada · 800×800'}
        style={
          product.image
            ? `background-image: url('${product.image}'); background-size: cover; background-position: center;`
            : undefined
        }
      >
        {product.image ? '' : product.emoji}
      </div>
      <div>
        {
          careRows.map((row) => (
            <div class="care-row">
              <button class="care-toggle" data-acc-toggle aria-expanded="false">
                <Icon name={row.icon} size={20} class="care-icon" />
                <span class="care-label">{row.label}</span>
                <span class="care-value">{row.value}</span>
                <span class="when-closed"><Icon name="chevron-down" size={18} class="acc-chev" /></span>
                <span class="when-open"><Icon name="chevron-up" size={18} class="acc-chev" /></span>
              </button>
              <div class="care-detail" hidden>
                {row.detail}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container related-section">
    <h2>Va bien con…</h2>
    <div class="related-grid">
      {related.map((p) => <ProductCard product={p} />)}
    </div>
  </section>

  <section id="resenas" class="container reviews-section">
    <h2>Reseñas de clientes</h2>
    <hr class="rule rule--flush reviews-rule" />

    <div class="reviews-top">
      <div>
        <div class="score-row">
          <div class="score">4.8</div>
          <div class="score-of">/ 5</div>
          <div>
            <span class="stars stars--lg" aria-hidden="true">
              {Array.from({ length: 5 }, () => (
                <svg viewBox="0 0 24 24" width="20" height="20"><path d={STAR_PATH} /></svg>
              ))}
            </span>
            <div class="score-count">128 reseñas</div>
          </div>
        </div>
        <div class="bars">
          {
            ratingBars.map((bar) => (
              <div class="bar-row">
                <span>{bar.stars}</span>
                <span class="bar-track">
                  <span class="bar-fill" style={`width: ${bar.pct}%`} />
                </span>
                <span class="bar-pct">{bar.pct}%</span>
              </div>
            ))
          }
        </div>
      </div>
      <div class="review-photos">
        {
          fotosResenas.length
            ? fotosResenas.map((foto) => (
                <div
                  class="review-photo"
                  style={`background-image: url('${foto}'); background-size: cover; background-position: center;`}
                />
              ))
            : Array.from({ length: 6 }, (_, i) => <div class="review-photo" data-n={i + 1} />)
        }
      </div>
    </div>

    <div class="review-questions">
      <div>
        <div class="rq-title">¿Fue un regalo?</div>
        <div class="rq-body">Sí (31) · No (18)</div>
      </div>
      <div>
        <div class="rq-title">¿Cuánta experiencia tienes con plantas?</div>
        <div class="rq-body">Principiante (22) · Intermedia (14) · Jardinera (9)</div>
      </div>
      <div>
        <div class="rq-title">¿Dónde vive tu planta?</div>
        <div class="rq-body">Jardín (19) · Terraza (12) · Balcón (7) · Oficina (4)</div>
      </div>
    </div>

    <div class="reviews-tabbar">
      <div class="reviews-tab">
        <span class="reviews-tab-name">Reseñas</span>
        <span class="reviews-tab-count">128</span>
      </div>
      <a
        href={`https://wa.me/${SITE.whatsappNumber}?text=${encodeURIComponent(`Hola, quiero dejar una reseña de "${product.name}".`)}`}
        class="write-review"
        target="_blank"
        rel="noopener">Escribir una reseña</a
      >
    </div>

    <div class="review-filters">
      <form class="review-search" onsubmit="return false">
        <Icon name="search" size={15} class="review-search-icon" />
        <input type="search" placeholder="Buscar reseñas" aria-label="Buscar reseñas" />
      </form>
      <button class="review-chip" type="button" disabled title="No disponible por ahora">Más relevantes</button>
      <button class="review-chip" type="button" disabled title="No disponible por ahora">Todas las estrellas</button>
      <button class="review-chip" type="button" disabled title="No disponible por ahora">Con fotos</button>
      <button class="review-chip" type="button" disabled title="No disponible por ahora">Más filtros</button>
    </div>

    <div class="review-list">
      {
        reviews.map((review) => (
          <div class="review">
            <div class="review-head">
              <span class="stars stars--md" aria-hidden="true">
                {Array.from({ length: 5 }, (_, i) => (
                  <svg viewBox="0 0 24 24" width="16" height="16" style={i < review.n ? '' : 'opacity:0.25'}>
                    <path d={STAR_PATH} />
                  </svg>
                ))}
              </span>
              <span class="review-date">{review.date}</span>
            </div>
            <div class="review-byline">
              <span class="review-name">{review.name}</span>
              <span class="verified">
                <Icon name="badge-check" size={15} class="verified-icon" /> Compra verificada
              </span>
            </div>
            <p class="review-text">{review.text}</p>
            <div class="review-meta">
              <div>
                <div class="rq-title">¿Fue un regalo?</div>
                <div class="rq-body">{review.gift}</div>
              </div>
              <div>
                <div class="rq-title">Experiencia</div>
                <div class="rq-body">{review.level}</div>
              </div>
              <div>
                <div class="rq-title">¿Dónde vive?</div>
                <div class="rq-body">{review.place}</div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Base>

<script>
  import { addToCart } from '../../../lib/cart';

  // Galeria: miniatura activa y flechas en bucle. Si la miniatura trae foto
  // real (data-foto), se intercambia tambien la imagen principal.
  const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-thumb]'));
  const mainNum = document.querySelector<HTMLElement>('[data-main-num]');
  const mainPhoto = document.querySelector<HTMLElement>('[data-main-photo]');
  let current = 0;

  function selectPhoto(index: number) {
    current = (index + thumbs.length) % thumbs.length;
    thumbs.forEach((t, i) => t.classList.toggle('active', i === current));
    if (mainNum) mainNum.textContent = `Foto ${current + 1} de ${thumbs.length}`;
    const foto = thumbs[current]?.dataset.foto;
    if (foto && mainPhoto) mainPhoto.style.backgroundImage = `url('${foto}')`;
  }

  thumbs.forEach((t, i) => t.addEventListener('click', () => selectPhoto(i)));
  document.querySelector('[data-gallery-prev]')?.addEventListener('click', () => selectPhoto(current - 1));
  document.querySelector('[data-gallery-next]')?.addEventListener('click', () => selectPhoto(current + 1));

  // Slider de similares: las flechas avanzan una "pagina" (ancho visible +
  // gap) y las bolitas marcan la pagina activa y navegan al tocarlas.
  const simTrack = document.querySelector<HTMLElement>('[data-sim-track]');
  const simDots = document.querySelector<HTMLElement>('[data-sim-dots]');
  const pasoSimilares = () =>
    simTrack ? simTrack.clientWidth + parseFloat(getComputedStyle(simTrack).columnGap || '0') : 0;

  function pintarBolitas() {
    if (!simTrack || !simDots) return;
    const paso = pasoSimilares();
    const gap = parseFloat(getComputedStyle(simTrack).columnGap || '0');
    // El -0.02 evita una pagina fantasma por redondeo de subpixeles.
    const paginas = Math.max(1, Math.ceil((simTrack.scrollWidth + gap) / paso - 0.02));
    const activa = Math.min(paginas - 1, Math.round(simTrack.scrollLeft / paso));
    if (simDots.children.length !== paginas) {
      simDots.innerHTML = '';
      for (let i = 0; i < paginas; i++) {
        const bolita = document.createElement('button');
        bolita.type = 'button';
        bolita.setAttribute('aria-label', `Ir a la página ${i + 1}`);
        bolita.addEventListener('click', () =>
          simTrack!.scrollTo({ left: i * pasoSimilares(), behavior: 'smooth' }),
        );
        simDots.appendChild(bolita);
      }
    }
    Array.from(simDots.children).forEach((d, i) => d.classList.toggle('active', i === activa));
  }

  document.querySelector('[data-sim-prev]')?.addEventListener('click', () => {
    simTrack?.scrollBy({ left: -pasoSimilares(), behavior: 'smooth' });
  });
  document.querySelector('[data-sim-next]')?.addEventListener('click', () => {
    simTrack?.scrollBy({ left: pasoSimilares(), behavior: 'smooth' });
  });
  simTrack?.addEventListener('scroll', pintarBolitas, { passive: true });
  window.addEventListener('resize', pintarBolitas);
  pintarBolitas();

  // Acordeones y filas de cuidado: apertura independiente, sin exclusivos.
  document.querySelectorAll<HTMLButtonElement>('[data-acc-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const body = btn.nextElementSibling as HTMLElement | null;
      if (!body) return;
      const willOpen = body.hidden;
      body.hidden = !willOpen;
      btn.classList.toggle('open', willOpen);
      btn.setAttribute('aria-expanded', String(willOpen));
    });
  });
  // Estado inicial de los abiertos por defecto (Descripcion).
  document.querySelectorAll<HTMLButtonElement>('[data-acc-toggle][aria-expanded="true"]').forEach((btn) => {
    btn.classList.add('open');
  });

  // Agregar al carrito con confirmacion de 1.6 s (diseno).
  const addBtn = document.querySelector<HTMLButtonElement>('.add-to-cart');
  addBtn?.addEventListener('click', () => {
    const d = addBtn.dataset;
    addToCart({
      sku: d.sku!,
      name: d.name!,
      price: Number(d.price),
      slug: d.slug!,
      category: d.category!,
      emoji: d.emoji!,
    });
    addBtn.textContent = 'Agregado al carrito ✓';
    setTimeout(() => {
      addBtn.textContent = d.label!;
    }, 1600);
  });

  // Producto agotado: el aviso de disponibilidad se coordina por WhatsApp
  // (no hay backend de correos todavia).
  const notifyForm = document.querySelector<HTMLFormElement>('[data-notify-form]');
  notifyForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const email = (notifyForm.querySelector('input[name="email"]') as HTMLInputElement).value;
    const msg = `Hola, avísenme cuando "${notifyForm.dataset.product}" vuelva a estar disponible. Mi correo: ${email}`;
    window.open(
      `https://wa.me/${notifyForm.dataset.wa}?text=${encodeURIComponent(msg)}`,
      '_blank',
      'noopener',
    );
  });
</script>

