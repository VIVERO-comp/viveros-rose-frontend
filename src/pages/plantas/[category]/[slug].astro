    scroll-snap-align: start;
  }

  .sim-arrow {
    position: absolute;
    /* Centrado sobre la zona de la foto (la tarjeta es foto 4:5 + texto). */
    top: calc((100% - 2.1rem) / 2);
    transform: translateY(-50%);
    z-index: 4;
    width: 42px;
    height: 42px;
    border-radius: 50%;
