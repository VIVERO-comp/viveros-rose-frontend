  .carrusel {
    position: relative;
    padding-bottom: 2.1rem;
  }

  /* Scroller nativo con snap: interrumpible, con inercia en tactil, y sin
     barra visible (las flechas y el dedo son el control). */
  .carrusel-ventana {
    display: flex;
    gap: 1.15rem;
