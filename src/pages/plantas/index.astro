---
// Catalogo segun el diseno "Shop Plantas" (claude.ai/design): hero oscuro con
// miga de pan, sidebar de colecciones + filtros, orden y grilla de tarjetas.
// El filtrado corre en el cliente sobre los data-atributos de cada tarjeta
// (?c= coleccion, ?q= busqueda del navbar). El catalogo y los badges de stock
// no cambian: ProductCard/StockBadge siguen conectados por SKU al stock proxy.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import NewsletterBand from '../../components/NewsletterBand.astro';
import { collections, factsOf } from '../../data/collections';
import { productosPublicados } from '../../lib/catalogo-build';

// Catalogo publicado: sin los productos archivados en Odoo (filtro de build,
// src/lib/catalogo-build.ts).
const products = await productosPublicados();

// Orden del sidebar segun el diseno (Shop Plantas).
const sidebarSlugs = [
  'all',
  'mas-vendidas',
  'recien',
  'interior',
  'exterior',
  'florales',
  'pet-friendly',
  'faciles',
];
const sidebar = sidebarSlugs.map((slug) => collections.find((c) => c.slug === slug)!);

const popularSlugs = ['faciles', 'pet-friendly', 'florales', 'jardin', 'interior'];
const popular = popularSlugs.map((slug) => collections.find((c) => c.slug === slug)!);

// Paginacion: 16 visibles (4 filas de 4) antes del "Ver mas plantas".
const PAGE_SIZE = 16;
---

<Base
  title="Catálogo de plantas"
  description="Todas nuestras plantas disponibles: interior, exterior y florales, con disponibilidad real del vivero."
>
  <section class="shop-hero">
    <!-- La foto del hero es la de la coleccion activa; el script la cambia
         cuando se llega con ?c=. Por defecto, la de "Todas las plantas". -->
    <div class="shop-hero-photo" data-shop-hero-photo style="background-image: url('/fotos_colecciones/all.jpeg'); background-size: cover; background-position: center;" aria-hidden="true"></div>
    <div class="shop-hero-scrim" aria-hidden="true"></div>
    <div class="container shop-hero-inner">
      <p class="shop-crumb"><a href="/">Inicio</a> / Plantas</p>
      <h1 data-shop-title>Todas las plantas</h1>
      <p class="shop-sub" data-shop-sub>
        Cultivadas en nuestro vivero. Entrega a domicilio en la ciudad de Panamá.
      </p>
    </div>
  </section>

  <div class="container shop-layout">
    <aside class="shop-aside" data-shop-aside>
      <div class="aside-head">
        <span class="aside-head-title">Filtrar</span>
        <button type="button" class="aside-close" data-aside-close aria-label="Cerrar filtros">
          <Icon name="x" size={20} />
        </button>
      </div>

      <!-- Orden como chips (referencia Jomashop movil): solo se ve en la
           hoja del celular; en escritorio el orden sigue en el select de la
           toolbar. Los chips mueven ese mismo select. -->
      <div class="aside-sort">
        <p class="aside-title">Ordenar por</p>
        <div class="sort-chips">
          <button type="button" class="sort-chip active" data-sort-value="featured">Destacadas</button>
          <button type="button" class="sort-chip" data-sort-value="price-asc">Precio: menor a mayor</button>
          <button type="button" class="sort-chip" data-sort-value="price-desc">Precio: mayor a menor</button>
          <button type="button" class="sort-chip" data-sort-value="name">Nombre A–Z</button>
        </div>
      </div>

      <div>
        <p class="aside-title">Comprar por colección</p>
        <div class="aside-links">
          {sidebar.map((c) => (
            <a href={`/plantas?c=${c.slug}`} data-collection-link={c.slug}>{c.name}</a>
          ))}
          <a href="/colecciones" class="aside-all">Ver todas las colecciones</a>
        </div>
      </div>

      <hr class="aside-rule" />

      <div>
        <p class="aside-title">Filtrar por</p>
        <div class="filter-groups" data-filters>
          <div class="filter-group">
            <p class="filter-name"><Icon name="ruler" size={15} class="filter-icon" /> Tamaño</p>
            <label><input type="checkbox" data-filter="size" value="pequena" /> Pequeña</label>
            <label><input type="checkbox" data-filter="size" value="mediana" /> Mediana</label>
            <label><input type="checkbox" data-filter="size" value="grande" /> Grande</label>
          </div>
          <div class="filter-group">
            <p class="filter-name"><Icon name="paw-print" size={15} class="filter-icon" /> Mascotas</p>
            <label><input type="checkbox" data-filter="pet" value="si" /> Solo aptas para mascotas</label>
          </div>
          <div class="filter-group">
            <p class="filter-name"><Icon name="sparkles" size={15} class="filter-icon" /> Nivel de cuidado</p>
            <label><input type="checkbox" data-filter="care" value="Facil" /> Fácil</label>
            <label><input type="checkbox" data-filter="care" value="Media" /> Media</label>
            <label><input type="checkbox" data-filter="care" value="Exigente" /> Exigente</label>
          </div>
          <div class="filter-group">
            <p class="filter-name"><Icon name="sun" size={15} class="filter-icon" /> Luz</p>
            <label><input type="checkbox" data-filter="light" value="sol" /> Sol pleno</label>
            <label><input type="checkbox" data-filter="light" value="indirecta" /> Luz indirecta</label>
            <label><input type="checkbox" data-filter="light" value="baja" /> Poca luz</label>
          </div>
          <div class="filter-group">
            <p class="filter-name"><Icon name="package-check" size={15} class="filter-icon" /> Disponibilidad</p>
            <label><input type="checkbox" data-filter="stock" value="in" /> Solo en stock</label>
          </div>
        </div>
        <button type="button" class="clear-filters" data-clear-filters hidden>Limpiar filtros</button>
      </div>
      <!-- Botonera fija abajo (referencia Jomashop movil): limpiar y cerrar. -->
      <div class="aside-actions">
        <button type="button" class="btn aside-limpiar" data-clear-filters>Limpiar todo</button>
        <button type="button" class="btn btn--green" data-aside-close>Listo</button>
      </div>
    </aside>

    <div class="shop-main">
      <div class="shop-toolbar">
        <p class="result-count" data-result-count>{products.length} plantas</p>
        <button type="button" class="filter-toggle" data-filter-toggle aria-expanded="false">
          <Icon name="sliders-horizontal" size={15} /> Filtrar
        </button>
        <!-- Alternador de vista del movil (referencia: 1 columna / grilla /
             lista); en escritorio no se muestra. -->
        <div class="view-toggles" role="group" aria-label="Vista de la grilla">
          <button type="button" data-view="1" aria-label="Una columna">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="4" width="14" height="16" rx="1.5"/></svg>
          </button>
          <button type="button" data-view="2" class="active" aria-label="Dos columnas">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="7" height="7" rx="1"/><rect x="13" y="4" width="7" height="7" rx="1"/><rect x="4" y="13" width="7" height="7" rx="1"/><rect x="13" y="13" width="7" height="7" rx="1"/></svg>
          </button>
          <button type="button" data-view="list" aria-label="Lista">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="6" height="6" rx="1"/><line x1="13" y1="6" x2="20" y2="6"/><line x1="13" y1="9" x2="18" y2="9"/><rect x="4" y="14" width="6" height="6" rx="1"/><line x1="13" y1="16" x2="20" y2="16"/><line x1="13" y1="19" x2="18" y2="19"/></svg>
          </button>
        </div>
        <div class="sort-row">
          <label for="sort" class="sort-label">Ordenar por</label>
          <select id="sort" data-sort>
            <option value="featured">Destacadas</option>
            <option value="price-asc">Precio: menor a mayor</option>
            <option value="price-desc">Precio: mayor a menor</option>
            <option value="name">Nombre A–Z</option>
          </select>
        </div>
      </div>

      <div class="grid grid--4 shop-grid" data-product-grid>
        {products.map((product, i) => {
          const f = factsOf(product);
          return (
            <div
              data-card
              data-index={i}
              data-name={f.name}
              data-category={f.category}
              data-care={f.care}
              data-light={f.light}
              data-available={f.available}
              data-price={f.price}
              data-size={f.size}
              data-pet={f.pet}
            >
              <ProductCard product={product} />
            </div>
          );
        })}
      </div>

      <div class="no-results" data-no-results hidden>
        <p>No hay plantas con esos filtros.</p>
        <button type="button" class="clear-filters" data-clear-filters>Quitar filtros</button>
      </div>

      <div class="show-more" data-show-more-wrap hidden>
        <button type="button" class="btn btn--green" data-show-more>Ver más plantas</button>
      </div>
    </div>
  </div>

  <section class="container popular">
    <hr class="popular-rule" />
    <h2>Colecciones populares</h2>
    <div class="popular-grid">
      {popular.map((c) => (
        <a href={`/plantas?c=${c.slug}`} class="popular-tile">
          <div
            class="popular-photo"
            style={c.image ? `background-image: url('${c.image}'); background-size: cover; background-position: center;` : undefined}
            aria-hidden="true"
          ></div>
          <span>{c.name}</span>
        </a>
      ))}
    </div>
  </section>

  <NewsletterBand />
</Base>

<script>
  import { getCollection } from '../../data/collections';

  const params = new URLSearchParams(window.location.search);
  const activeSlug = params.get('c') ?? 'all';
  const query = (params.get('q') ?? '').trim().toLowerCase();
  const collection = getCollection(activeSlug);

  // Titulo, subtitulo y enlace activo del sidebar segun la coleccion.
  const titleEl = document.querySelector('[data-shop-title]');
  const subEl = document.querySelector('[data-shop-sub]');
  if (collection.slug !== 'all' && titleEl && subEl) {
    titleEl.textContent = collection.name;
    subEl.textContent = collection.blurb;
  }
  // Foto del hero segun la coleccion activa (si la coleccion tiene foto).
  const heroPhoto = document.querySelector<HTMLElement>('[data-shop-hero-photo]');
  if (heroPhoto && collection.image) {
    heroPhoto.style.backgroundImage = `url('${collection.image}')`;
  }
  if (query && titleEl) {
    titleEl.textContent = `Resultados para “${query}”`;
  }
  document
    .querySelector(`[data-collection-link="${collection.slug}"]`)
    ?.classList.add('active');

  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card]'));
  const grid = document.querySelector<HTMLElement>('[data-product-grid]');
  const countEl = document.querySelector<HTMLElement>('[data-result-count]');
  const noResults = document.querySelector<HTMLElement>('[data-no-results]');
  const sortSelect = document.querySelector<HTMLSelectElement>('[data-sort]');
  const checks = Array.from(
    document.querySelectorAll<HTMLInputElement>('[data-filters] input[type="checkbox"]')
  );
  const clearButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-clear-filters]')
  );

  const showMoreWrap = document.querySelector<HTMLElement>('[data-show-more-wrap]');
  const showMoreBtn = document.querySelector<HTMLButtonElement>('[data-show-more]');

  // Paginacion: 16 visibles (4 filas de 4), "Ver mas plantas" agrega de a 16
  // y cualquier cambio de filtro reinicia a 16.
  const PAGE_SIZE = 16;
  let visibleCount = PAGE_SIZE;

  function factsFrom(card: HTMLElement) {
    return {
      name: card.dataset.name ?? '',
      category: card.dataset.category ?? '',
      care: card.dataset.care ?? '',
      light: card.dataset.light ?? '',
      available: Number(card.dataset.available ?? 0),
      price: Number(card.dataset.price ?? 0),
      size: card.dataset.size ?? '',
      pet: card.dataset.pet ?? '',
    };
  }

  function checkedValues(kind: string): string[] {
    return checks.filter((c) => c.dataset.filter === kind && c.checked).map((c) => c.value);
  }

  function apply() {
    const size = checkedValues('size');
    const petOnly = checkedValues('pet').length > 0;
    const care = checkedValues('care');
    const light = checkedValues('light');
    const inStockOnly = checkedValues('stock').length > 0;
    const hasFilters =
      size.length > 0 || petOnly || care.length > 0 || light.length > 0 || inStockOnly;

    // Se filtra en el orden actual del DOM (que refleja el orden elegido).
    const ordered = grid
      ? (Array.from(grid.children) as HTMLElement[]).filter((el) => el.matches('[data-card]'))
      : cards;

    let matches = 0;
    for (const card of ordered) {
      const f = factsFrom(card);
      let show = collection.test(f);
      if (show && query) show = f.name.toLowerCase().includes(query);
      if (show && size.length) show = size.includes(f.size);
      // Sin dato de mascotas no se asume nada: solo pasa el "si" explicito.
      if (show && petOnly) show = f.pet === 'si';
      if (show && care.length) show = care.includes(f.care);
      if (show && light.length) show = light.some((l) => f.light.toLowerCase().includes(l));
      if (show && inStockOnly) show = f.available > 0;
      if (show) {
        matches += 1;
        card.hidden = matches > visibleCount;
      } else {
        card.hidden = true;
      }
    }

    if (countEl) countEl.textContent = `${matches} ${matches === 1 ? 'planta' : 'plantas'}`;
    if (noResults) noResults.hidden = matches > 0;
    if (showMoreWrap) showMoreWrap.hidden = matches <= visibleCount;
    clearButtons.forEach((b) => {
      // El "Limpiar todo" de la botonera movil se muestra siempre (como el
      // Clear All de la referencia); solo el enlace del sidebar se esconde.
      if (b.closest('[data-no-results]') || b.classList.contains('aside-limpiar')) return;
      b.hidden = !hasFilters;
    });
  }

  function sortCards() {
    if (!grid || !sortSelect) return;
    const mode = sortSelect.value;
    const sorted = cards.slice().sort((a, b) => {
      const fa = factsFrom(a);
      const fb = factsFrom(b);
      if (mode === 'price-asc') return fa.price - fb.price;
      if (mode === 'price-desc') return fb.price - fa.price;
      if (mode === 'name') return fa.name.localeCompare(fb.name);
      return Number(a.dataset.index) - Number(b.dataset.index);
    });
    sorted.forEach((card) => grid.appendChild(card));
    apply();
  }

  checks.forEach((c) =>
    c.addEventListener('change', () => {
      visibleCount = PAGE_SIZE;
      apply();
    })
  );
  sortSelect?.addEventListener('change', sortCards);
  clearButtons.forEach((b) =>
    b.addEventListener('click', () => {
      checks.forEach((c) => (c.checked = false));
      visibleCount = PAGE_SIZE;
      apply();
    })
  );
  showMoreBtn?.addEventListener('click', () => {
    visibleCount += PAGE_SIZE;
    apply();
  });

  // Estado inicial (coleccion de la URL o busqueda del navbar).
  apply();

  // Offset del sidebar sticky de escritorio: la altura real del header
  // (varia con el ancho y el zoom), medida y expuesta como variable CSS.
  const headerEl = document.querySelector<HTMLElement>('.site-header');
  const setHeaderAlto = () => {
    if (headerEl) {
      document.documentElement.style.setProperty('--header-alto', `${headerEl.offsetHeight}px`);
    }
  };
  setHeaderAlto();
  window.addEventListener('resize', setHeaderAlto);

  // Hoja de filtros del movil: el boton "Filtrar" abre el aside a pantalla
  // completa; "Ver resultados" o la X lo cierran. En escritorio el aside es
  // una columna normal y estos controles no se muestran.
  const asideEl = document.querySelector<HTMLElement>('[data-shop-aside]');
  const filterToggle = document.querySelector<HTMLButtonElement>('[data-filter-toggle]');
  filterToggle?.addEventListener('click', () => {
    asideEl?.classList.add('open');
    document.body.style.overflow = 'hidden';
    filterToggle.setAttribute('aria-expanded', 'true');
  });
  document.querySelectorAll<HTMLElement>('[data-aside-close]').forEach((btn) =>
    btn.addEventListener('click', () => {
      asideEl?.classList.remove('open');
      document.body.style.overflow = '';
      filterToggle?.setAttribute('aria-expanded', 'false');
    }),
  );

  // Chips de orden de la hoja movil (referencia Jomashop): mueven el mismo
  // select de la toolbar, asi hay una sola fuente del orden.
  const sortChips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-sort-value]'));
  const syncSortChips = () => {
    sortChips.forEach((c) => c.classList.toggle('active', c.dataset.sortValue === sortSelect?.value));
  };
  sortChips.forEach((chip) =>
    chip.addEventListener('click', () => {
      if (!sortSelect) return;
      sortSelect.value = chip.dataset.sortValue!;
      sortCards();
      syncSortChips();
    }),
  );
  sortSelect?.addEventListener('change', syncSortChips);

  // Acordeones de la hoja movil: los grupos de filtros arrancan cerrados y
  // el titulo los abre/cierra. En escritorio (aside sin .open) no aplica.
  document.querySelectorAll<HTMLElement>('.filter-group .filter-name').forEach((name) =>
    name.addEventListener('click', () => {
      if (!asideEl?.classList.contains('open')) return;
      name.parentElement?.classList.toggle('abierto');
    }),
  );

  // Alternador de vista del movil: 1 columna, grilla de 2 o lista.
  const viewButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-view]'));
  viewButtons.forEach((btn) =>
    btn.addEventListener('click', () => {
      grid?.classList.toggle('view-1', btn.dataset.view === '1');
      grid?.classList.toggle('view-list', btn.dataset.view === 'list');
      viewButtons.forEach((b) => b.classList.toggle('active', b === btn));
    }),
  );
</script>

<style>
  /* Hero */
  .shop-hero {
    position: relative;
    height: 300px;
    overflow: hidden;
    display: flex;
    align-items: center;
    background: var(--card-dark);
    border-bottom: 1px solid var(--line);
  }

  .shop-hero-photo {
    position: absolute;
    inset: 0;
    background: linear-gradient(150deg, #2a4432, var(--card-dark) 70%);
  }

  .shop-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(27, 42, 31, 0.72), rgba(27, 42, 31, 0.25));
  }

  .shop-hero-inner {
    position: relative;
    width: 100%;
  }

  .shop-crumb {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8ce6a8;
    margin: 0 0 0.55rem;
  }

  .shop-crumb a { color: #8ce6a8; }

  .shop-hero h1 {
    color: #eef5f0;
    font-weight: 600;
    font-size: clamp(2rem, 4vw, 2.9rem);
    margin: 0;
  }

  .shop-sub {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    margin: 0.55rem 0 0;
    max-width: 38rem;
  }

  /* Layout */
  .shop-layout {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 2.9rem;
    padding-top: 2.3rem;
    padding-bottom: 4.6rem;
  }

  @media (max-width: 900px) {
    .shop-layout { grid-template-columns: 1fr; gap: 1.7rem; }
  }

  .shop-aside {
    display: flex;
    flex-direction: column;
    gap: 1.7rem;
  }

  /* Escritorio: el sidebar queda fijo bajo el header al hacer scroll
     (referencia Jomashop). El offset usa la altura REAL del header, que el
     script mide y expone en --header-alto (el header es sticky y su alto
     varia con el ancho de la ventana). Si el sidebar es mas alto que la
     ventana, tiene scroll interno. */
  @media (min-width: 901px) {
    .shop-aside {
      position: sticky;
      top: calc(var(--header-alto, 160px) + 18px);
      align-self: start;
      max-height: calc(100vh - var(--header-alto, 160px) - 36px);
      overflow-y: auto;
    }
  }

  /* Cabecera y controles de la hoja de filtros: solo existen en movil. */
  .aside-head { display: none; }
  .aside-sort { display: none; }
  .aside-actions { display: none; }

  .aside-close {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(27, 42, 31, 0.2);
    border-radius: 50%;
    background: #ffffff;
    color: var(--ink);
    cursor: pointer;
  }

  /* Alternador de vista (solo movil): tres iconos, el activo enmarcado. */
  .view-toggles {
    display: none;
    align-items: center;
    gap: 4px;
    margin-left: auto;
  }

  .view-toggles button {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: var(--ink-soft);
    cursor: pointer;
  }

  .view-toggles button.active {
    color: var(--ink);
    border-color: var(--line-strong);
    background: #ffffff;
  }

  .filter-toggle {
    display: none;
    align-items: center;
    gap: 7px;
    font-family: var(--font-ui);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--ink);
    background: #ffffff;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 0.5rem 1.1rem;
    cursor: pointer;
  }

  @media (max-width: 900px) {
    .filter-toggle { display: inline-flex; }

    /* En movil el aside vive oculto y se abre como hoja a pantalla completa
       (referencia: filtro movil de Lively Root). */
    .shop-aside { display: none; }

    .shop-aside.open {
      display: flex;
      position: fixed;
      inset: 0;
      z-index: 90;
      background: var(--bg);
      overflow-y: auto;
      padding: 1.15rem 1.4rem 2.3rem;
    }

    .shop-aside.open .aside-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 0.85rem;
      border-bottom: 1px solid var(--line);
    }

    .aside-head-title { font-size: 1.2rem; font-weight: 600; }

    /* Orden como chips, arriba de todo (referencia Jomashop movil). */
    .shop-aside.open .aside-sort { display: block; }

    .sort-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .sort-chip {
      font-family: var(--font-ui);
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--ink);
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 0.5rem 0.9rem;
      cursor: pointer;
    }

    .sort-chip.active {
      border: 1.5px solid var(--ink);
      font-weight: 600;
    }

    /* Grupos de filtros como acordeones cerrados, con + / − a la derecha. */
