---
// Pagina de confirmacion. Hoy el checkout cierra por WhatsApp; esta pagina
// queda lista para el flujo completo con el orders-api (ver PENDIENTES.md),
// que llegara con ?order=<numero>.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { whatsappLink } from '../../lib/site';
---

<Base
  noindex
  title="¡Gracias por tu compra!"
  description="Tu pedido fue recibido con éxito. Te contactamos por WhatsApp para coordinar el pago y la entrega de tus plantas a domicilio en Panamá."
>
  <section class="section">
    <div class="container success-container">
      <div class="success-icon" data-icon-ok><Icon name="badge-check" size={52} /></div>
      <div class="success-icon success-icon--alerta" hidden data-icon-alerta>
        <Icon name="alert-triangle" size={52} />
      </div>
      <h1 data-titulo>¡Gracias por tu compra!</h1>
      <p class="lead" data-lead>
        Recibimos tu pedido y lo confirmamos contigo por WhatsApp, junto con el
        número de pedido para darle seguimiento.
      </p>

      <div class="card success-card">
        <div data-order-info>
          <p><strong>Numero de pedido:</strong> <span data-order-number>—</span></p>
          <p class="help">Guardalo: es lo unico que necesitas para rastrear tu entrega.</p>
        </div>
        <div class="success-actions">
          <a href="/pedido" class="btn btn--green" data-track-link>Rastrear mi pedido</a>
          <a href="/checkout" class="btn btn--green" hidden data-retry>Intentar el pago de nuevo</a>
          <a
            href={whatsappLink('Hola, acabo de hacer un pedido en plantaspanama.com.')}
            class="btn btn--whatsapp"
            target="_blank"
            rel="noopener"
            data-wa-fallback
          >
            Enviar mi pedido por WhatsApp
          </a>
        </div>
      </div>

      <!-- Oferta de cuenta (decision del diseno de cuentas): el camino
           principal es el enlace de un solo uso del correo de confirmacion;
           el boton es la alternativa. Se oculta si ya hay sesion. -->
      <div class="card success-card success-cuenta" data-cuenta-oferta>
        <h2>Sigue todos tus pedidos en un solo lugar</h2>
        <p class="help">
          En el correo de confirmación va un enlace personal para crear tu cuenta con un solo
          clic, sin códigos. También puedes crearla ahora:
        </p>
        <a href="/cuenta/registro" class="btn btn--ghost">Crear mi cuenta</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { clearCart } from '../../lib/cart';
  import { whatsappLink } from '../../lib/site';

  // El numero de pedido llega como query param desde el checkout:
  // /checkout/success?order=VR-20260820-K7M2QX9P4T
  const params = new URLSearchParams(window.location.search);
  const order = params.get('order');

  // Al volver de la pagina de pago de PagueloFacil la URL trae ademas el
  // resultado del cobro (Estado, Oper, Razon...). Aqui no hay WhatsApp que
  // abrir; con venta directa el cobro es inmediato: el pago ya entro y el
  // pedido queda confirmado (la validacion interna es antes de entregar,
  // no antes de cobrar).
  const estadoPago = (params.get('Estado') ?? '').toLowerCase();
  let pagoRechazado = false;
  if (params.get('Estado') || params.get('Oper')) {
    const lead = document.querySelector<HTMLElement>('[data-lead]');
    let texto: string;
    let pagoAprobado = false;
    if (!estadoPago || estadoPago.startsWith('aprobad')) {
      pagoAprobado = true;
      texto =
        'Recibimos tu pago con tarjeta y tu pedido quedó confirmado. Te llega el ' +
        'comprobante por correo y preparamos la entrega para el siguiente día de ' +
        'reparto (lunes a jueves y domingo). ' +
        'Si algo no estuviera disponible, te contactamos y devolvemos el cobro.';
    } else if (estadoPago.startsWith('pendient')) {
      texto =
        'Tu pago con tarjeta quedó pendiente de confirmación del banco. Te avisamos por ' +
        'correo en cuanto se resuelva; también puedes escribirnos por WhatsApp.';
    } else {
      pagoRechazado = true;
      const razon = params.get('Razon');
      texto =
        `No pudimos procesar el pago con tu tarjeta${razon ? ` (${razon})` : ''}. No se ` +
        'hizo ningún cobro y este pedido quedó cancelado. Puedes intentar de nuevo con la ' +
        'misma tarjeta u otra, o escribirnos por WhatsApp para coordinar otro medio de pago.';
    }
    if (lead) lead.textContent = texto;
    if (pagoAprobado) {
      document.querySelector<HTMLElement>('[data-wa-fallback]')?.setAttribute('hidden', '');
    }
    if (pagoRechazado) {
      // Un rechazo no se celebra: titulo e icono propios, sin numero ni
      // rastreo ni oferta de cuenta (ese pedido quedo cancelado), y con el
      // camino claro para reintentar. El carrito NO se vacia (ver abajo).
      document.title = 'No pudimos procesar tu pago';
      const titulo = document.querySelector<HTMLElement>('[data-titulo]');
      if (titulo) titulo.textContent = 'No pudimos procesar tu pago';
      document.querySelector<HTMLElement>('[data-icon-ok]')?.setAttribute('hidden', '');
      document.querySelector<HTMLElement>('[data-icon-alerta]')?.removeAttribute('hidden');
      document.querySelector<HTMLElement>('[data-order-info]')?.setAttribute('hidden', '');
      document.querySelector<HTMLElement>('[data-track-link]')?.setAttribute('hidden', '');
      document.querySelector<HTMLElement>('[data-retry]')?.removeAttribute('hidden');
      document.querySelector<HTMLElement>('[data-cuenta-oferta]')?.setAttribute('hidden', '');
    }
  }

  if (order) {
    const el = document.querySelector('[data-order-number]');
    if (el) el.textContent = order;
    const link = document.querySelector<HTMLAnchorElement>('[data-track-link]');
    if (link) {
      // El token de rastreo (t) llega del checkout o del retorno de
      // PagueloFacil: autentica el enlace, porque el numero correlativo es
      // enumerable y ya no es credencial por si solo.
      const rastreo = new URLSearchParams({ n: order });
      const token = params.get('t');
      if (token) rastreo.set('t', token);
      link.href = `/pedido?${rastreo.toString()}`;
    }
    // Con el pago rechazado el carrito queda intacto: "Intentar el pago de
    // nuevo" vuelve al checkout con todo cargado.
    if (!pagoRechazado) clearCart();
  }

  // El checkout dejo el mensaje completo en sessionStorage: si el navegador
  // bloqueo la pestana de WhatsApp, este boton es el respaldo con el mismo
  // resumen (numero incluido).
  const waBtn = document.querySelector<HTMLAnchorElement>('[data-wa-fallback]');
  if (waBtn) {
    let mensaje = '';
    try {
      mensaje = sessionStorage.getItem('pp-wa-mensaje') ?? '';
    } catch {
      // sin sessionStorage se usa el saludo generico del href
    }
    if (mensaje) waBtn.href = whatsappLink(mensaje);
    else if (order) waBtn.href = whatsappLink(`Hola, acabo de hacer el pedido ${order} en plantaspanama.com.`);
  }

  // Quien ya tiene sesion no necesita la oferta de crear cuenta.
  fetch('/api/auth/me')
    .then((res) => {
      if (res.ok) document.querySelector<HTMLElement>('[data-cuenta-oferta]')?.setAttribute('hidden', '');
    })
    .catch(() => {
      // sin backend disponible la oferta se queda visible
    });
</script>

<style>
  .success-container {
    max-width: 36rem;
    text-align: center;
  }

  .success-icon {
    display: flex;
    justify-content: center;
    color: var(--green);
    margin-bottom: 1rem;
  }

  /* El display:flex le ganaria al atributo hidden (mismo caso que el boton
     de WhatsApp mas abajo). */
  .success-icon[hidden] { display: none; }

  .success-icon--alerta { color: #b3541e; }

  .success-card {
    margin-top: 2rem;
    padding: 2rem;
  }

  .success-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.25rem;
  }

  .success-cuenta h2 {
    font-size: 1.2rem;
    margin-bottom: 0.4rem;
  }

  .success-cuenta .btn { margin-top: 0.85rem; }

  .success-cuenta[hidden] { display: none; }

  /* El display de .btn le gana al atributo hidden; sin esto el boton de
     WhatsApp no se ocultaria al volver de PagueloFacil. */
  .success-actions .btn[hidden] { display: none; }
</style>
