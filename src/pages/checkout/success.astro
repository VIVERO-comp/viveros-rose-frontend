---
// Pagina de confirmacion. Hoy el checkout cierra por WhatsApp; esta pagina
// queda lista para el flujo completo con el orders-api (ver PENDIENTES.md),
// que llegara con ?order=<numero>.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { whatsappLink } from '../../lib/site';
---

<Base title="¡Gracias por tu compra!" description="Tu pedido fue recibido.">
  <section class="section">
    <div class="container success-container">
      <div class="success-icon"><Icon name="badge-check" size={52} /></div>
      <h1>¡Gracias por tu compra!</h1>
      <p class="lead">
        Recibimos tu pedido y lo confirmamos contigo por WhatsApp, junto con el
        número de pedido para darle seguimiento.
      </p>

      <div class="card success-card">
        <p><strong>Numero de pedido:</strong> <span data-order-number>—</span></p>
        <p class="help">Guardalo: es lo unico que necesitas para rastrear tu entrega.</p>
        <div class="success-actions">
          <a href="/pedido" class="btn btn--green" data-track-link>Rastrear mi pedido</a>
          <a
            href={whatsappLink('Hola, acabo de hacer un pedido en plantaspanama.com.')}
            class="btn btn--whatsapp"
            target="_blank"
            rel="noopener"
            data-wa-fallback
          >
            Enviar mi pedido por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { clearCart } from '../../lib/cart';
  import { whatsappLink } from '../../lib/site';

  // El numero de pedido llega como query param desde el checkout:
  // /checkout/success?order=VR-20260820-K7M2QX9P4T
  const params = new URLSearchParams(window.location.search);
  const order = params.get('order');

  if (order) {
    const el = document.querySelector('[data-order-number]');
    if (el) el.textContent = order;
    const link = document.querySelector<HTMLAnchorElement>('[data-track-link]');
    if (link) link.href = `/pedido?n=${encodeURIComponent(order)}`;
    clearCart();
  }

  // El checkout dejo el mensaje completo en sessionStorage: si el navegador
  // bloqueo la pestana de WhatsApp, este boton es el respaldo con el mismo
  // resumen (numero incluido).
  const waBtn = document.querySelector<HTMLAnchorElement>('[data-wa-fallback]');
  if (waBtn) {
    let mensaje = '';
    try {
      mensaje = sessionStorage.getItem('pp-wa-mensaje') ?? '';
    } catch {
      // sin sessionStorage se usa el saludo generico del href
    }
    if (mensaje) waBtn.href = whatsappLink(mensaje);
    else if (order) waBtn.href = whatsappLink(`Hola, acabo de hacer el pedido ${order} en plantaspanama.com.`);
  }
</script>

<style>
  .success-container {
    max-width: 36rem;
    text-align: center;
  }

  .success-icon {
    display: flex;
    justify-content: center;
    color: var(--green);
    margin-bottom: 1rem;
  }

  .success-card {
    margin-top: 2rem;
    padding: 2rem;
  }

  .success-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.25rem;
  }
</style>
