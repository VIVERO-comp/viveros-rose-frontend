---
import Base from '../../layouts/Base.astro';
---

<Base title="Checkout" description="Finaliza tu compra como invitado. Sin crear cuenta.">
  <section class="section">
    <div class="container checkout-container">
      <h1>Checkout</h1>
      <p class="lead">Compra como invitado. No necesitas crear una cuenta.</p>

      <div class="checkout-grid">
        <form class="checkout-form" novalidate>
          <h3>Datos de entrega</h3>

          <div class="field">
            <label for="name">Nombre completo *</label>
            <input type="text" id="name" name="name" required autocomplete="name" />
          </div>

          <div class="field">
            <label for="email">Correo electronico *</label>
            <input type="email" id="email" name="email" required autocomplete="email" />
            <p class="help">Aqui te enviaremos la confirmacion y el enlace de seguimiento.</p>
          </div>

          <div class="field">
            <label for="phone">Telefono / WhatsApp</label>
            <input type="tel" id="phone" name="phone" autocomplete="tel" placeholder="+507 6000-0000" />
            <p class="help">Muy recomendado: coordinamos la entrega por WhatsApp.</p>
          </div>

          <div class="field">
            <label for="address">Direccion de entrega *</label>
            <textarea id="address" name="address" rows="3" required autocomplete="street-address"></textarea>
          </div>

          <div class="field">
            <label for="notes">Notas para la entrega</label>
            <textarea id="notes" name="notes" rows="2" placeholder="Referencias, horario preferido, etc."></textarea>
          </div>

          <button type="submit" class="btn btn--green" style="width: 100%; justify-content: center;">
            Continuar al pago
          </button>

          <p class="form-error" hidden></p>
          <p class="help" style="margin-top: 0.75rem;">
            El pago se procesa de forma segura con Wompi. Antes de cobrar,
            verificamos la disponibilidad real de cada planta.
          </p>
        </form>

        <aside class="order-summary card">
          <h3>Tu pedido</h3>
          <div data-summary-items></div>
          <div class="summary-total">
            <span>Subtotal</span>
            <strong data-summary-total>$0.00</strong>
          </div>
          <p class="help">Entrega se cotiza segun tu zona. <a href="/entrega">Ver tarifas</a>.</p>
        </aside>
      </div>
    </div>
  </section>
</Base>

<script>
  import { getCart, cartTotal } from '../../lib/cart';

  const items = getCart();
  const list = document.querySelector<HTMLElement>('[data-summary-items]');
  const total = document.querySelector<HTMLElement>('[data-summary-total]');

  if (list) {
    if (!items.length) {
      list.innerHTML = '<p>Tu carrito esta vacio. <a href="/plantas">Ver plantas</a></p>';
    } else {
      list.innerHTML = items
        .map(
          (i) => `
            <div class="summary-item">
              <span>${i.emoji} ${i.name} × ${i.qty}</span>
              <span>$${(i.price * i.qty).toFixed(2)}</span>
            </div>`,
        )
        .join('');
    }
  }
  if (total) total.textContent = `$${cartTotal().toFixed(2)}`;

  // v1: aqui se llama a POST /api/checkout/create-intent, que valida stock
  // contra el proxy y crea la referencia de pago Wompi. Ese backend aun no
  // esta desplegado, asi que por ahora informamos al usuario.
  const form = document.querySelector<HTMLFormElement>('.checkout-form');
  const error = document.querySelector<HTMLElement>('.form-error');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    if (!getCart().length) {
      if (error) {
        error.textContent = 'Tu carrito esta vacio.';
        error.removeAttribute('hidden');
      }
      return;
    }
    if (error) {
      error.textContent =
        'El pago online estara disponible muy pronto. Por ahora, completa tu pedido por WhatsApp: te atenderemos al instante.';
      error.removeAttribute('hidden');
    }
  });
</script>

<style is:global>
  .checkout-container { max-width: 60rem; }

  .checkout-grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 2rem;
    align-items: start;
    margin-top: 1.5rem;
  }

  @media (max-width: 800px) {
    .checkout-grid { grid-template-columns: 1fr; }
    .order-summary { order: -1; }
  }

  .checkout-form {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
  }

  .order-summary { padding: 1.5rem; }

  .summary-item {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.95rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--line);
  }

  .summary-total {
    display: flex;
    justify-content: space-between;
    font-size: 1.1rem;
    margin-top: 0.75rem;
  }

  .form-error {
    margin-top: 1rem;
    padding: 0.85rem 1rem;
    background: var(--amber-tint);
    color: var(--amber);
    border-radius: var(--radius);
    font-weight: 600;
  }
</style>
