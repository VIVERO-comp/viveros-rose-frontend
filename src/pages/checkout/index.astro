---
// Checkout segun el diseno "Checkout" (claude.ai/design): formulario a la
// izquierda y resumen en columna arena a la derecha. Compra como invitado.
// Al confirmar, el pedido se registra en el order-api (via /api/checkout,
// que corre en el servidor y guarda la API key): se revalida stock, se crea
// el presupuesto en Odoo y vuelve el numero VR-..., que viaja en el mensaje
// de WhatsApp con el que se coordina el pago (Yappy, transferencia o
// efectivo). El carrito sigue siendo src/lib/cart.ts.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';

// Metodos de entrega del diseno: estandar $3 fijo (sin regla de envio
// gratis desde $50), express $9 y retiro sin costo.
const SHIPPING = [
  { id: 'std', name: 'Entrega estándar', detail: '24–48 horas · ciudad de Panamá', price: 3 },
  { id: 'exp', name: 'Entrega express', detail: '24 horas · ciudad de Panamá', price: 9 },
  { id: 'pickup', name: 'Retiro en el vivero', detail: 'Ciudad de Panamá · Lun–Vie 9–5', price: 0 },
];

// Metodos de pago del diseno. La tarjeta (Wompi) vive detras de la bandera
// PUBLIC_WOMPI_ACTIVO: apagada, se muestra deshabilitada ("Proximamente") y
// nada del flujo de pago en linea existe en la pagina. Encendida, el submit
// redirige a la url_pago que devuelve el order-api. Yappy queda seleccionado
// por defecto en ambos casos.
const WOMPI_ACTIVO = (import.meta.env.PUBLIC_WOMPI_ACTIVO ?? '0') === '1';
const PAYMENTS = [
  { id: 'yappy', name: 'Yappy', detail: 'Pago desde tu banco' },
  { id: 'transfer', name: 'Transferencia bancaria', detail: 'Enviamos los datos por WhatsApp' },
  { id: 'cash', name: 'Efectivo contra entrega', detail: 'Solo ciudad de Panamá' },
  ...(WOMPI_ACTIVO
    ? [{ id: 'wompi', name: 'Tarjeta de crédito o débito', detail: 'Pago seguro en línea (Wompi)' }]
    : []),
];

const PROVINCES = [
  'Panamá',
  'Panamá Oeste',
  'Colón',
  'Coclé',
  'Chiriquí',
  'Herrera',
  'Los Santos',
  'Veraguas',
];

// Con la llave de Google Maps configurada, la direccion gana autocompletado
// (Places API New, restringido a Panama) y el boton para marcar el punto
// exacto en un mapa. Sin la llave, el checkout se ve y funciona exactamente
// igual que siempre: nada de esto se renderiza.
const GOOGLE_MAPS_KEY = import.meta.env.PUBLIC_GOOGLE_MAPS_KEY ?? '';
---

<Base
  noindex
  title="Checkout"
  description="Finaliza tu compra como invitado, sin crear cuenta: datos de contacto, dirección de entrega y confirmación del pedido por WhatsApp en pocos pasos."
  chrome="minimal"
  minimalLinkHref="/carrito"
  minimalLinkLabel="Volver al carrito"
>
  <div class="checkout-grid">
    <main class="checkout-main">
      <!-- El diseno del checkout no lleva titulo visible; el h1 queda solo
           para lectores de pantalla y buscadores. -->
      <h1 class="visually-hidden">Checkout</h1>
      <div class="trust-row">
        <span><Icon name="package" size={22} class="trust-icon" /> Empaque seguro</span>
        <span><Icon name="smile" size={22} class="trust-icon" /> Satisfacción del cliente</span>
        <span><Icon name="truck" size={22} class="trust-icon" /> Entrega 24–48 h</span>
      </div>

      <form class="checkout-form" novalidate>
        <h2>Contacto</h2>
        <div class="fields">
          <div class="field">
            <label for="email">Correo electrónico *</label>
            <input type="email" id="email" name="email" required autocomplete="email" />
            <p class="help">Aquí te enviaremos la confirmación y el enlace de seguimiento.</p>
          </div>
          <div class="field">
            <label for="phone">WhatsApp (+507) *</label>
            <input type="tel" id="phone" name="phone" required autocomplete="tel" placeholder="+507 6000-0000" />
            <p class="help">Coordinamos la entrega por WhatsApp.</p>
          </div>
        </div>

        <h2>Entrega</h2>
        <div class="fields">
          <div class="two-col">
            <div class="field">
              <label for="name">Nombre *</label>
              <input type="text" id="name" name="name" required autocomplete="given-name" />
            </div>
            <div class="field">
              <label for="lastname">Apellido *</label>
              <input type="text" id="lastname" name="lastname" required autocomplete="family-name" />
            </div>
          </div>
          <div class="field">
            <label for="province">Provincia *</label>
            <select id="province" name="province" required>
              {PROVINCES.map((p) => <option value={p}>{p}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="district">Corregimiento o barriada *</label>
            <input type="text" id="district" name="district" required />
          </div>
          <div class="field field--direccion">
            <label for="address">Dirección: calle, casa o edificio *</label>
            <input type="text" id="address" name="address" required autocomplete="street-address" />
            {GOOGLE_MAPS_KEY && <div class="sugerencias" data-sugerencias hidden></div>}
          </div>
          <div class="field">
            <label for="reference">Apartamento, piso, referencia (opcional)</label>
            <input type="text" id="reference" name="reference" />
          </div>
          {GOOGLE_MAPS_KEY && (
            <div class="field">
              <button type="button" class="mapa-boton" data-abrir-mapa>
                📍 Marcar el punto exacto en el mapa <span class="suave-inline">(opcional)</span>
              </button>
              <p class="mapa-marcado" data-mapa-marcado hidden>
                <span>✓ Punto de entrega marcado</span>
                <button type="button" class="mapa-quitar" data-quitar-punto>Quitar</button>
              </p>
              <div class="mapa-panel" data-mapa-panel hidden>
                <p class="help">Mueve el mapa hasta que el pin quede en tu puerta.</p>
                <div class="mapa-lienzo" data-mapa>
                  <span class="mapa-pin" aria-hidden="true">📍</span>
                </div>
                <div class="mapa-acciones">
                  <button type="button" class="mapa-secundario" data-usar-gps>Usar mi ubicación</button>
                  <button type="button" class="mapa-confirmar" data-confirmar-punto>Confirmar este punto</button>
                </div>
                <p class="help mapa-error" data-mapa-error hidden>El mapa no está disponible ahora; tu dirección escrita es suficiente.</p>
              </div>
            </div>
          )}
        </div>

        <h2>Método de entrega</h2>
        <div class="option-list">
          {SHIPPING.map((s, i) => (
            <label class="option">
              <span class="option-main">
                <input
                  type="radio"
                  name="envio"
                  value={s.id}
                  checked={i === 0}
                  data-ship-price={s.price}
                  data-ship-name={s.name}
                />
                <span>
                  <span class="option-name">{s.name}</span>
                  <span class="option-detail">{s.detail}</span>
                </span>
              </span>
              <span class="option-price">{s.price === 0 ? 'Gratis' : `$${s.price.toFixed(2)}`}</span>
            </label>
          ))}
        </div>

        <h2>Pago</h2>
        <p class="pay-note">Todas las transacciones son seguras y encriptadas.</p>
        <div class="pay-box">
          {!WOMPI_ACTIVO && (
            <label class="pay-row pay-row--disabled" title="Próximamente">
              <span class="pay-main">
                <input type="radio" name="pago" disabled />
                Tarjeta de crédito o débito
              </span>
              <span class="pay-soon">Próximamente</span>
            </label>
          )}
          {PAYMENTS.map((p, i) => (
            <label class="pay-row">
              <span class="pay-main">
                <input type="radio" name="pago" value={p.id} checked={i === 0} data-pay-name={p.name} />
                {p.name}
              </span>
              <span class="pay-detail">{p.detail}</span>
            </label>
          ))}
        </div>

        <button type="submit" class="submit-btn" data-submit-whatsapp="Confirmar pedido por WhatsApp" data-submit-wompi="Continuar al pago seguro">Confirmar pedido por WhatsApp</button>
        <p class="form-error" hidden></p>
        <p class="help center" data-help-whatsapp>
          {WOMPI_ACTIVO
            ? 'Al confirmar se abre WhatsApp con el resumen de tu pedido para cerrar la compra al instante.'
            : 'El pago online con Wompi estará disponible muy pronto. Al confirmar se abre WhatsApp con el resumen de tu pedido para cerrar la compra al instante.'}
        </p>
        {WOMPI_ACTIVO && (
          <p class="help center" data-help-wompi hidden>
            Al confirmar te llevamos a la página segura de Wompi para pagar con tu tarjeta.
            Tu pedido queda confirmado automáticamente al aprobarse el pago.
          </p>
        )}
      </form>
    </main>

    <aside class="checkout-aside">
      <!-- En movil el resumen queda arriba y colapsable; en escritorio el
           script lo mantiene siempre abierto y la barra de toggle se oculta. -->
      <details class="aside-inner" data-aside-details open>
        <summary class="aside-toggle">
          <span>Resumen del pedido</span>
          <strong data-toggle-total>$0.00</strong>
        </summary>
        <div class="aside-body">
          <div data-summary-items></div>
          <!-- Codigo de descuento: aun no hay backend de cupones. -->
          <div class="discount-row">
            <input type="text" placeholder="Código de descuento" disabled title="No disponible por ahora" />
            <button type="button" disabled title="No disponible por ahora">Aplicar</button>
          </div>
          <div class="aside-rows">
            <div class="aside-row"><span>Subtotal</span><span data-summary-subtotal>$0.00</span></div>
            <div class="aside-row"><span>Envío</span><span data-summary-shipping>Gratis</span></div>
          </div>
          <div class="aside-total">
            <span>Total</span>
            <strong data-summary-total>$0.00</strong>
          </div>

          <p class="secure-note"><Icon name="lock" size={15} class="lock-icon" /> Pedido seguro · Vivero Rose, Ciudad de Panamá</p>
        </div>
      </details>
    </aside>
  </div>
</Base>

<script>
  import { getCart, cartTotal } from '../../lib/cart';
  import { whatsappLink } from '../../lib/site';

  const money = (n: number) => `$${n.toFixed(2)}`;

  const items = getCart();
  const list = document.querySelector<HTMLElement>('[data-summary-items]');
  const subtotalEl = document.querySelector<HTMLElement>('[data-summary-subtotal]');
  const shippingEl = document.querySelector<HTMLElement>('[data-summary-shipping]');
  const totalEl = document.querySelector<HTMLElement>('[data-summary-total]');

  if (list) {
    if (!items.length) {
      list.innerHTML = '<p class="aside-empty">Tu carrito está vacío. <a href="/plantas">Ver plantas</a></p>';
    } else {
      list.innerHTML = items
        .map((i) => {
          // Con foto real se muestra la foto; sin foto queda el emoji.
          const contenido = i.image
            ? `<i class="aside-qty">${i.qty}</i>`
            : `${i.emoji}<i class="aside-qty">${i.qty}</i>`;
          const estilo = i.image
            ? ` style="background-image: url('${i.image}'); background-size: cover; background-position: center;"`
            : '';
          return `
            <div class="aside-item">
              <span class="aside-thumb" aria-hidden="true"${estilo}>${contenido}</span>
              <span class="aside-name">${i.name}</span>
              <span class="aside-line">$${(i.price * i.qty).toFixed(2)}</span>
            </div>`;
        })
        .join('');
    }
  }

  function selectedShipping() {
    const radio = document.querySelector<HTMLInputElement>('input[name="envio"]:checked');
    return {
      price: Number(radio?.dataset.shipPrice ?? 0),
      name: radio?.dataset.shipName ?? 'Entrega estándar',
    };
  }

  function selectedPayment() {
    const radio = document.querySelector<HTMLInputElement>('input[name="pago"]:checked');
    return radio?.dataset.payName ?? 'Yappy';
  }

  function refreshTotals() {
    const subtotal = cartTotal();
    const ship = selectedShipping();
    const total = subtotal + (subtotal > 0 ? ship.price : 0);
    if (subtotalEl) subtotalEl.textContent = money(subtotal);
    if (shippingEl) shippingEl.textContent = ship.price === 0 ? 'Gratis' : money(ship.price);
    if (totalEl) totalEl.textContent = money(total);
    const toggleTotal = document.querySelector<HTMLElement>('[data-toggle-total]');
    if (toggleTotal) toggleTotal.textContent = money(total);
  }

  document
    .querySelectorAll<HTMLInputElement>('input[name="envio"]')
    .forEach((r) => r.addEventListener('change', refreshTotals));
  refreshTotals();

  // Resumen colapsable solo en movil: en escritorio queda siempre abierto.
  const resumen = document.querySelector<HTMLDetailsElement>('[data-aside-details]');
  const escritorio = window.matchMedia('(min-width: 901px)');
  if (resumen) {
    resumen.open = escritorio.matches;
    escritorio.addEventListener('change', (e) => {
      resumen.open = e.matches;
    });
  }

  // -- ubicacion exacta (solo existe con PUBLIC_GOOGLE_MAPS_KEY) -----------
  //
  // El punto que marca el cliente viaja como cliente.ubicacion {lat, lng}
  // JUNTO al texto de la direccion, nunca en vez de el. Google se carga
  // perezoso (al escribir la direccion o abrir el mapa), y cualquier fallo
  // deja el checkout funcionando como siempre: el texto es el respaldo.
  const MAPS_KEY = import.meta.env.PUBLIC_GOOGLE_MAPS_KEY as string | undefined;
  let ubicacion: { lat: number; lng: number } | null = null;

  if (MAPS_KEY && document.querySelector('[data-abrir-mapa]')) {
    const campoDireccion = document.querySelector<HTMLInputElement>('#address')!;
    const sugerenciasEl = document.querySelector<HTMLElement>('[data-sugerencias]')!;
    const botonMapa = document.querySelector<HTMLElement>('[data-abrir-mapa]')!;
    const panelMapa = document.querySelector<HTMLElement>('[data-mapa-panel]')!;
    const lienzoMapa = document.querySelector<HTMLElement>('[data-mapa]')!;
    const marcadoEl = document.querySelector<HTMLElement>('[data-mapa-marcado]')!;
    const errorMapa = document.querySelector<HTMLElement>('[data-mapa-error]')!;

    const CENTRO_PANAMA = { lat: 8.9824, lng: -79.5199 };
    const textoOriginalBoton = botonMapa.innerHTML;
    let promesaGoogle: Promise<any> | null = null;
    let mapa: any = null;
    let tokenSesion: any = null;

    function cargarGoogle(): Promise<any> {
      if (!promesaGoogle) {
        promesaGoogle = new Promise((listo, fallo) => {
          (window as any).__mapsListo = () => listo((window as any).google);
          const script = document.createElement('script');
          script.src =
            'https://maps.googleapis.com/maps/api/js?key=' +
            encodeURIComponent(MAPS_KEY!) +
            '&v=weekly&loading=async&language=es&region=PA&callback=__mapsListo';
          script.onerror = () => fallo(new Error('google maps no cargo'));
          document.head.appendChild(script);
        });
      }
      return promesaGoogle;
    }

    function marcarPunto(punto: { lat: number; lng: number }) {
      ubicacion = punto;
      marcadoEl.hidden = false;
      botonMapa.textContent = '📍 Ajustar el punto en el mapa';
    }

    // Autocompletado con dropdown propio (Places API New): el input del
    // formulario no se toca, las sugerencias se pintan debajo con el estilo
    // del sitio.
    let temporizador: ReturnType<typeof setTimeout> | undefined;
    campoDireccion.addEventListener('input', () => {
      clearTimeout(temporizador);
      const texto = campoDireccion.value.trim();
      if (texto.length < 3) {
        sugerenciasEl.hidden = true;
        return;
      }
      temporizador = setTimeout(() => sugerir(texto), 300);
    });
    document.addEventListener('click', (e) => {
      if (!sugerenciasEl.contains(e.target as Node) && e.target !== campoDireccion) {
        sugerenciasEl.hidden = true;
      }
    });

    async function sugerir(texto: string) {
      try {
        const google = await cargarGoogle();
        const { AutocompleteSuggestion, AutocompleteSessionToken } =
          await google.maps.importLibrary('places');
        tokenSesion ??= new AutocompleteSessionToken();
        const { suggestions } = await AutocompleteSuggestion.fetchAutocompleteSuggestions({
          input: texto,
          sessionToken: tokenSesion,
          includedRegionCodes: ['pa'],
          language: 'es-419',
        });
        if (campoDireccion.value.trim() !== texto) return; // ya siguio escribiendo
        pintarSugerencias(suggestions.slice(0, 5));
      } catch {
        sugerenciasEl.hidden = true; // sin sugerencias no pasa nada: texto libre
      }
    }

    function pintarSugerencias(sugerencias: any[]) {
      if (!sugerencias.length) {
        sugerenciasEl.hidden = true;
        return;
      }
      sugerenciasEl.innerHTML = '';
      for (const sugerencia of sugerencias) {
        const boton = document.createElement('button');
        boton.type = 'button';
        boton.className = 'sugerencia';
        boton.textContent = sugerencia.placePrediction.text.text;
        boton.addEventListener('click', () => elegirSugerencia(sugerencia));
        sugerenciasEl.appendChild(boton);
      }
      sugerenciasEl.hidden = false;
    }

    async function elegirSugerencia(sugerencia: any) {
      sugerenciasEl.hidden = true;
      campoDireccion.value = sugerencia.placePrediction.text.text;
      try {
        const lugar = sugerencia.placePrediction.toPlace();
        // Cierra la sesion de autocompletado (asi las sugerencias son gratis).
        await lugar.fetchFields({ fields: ['location'] });
        tokenSesion = null;
        if (lugar.location) {
          marcarPunto({ lat: lugar.location.lat(), lng: lugar.location.lng() });
          if (mapa) {
            mapa.setCenter(ubicacion!);
            mapa.setZoom(17);
          }
        }
      } catch {
        tokenSesion = null; // el texto elegido queda igual; sin coordenadas
      }
    }

    // El mapa con el pin fijo al centro: se mueve el mapa, no el pin. Es el
    // gesto mas comodo con una mano y no depende de arrastrar un marcador.
    async function abrirMapa() {
      panelMapa.hidden = false;
      errorMapa.hidden = true;
      try {
        const google = await cargarGoogle();
        const { Map } = await google.maps.importLibrary('maps');
        if (!mapa) {
          mapa = new Map(lienzoMapa, {
            center: ubicacion ?? CENTRO_PANAMA,
            zoom: ubicacion ? 17 : 12,
            disableDefaultUI: true,
            zoomControl: true,
            clickableIcons: false,
            gestureHandling: 'greedy',
          });
        } else if (ubicacion) {
          mapa.setCenter(ubicacion);
        }
      } catch {
        errorMapa.hidden = false;
      }
    }

    botonMapa.addEventListener('click', () => {
      if (panelMapa.hidden) abrirMapa();
      else panelMapa.hidden = true;
    });

    document.querySelector('[data-confirmar-punto]')!.addEventListener('click', () => {
      if (!mapa) return;
      const centro = mapa.getCenter();
      marcarPunto({
        lat: Number(centro.lat().toFixed(7)),
        lng: Number(centro.lng().toFixed(7)),
      });
      panelMapa.hidden = true;
    });

    document.querySelector('[data-usar-gps]')!.addEventListener('click', () => {
      navigator.geolocation?.getCurrentPosition(
        (posicion) => {
          mapa?.setCenter({ lat: posicion.coords.latitude, lng: posicion.coords.longitude });
          mapa?.setZoom(17);
        },
        () => {}, // permiso negado: el mapa se queda donde estaba
        { enableHighAccuracy: true, timeout: 8000 },
      );
    });

    document.querySelector('[data-quitar-punto]')!.addEventListener('click', () => {
      ubicacion = null;
      marcadoEl.hidden = true;
      botonMapa.innerHTML = textoOriginalBoton;
    });
  }

  const form = document.querySelector<HTMLFormElement>('.checkout-form');
  const error = document.querySelector<HTMLElement>('.form-error');
  const submitBtn = document.querySelector<HTMLButtonElement>('.submit-btn');

  function mostrarError(texto: string) {
    if (error) {
      error.textContent = texto;
      error.removeAttribute('hidden');
    }
  }

  function pagoConTarjeta() {
    return (
      document.querySelector<HTMLInputElement>('input[name="pago"]:checked')?.value === 'wompi'
    );
  }

  function textoDeConfirmar() {
    if (!submitBtn) return;
    submitBtn.textContent = pagoConTarjeta()
      ? (submitBtn.dataset.submitWompi ?? '')
      : (submitBtn.dataset.submitWhatsapp ?? '');
    // Con Wompi la ayuda de WhatsApp no aplica y viceversa. El bloque de
    // Wompi solo existe con PUBLIC_WOMPI_ACTIVO encendida.
    const ayudaWa = document.querySelector<HTMLElement>('[data-help-whatsapp]');
    const ayudaWompi = document.querySelector<HTMLElement>('[data-help-wompi]');
    if (ayudaWa) ayudaWa.hidden = pagoConTarjeta();
    if (ayudaWompi) ayudaWompi.hidden = !pagoConTarjeta();
  }

  document
    .querySelectorAll<HTMLInputElement>('input[name="pago"]')
    .forEach((r) => r.addEventListener('change', textoDeConfirmar));
  textoDeConfirmar();

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    error?.setAttribute('hidden', '');

    const cart = getCart();
    if (!cart.length) {
      mostrarError('Tu carrito está vacío.');
      return;
    }

    const data = new FormData(form);
    const ship = selectedShipping();
    const envioId =
      document.querySelector<HTMLInputElement>('input[name="envio"]:checked')?.value ?? 'std';
    const pagoId =
      document.querySelector<HTMLInputElement>('input[name="pago"]:checked')?.value ?? 'yappy';

    let gift = '';
    try {
      const saved = JSON.parse(localStorage.getItem('pp-gift-v1') ?? 'null');
      if (saved?.on && saved.note) gift = `\nEs un regalo. Mensaje de la tarjeta: ${saved.note}`;
    } catch {
      // sin nota de regalo
    }

    const direccion =
      `${data.get('address')}, ${data.get('district')}, ${data.get('province')}` +
      `${data.get('reference') ? ` (${data.get('reference')})` : ''}`;

    // El pedido se registra ANTES de abrir WhatsApp: el order-api revalida el
    // stock, congela los precios de Odoo, crea el presupuesto y devuelve el
    // numero VR-..., que es el que viaja en el mensaje.
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Registrando tu pedido…';
    }
    let pedido: {
      numero_pedido: string;
      subtotal_centavos: number;
      envio_centavos: number;
      total_centavos: number;
      url_pago?: string;
    };
    try {
      const respuesta = await fetch('/api/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: cart.map((i) => ({ sku: i.sku, cantidad: i.qty })),
          cliente: {
            nombre: `${data.get('name')} ${data.get('lastname')}`.trim(),
            email: data.get('email'),
            telefono: data.get('phone'),
            direccion,
            // Version estructurada para el contacto de Odoo (street/city);
            // `direccion` completa sigue yendo a la nota del pedido.
            calle: data.get('address'),
            ciudad: `${data.get('district')}, ${data.get('province')}`,
            notas: gift ? gift.trim() : null,
            // El punto exacto del mapa o del autocompletado, si lo marco.
            ...(ubicacion ? { ubicacion } : {}),
          },
          envio: envioId,
          metodo_pago: pagoId,
        }),
      });
      if (respuesta.status === 409) {
        const detalle = await respuesta.json();
        if (detalle.error === 'price_not_ready') {
          // Salvaguarda del order-api: el producto tiene el precio sin
          // corregir en Odoo. Mensaje claro, sin jerga tecnica.
          const nombres = (detalle.items ?? [])
            .map((i: { sku: string; nombre?: string }) => {
              const enCarrito = cart.find((c) => c.sku === i.sku);
              return enCarrito?.name ?? i.nombre ?? i.sku;
            })
            .join(', ');
          mostrarError(
            `Por ahora no podemos vender en línea: ${nombres}. ` +
              'Quítalo del carrito para completar tu pedido, o escríbenos por WhatsApp y te lo cotizamos.',
          );
          return;
        }
        const agotados = (detalle.items ?? [])
          .filter((i: { ok: boolean }) => !i.ok)
          .map((i: { sku: string; disponible: number }) => {
            const enCarrito = cart.find((c) => c.sku === i.sku);
            return `${enCarrito?.name ?? i.sku} (quedan ${i.disponible})`;
          })
          .join(', ');
        mostrarError(
          `No hay stock suficiente de: ${agotados}. Ajusta las cantidades en el carrito.`,
        );
        return;
      }
      if (!respuesta.ok) {
        mostrarError('No pudimos registrar tu pedido. Revisa tu conexión e intenta de nuevo.');
        return;
      }
      pedido = await respuesta.json();
    } catch {
      mostrarError('No pudimos registrar tu pedido. Revisa tu conexión e intenta de nuevo.');
      return;
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        textoDeConfirmar();
      }
    }

    // Con tarjeta no hay WhatsApp: el pedido ya quedo registrado y el pago se
    // hace en la pagina de Wompi, que al terminar regresa a /checkout/success.
    if (pagoId === 'wompi' && pedido.url_pago) {
      window.location.assign(pedido.url_pago);
      return;
    }

    const centavos = (n: number) => money(n / 100);
    const lines = cart
      .map((i) => `- ${i.name} × ${i.qty} = $${(i.price * i.qty).toFixed(2)} (${i.sku})`)
      .join('\n');
    const message =
      `Hola, quiero confirmar mi pedido ${pedido.numero_pedido} de plantaspanama.com:\n\n${lines}\n\n` +
      `Subtotal: ${centavos(pedido.subtotal_centavos)}\n` +
      `Envío (${ship.name}): ${pedido.envio_centavos === 0 ? 'Gratis' : centavos(pedido.envio_centavos)}\n` +
      `Total: ${centavos(pedido.total_centavos)}\n\n` +
      `Nombre: ${data.get('name')} ${data.get('lastname')}\n` +
      `Correo: ${data.get('email')}\nWhatsApp: ${data.get('phone')}\n` +
      `Dirección: ${direccion}\n` +
      `Método de pago: ${selectedPayment()}${gift}`;

    // Se guarda el mensaje para que la pagina de gracias ofrezca el mismo
    // enlace si el navegador bloqueo la pestana nueva de WhatsApp.
    try {
      sessionStorage.setItem('pp-wa-mensaje', message);
    } catch {
      // sin sessionStorage no hay respaldo, pero el flujo sigue
    }
    window.open(whatsappLink(message), '_blank', 'noopener');
    window.location.assign(`/checkout/success?order=${encodeURIComponent(pedido.numero_pedido)}`);
  });
</script>

