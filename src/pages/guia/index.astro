---
// Indice de guias: hero oscuro compacto (mismo patron que /servicios y
// /eventos) con la foto de "plant care", y tarjetas con la foto de cada guia
// (definida en guides.ts).
import Base from '../../layouts/Base.astro';
import { guides } from '../../data/guides';
---

<Base
  title="Guias de cuidado"
  description="Guías prácticas para cuidar tus plantas en el clima de Panamá: riego, luz, drenaje y temporada de lluvias, escritas por el equipo del vivero."
>
  <section class="guia-hero">
    <div class="guia-hero-photo" style="background-image: url('/fotos_homepage/guias_banda.jpg'); background-size: cover; background-position: center;" aria-hidden="true"></div>
    <div class="guia-hero-scrim" aria-hidden="true"></div>
    <div class="container guia-hero-inner">
      <p class="guia-crumb"><a href="/">Inicio</a> / Guías</p>
      <h1>Cuida tus plantas como lo hacemos en el vivero</h1>
      <p class="guia-sub">
        Consejos prácticos para el clima panameño, escritos por quienes producen las plantas que
        vendemos.
      </p>
    </div>
  </section>

  <section class="container guias-wrap">
    <div class="grid grid--3">
      {guides.map((guide) => (
        <a href={`/guia/${guide.slug}`} class="card guide-card">
          <div
            class="guide-card-photo"
            style={`background-image: url('${guide.photo}'); background-size: cover; background-position: center;`}
            aria-hidden="true"
          ></div>
          <div class="guide-card-copy">
            <h3>{guide.title}</h3>
            <p>{guide.excerpt}</p>
            <span class="read-more">Leer guía →</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  /* Hero compacto oscuro, como el de /servicios. */
  .guia-hero {
    position: relative;
    height: 220px;
    overflow: hidden;
    display: flex;
    align-items: center;
    background: var(--card-dark);
    border-bottom: 1px solid var(--line);
  }

  .guia-hero-photo {
    position: absolute;
    inset: 0;
    background: linear-gradient(150deg, #2a4432, var(--card-dark) 70%);
  }

  .guia-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(27, 42, 31, 0.78), rgba(27, 42, 31, 0.35));
  }

  .guia-hero-inner { position: relative; width: 100%; }

  .guia-crumb {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8ce6a8;
    margin: 0 0 0.55rem;
  }

  .guia-crumb a { color: #8ce6a8; }

  .guia-hero h1 {
    color: #eef5f0;
    font-weight: 600;
    font-size: clamp(1.7rem, 3.4vw, 2.5rem);
    margin: 0;
    max-width: 44rem;
  }

  .guia-sub {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    margin: 0.55rem 0 0;
    max-width: 38rem;
  }

  .guias-wrap { padding-top: 2.3rem; padding-bottom: 74px; }

  .guide-card {
    padding: 0;
    overflow: hidden;
    color: var(--ink);
    display: flex;
    flex-direction: column;
  }

  /* Sin sombras (la unica del sistema es la del boton de WhatsApp). */
  .guide-card:hover {
    text-decoration: none;
    border-color: var(--green);
  }

  .guide-card:hover h3 { text-decoration: underline; }

  .guide-card-photo {
    aspect-ratio: 16 / 9;
    background: var(--surface-2);
  }

  .guide-card-copy {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    flex: 1;
  }

  .guide-card-copy h3 { margin: 0; }

  .guide-card-copy p {
    color: var(--ink-soft);
    font-size: 0.95rem;
    flex: 1;
    margin: 0;
  }

  .read-more {
    color: var(--green);
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>
