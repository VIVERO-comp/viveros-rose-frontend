---
// Pagina "Colecciones" del diseno (claude.ai/design): grilla de teselas
// cuadradas que abren el catalogo ya filtrado (/plantas?c=slug). Los conteos
// se calculan en build sobre el catalogo real, no son cifras decorativas.
import Base from '../layouts/Base.astro';
import NewsletterBand from '../components/NewsletterBand.astro';
import { collections, factsOf } from '../data/collections';
import { productosPublicados } from '../lib/catalogo-build';

// Conteos sobre el catalogo publicado (sin archivados en Odoo).
const products = await productosPublicados();

const tiles = collections.map((c) => {
  const count = products.filter((p) => c.test(factsOf(p))).length;
  return { ...c, count };
});
---

<Base
  title="Colecciones"
  description="Explora todas las colecciones del vivero: por espacio, por facilidad de cuidado, por temporada y por tipo de planta, con disponibilidad real."
>
  <section class="section">
    <div class="container">
      <p class="crumb"><a href="/">Inicio</a> / Colecciones</p>
      <h1>Catálogo</h1>
      <p class="lead">
        Todas las colecciones del vivero: por espacio, por cuidado, por temporada
        y por tipo de planta. Cada colección abre el catálogo ya filtrado.
      </p>

      <div class="tiles">
        {tiles.map((c) => (
          <a href={`/plantas?c=${c.slug}`} class="tile">
            <div
              class="tile-photo"
              style={c.image ? `background-image: url('${c.image}'); background-size: cover; background-position: center;` : undefined}
              aria-hidden="true"
            ></div>
            <span class="tile-name">{c.name}</span>
            <span class="tile-count">{c.count} {c.count === 1 ? 'planta' : 'plantas'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <NewsletterBand />
</Base>

<style>
  .crumb {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 0.55rem;
  }

  .crumb a { color: var(--ink-soft); }

  h1 { font-weight: 600; }

  /* Grilla del diseno: 5 columnas en escritorio, gap 22px. */
  .tiles {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 22px;
    margin-top: 2.3rem;
  }

  @media (max-width: 1000px) {
    .tiles { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 768px) {
    .tiles { grid-template-columns: repeat(2, 1fr); }
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    color: var(--ink);
    text-align: center;
  }

  .tile:hover { color: var(--ink); }
  .tile:hover .tile-name { text-decoration: underline; }

  .tile-photo {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    outline: 1px solid rgba(27, 42, 31, 0.12);
    background: var(--surface-2);
  }

  .tile-name { font-size: 0.88rem; font-weight: 500; }

  .tile-count {
    font-size: 0.75rem;
    color: var(--ink-soft);
    margin-top: -0.3rem;
  }
</style>
