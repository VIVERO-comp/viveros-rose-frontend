---
// Panel de administracion del portal. Misma familia que /repartidor: se
// siente app, movil primero, para mirarse con una mano y al sol. Cuatro
// pantallas con navegacion fija abajo:
//
//   INICIO   resumen del periodo (hoy / semana / mes): pedidos generados,
//            plantas vendidas, valor, la calle (sin tomar / en camino /
//            con retraso) y los tiempos de entrega.
//   PEDIDOS  la lista completa: por validar arriba, luego con retraso,
//            en proceso y los terminados con "Ver mas" (paginados por
//            cursor en el order-api). Detalle con historial.
//   VALIDAR  marcar un pedido como pagado (accion_marcar_pagado en Odoo),
//            con confirmacion explicita y constancia de quien lo hizo.
//   STOCK    buscar una planta y ver su disponibilidad (via stock-proxy).
//
// Los avisos Web Push de pedido nuevo se activan desde Inicio: la misma
// suscripcion del repartidor, pero con la clave de admin en el header, y el
// order-api la guarda con rol "dueno". Un aviso tocado abre
// /admin?pantalla=validar.
//
// La credencial es el enlace personal ...?clave=... de la etiqueta "Admin"
// en Odoo. La clave se guarda en el navegador, se limpia de la URL con
// replaceState y viaja SIEMPRE en el header X-Clave-Admin (peticionAdmin la
// rechaza si aparece en una URL); el order-api la valida contra Odoo en
// cada peticion, asi que rotarla o quitar la etiqueta revoca al instante.
import Base from '../layouts/Base.astro';
import { products } from '../data/products';

// Catalogo local para la busqueda de stock: el nombre y la foto ya viven en
// el frontend; al order-api solo viajan los SKUs elegidos.
const CATALOGO = products.map((p) => ({
  sku: p.sku,
  nombre: p.name,
  image: p.image ?? null,
  emoji: p.emoji,
}));
---

<Base
  noindex
  title="Admin"
  description="Panel de administración de Vivero Rose."
  chrome="bare"
  manifest="/manifest-admin.webmanifest"
>
  <div class="app">
    <!-- Indicador del pull to refresh: un disco que baja con el dedo, con
         un arco que se llena al acercarse al umbral y gira mientras carga.
         Solo tacto; el boton "Actualizar" sigue siendo el respaldo. -->
    <div class="ptr" data-ptr aria-hidden="true">
      <div class="ptr-disco">
        <svg viewBox="0 0 24 24" data-ptr-svg>
          <circle class="ptr-arco" cx="12" cy="12" r="9" pathLength="1"/>
        </svg>
      </div>
    </div>

    <div class="globales">
      <!-- Sin clave o clave revocada: solo se entra con el enlace personal. -->
      <div class="tarjeta" data-sin-clave hidden>
        <p><strong>Falta tu enlace de admin.</strong></p>
        <p>
          Abre el enlace de admin que se genera en Odoo (termina en
          <code>?clave=…</code>), o pégalo aquí:
        </p>
        <form class="form-clave" data-form-clave>
          <input
            type="text"
            data-input-clave
            placeholder="Pega aquí tu enlace o tu clave"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
          />
          <button type="submit" class="btn btn--green">Entrar</button>
        </form>
        <p class="field-error" data-error-clave hidden>Pega el enlace completo o la clave.</p>
        <p class="suave">
          Si el enlace dejó de funcionar, se generó uno más nuevo: cópialo de
          la ficha del contacto en Odoo (pestaña Admin).
        </p>
      </div>

      <p class="portal-mensaje" data-mensaje hidden></p>
    </div>

    <!-- Pantalla 1: INICIO -->
    <section class="pantalla" data-pantalla="inicio">
      <header class="inicio-head">
        <p class="kicker">VIVERO ROSE · ADMIN</p>
        <h1 class="saludo">Hola<span data-nombre></span></h1>
      </header>

      <!-- Avisos push: suena el telefono con cada pedido nuevo. Solo se
           ofrece si el navegador lo soporta y aun no se activo aqui. -->
      <div class="banda-push" data-banda-push hidden>
        <p>Activa los avisos para que te suene el teléfono con cada pedido nuevo.</p>
        <button class="btn btn--green" data-activar-push type="button">Activar avisos</button>
      </div>
      <p class="push-estado" data-push-estado hidden></p>

      <!-- Selector de periodo: segmentado, tocable con el pulgar. -->
      <div class="periodos" role="group" aria-label="Periodo del resumen">
        <button class="periodo periodo--activo" type="button" data-periodo="hoy" aria-pressed="true">Hoy</button>
        <button class="periodo" type="button" data-periodo="semana" aria-pressed="false">Semana</button>
        <button class="periodo" type="button" data-periodo="mes" aria-pressed="false">Mes</button>
      </div>

      <div data-resumen><p class="cargando">Cargando…</p></div>
    </section>

    <!-- Pantalla 2: PEDIDOS -->
    <section class="pantalla" data-pantalla="pedidos" hidden>
      <header class="pantalla-head">
        <h1>Pedidos</h1>
        <button class="btn btn--ghost btn-refrescar" data-refrescar-pedidos type="button">Actualizar</button>
      </header>
      <div data-vista-lista>
        <div data-lista><p class="cargando">Cargando…</p></div>
      </div>
      <div data-vista-detalle hidden>
        <button class="volver" data-volver type="button">← Todos los pedidos</button>
        <div data-detalle></div>
      </div>
    </section>

    <!-- Pantalla 3: VALIDAR -->
    <section class="pantalla" data-pantalla="validar" hidden>
      <header class="pantalla-head">
        <h1>Validar pagos</h1>
        <button class="btn btn--ghost btn-refrescar" data-refrescar-validar type="button">Actualizar</button>
      </header>
      <p class="suave intro-validar">
        Pedidos del checkout esperando tu validación. Los pagos coordinados
        (Yappy, transferencia o efectivo) se marcan como pagados; con tarjeta
        (PagueloFacil) los fondos ya están retenidos y aquí decides: capturar
        (cobra y prepara) o reversar (devuelve y cancela). Todo queda
        registrado a tu nombre.
      </p>
      <div data-validar><p class="cargando">Cargando…</p></div>
    </section>

    <!-- Pantalla 4: STOCK -->
    <section class="pantalla" data-pantalla="stock" hidden>
      <header class="pantalla-head">
        <h1>Stock</h1>
      </header>
      <input
        class="buscador"
        type="search"
        placeholder="Busca una planta por nombre o SKU"
        data-buscador
        autocomplete="off"
      />
      <div data-stock>
        <p class="suave">Escribe al menos 2 letras para buscar en el catálogo.</p>
      </div>
    </section>

    <!-- Pantalla 5: AVISOS -->
    <section class="pantalla" data-pantalla="avisos" hidden>
      <header class="pantalla-head">
        <h1>Avisos</h1>
      </header>
      <p class="suave intro-avisos">
        Un mensaje corto que les suena como notificación a todos los
        repartidores y queda en la pantalla de avisos de su portal.
      </p>
      <form class="tarjeta form-aviso" data-form-aviso>
        <textarea
          data-texto-aviso
          rows="3"
          maxlength="300"
          placeholder="Ej.: Mañana salimos a las 8:00, hay muchos pedidos"
          autocomplete="off"
        ></textarea>
        <div class="aviso-pie">
          <p class="contador" data-contador-aviso>0/120</p>
          <button type="submit" class="btn btn--green" data-boton-aviso>Revisar y mandar</button>
        </div>
        <p class="alcance-aviso" data-alcance-aviso></p>
        <p class="field-error" data-error-aviso hidden></p>
      </form>
      <div class="tarjeta confirmar-aviso" data-confirmar-aviso hidden>
        <p class="suave">Así les va a llegar:</p>
        <div class="notif-preview">
          <img class="notif-icono" src="/icono-192.png" alt="" />
          <span class="notif-textos">
            <span class="notif-titulo">Aviso del vivero</span>
            <span class="notif-cuerpo" data-preview-cuerpo></span>
            <span class="notif-origen">plantaspanama.com · ahora</span>
          </span>
        </div>
        <p class="confirmar-texto" data-confirmar-texto></p>
        <div class="confirmar-botones">
          <button type="button" class="btn btn--ghost" data-cancelar-aviso>Cancelar</button>
          <button type="button" class="btn btn--green" data-mandar-aviso>Mandar ahora</button>
        </div>
      </div>
      <p class="push-estado" data-estado-aviso hidden></p>
      <h2 class="bloque-titulo bloque-titulo--dentro">Últimos avisos</h2>
      <div data-historial-avisos><p class="cargando">Cargando…</p></div>
    </section>
  </div>

  <nav class="tabs" data-tabs aria-label="Pantallas">
    <button class="tab tab--activa" type="button" data-tab="inicio" aria-label="Inicio">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
      <span>Inicio</span>
    </button>
    <button class="tab" type="button" data-tab="pedidos" aria-label="Pedidos">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8.5 12 3 3 8.5v7L12 21l9-5.5v-7Z"/><path d="M3 8.5 12 14l9-5.5"/><path d="M12 14v7"/></svg>
      <span>Pedidos</span>
    </button>
    <button class="tab" type="button" data-tab="validar" aria-label="Validar pagos">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 4.5-5"/></svg>
      <span>Validar</span>
      <span class="tab-globito" data-globito-validar hidden></span>
    </button>
    <button class="tab" type="button" data-tab="stock" aria-label="Stock">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <span>Stock</span>
    </button>
    <button class="tab" type="button" data-tab="avisos" aria-label="Avisos a repartidores">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 9 20 4v16L7 15H4.5A1.5 1.5 0 0 1 3 13.5v-3A1.5 1.5 0 0 1 4.5 9H7Z"/><path d="M9 15v3.5A1.5 1.5 0 0 0 10.5 20H11"/></svg>
      <span>Avisos</span>
    </button>
  </nav>
</Base>

<script is:inline define:vars={{ CATALOGO }}>
  window.CATALOGO_ADMIN = CATALOGO;
</script>

<script>
  import { ETIQUETA_ESTADO, agruparPedidos, metodoPagoCorto, duracionLegible, minutosDesde, peticionAdmin } from '../lib/admin';
  import { instalarTirarParaRefrescar } from '../lib/refrescar';

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const mensajeEl = $('[data-mensaje]');
  const resumenEl = $('[data-resumen]');
  const listaEl = $('[data-lista]');
  const detalleEl = $('[data-detalle]');
  const vistaLista = $('[data-vista-lista]');
  const vistaDetalle = $('[data-vista-detalle]');
  const validarEl = $('[data-validar]');
  const stockEl = $('[data-stock]');

  const CATALOGO: { sku: string; nombre: string; image: string | null; emoji: string }[] =
    (window as any).CATALOGO_ADMIN ?? [];

  // -- credencial -----------------------------------------------------------

  const parametros = new URLSearchParams(location.search);
  const claveUrl = parametros.get('clave');
  if (claveUrl) localStorage.setItem('vr_clave_admin', claveUrl);
  // Un aviso push abre directo la pantalla que toca (/admin?pantalla=validar).
  const pantallaUrl = parametros.get('pantalla');
  if (claveUrl || pantallaUrl) {
    // La clave no se queda en la barra, en el historial ni en logs.
    history.replaceState(null, '', '/admin');
  }
  const clave = claveUrl || localStorage.getItem('vr_clave_admin') || '';

  // -- errores --------------------------------------------------------------

  // "Revisa tu señal" es solo para cuando NO hubo respuesta (fetch lanzo).
  // Si el servidor respondio, se muestra lo que dijo: un 403 o un 404
  // tapados con el mensaje de señal mandan a la gente a buscar cobertura
  // por un problema que no es de red.
  class ErrorServidor extends Error {}

  async function errorDe(res: Response): Promise<ErrorServidor> {
    let detalle = '';
    try {
      const texto = await res.text();
      try {
        const datos = JSON.parse(texto);
        detalle = datos?.message || datos?.error || '';
      } catch {
        detalle = texto.trim().slice(0, 120);
      }
    } catch {
      // sin cuerpo legible: queda solo el codigo
    }
    return new ErrorServidor(
      detalle ? `${detalle} (HTTP ${res.status})` : `El servidor respondió HTTP ${res.status}.`,
    );
  }

  function textoDeError(error: unknown, sinRespuesta: string): string {
    return error instanceof ErrorServidor ? error.message : sinRespuesta;
  }

  function mensaje(texto: string) {
    mensajeEl.textContent = texto;
    mensajeEl.hidden = !texto;
  }

  function escapar(texto: string): string {
    const div = document.createElement('div');
    div.textContent = texto;
    return div.innerHTML;
  }

  const dinero = (centavos: number) => `$${(centavos / 100).toFixed(2)}`;

  function fechaOdoo(valor: string): Date {
    return new Date(valor.replace(' ', 'T') + 'Z');
  }

  const cuando = (valor: string) =>
    fechaOdoo(valor).toLocaleString('es-PA', {
      day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit',
    });

  function htmlComoTexto(html: string): string {
    const doc = new DOMParser().parseFromString(html, 'text/html');
    return (doc.body.textContent ?? '').trim();
  }

  function sinClave() {
    $('[data-sin-clave]').hidden = false;
    document.querySelectorAll<HTMLElement>('.pantalla').forEach((el) => (el.hidden = true));
    ($('[data-tabs]') as HTMLElement).style.display = 'none';
  }

  function manejar401() {
    localStorage.removeItem('vr_clave_admin');
    mensaje('');
    sinClave();
    $('[data-error-clave]').hidden = true;
  }

  async function pedirAdmin(ruta: string, init: RequestInit = {}): Promise<Response> {
    const { url, init: opciones } = peticionAdmin(ruta, clave, init);
    return fetch(url, opciones);
  }

  // -- pantallas y navegacion -----------------------------------------------

  type Pantalla = 'inicio' | 'pedidos' | 'validar' | 'stock' | 'avisos';
  let pantallaActual: Pantalla = 'inicio';

  function animarEntrada(el: HTMLElement, clase: string) {
    el.classList.add(clase);
    void el.offsetWidth;
    el.classList.remove(clase);
  }

  const CARGADORES: Record<Pantalla, () => void> = {
    inicio: () => cargarResumen(),
    pedidos: cargarPedidos,
    validar: cargarPedidos,
    stock: () => {},
    avisos: cargarAvisos,
  };

  function cambiarPantalla(destino: Pantalla) {
    mensaje('');
    document.querySelectorAll<HTMLElement>('[data-tab]').forEach((tab) => {
      tab.classList.toggle('tab--activa', tab.getAttribute('data-tab') === destino);
    });
    document.querySelectorAll<HTMLElement>('[data-pantalla]').forEach((pantalla) => {
      const activa = pantalla.getAttribute('data-pantalla') === destino;
      if (activa && pantalla.hidden) {
        pantalla.hidden = false;
        animarEntrada(pantalla, 'pantalla-entrando');
      } else if (!activa) {
        pantalla.hidden = true;
      }
    });
    pantallaActual = destino;
    window.scrollTo(0, 0);
    if (clave) CARGADORES[destino]();
  }

  document.querySelectorAll<HTMLElement>('[data-tab]').forEach((tab) => {
    tab.addEventListener('click', () => cambiarPantalla(tab.getAttribute('data-tab') as Pantalla));
  });

  // -- pantalla INICIO ------------------------------------------------------

  let periodoActual = 'hoy';

  document.querySelectorAll<HTMLButtonElement>('[data-periodo]').forEach((boton) => {
    boton.addEventListener('click', () => {
      periodoActual = boton.getAttribute('data-periodo')!;
      document.querySelectorAll<HTMLButtonElement>('[data-periodo]').forEach((b) => {
        const activo = b === boton;
        b.classList.toggle('periodo--activo', activo);
        b.setAttribute('aria-pressed', String(activo));
      });
      cargarResumen();
    });
  });

  async function cargarResumen() {
    try {
      const res = await pedirAdmin(`/api/admin/resumen?periodo=${periodoActual}`);
      if (res.status === 401) {
        manejar401();
        return;
      }
      if (!res.ok) throw await errorDe(res);
      pintarResumen(await res.json());
    } catch (error) {
      resumenEl.innerHTML = '';
      mensaje(textoDeError(error, 'No pudimos cargar el resumen. Revisa tu señal e intenta de nuevo.'));
    }
  }

  const ETIQUETA_PERIODO: Record<string, string> = {
    hoy: 'hoy', semana: 'esta semana', mes: 'este mes',
  };

  function pintarResumen(datos: any) {
    const pedidos = datos.pedidos;
    const vendido = datos.vendido;
    const retenido = datos.retenido;
    const calle = datos.calle ?? {};
    const tiempos = datos.tiempos ?? {};
    const retrasoAlto = (calle.con_retraso ?? 0) > 0;
    // Retenido > 0 es una decision pendiente (capturar o reversar): se
    // resalta como el retraso.
    const retenidoAlto = (retenido?.pedidos ?? 0) > 0;
    // Las secciones operativas solo aparecen cuando hay algo que mirar:
    // sin repartos en curso ni entregas medidas serian puras cifras en cero.
    const hayCalle = (calle.sin_tomar ?? 0) > 0 || (calle.en_camino ?? 0) > 0 || retrasoAlto;
    const hayTiempos = tiempos.promedio_minutos != null || tiempos.ultimo_minutos != null;
    resumenEl.innerHTML = `
      <div class="tarjeta-valor">
        <p class="valor-etiqueta">Vendido ${ETIQUETA_PERIODO[datos.periodo] ?? ''}</p>
        <p class="valor-monto">${vendido ? dinero(vendido.valor_centavos) : '—'}</p>
        <p class="valor-detalle">${
          vendido
            ? `${vendido.pedidos === 1 ? '1 pedido cobrado o validado' : `${vendido.pedidos} pedidos cobrados o validados`} · ${
                vendido.plantas === 1 ? '1 planta' : `${vendido.plantas} plantas`
              }`
            : 'Sin datos de la tienda ahora mismo'
        }</p>
      </div>

      <div class="metricas metricas--resumen">
        <div class="metrica">
          <span class="metrica-numero">${pedidos?.generados ?? '—'}</span>
          <span class="metrica-nombre">Pedidos ${ETIQUETA_PERIODO[datos.periodo] ?? ''}</span>
          ${
            pedidos
              ? `<span class="metrica-detalle">${dinero(pedidos.valor_centavos)} · ${
                  pedidos.plantas === 1 ? '1 planta' : `${pedidos.plantas} plantas`
                }</span>`
              : ''
          }
        </div>
        <div class="metrica ${retenidoAlto ? 'metrica--alerta' : ''}">
          <span class="metrica-numero metrica-numero--chica">${retenido ? dinero(retenido.valor_centavos) : '—'}</span>
          <span class="metrica-nombre">Retenido por capturar</span>
          ${
            retenido
              ? `<span class="metrica-detalle">${
                  retenido.pedidos === 1 ? '1 pedido' : `${retenido.pedidos} pedidos`
                }</span>`
              : ''
          }
        </div>
      </div>

      ${
        hayCalle
          ? `<h2 class="bloque-titulo">La calle ahora</h2>
      <div class="metricas metricas--tres">
        <div class="metrica">
          <span class="metrica-numero">${calle.sin_tomar ?? '—'}</span>
          <span class="metrica-nombre">Sin tomar</span>
        </div>
        <div class="metrica">
          <span class="metrica-numero">${calle.en_camino ?? '—'}</span>
          <span class="metrica-nombre">En camino</span>
        </div>
        <div class="metrica ${retrasoAlto ? 'metrica--alerta' : ''}">
          <span class="metrica-numero">${calle.con_retraso ?? '—'}</span>
          <span class="metrica-nombre">Con retraso</span>
        </div>
      </div>`
          : ''
      }

      ${
        hayTiempos
          ? `<h2 class="bloque-titulo">Tiempo de entrega</h2>
      <div class="metricas">
        <div class="metrica">
          <span class="metrica-numero metrica-numero--chica">${duracionLegible(tiempos.promedio_minutos)}</span>
          <span class="metrica-nombre">Promedio (pago → entrega${
            tiempos.entregas ? `, ${tiempos.entregas === 1 ? '1 entrega' : `${tiempos.entregas} entregas`}` : ''
          })</span>
        </div>
        <div class="metrica">
          <span class="metrica-numero metrica-numero--chica">${duracionLegible(tiempos.ultimo_minutos)}</span>
          <span class="metrica-nombre">Último pedido entregado</span>
        </div>
      </div>`
          : ''
      }`;
  }

  // -- pantalla PEDIDOS y VALIDAR (comparten la carga) ----------------------

  let porValidar: any[] = [];
  // Los bloques ordenados de la lista y el cursor del "Ver mas" de
  // terminados (fecha de fin + numero del ultimo mostrado, como lo
  // devuelve el order-api).
  let bloques = agruparPedidos({});
  let cursorAntesDe: string | null = null;
  let cursorNumero: string | null = null;

  async function cargarPedidos() {
    vistaDetalle.hidden = true;
    vistaLista.hidden = false;
    try {
      const res = await pedirAdmin('/api/admin/pedidos');
      if (res.status === 401) {
        manejar401();
        return;
      }
      if (!res.ok) throw await errorDe(res);
      const datos = await res.json();
      bloques = agruparPedidos(datos);
      // Solo lo que espera una decision: pagos coordinados por confirmar y
      // tarjetas autorizadas por capturar. Lo demas no cuenta en el globito.
      porValidar = bloques.porValidar;
      cursorAntesDe = datos.siguiente_antes_de ?? null;
      cursorNumero = datos.siguiente_numero ?? null;
      pintarPedidos();
      pintarValidar();
      pintarGlobitoValidar();
    } catch (error) {
      listaEl.innerHTML = '';
      validarEl.innerHTML = '';
      mensaje(textoDeError(error, 'No pudimos cargar los pedidos. Revisa tu señal y toca “Actualizar”.'));
    }
  }

  function pintarGlobitoValidar() {
    const globito = $('[data-globito-validar]');
    globito.hidden = porValidar.length === 0;
    globito.textContent = porValidar.length > 9 ? '9+' : String(porValidar.length);
  }

  function resumenArticulos(articulos: any[]): string {
    const total = articulos.reduce((suma, a) => suma + (a.cantidad ?? 0), 0);
    return total === 1 ? '1 artículo' : `${total} artículos`;
  }

  // La descripcion de Odoo llega como "[SKU] NOMBRE": en la tarjeta de la
  // lista alcanza con el nombre; el SKU vive en el detalle.
  function nombrePlanta(descripcion: string): string {
    return (descripcion ?? '').replace(/^\[[^\]]*\]\s*/, '');
  }

  // Que plantas lleva el pedido, como en el portal del repartidor: las
  // primeras con su cantidad, y "+N más" si son muchas. Devuelve la linea
  // completa (o nada) para no dejar un hueco cuando no hay articulos.
  function lineaPlantas(articulos: any[], maximo = 3): string {
    if (!articulos?.length) return '';
    const partes = articulos
      .slice(0, maximo)
      .map((a) => `${Math.round(a.cantidad ?? 0)}× ${nombrePlanta(a.descripcion)}`);
    const resto = articulos.length - maximo;
    const texto = escapar(partes.join(' · ') + (resto > 0 ? ` +${resto} más` : ''));
    return `<span class="pedido-plantas">${texto}</span>`;
  }

  function tarjetaPedido(p: any): string {
    const desde = p.en_camino_desde
      ? `hace ${duracionLegible(minutosDesde(p.en_camino_desde, new Date()))}`
      : null;
    // La esquina de abajo: quien lo lleva, o desde cuando espera validacion.
    const derecha =
      p.estado === 'por_validar'
        ? p.creado_en
          ? `Pedido el ${cuando(p.creado_en)}`
          : 'Esperando validación'
        : p.repartidor
          ? `${escapar(p.repartidor)}${desde ? ' · ' + desde : ''}`
          : 'Sin repartidor';
    return `
      <button class="tarjeta pedido-card ${p.con_retraso ? 'pedido-card--retraso' : ''}"
              data-numero="${escapar(p.numero)}" type="button">
        <span class="pedido-linea1">
          <span class="pedido-numero">${escapar(p.numero)}</span>
          <span class="chip chip--${p.estado}">${ETIQUETA_ESTADO[p.estado] ?? p.estado}</span>
        </span>
        <span class="pedido-linea2">
          <span>${escapar(p.cliente ?? 'Cliente')}${p.zona ? ' · ' + escapar(p.zona) : ''}</span>
          <span class="pedido-total">$${Number(p.total).toFixed(2)}</span>
        </span>
        ${lineaPlantas(p.articulos ?? [])}
        <span class="pedido-linea2 suave">
          <span>${resumenArticulos(p.articulos ?? [])}</span>
          <span>${derecha}</span>
        </span>
        ${p.con_retraso ? '<span class="chip chip--retraso">Con retraso</span>' : ''}
      </button>`;
  }

  // Un terminado se lee de un vistazo: que paso y cuando termino.
  function tarjetaTerminado(p: any): string {
    return `
      <button class="tarjeta pedido-card pedido-card--terminado"
              data-numero="${escapar(p.numero)}" type="button">
        <span class="pedido-linea1">
          <span class="pedido-numero">${escapar(p.numero)}</span>
          <span class="chip chip--${p.estado}">${ETIQUETA_ESTADO[p.estado] ?? p.estado}</span>
        </span>
        <span class="pedido-linea2">
          <span>${escapar(p.cliente ?? 'Cliente')}${p.zona ? ' · ' + escapar(p.zona) : ''}</span>
          <span class="pedido-total">$${Number(p.total).toFixed(2)}</span>
        </span>
        ${lineaPlantas(p.articulos ?? [])}
        <span class="pedido-linea2 suave">
          <span>${ETIQUETA_ESTADO[p.estado] ?? ''} el ${p.terminado_en ? cuando(p.terminado_en) : '—'}</span>
        </span>
      </button>`;
  }

  // Fila compacta para lo que espera decision o pago: se ve el estado y
  // abre el detalle, sin repetir la tarjeta completa (las acciones viven
  // SOLO en la pestaña Validar).
  function filaPendiente(p: any, etiqueta: string, chip: string): string {
    const metodo = metodoPagoCorto(p);
    return `
      <button class="tarjeta pedido-card pedido-card--compacta" data-numero="${escapar(p.numero)}" type="button">
        <span class="pedido-linea1">
          <span class="pedido-numero">${escapar(p.numero)}</span>
          <span class="chip ${chip}">${etiqueta}</span>
        </span>
        ${lineaPlantas(p.articulos ?? [])}
        <span class="pedido-linea2 suave">
          <span>${escapar(p.cliente ?? 'Cliente')}${p.zona ? ' · ' + escapar(p.zona) : ''}${metodo ? ' · ' + escapar(metodo) : ''}</span>
          <span class="pedido-total">$${Number(p.total).toFixed(2)}</span>
        </span>
      </button>`;
  }

  function pintarPedidos() {
    const { porValidar: nuevos, esperandoPago, conRetraso, enProceso, terminados } = bloques;
    if (!nuevos.length && !esperandoPago.length && !conRetraso.length && !enProceso.length && !terminados.length) {
      listaEl.innerHTML = '<div class="tarjeta vacio"><p>No hay pedidos todavía.</p></div>';
      return;
    }
    listaEl.innerHTML = [
      // El contador de arriba: cuantos esperan validacion. Solo informa y
      // remite a la pestaña Validar: aca no hay botones de accion (Pedidos
      // es vista de consulta; validar, capturar y reversar viven SOLO en la
      // pestaña Validar). Con cero no se pinta.
      nuevos.length
        ? `<div class="banda-validar">
             <p>${nuevos.length === 1 ? '1 pedido espera' : `${nuevos.length} pedidos esperan`} tu decisión en la pestaña <strong>Validar</strong></p>
           </div>`
        : '',
      nuevos.length
        ? '<h2 class="bloque-titulo">Por validar</h2>' +
          nuevos.map((p: any) => filaPendiente(p, 'Por validar', 'chip--por_validar')).join('')
        : '',
      // Tarjetas sin autorizar: el cliente no completo el pago; no hay nada
      // que decidir, pero el pedido existe y se ve aqui.
      esperandoPago.length
        ? '<h2 class="bloque-titulo">Esperando pago</h2>' +
          esperandoPago.map((p: any) => filaPendiente(p, 'Esperando pago', 'chip--esperando')).join('')
        : '',
      conRetraso.length
        ? '<h2 class="bloque-titulo bloque-titulo--alerta">Con retraso</h2>' +
          conRetraso.map(tarjetaPedido).join('')
        : '',
      enProceso.length
        ? '<h2 class="bloque-titulo">En proceso</h2>' + enProceso.map(tarjetaPedido).join('')
        : '',
      terminados.length
        ? '<h2 class="bloque-titulo">Terminados</h2>' + terminados.map(tarjetaTerminado).join('')
        : '',
      // La pagina siguiente de terminados: mas viejos que el cursor.
      cursorAntesDe
        ? '<button class="btn btn--ghost btn-ver-mas" data-ver-mas type="button">Ver más</button>'
        : '',
    ].join('');
    listaEl.querySelectorAll('[data-numero]').forEach((el) =>
      el.addEventListener('click', () => abrirDetalle(el.getAttribute('data-numero')!)),
    );
    listaEl.querySelector('[data-ver-mas]')?.addEventListener('click', verMasTerminados);
  }

  async function verMasTerminados() {
    const boton = listaEl.querySelector<HTMLButtonElement>('[data-ver-mas]');
    if (!boton || !cursorAntesDe) return;
    boton.disabled = true;
    boton.textContent = 'Cargando…';
    try {
      const consulta = new URLSearchParams({ antes_de: cursorAntesDe });
      if (cursorNumero) consulta.set('numero', cursorNumero);
      const res = await pedirAdmin(`/api/admin/pedidos/terminados?${consulta}`);
      if (res.status === 401) {
        manejar401();
        return;
      }
      if (!res.ok) throw await errorDe(res);
      const datos = await res.json();
      bloques.terminados.push(...(datos.terminados ?? []));
      cursorAntesDe = datos.siguiente_antes_de ?? null;
      cursorNumero = datos.siguiente_numero ?? null;
      pintarPedidos();
    } catch (error) {
      boton.disabled = false;
      boton.textContent = 'Ver más';
      mensaje(textoDeError(error, 'No pudimos cargar más pedidos. Revisa tu señal e intenta de nuevo.'));
    }
  }

  let numeroDetalleAbierto = '';

  // Al abrir un pedido, sus notificaciones push (que llevan el numero VR-…
  // en el titulo o el cuerpo) se dan por vistas: se cierran en el centro de
  // notificaciones y el globito del icono se recalcula (el service worker
  // cuenta las que siguen abiertas; con cero, clearAppBadge lo quita).
  // Fire-and-forget y silencioso: sin service worker o sin permiso de
  // avisos no hay nada que limpiar.
  async function limpiarAvisosDelPedido(numero: string) {
    try {
      const registro = await navigator.serviceWorker?.getRegistration();
      if (!registro) return;
      const avisos = await registro.getNotifications();
      let cerrados = 0;
      for (const aviso of avisos) {
        if (`${aviso.title} ${aviso.body ?? ''}`.includes(numero)) {
          aviso.close();
          cerrados++;
        }
      }
      if (!cerrados || !('setAppBadge' in navigator)) return;
      const restantes = avisos.length - cerrados;
      if (restantes > 0) await navigator.setAppBadge(restantes);
      else await (navigator as any).clearAppBadge?.();
    } catch {
      // sin soporte o sin permiso: no hay globito que limpiar
    }
  }

  async function abrirDetalle(numero: string) {
    numeroDetalleAbierto = numero;
    void limpiarAvisosDelPedido(numero);
    vistaLista.hidden = true;
    vistaDetalle.hidden = false;
    animarEntrada(vistaDetalle, 'detalle-entrando');
    window.scrollTo(0, 0);
    detalleEl.innerHTML = '<p class="cargando">Cargando pedido…</p>';
    try {
      const res = await pedirAdmin(`/api/admin/pedidos/${encodeURIComponent(numero)}`);
      if (!res.ok) throw new Error();
      pintarDetalle(await res.json());
    } catch {
      detalleEl.innerHTML =
        '<div class="tarjeta"><p>No pudimos cargar este pedido. Vuelve a la lista e intenta de nuevo.</p></div>';
    }
  }

  function pintarDetalle(p: any) {
    const items = (p.articulos ?? [])
      .map(
        (item: any) => `
        <li class="item">
          <span class="item-nombre">${escapar(item.descripcion)}</span>
          <span class="item-cant">× ${item.cantidad}</span>
        </li>`,
      )
      .join('');
    // El historial: los hitos sellados del flujo, mas las notas del chatter
    // (ahi quedan las validaciones del panel, con quien y cuando).
    // Cancelado no es un paso del camino: si el pedido se cancelo, quedan
    // solo los hitos que si pasaron y el sello de la cancelacion al final.
    let pasos: [string, string | null | undefined][] = [
      ['Creado', p.hitos?.creado_en],
      ['Pagado', p.hitos?.pagado_en],
      ['En camino', p.hitos?.en_camino_en],
      ['Entregado', p.hitos?.entregado_en],
    ];
    if (p.hitos?.cancelado_en) {
      pasos = [...pasos.filter(([, fecha]) => fecha), ['Cancelado', p.hitos.cancelado_en]];
    }
    const hitos = pasos
      .map(
        ([nombre, fecha]) => `
        <p class="hito ${fecha ? '' : 'hito--pendiente'}">
          <span class="hito-punto"></span>
          <span class="hito-nombre">${nombre}</span>
          <span class="hito-fecha">${fecha ? cuando(fecha as string) : 'Pendiente'}</span>
        </p>`,
      )
      .join('');
    const notas = (p.notas ?? [])
      .map(
        (nota: any) => `
        <p class="nota">
          <span>${escapar(htmlComoTexto(nota.texto))}</span>
          <span class="suave">${nota.autor ? escapar(nota.autor) + ' · ' : ''}${nota.fecha ? cuando(nota.fecha) : ''}</span>
        </p>`,
      )
      .join('');
    // Pedidos es vista de consulta: si este pedido espera una decision
    // (pago coordinado por confirmar o tarjeta autorizada por capturar),
    // aca solo se avisa; los botones viven SOLO en la pestaña Validar.
    const esperaDecision = porValidar.some((v: any) => v.numero === p.numero);
    detalleEl.innerHTML = `
      <div class="tarjeta ${p.con_retraso ? 'pedido-card--retraso' : ''}">
        <p class="pedido-linea1">
          <span class="pedido-numero">${escapar(p.numero)}</span>
          <span class="chip chip--${p.estado}">${ETIQUETA_ESTADO[p.estado] ?? p.estado ?? 'Sin validar'}</span>
        </p>
        ${esperaDecision ? '<p class="suave">⏳ Este pedido espera tu decisión: está en la pestaña <strong>Validar</strong>.</p>' : ''}
        <p class="detalle-cliente">${escapar(p.cliente ?? 'Cliente')}</p>
        ${p.repartidor ? `<p class="suave">Lo lleva ${escapar(p.repartidor)}</p>` : ''}
        ${p.con_retraso ? '<span class="chip chip--retraso">Con retraso</span>' : ''}
        <ul class="items">${items}</ul>
        <p class="detalle-total">Total: <strong>$${Number(p.total).toFixed(2)}</strong></p>
        ${p.nota ? `<pre class="detalle-nota">${escapar(htmlComoTexto(p.nota))}</pre>` : ''}
      </div>
      <div class="tarjeta">
        <h2 class="bloque-titulo bloque-titulo--dentro">Historial</h2>
        <div class="hitos">${hitos}</div>
        ${notas ? `<div class="notas">${notas}</div>` : ''}
      </div>`;
  }

  $('[data-volver]').addEventListener('click', cargarPedidos);
  $('[data-refrescar-pedidos]').addEventListener('click', cargarPedidos);
  $('[data-refrescar-validar]').addEventListener('click', cargarPedidos);

  // -- pantalla VALIDAR -----------------------------------------------------

  function pintarValidar() {
    if (!porValidar.length) {
      validarEl.innerHTML =
        '<div class="tarjeta vacio"><p>No hay pagos por validar.</p>' +
        '<p class="suave">Cuando entre un pedido nuevo aparecerá aquí.</p></div>';
      return;
    }
    // Dos grupos, sin mezclar decisiones distintas: confirmar un pago
    // coordinado (Yappy/transferencia/efectivo) y capturar o reversar una
    // tarjeta autorizada.
    const coordinados = porValidar.filter((p: any) => !p.pago?.tarjeta);
    const tarjetas = porValidar.filter((p: any) => p.pago?.tarjeta);
    const tarjetaValidar = (p: any) => {
      const metodo = metodoPagoCorto(p);
      return `
        <div class="tarjeta por-validar" data-validar-numero="${escapar(p.numero)}">
          <p class="pedido-linea1">
            <span class="pedido-numero">${escapar(p.numero)}</span>
            <span class="pedido-total">$${Number(p.total).toFixed(2)}</span>
          </p>
          <p class="pedido-linea2">
            <span>${escapar(p.cliente ?? 'Cliente')}</span>
            <span class="suave">${p.creado_en ? cuando(p.creado_en) : ''}</span>
          </p>
          <p class="suave">${resumenArticulos(p.articulos ?? [])}${metodo ? ' · ' + escapar(metodo) : ''}</p>
          ${zonaValidar(p)}
        </div>`;
    };
    validarEl.innerHTML = [
      coordinados.length
        ? '<h2 class="bloque-titulo bloque-titulo--dentro">Pagos por confirmar</h2>' +
          coordinados.map(tarjetaValidar).join('')
        : '',
      tarjetas.length
        ? '<h2 class="bloque-titulo">Tarjetas autorizadas · capturar o reversar</h2>' +
          tarjetas.map(tarjetaValidar).join('')
        : '',
    ].join('');
    validarEl.querySelectorAll<HTMLElement>('[data-validar-numero]').forEach((tarjeta) => {
      const numero = tarjeta.getAttribute('data-validar-numero')!;
      // Confirmacion explicita en dos pasos, nunca un toque suelto.
      armarDosPasos(tarjeta, '[data-pedir-confirmacion]', '[data-confirmacion]', '[data-cancelar]');
      tarjeta
        .querySelector<HTMLButtonElement>('[data-confirmar]')
        ?.addEventListener('click', (e) => validarPago(numero, tarjeta, e.target as HTMLButtonElement));
      // Tarjeta pre-autorizada: capturar (cobra y prepara) o reversar
      // (devuelve la retencion y cancela). Cada boton esconde al otro
      // mientras su confirmacion esta abierta.
      armarDosPasos(
        tarjeta, '[data-pedir-captura]', '[data-confirmacion-captura]',
        '[data-cancelar-captura]', ['[data-pedir-reverso]'],
      );
      armarDosPasos(
        tarjeta, '[data-pedir-reverso]', '[data-confirmacion-reverso]',
        '[data-cancelar-reverso]', ['[data-pedir-captura]'],
      );
      tarjeta
        .querySelector<HTMLButtonElement>('[data-confirmar-captura]')
        ?.addEventListener('click', (e) =>
          accionTarjeta(numero, tarjeta, e.target as HTMLButtonElement, 'capturar'));
      tarjeta
        .querySelector<HTMLButtonElement>('[data-confirmar-reverso]')
        ?.addEventListener('click', (e) =>
          accionTarjeta(numero, tarjeta, e.target as HTMLButtonElement, 'reversar'));
    });
  }

  // La zona de acciones de cada "por validar": un pago coordinado (Yappy,
  // transferencia, efectivo) se marca pagado a mano; una tarjeta
  // pre-autorizada (PagueloFacil) tiene los fondos retenidos y se captura o
  // se reversa; una tarjeta que aun no autorizo no tiene nada que validar.
  function zonaValidar(p: any): string {
    const pago = p.pago;
    if (pago?.tarjeta && pago.estado === 'autorizada') {
      const vence = pago.vence_en ? cuandoVence(pago.vence_en) : null;
      return `
          <div class="zona-validar">
            <p class="pago-tarjeta">💳 Tarjeta pre-autorizada: los fondos están retenidos, sin cobrar.${
              vence ? ` Captura antes del <strong>${escapar(vence)}</strong>.` : ''
            }</p>
            <div class="confirmacion-botones">
              <button class="btn btn--green btn-grande" type="button" data-pedir-captura>
                Capturar pago
              </button>
              <button class="btn btn--ghost btn-reversar" type="button" data-pedir-reverso>Reversar</button>
            </div>
            <div class="confirmacion" data-confirmacion-captura hidden>
              <p><strong>¿Hay stock y sale ${escapar(p.numero)}?</strong>
                 El sistema va a cobrar la retención de la tarjeta del cliente y el
                 pedido queda listo para salir.</p>
              <div class="confirmacion-botones">
                <button class="btn btn--green btn-grande" type="button" data-confirmar-captura>Sí, capturar el pago</button>
                <button class="btn btn--ghost" type="button" data-cancelar-captura>Cancelar</button>
              </div>
            </div>
            <div class="confirmacion" data-confirmacion-reverso hidden>
              <p><strong>¿Reversar ${escapar(p.numero)}?</strong>
                 La retención se devuelve completa al cliente y el pedido se cancela.
                 No se puede deshacer.</p>
              <div class="confirmacion-botones">
                <button class="btn btn--ghost btn-reversar btn-grande" type="button" data-confirmar-reverso>Sí, reversar y cancelar</button>
                <button class="btn btn--ghost" type="button" data-cancelar-reverso>Cancelar</button>
              </div>
            </div>
            <p class="validar-estado" data-validar-estado hidden></p>
          </div>`;
    }
    if (pago?.tarjeta) {
      // Tarjeta sin autorizar todavia (el cliente no completo el pago) o ya
      // reversada: no hay nada que validar a mano.
      return `
          <div class="zona-validar">
            <p class="pago-tarjeta suave">💳 Pago con tarjeta ${
              pago.estado === 'reversada' ? 'reversado' : 'sin completar todavía'
            }: no hay nada que validar por ahora.</p>
          </div>`;
    }
    // Pago coordinado (Yappy, transferencia, efectivo): la accion es que
    // ABRAHAM confirma que el dinero ya le llego. Es distinta de la captura
    // de tarjeta (donde el SISTEMA cobra la retencion) y el texto lo dice.
    return `
          <div class="zona-validar">
            <button class="btn btn--green btn-grande" type="button" data-pedir-confirmacion>
              Confirmar pago recibido
            </button>
            <div class="confirmacion" data-confirmacion hidden>
              <p><strong>¿Recibiste el pago de ${escapar(p.numero)}?</strong>
                 Estás confirmando que el dinero ya te llegó (Yappy, transferencia o
                 efectivo). El pedido quedará listo para salir y la validación se
                 registra a tu nombre.</p>
              <div class="confirmacion-botones">
                <button class="btn btn--green btn-grande" type="button" data-confirmar>Sí, ya recibí el pago</button>
                <button class="btn btn--ghost" type="button" data-cancelar>Cancelar</button>
              </div>
            </div>
            <p class="validar-estado" data-validar-estado hidden></p>
          </div>`;
  }

  /** Fecha limite de captura (ISO con zona) en horario legible de Panama. */
  function cuandoVence(valor: string): string {
    return new Date(valor).toLocaleString('es-PA', {
      day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit',
    });
  }

  /** Confirmacion en dos pasos: abrir esconde el disparador (y los botones
      hermanos), cancelar lo restaura. Silencioso si la tarjeta no tiene
      estos elementos (cada zona trae solo los suyos). */
  function armarDosPasos(
    tarjeta: HTMLElement,
    abrirSel: string,
    confirmacionSel: string,
    cancelarSel: string,
    ocultarTambien: string[] = [],
  ) {
    const abrir = tarjeta.querySelector<HTMLButtonElement>(abrirSel);
    const confirmacion = tarjeta.querySelector<HTMLElement>(confirmacionSel);
    if (!abrir || !confirmacion) return;
    const hermanos = ocultarTambien
      .map((sel) => tarjeta.querySelector<HTMLElement>(sel))
      .filter((el): el is HTMLElement => el !== null);
    abrir.addEventListener('click', () => {
      abrir.hidden = true;
      hermanos.forEach((el) => (el.hidden = true));
      confirmacion.hidden = false;
      animarEntrada(confirmacion, 'pantalla-entrando');
    });
    tarjeta.querySelector<HTMLButtonElement>(cancelarSel)?.addEventListener('click', () => {
      confirmacion.hidden = true;
      abrir.hidden = false;
      hermanos.forEach((el) => (el.hidden = false));
    });
  }

  async function accionTarjeta(
    numero: string,
    tarjeta: HTMLElement,
    boton: HTMLButtonElement,
    accion: 'capturar' | 'reversar',
  ) {
    const estado = tarjeta.querySelector<HTMLElement>('[data-validar-estado]')!;
    const textoOriginal = boton.textContent ?? '';
    boton.disabled = true;
    boton.textContent = accion === 'capturar' ? 'Capturando…' : 'Reversando…';
    try {
      const res = await pedirAdmin(
        `/api/admin/pedidos/${encodeURIComponent(numero)}/${accion}-pago`,
        { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' },
      );
      if (res.status === 401) {
        manejar401();
        return;
      }
      if (!res.ok) throw await errorDe(res);
      tarjeta.querySelectorAll<HTMLElement>('.confirmacion').forEach((c) => (c.hidden = true));
      estado.hidden = false;
      estado.textContent =
        accion === 'capturar'
          ? `✅ ${numero}: pago capturado, quedó listo para salir.`
          : `↩️ ${numero}: la retención se devolvió y el pedido quedó cancelado.`;
      porValidar = porValidar.filter((p) => p.numero !== numero);
      pintarGlobitoValidar();
      setTimeout(() => {
        tarjeta.classList.add('por-validar--saliendo');
        setTimeout(() => {
          tarjeta.remove();
          if (!porValidar.length) pintarValidar();
        }, 220);
      }, 1600);
    } catch (error) {
      boton.disabled = false;
      boton.textContent = textoOriginal;
      estado.hidden = false;
      estado.textContent = textoDeError(
        error,
        accion === 'capturar'
          ? 'No se pudo capturar. Revisa tu señal e intenta de nuevo (reintentar es seguro).'
          : 'No se pudo reversar. Revisa tu señal e intenta de nuevo (reintentar es seguro).',
      );
    }
  }

  async function validarPago(numero: string, tarjeta: HTMLElement, boton: HTMLButtonElement) {
    const estado = tarjeta.querySelector<HTMLElement>('[data-validar-estado]')!;
    boton.disabled = true;
    boton.textContent = 'Validando…';
    try {
      // Con Content-Type JSON y cuerpo, aunque vaya vacio: un POST sin
      // Content-Type lo frena la proteccion CSRF de Astro en Vercel (403
      // "Cross-site POST form submissions are forbidden") antes de llegar
      // al order-api.
      const res = await pedirAdmin(`/api/admin/pedidos/${encodeURIComponent(numero)}/validar-pago`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: '{}',
      });
      if (res.status === 401) {
        manejar401();
        return;
      }
      if (!res.ok) throw await errorDe(res);
      tarjeta.querySelector<HTMLElement>('[data-confirmacion]')!.hidden = true;
      estado.hidden = false;
      estado.textContent = `✅ ${numero}: pago recibido, quedó listo para salir.`;
      // La tarjeta se despide sola y el conteo del tab se actualiza.
      porValidar = porValidar.filter((p) => p.numero !== numero);
      pintarGlobitoValidar();
      setTimeout(() => {
        tarjeta.classList.add('por-validar--saliendo');
        setTimeout(() => {
          tarjeta.remove();
          if (!porValidar.length) pintarValidar();
        }, 220);
      }, 1200);
    } catch (error) {
      boton.disabled = false;
      boton.textContent = 'Sí, ya recibí el pago';
      estado.hidden = false;
      estado.textContent = textoDeError(
        error,
        'No se pudo validar. Revisa tu señal e intenta de nuevo (reintentar es seguro).',
      );
    }
  }

  // -- pantalla STOCK -------------------------------------------------------

  let temporizadorBusqueda: ReturnType<typeof setTimeout> | undefined;

  $('[data-buscador]').addEventListener('input', (e) => {
    const texto = (e.target as HTMLInputElement).value.trim().toLowerCase();
    clearTimeout(temporizadorBusqueda);
    if (texto.length < 2) {
      stockEl.innerHTML =
        '<p class="suave">Escribe al menos 2 letras para buscar en el catálogo.</p>';
      return;
    }
    temporizadorBusqueda = setTimeout(() => buscarStock(texto), 250);
  });

  async function buscarStock(texto: string) {
    const coincidencias = CATALOGO.filter(
      (p) => p.nombre.toLowerCase().includes(texto) || p.sku.toLowerCase().includes(texto),
    ).slice(0, 20);
    if (!coincidencias.length) {
      stockEl.innerHTML = '<div class="tarjeta vacio"><p>Nada en el catálogo con ese nombre.</p></div>';
      return;
    }
    stockEl.innerHTML = '<p class="cargando">Consultando stock…</p>';
    let disponibles: Record<string, number> = {};
    let sinStock = false;
    let errorStock = '';
    try {
      const res = await pedirAdmin(
        `/api/admin/stock?skus=${encodeURIComponent(coincidencias.map((p) => p.sku).join(','))}`,
      );
      if (res.status === 401) {
        manejar401();
        return;
      }
      if (!res.ok) throw await errorDe(res);
      disponibles = (await res.json()).disponibles ?? {};
    } catch (error) {
      sinStock = true;
      errorStock = textoDeError(error, 'El stock no respondió (¿sin señal?)');
    }
    stockEl.innerHTML =
      (sinStock
        ? `<p class="suave">${escapar(errorStock)}: se muestra el catálogo sin cantidades.</p>`
        : '') +
      coincidencias
        .map((p) => {
          const unidades = disponibles[p.sku];
          const badge = sinStock || unidades === undefined
            ? '<span class="chip">Sin dato</span>'
            : unidades > 0
              ? `<span class="chip chip--stock">${unidades} en stock</span>`
              : '<span class="chip chip--agotado">Agotado</span>';
          const foto = p.image
            ? `<img class="item-foto" src="${p.image}" alt="" loading="lazy" />`
            : `<span class="item-foto item-emoji">${p.emoji ?? '🪴'}</span>`;
          return `
          <div class="tarjeta stock-card">
            ${foto}
            <span class="stock-datos">
              <span class="stock-nombre">${escapar(p.nombre)}</span>
              <span class="suave">${escapar(p.sku)}</span>
            </span>
            ${badge}
          </div>`;
        })
        .join('');
  }

  // -- pantalla AVISOS ------------------------------------------------------

  // El limite real lo manda (y lo vuelve a validar) el order-api; aqui solo
  // se pinta el contador y se frena el boton. Mandar tiene dos pasos a
  // proposito: un aviso mandado no se puede retirar.
  let maximoAviso = 120;
  let alcanceAviso: { con_push: number; total: number } | null = null;

  const textoAvisoEl = () => $('[data-texto-aviso]') as unknown as HTMLTextAreaElement;

  function errorAviso(texto: string) {
    const el = $('[data-error-aviso]');
    el.textContent = texto;
    el.hidden = !texto;
  }

  function estadoAviso(texto: string) {
    const el = $('[data-estado-aviso]');
    el.textContent = texto;
    el.hidden = !texto;
  }

  function pintarContadorAviso() {
    const largo = textoAvisoEl().value.replace(/\s+/g, ' ').trim().length;
    const contador = $('[data-contador-aviso]');
    contador.textContent = `${largo}/${maximoAviso}`;
    contador.classList.toggle('contador--rojo', largo > maximoAviso);
    if (largo > maximoAviso) {
      errorAviso(`Te pasaste por ${largo - maximoAviso}: recorta el aviso para que la notificación no se corte.`);
    } else {
      errorAviso('');
    }
  }

  async function cargarAvisos() {
    try {
      const res = await pedirAdmin('/api/admin/avisos');
      if (res.status === 401) {
        manejar401();
        return;
      }
      if (!res.ok) throw await errorDe(res);
      pintarAvisosAdmin(await res.json());
    } catch (error) {
      $('[data-historial-avisos]').innerHTML = '';
      mensaje(textoDeError(error, 'No pudimos cargar los avisos. Revisa tu señal e intenta de nuevo.'));
    }
  }

  function pintarAvisosAdmin(datos: any) {
    maximoAviso = datos.maximo_caracteres ?? 120;
    alcanceAviso = { con_push: datos.con_push ?? 0, total: datos.total ?? 0 };
    const sinPush = (datos.repartidores ?? []).filter((r: any) => !r.con_push);
    const alcanceEl = $('[data-alcance-aviso]');
    if (!alcanceAviso.total) {
      alcanceEl.innerHTML = '<span class="suave">No hay contactos con la etiqueta Repartidor en Odoo.</span>';
    } else {
      const linea = `${alcanceAviso.con_push} de ${alcanceAviso.total} repartidores recibirán este aviso.`;
      const detalle = sinPush.length
        ? `<br /><span class="suave">Sin avisos activos: ${escapar(
            sinPush.map((r: any) => r.nombre).join(', '),
          )}. Lo verán igual al abrir su portal.</span>`
        : '';
      alcanceEl.innerHTML = `${escapar(linea)}${detalle}`;
    }
    pintarContadorAviso();
    pintarHistorialAvisos(datos.avisos ?? []);
  }

  function pintarHistorialAvisos(avisos: any[]) {
    const historialEl = $('[data-historial-avisos]');
    if (!avisos.length) {
      historialEl.innerHTML =
        '<div class="tarjeta vacio"><p>Todavía no has mandado ningún aviso.</p></div>';
      return;
    }
    historialEl.innerHTML = avisos
      .map((a) => {
        const fecha = new Date(a.creado_en).toLocaleString('es-PA', {
          day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit',
        });
        return `
        <div class="tarjeta aviso-mandado">
          <p class="aviso-mandado-texto">${escapar(a.mensaje)}</p>
          <p class="suave">${escapar(fecha)} · ${escapar(a.enviado_por)} · llegó a ${a.alcanzados} de ${a.total_repartidores}</p>
        </div>`;
      })
      .join('');
  }

  function cerrarConfirmacionAviso() {
    $('[data-confirmar-aviso]').hidden = true;
  }

  $('[data-form-aviso]').addEventListener('submit', (e) => {
    e.preventDefault();
    estadoAviso('');
    const texto = textoAvisoEl().value.replace(/\s+/g, ' ').trim();
    if (!texto) {
      errorAviso('Escribe el aviso primero.');
      return;
    }
    if (texto.length > maximoAviso) {
      pintarContadorAviso();
      return;
    }
    errorAviso('');
    $('[data-preview-cuerpo]').textContent = texto;
    $('[data-confirmar-texto]').textContent = alcanceAviso
      ? `Se mandará a ${alcanceAviso.con_push} de ${alcanceAviso.total} repartidores. Un aviso mandado no se puede retirar.`
      : 'Un aviso mandado no se puede retirar.';
    const confirmacion = $('[data-confirmar-aviso]');
    confirmacion.hidden = false;
    animarEntrada(confirmacion, 'pantalla-entrando');
  });

  $('[data-cancelar-aviso]').addEventListener('click', cerrarConfirmacionAviso);

  $('[data-texto-aviso]').addEventListener('input', () => {
    // El texto cambio: la vista previa abierta ya no corresponde.
    cerrarConfirmacionAviso();
    estadoAviso('');
    pintarContadorAviso();
  });

  $('[data-mandar-aviso]').addEventListener('click', async () => {
    const boton = $('[data-mandar-aviso]') as unknown as HTMLButtonElement;
    const texto = textoAvisoEl().value.replace(/\s+/g, ' ').trim();
    if (!texto || boton.disabled) return;
    boton.disabled = true;
    boton.textContent = 'Mandando…';
    try {
      const res = await pedirAdmin('/api/admin/avisos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ mensaje: texto }),
      });
      if (res.status === 401) {
        manejar401();
        return;
      }
      if (!res.ok) throw await errorDe(res);
      const datos = await res.json();
      textoAvisoEl().value = '';
      cerrarConfirmacionAviso();
      estadoAviso(`✅ Aviso mandado: llegó a ${datos.alcanzados} de ${datos.total} repartidores.`);
      cargarAvisos();
    } catch (error) {
      cerrarConfirmacionAviso();
      errorAviso(textoDeError(error, 'El aviso no salió (¿sin señal?). Intenta de nuevo.'));
    } finally {
      boton.disabled = false;
      boton.textContent = 'Mandar ahora';
    }
  });

  // -- enlace pegado a mano y arranque --------------------------------------

  function extraerClave(texto: string): string {
    const limpio = texto.trim();
    try {
      const url = new URL(limpio);
      return url.searchParams.get('clave')?.trim() ?? '';
    } catch {
      return limpio;
    }
  }

  $('[data-form-clave]').addEventListener('submit', (e) => {
    e.preventDefault();
    const input = $('[data-input-clave]') as unknown as HTMLInputElement;
    const nueva = extraerClave(input.value);
    if (!nueva) {
      $('[data-error-clave]').hidden = false;
      return;
    }
    localStorage.setItem('vr_clave_admin', nueva);
    location.replace('/admin');
  });

  // -- tirar para refrescar -------------------------------------------------

  // Recarga lo que se este mirando: el resumen, la lista (o el detalle
  // abierto), los pagos por validar o la busqueda de stock vigente. El
  // boton "Actualizar" sigue ahi como respaldo del gesto.
  instalarTirarParaRefrescar({
    indicador: $('[data-ptr]'),
    alRefrescar: async () => {
      if (!clave) return;
      if (pantallaActual === 'inicio') {
        await cargarResumen();
      } else if (pantallaActual === 'avisos') {
        await cargarAvisos();
      } else if (pantallaActual === 'stock') {
        const texto = ($('[data-buscador]') as unknown as HTMLInputElement).value
          .trim()
          .toLowerCase();
        if (texto.length >= 2) await buscarStock(texto);
      } else if (pantallaActual === 'pedidos' && !vistaDetalle.hidden && numeroDetalleAbierto) {
        await abrirDetalle(numeroDetalleAbierto);
      } else {
        await cargarPedidos();
      }
    },
  });

  // -- avisos push ----------------------------------------------------------

  const PUSH_ACTIVADO = 'vr_push_admin_activado';

  function mostrarBandaPush() {
    const soporta = 'serviceWorker' in navigator && 'PushManager' in window;
    if (!soporta || localStorage.getItem(PUSH_ACTIVADO)) return;
    $('[data-banda-push]').hidden = false;
  }

  function base64aBytes(base64: string): Uint8Array {
    const relleno = '='.repeat((4 - (base64.length % 4)) % 4);
    const crudo = atob((base64 + relleno).replace(/-/g, '+').replace(/_/g, '/'));
    return Uint8Array.from(crudo, (c) => c.charCodeAt(0));
  }

  // Misma activacion que en /repartidor; la diferencia es la credencial: la
  // clave de admin viaja en el header (pedirAdmin) y el order-api guarda la
  // suscripcion con rol "dueno".
  async function activarAvisos() {
    const estado = $('[data-push-estado]');
    const banda = $('[data-banda-push]');
    estado.hidden = false;
    try {
      const permiso = await Notification.requestPermission();
      if (permiso !== 'granted') {
        estado.textContent = 'Los avisos quedaron bloqueados en el navegador.';
        return;
      }
      const registro = await navigator.serviceWorker.register('/sw-avisos.js');
      await navigator.serviceWorker.ready;
      const resClave = await fetch('/api/push/clave-publica');
      if (!resClave.ok) {
        estado.textContent = 'Los avisos no están configurados todavía en el servidor.';
        return;
      }
      const { clave_publica } = await resClave.json();
      const suscripcion = await registro.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: base64aBytes(clave_publica),
      });
      const res = await pedirAdmin('/api/push/suscribir', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ suscripcion: suscripcion.toJSON() }),
      });
      if (res.status === 401) {
        manejar401();
        return;
      }
      if (!res.ok) throw await errorDe(res);
      localStorage.setItem(PUSH_ACTIVADO, '1');
      banda.hidden = true;
      estado.textContent = '✅ Avisos activados en este teléfono.';
    } catch (error) {
      estado.textContent = textoDeError(
        error,
        'No se pudieron activar los avisos. Revisa tu señal e intenta de nuevo.',
      );
    }
  }

  $('[data-activar-push]').addEventListener('click', activarAvisos);

  // -- arranque -------------------------------------------------------------

  const PANTALLAS: Pantalla[] = ['inicio', 'pedidos', 'validar', 'stock', 'avisos'];
  const pantallaInicial: Pantalla | null =
    pantallaUrl && (PANTALLAS as string[]).includes(pantallaUrl) ? (pantallaUrl as Pantalla) : null;

  async function arrancar() {
    if (!clave) {
      sinClave();
      return;
    }
    // Un aviso tocado abre directo su pantalla (cambiarPantalla ya la carga).
    if (pantallaInicial && pantallaInicial !== 'inicio') cambiarPantalla(pantallaInicial);
    try {
      const res = await pedirAdmin(`/api/admin/resumen?periodo=${periodoActual}`);
      if (res.status === 401) {
        manejar401();
        return;
      }
      if (!res.ok) throw await errorDe(res);
      pintarResumen(await res.json());
      mostrarBandaPush();
      // Precarga pedidos y el conteo de "Validar" (salvo que ya se este cargando).
      if (pantallaInicial !== 'pedidos' && pantallaInicial !== 'validar') cargarPedidos();
    } catch (error) {
      mensaje(textoDeError(error, 'No pudimos cargar el panel. Revisa tu señal e intenta de nuevo.'));
    }
  }

  arrancar();
</script>

<!-- Global a proposito, como en /repartidor: las pantallas se inyectan con
     innerHTML y el CSS scoped no las alcanzaria. Todo prefijado con .app o
     .tabs (solo existen en esta pagina). -->
<style is:global>
  .wa-float { display: none !important; }

  .app [hidden] { display: none !important; }

  .app {
    max-width: 34rem;
    margin: 0 auto;
    padding: 1.1rem 1.1rem calc(84px + env(safe-area-inset-bottom, 0px));
  }

  .app .pantalla {
    transition: opacity 180ms var(--ease-out), transform 180ms var(--ease-out);
  }

  .app .pantalla-entrando {
    opacity: 0;
    transform: translateY(8px);
  }

  .app [data-vista-detalle] {
    transition: opacity 220ms var(--ease-drawer), transform 220ms var(--ease-drawer);
  }

  .app .detalle-entrando {
    opacity: 0;
    transform: translateX(28px);
  }

  @media (prefers-reduced-motion: reduce) {
    .app .pantalla,
    .app [data-vista-detalle] {
      transition: opacity 150ms ease;
    }
    .app .pantalla-entrando,
    .app .detalle-entrando {
      transform: none;
    }
  }

  /* -- tirar para refrescar ----------------------------------------------- */

  /* Sin el pull-to-refresh nativo del navegador: aqui lo maneja el portal. */
  html,
  body {
    overscroll-behavior-y: contain;
  }

  .app .ptr {
    position: fixed;
    top: 0;
    left: 50%;
    transform: translate(-50%, -48px);
    opacity: 0;
    z-index: 55; /* sobre las tarjetas, bajo cualquier velo */
    pointer-events: none;
  }

  .app .ptr-disco {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: 0 2px 10px rgba(27, 42, 31, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .app .ptr svg {
    width: 22px;
    height: 22px;
  }

  .app .ptr-arco {
    fill: none;
    stroke: var(--green-deep);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .app .ptr--girando svg {
    animation: ptr-giro 700ms linear infinite;
  }

  /* El regreso al soltar; el seguimiento del dedo va sin transicion. */
  .app .ptr--volviendo {
    transition: transform 200ms var(--ease-out), opacity 200ms var(--ease-out);
  }

  @keyframes ptr-giro {
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .app .ptr--girando svg { animation: none; }
    .app .ptr--volviendo { transition: none; }
  }

  .app .kicker {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--ink-faint);
    margin: 0 0 0.2rem;
  }

  .app .inicio-head { margin-bottom: 1rem; }

  .app .saludo { font-weight: 400; font-size: 1.7rem; margin: 0; }

  .app .pantalla-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .app .pantalla-head h1 { font-weight: 400; font-size: 1.5rem; margin: 0; }

  .app .btn-refrescar { flex-shrink: 0; }

  .app .bloque-titulo {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 1.4rem 0 0.6rem;
  }

  .app .bloque-titulo--alerta { color: #a4322a; }

  .app .bloque-titulo--dentro { margin-top: 0; }

  /* -- selector de periodo ------------------------------------------------ */

  .app .periodos {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 4px;
    background: var(--surface-tint);
    border-radius: var(--radius-lg);
    padding: 4px;
    margin-bottom: 1rem;
  }

  .app .periodo {
    border: none;
    background: transparent;
    font: inherit;
    font-weight: 600;
    color: var(--ink-soft);
    min-height: 44px;
    border-radius: calc(var(--radius-lg) - 4px);
    cursor: pointer;
    transition: transform 160ms var(--ease-out);
  }

  .app .periodo:active { transform: scale(0.97); }

  .app .periodo--activo {
    background: var(--surface);
    color: var(--green-deep);
    box-shadow: 0 1px 4px rgba(27, 42, 31, 0.12);
  }

  /* -- resumen (inicio) --------------------------------------------------- */

  .app .tarjeta-valor {
    background: var(--card-dark);
    color: #fff;
    border-radius: var(--radius-lg);
    padding: 1.3rem 1.4rem 1.2rem;
  }

  .app .valor-etiqueta {
    font-size: 0.78rem;
    letter-spacing: 0.1em;
