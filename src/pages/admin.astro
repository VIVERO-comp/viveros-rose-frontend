  .app .valor-monto {
    font-size: 2.9rem;
    font-weight: 600;
    line-height: 1.05;
    margin: 0 0 0.45rem;
    font-variant-numeric: tabular-nums;
  }

  .app .valor-detalle {
    margin: 0;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .app .metricas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
  }

  .app .metricas--tres { grid-template-columns: 1fr 1fr 1fr; }

  /* Las fichas del resumen van pegadas debajo de la tarjeta de vendido:
     necesitan su propio aire (los demas bloques lo heredan del titulo). */
  .app .metricas--resumen { margin-top: 0.8rem; }

  .app .metrica {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    background: var(--green-tint);
    color: var(--green-deep);
    border-radius: var(--radius-lg);
    padding: 1rem 1.1rem;
  }

  .app .metrica--alerta {
    background: #f7e3e0;
    color: #a4322a;
  }

  .app .metrica-numero {
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
