---
// Servicios segun el diseno "Servicios" (claude.ai/design). El diseno tiene
// tres variantes por query (?s=paisajismo|mantenimiento|proyectos); aqui las
// tres viven en una sola pagina estatica como bloques con ancla (#diseno,
// #mantenimiento, #proyectos), que es a donde apuntan el navbar y el footer.
import Base from '../layouts/Base.astro';
import { SITE, whatsappLink } from '../lib/site';

const blocks = [
  {
    id: 'diseno',
    kicker: 'Diseño de jardines',
    title: 'Escuchamos lo que quieres y lo construimos',
    body: 'Levantamos el terreno, proponemos un trazo con las especies que rinden en tu suelo y nos encargamos de la siembra y los detalles que hacen que un jardín se sienta como casa.',
    cta: 'Iniciar proyecto',
    ctaMessage: 'Hola, quiero iniciar un proyecto de diseño de jardín.',
    detail: 'Cómo funciona',
  },
  {
    id: 'mantenimiento',
    kicker: 'Mantenimiento',
    title: 'Los jardines necesitan cuidado para mantenerse bonitos',
    body: 'Regresamos con regularidad, ajustamos según las estaciones y nos aseguramos de que cada planta reciba lo que necesita: poda, riego, abono y control de plagas. En temporada seca priorizamos riego y sombra; en la lluviosa, drenaje, poda y control de hongos.',
    cta: 'Agendar servicio',
    ctaMessage: 'Hola, quiero agendar un servicio de mantenimiento de jardín.',
    detail: 'Frecuencias y planes',
  },
  {
    id: 'proyectos',
    kicker: 'Proyectos comerciales',
    title: 'Áreas verdes de entrega para desarrolladores',
    body: 'Trabajamos con constructoras, PH y administradores en la siembra de áreas comunes, entradas y linderos, con cronograma atado a la fecha de entrega de la obra y mantenimiento post-entrega.',
    cta: 'Hablar de mi proyecto',
    ctaMessage: 'Hola, quiero cotizar un proyecto comercial de áreas verdes.',
    detail: 'Tiempos y alcance',
  },
];

const reviews = [
  {
    text: 'Hicieron el diseño de la bordura del jardín y volvieron al mes a revisar. Es la primera vez que las plantas que compro sobreviven la temporada seca.',
    author: 'Ana L.',
    role: 'Residencial, Clayton',
  },
  {
    text: 'Vienen cada quince días sin que haya que recordárselo y el área social siempre está impecable.',
    author: 'Junta de PH',
    role: 'Ciudad Radial',
  },
  {
    text: 'Entregaron el área verde completa una semana antes de la inauguración del proyecto.',
    author: 'Carlos Ríos',
    role: 'Gerente de obra, Constructora',
  },
];

const interests = ['Diseño de jardines', 'Mantenimiento', 'Proyectos comerciales', 'Compra de plantas'];
---

<Base
  title="Servicios de paisajismo"
  description="Diseño de jardines, mantenimiento y proyectos comerciales en Panamá, con material de nuestro propio vivero."
  whatsappMessage="Hola, me interesa una cotización de paisajismo."
>
  <section class="serv-hero">
    <!-- FOTO PENDIENTE: hero de servicios — banda a lo ancho, minimo 1920×620 px -->
    <div class="serv-hero-photo" data-medidas="Foto hero · 1920×620" aria-hidden="true"></div>
    <div class="serv-hero-scrim" aria-hidden="true"></div>
    <div class="serv-hero-copy">
      <span class="hero-pill">Diseño · Siembra · Detalle</span>
      <h1>Paisajismo bien hecho</h1>
      <span class="hero-divider" aria-hidden="true"></span>
      <p>Jardines pensados para el clima de Panamá, desde el trazo hasta la última planta.</p>
    </div>
  </section>

  <section class="container serv-blocks">
    {blocks.map((b, i) => (
      <div class="serv-block" id={b.id}>
        <div class:list={['serv-text', { 'serv-text--after': i % 2 === 1 }]}>
          <span class="eyebrow">{b.kicker}</span>
          <h2>{b.title}</h2>
          <p class="serv-body">{b.body}</p>
          <a href={whatsappLink(b.ctaMessage)} class="btn btn--ghost" target="_blank" rel="noopener">{b.cta}</a>
          <p class="thumbs-label">Proyectos recientes</p>
          <div class="thumbs">
            <!-- FOTOS PENDIENTES: 2 miniaturas de proyecto — minimo 420×260 px c/u -->
            <div class="thumb" data-medidas="Foto · 420×260" aria-hidden="true"></div>
            <div class="thumb" data-medidas="Foto · 420×260" aria-hidden="true"></div>
          </div>
          <div class="serv-detail">
            <span>{b.detail}</span>
            <span aria-hidden="true">+</span>
          </div>
        </div>
        <!-- FOTO PENDIENTE: foto principal del bloque — vertical, minimo 640×760 px -->
        <div class="serv-photo" data-medidas="Foto · 640×760" aria-hidden="true"></div>
      </div>
    ))}
  </section>

  <section class="container serv-cta-wrap">
    <div class="serv-cta">
      <div>
        <span class="eyebrow eyebrow--light">Mayoristas y proyectos</span>
        <h2>¿Compras por volumen o planeas un proyecto comercial?</h2>
        <p>
          Cultivamos y distribuimos plantas a escala para constructoras, empresas
          y revendedores en todo Panamá.
        </p>
        <a href="/mayorista" class="cta-link">Conoce la venta al mayor →</a>
      </div>
      <div class="serv-cta-btn">
        <a href={whatsappLink('Hola, quiero cotizar un pedido por volumen o un proyecto comercial.')} class="btn btn--light" target="_blank" rel="noopener">Cotizar por WhatsApp</a>
      </div>
    </div>
  </section>

  <section class="reviews">
    <div class="container reviews-grid">
      <div>
        <h2>Lo que dicen los clientes</h2>
        <p class="reviews-sub">Resultados reales de jardines reales.</p>
      </div>
      <div>
        <figure class="review-card">
          <div class="stars" aria-label="5 estrellas">★★★★★</div>
          <blockquote data-review-text>{reviews[0].text}</blockquote>
          <figcaption>
            <strong data-review-author>{reviews[0].author}</strong>
            <span data-review-role>{reviews[0].role}</span>
          </figcaption>
        </figure>
        <div class="review-nav">
          <div class="dots" data-review-dots>
            {reviews.map((_, i) => <span class:list={['dot', { on: i === 0 }]}></span>)}
          </div>
          <div class="arrows">
            <button type="button" data-review-prev aria-label="Anterior">←</button>
            <button type="button" data-review-next aria-label="Siguiente">→</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container contact-split-wrap">
    <div class="contact-split">
      <div class="contact-photo-col">
        <!-- FOTO PENDIENTE: lateral del formulario — vertical, minimo 640×760 px -->
        <div class="contact-photo" data-medidas="Foto · 640×760" aria-hidden="true"></div>
        <div class="contact-scrim" aria-hidden="true"></div>
        <div class="contact-copy">
          <h2>Comienza hoy la transformación de tu jardín</h2>
          <p>Cuéntanos qué necesitas y te respondemos en menos de un día hábil.</p>
          <a href={whatsappLink('Hola, quiero cotizar un servicio de paisajismo.')} class="btn btn--green" target="_blank" rel="noopener">Escríbenos por WhatsApp</a>
          <div class="contact-facts">
            <span>🕐 <strong>Horario:</strong> {SITE.hours}</span>
            <span>📍 {SITE.address}</span>
          </div>
        </div>
      </div>
      <form class="contact-form" data-quote-form>
        <div class="field">
          <label for="s-nombre">Nombre</label>
          <input type="text" id="s-nombre" name="nombre" required />
        </div>
        <div class="field">
          <label for="s-contacto">WhatsApp o correo</label>
          <input type="text" id="s-contacto" name="contacto" placeholder="+507 …" required />
        </div>
        <div class="field">
          <label for="s-interes">Me interesa</label>
          <select id="s-interes" name="interes">
            {interests.map((x) => <option value={x}>{x}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="s-detalle">Cuéntanos sobre tu proyecto</label>
          <textarea id="s-detalle" name="detalle" rows="5"></textarea>
        </div>
        <button type="submit" class="btn btn--green form-submit">Solicitar cotización</button>
      </form>
    </div>
  </section>
</Base>

<script>
  import { whatsappLink } from '../lib/site';

  // Carrusel simple de resenas.
  const dots = Array.from(document.querySelectorAll('[data-review-dots] .dot'));

  let current = 0;
  const REVIEWS = [
    {
      text: 'Hicieron el diseño de la bordura del jardín y volvieron al mes a revisar. Es la primera vez que las plantas que compro sobreviven la temporada seca.',
      author: 'Ana L.',
      role: 'Residencial, Clayton',
    },
    {
      text: 'Vienen cada quince días sin que haya que recordárselo y el área social siempre está impecable.',
      author: 'Junta de PH',
      role: 'Ciudad Radial',
    },
    {
      text: 'Entregaron el área verde completa una semana antes de la inauguración del proyecto.',
      author: 'Carlos Ríos',
      role: 'Gerente de obra, Constructora',
    },
  ];

  function showReview(i: number) {
    current = ((i % REVIEWS.length) + REVIEWS.length) % REVIEWS.length;
    const r = REVIEWS[current];
    const text = document.querySelector('[data-review-text]');
    const author = document.querySelector('[data-review-author]');
    const role = document.querySelector('[data-review-role]');
    if (text) text.textContent = r.text;
    if (author) author.textContent = r.author;
    if (role) role.textContent = r.role;
    dots.forEach((d, k) => d.classList.toggle('on', k === current));
  }

  document.querySelector('[data-review-prev]')?.addEventListener('click', () => showReview(current - 1));
  document.querySelector('[data-review-next]')?.addEventListener('click', () => showReview(current + 1));

  // Formulario de cotizacion → WhatsApp.
  const form = document.querySelector<HTMLFormElement>('[data-quote-form]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const d = new FormData(form);
    const message =
      `Hola, quiero una cotización de servicios.\n\n` +
      `Nombre: ${d.get('nombre')}\nContacto: ${d.get('contacto')}\n` +
      `Me interesa: ${d.get('interes')}\nDetalle: ${d.get('detalle') || '—'}`;
    window.open(whatsappLink(message), '_blank', 'noopener');
  });
</script>

<style>
  /* Hero */
  .serv-hero {
    position: relative;
    height: 620px;
    overflow: hidden;
    background: var(--card-dark);
  }

  .serv-hero-photo {
    position: absolute;
    inset: 0;
    background: linear-gradient(150deg, #2a4432, var(--card-dark) 70%);
  }

  .serv-hero-photo::after,
  .serv-photo::after,
  .thumb::after,
  .contact-photo::after {
    content: attr(data-medidas);
    position: absolute;
    right: 12px;
    top: 12px;
    z-index: 1;
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(238, 245, 240, 0.7);
    background: rgba(27, 42, 31, 0.55);
    padding: 2px 8px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .serv-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(27, 42, 31, 0.55), rgba(27, 42, 31, 0.72));
  }

  .serv-hero-copy {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 2.3rem;
    color: #ffffff;
  }

  .hero-pill {
    display: inline-block;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 999px;
    padding: 0.5rem 1.4rem;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 1.7rem;
  }

  .serv-hero-copy h1 {
    color: #ffffff;
    font-weight: 400;
    font-size: clamp(2.6rem, 6vw, 4.75rem);
    margin: 0;
    max-width: 22ch;
  }

  .hero-divider {
    width: 64px;
    height: 2px;
    background: #4ade80;
    margin: 1.7rem 0;
  }

  .serv-hero-copy p {
    font-style: italic;
    font-size: 1.35rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
    max-width: 44ch;
  }

  /* Bloques */
  .serv-blocks { padding-top: 5.8rem; }

  .serv-block {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 3.4rem;
    align-items: center;
    margin-bottom: 5.8rem;
    scroll-margin-top: 120px;
  }

  .serv-text--after { order: 1; }

  @media (max-width: 720px) {
    .serv-text--after { order: 0; }
  }

  .serv-block h2 {
    font-weight: 400;
    font-size: clamp(1.9rem, 3.5vw, 2.9rem);
    line-height: 1.1;
    margin: 0 0 1.15rem;
  }

  .serv-body {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--ink-soft);
    margin: 0 0 1.4rem;
    max-width: 34rem;
  }

  .thumbs-label {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 1.7rem 0 0.85rem;
  }

  .thumbs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
    max-width: 420px;
  }

  .thumb {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    outline: 1px solid rgba(27, 42, 31, 0.1);
    background: linear-gradient(160deg, var(--green-tint), var(--surface-2));
    min-height: 120px;
  }

  .serv-detail {
    border-top: 1px solid var(--line);
    margin-top: 1.7rem;
    padding-top: 1.15rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.15rem;
    font-size: 1rem;
  }

  .serv-detail span:last-child { color: var(--green-deep); font-size: 1.15rem; }

  .serv-photo {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    outline: 1px solid rgba(27, 42, 31, 0.1);
    background: linear-gradient(160deg, var(--green-tint), var(--surface-2));
    min-height: 520px;
  }

  /* CTA oscuro */
  .serv-cta-wrap { padding-bottom: 5.8rem; }

  .serv-cta {
    background: var(--card-dark);
    border-radius: 20px;
    padding: 3.4rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2.3rem;
    align-items: center;
    color: #ffffff;
  }

  .eyebrow--light { color: #8ce6a8; }

  .serv-cta h2 {
    color: #ffffff;
    font-weight: 400;
    font-size: clamp(1.7rem, 3vw, 2.6rem);
    margin: 0 0 1.15rem;
  }

  .serv-cta p {
    color: rgba(255, 255, 255, 0.82);
    margin: 0 0 1.15rem;
    max-width: 32rem;
  }

  .cta-link { color: #8ce6a8; text-decoration: underline; }
  .cta-link:hover { color: #8ce6a8; }

  .serv-cta-btn { display: flex; justify-content: flex-end; }

  @media (max-width: 720px) {
    .serv-cta-btn { justify-content: flex-start; }
  }

  .btn--light {
    background: #ffffff;
    border-color: #ffffff;
    color: var(--ink);
  }

  .btn--light:hover { background: var(--bg); color: var(--ink); }

  /* Resenas */
  .reviews { background: var(--surface-2); }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 3.4rem;
    align-items: center;
    padding-top: 5.8rem;
    padding-bottom: 5.8rem;
  }

  .reviews h2 {
    font-weight: 400;
    font-size: clamp(1.9rem, 3.5vw, 2.9rem);
    margin: 0 0 0.85rem;
  }

  .reviews-sub { color: var(--ink-soft); margin: 0; }

  .review-card {
    margin: 0;
    background: #ffffff;
    border-radius: 16px;
    padding: 2.3rem;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .stars { color: var(--green-deep); letter-spacing: 0.2em; font-size: 0.88rem; }

  .review-card blockquote {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.6;
  }

  .review-card figcaption { font-size: 0.88rem; display: flex; flex-direction: column; }
  .review-card figcaption span { color: var(--ink-soft); }

  .review-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.4rem;
  }

  .dots { display: flex; gap: 7px; }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(27, 42, 31, 0.2);
  }

  .dot.on { background: var(--green-deep); }

  .arrows { display: flex; gap: 0.55rem; }

  .arrows button {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(27, 42, 31, 0.18);
    background: #ffffff;
    color: var(--ink);
    cursor: pointer;
    font-size: 1rem;
  }

  .arrows button:hover { background: var(--bg); }

  /* Contacto */
  .contact-split-wrap { padding: 5.8rem 1.5rem; }

  .contact-split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(27, 42, 31, 0.08);
  }

  .contact-photo-col {
    position: relative;
    min-height: 540px;
    background: var(--card-dark);
  }

  .contact-photo {
    position: absolute;
    inset: 0;
    background: linear-gradient(150deg, #2a4432, var(--card-dark) 70%);
  }

  .contact-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(27, 42, 31, 0.55), rgba(27, 42, 31, 0.78));
  }

  .contact-copy {
    position: relative;
    padding: 2.9rem;
    color: #ffffff;
  }

  .contact-copy h2 {
    color: #ffffff;
    font-weight: 400;
    font-size: clamp(1.7rem, 3vw, 2.6rem);
    margin: 0 0 1.15rem;
  }

  .contact-copy p {
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 1.7rem;
    max-width: 32rem;
  }

  .contact-facts {
    border-top: 1px solid rgba(255, 255, 255, 0.25);
    margin-top: 2.3rem;
    padding-top: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    font-size: 0.95rem;
  }

  .contact-form {
    background: #ffffff;
    padding: 2.9rem;
    display: flex;
    flex-direction: column;
  }

  .form-submit { justify-content: center; }
</style>
