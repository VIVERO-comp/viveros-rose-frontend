---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { SITE } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  // Imagen para las vistas previas al compartir (WhatsApp, redes). Ruta
  // relativa a public/; por defecto la foto del hero del home.
  socialImage?: string;
  whatsappMessage?: string;
  // 'minimal': cabecera reducida sin nav ni footer, como Carrito/Checkout/
  // Pedidos en el diseno. El enlace de la derecha se configura por pagina.
  // 'bare': sin cabecera ni footer del sitio (Servicios, Mayoristas, Eventos
  // y Contacto van solo con la flecha de retorno; es intencional del diseno).
  chrome?: 'full' | 'minimal' | 'bare';
  minimalLinkHref?: string;
  minimalLinkLabel?: string;
  // true en paginas transaccionales o privadas (carrito, checkout, pedido,
  // cuenta, repartidor, calificar): les pone <meta name="robots"
  // content="noindex"> y quedan tambien filtradas del sitemap en
  // astro.config.mjs.
  noindex?: boolean;
  // Ruta de un web app manifest (solo /repartidor: lo hace instalable como
  // app en la pantalla de inicio del celular).
  manifest?: string;
}

const {
  title,
  description = 'Vivero real en Panama. Compra plantas online con entrega a domicilio.',
  socialImage = '/fotos_homepage/primerafoto.jpg',
  whatsappMessage,
  chrome = 'full',
  minimalLinkHref = '/plantas',
  minimalLinkLabel = 'Seguir comprando',
  noindex = false,
  manifest,
} = Astro.props;

// La canonica usa solo el pathname: las variantes del catalogo con parametros
// (/plantas?c=...) sirven el mismo HTML y deben canonicalizar a /plantas.
// Sin barra final (salvo el home), igual que los enlaces internos del sitio.
const canonicalPath =
  Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/$/, '') : '/';
const canonicalUrl = new URL(canonicalPath, Astro.site).href;
const socialImageUrl = new URL(socialImage, Astro.site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- El .ico es el respaldo para Safari, que no soporta favicons SVG. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Instrument Serif (italica) solo se usa en los heros de las paginas
         sin navbar (Servicios, Mayoristas), como en el handoff. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
    />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {manifest && <link rel="manifest" href={manifest} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title} · {SITE.name}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'GardenStore',
      name: SITE.name,
      alternateName: `${SITE.name} ${SITE.byline}`,
      url: Astro.site?.href,
      telephone: `+${SITE.whatsappNumber}`,
      // Google exige address en los Local Business para los rich results.
      address: { '@type': 'PostalAddress', ...SITE.addressSchema },
      areaServed: 'Panama',
      parentOrganization: { '@type': 'Organization', name: 'Vivero Rose', url: 'https://viverorose.com' },
    })} />
  </head>
  <body>
    {chrome === 'full' && <Header />}
    {chrome === 'minimal' && (
      <header class="minimal-header">
        <div class="container minimal-inner">
          <a href="/" class="minimal-brand">PLANTAS PANAMÁ</a>
          <a href={minimalLinkHref} class="minimal-link">← {minimalLinkLabel}</a>
        </div>
      </header>
    )}
    <main>
      <slot />
    </main>
    {chrome === 'full' && <Footer />}
    <WhatsAppButton message={whatsappMessage} />
  </body>
</html>

<style>
  .minimal-header {
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .minimal-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.4rem;
    min-height: 64px;
  }

  .minimal-brand {
    font-size: 1.35rem;
    letter-spacing: 0.1em;
    color: var(--ink);
  }

  .minimal-brand:hover { text-decoration: none; color: var(--ink); }

  .minimal-link {
    font-size: 0.9rem;
    color: var(--ink);
  }
</style>
