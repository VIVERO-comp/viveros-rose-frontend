---
// Footer de 4 columnas del diseno "Home Plantas Panama", con enlaces
// unicamente a rutas que existen en el sitio.
import { SITE, whatsappLink } from '../lib/site';
import { categories } from '../data/products';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <nav aria-label="Tienda">
      <p class="footer-title">Tienda</p>
      <ul>
        <li><a href="/plantas">Todo el catalogo</a></li>
        <li><a href="/colecciones">Colecciones</a></li>
        {categories.map((cat) => (
          <li><a href={`/plantas/${cat.slug}`}>{cat.name}</a></li>
        ))}
        <li><a href="/carrito">Carrito</a></li>
      </ul>
    </nav>

    <nav aria-label="Aprender">
      <p class="footer-title">Aprender</p>
      <ul>
        <li><a href="/guia">Guias de cuidado</a></li>
        <li><a href="https://viverorose.com/" target="_blank" rel="noopener">Nuestro vivero</a></li>
        <li><a href="/servicios/paisajismo">Paisajismo</a></li>
        <li><a href="/eventos">Plantas para eventos</a></li>
        <li><a href="/mayorista">Mayorista</a></li>
      </ul>
    </nav>

    <nav aria-label="Ayuda">
      <p class="footer-title">Ayuda</p>
      <ul>
        <li><a href="/contacto">Contacto</a></li>
        <li><a href="/pedido">Rastrear mi pedido</a></li>
        <li><a href="/entrega">Zonas y tarifas de entrega</a></li>
        <li><a href="/privacidad">Política de privacidad</a></li>
        <li><a href="/terminos">Términos y condiciones</a></li>
      </ul>
    </nav>

    <div class="footer-brand-col">
      <div>
        <p class="footer-brand">PLANTAS PANAMÁ</p>
        <p class="footer-byline">{SITE.byline}</p>
      </div>
      <p class="footer-note">{SITE.domain}<br />{SITE.address}</p>
      <a class="footer-wa" href={whatsappLink('Hola, tengo una consulta sobre sus plantas.')} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
        </svg>
        WhatsApp
      </a>
    </div>
  </div>

  <div class="footer-bottom-band">
    <div class="container footer-bottom">
      <p>© {new Date().getFullYear()} Vivero Rose — Plantas Panamá</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    background: var(--bg);
    border-top: 1px solid var(--line);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.3rem;
    padding-top: 3.4rem;
    padding-bottom: 3.4rem;
  }

  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .footer-grid { grid-template-columns: 1fr; }
  }

  .footer-title {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 0.6rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  a {
    color: var(--ink);
    font-size: 0.9rem;
  }

  a:hover { color: var(--green-deep); }

  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .footer-brand {
    font-size: 1.35rem;
    letter-spacing: 0.12em;
    margin: 0;
  }

  .footer-byline {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0.25rem 0 0;
  }

  .footer-note {
    font-size: 0.9rem;
    color: var(--ink-soft);
    line-height: 1.7;
    margin: 0;
  }

  .footer-wa {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--green-deep);
  }

  .footer-bottom-band {
    border-top: 1px solid var(--line);
  }

  .footer-bottom {
    padding-top: 1.4rem;
    padding-bottom: 1.4rem;
    text-align: center;
    font-size: 0.78rem;
    color: var(--ink-soft);
  }

  .footer-bottom p { margin: 0; }
</style>
