---
// Banda de newsletter del diseno (se repite al pie de Shop y Colecciones).
// Sin backend de correo todavia: la suscripcion llega por WhatsApp, igual
// que en el home.
---

<section class="news-band">
  <div class="container news-inner">
    <p class="news-copy">Recibe lo que sale del vivero, avisos de temporada y ofertas.</p>
    <form class="news-form" data-news-form>
      <input type="email" name="email" placeholder="Tu correo" required aria-label="Tu correo" />
      <button type="submit" class="btn btn--green news-btn" aria-label="Suscribirme">
        <span class="news-btn-label">Suscribirme</span>
        <span class="news-btn-arrow" aria-hidden="true">→</span>
      </button>
    </form>
  </div>
</section>

<script>
  import { whatsappLink } from '../lib/site';

  document.querySelectorAll<HTMLFormElement>('[data-news-form]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = (form.elements.namedItem('email') as HTMLInputElement).value;
      window.open(
        whatsappLink(`Hola, quiero recibir novedades del vivero. Mi correo: ${email}`),
        '_blank',
        'noopener'
      );
    });
  });
</script>

<style>
  .news-band {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .news-inner {
    padding-top: 2.3rem;
    padding-bottom: 2.3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.7rem;
    flex-wrap: wrap;
  }

  .news-copy {
    font-size: 1.35rem;
    margin: 0;
  }

  .news-form {
    display: flex;
    gap: 0.55rem;
    align-items: center;
  }

  .news-form input {
    min-width: 260px;
    min-height: 40px;
    padding: 6px 14px;
    font-size: 0.9rem;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .news-btn-arrow { display: none; }

  /* Movil como la referencia: texto centrado y el campo con el boton de
     flecha pegado a la derecha, en una sola pastilla. */
  @media (max-width: 768px) {
    .news-inner { flex-direction: column; gap: 1.15rem; }

    .news-copy {
      font-size: 1.15rem;
      text-align: center;
      max-width: 22rem;
    }

    .news-form { width: 100%; gap: 0; }

    .news-form input {
      min-width: 0;
      flex: 1;
      min-height: 48px;
      border-radius: 999px 0 0 999px;
      border-right: 0;
    }

    .news-btn {
      border-radius: 0 999px 999px 0;
      min-height: 48px;
      padding: 0.8rem 1.4rem;
    }

    .news-btn-label { display: none; }
    .news-btn-arrow { display: inline; font-size: 1.1rem; line-height: 1; }
  }
</style>
