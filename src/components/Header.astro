---
// Navbar del handoff (Navbar.dc.html): tres franjas — barra de promocion,
// cabecera con buscador centrado y menu en mayusculas con desplegables — mas
// los paneles laterales de carrito, cuenta y pedidos.
// El contador del carrito conserva data-cart-count (lo refresca src/lib/cart).
// "Nuestro Vivero" apunta al sitio corporativo viverorose.com (externo).
// El panel de cuenta consulta la sesion real (/api/auth/me, cookie httpOnly)
// la primera vez que se abre: sin sesion ofrece entrar o registrarse; con
// sesion saluda y lleva a /cuenta.
import { SITE, whatsappLink } from '../lib/site';
import { collections } from '../data/collections';
import { esComprable, precioVigente } from '../data/products';
import { productosPublicados } from '../lib/catalogo-build';
import Icon from './Icon.astro';

// El buscador sugiere solo productos publicados: un archivado en Odoo no
// debe aparecer ni enlazar a una pagina que ya no existe (catalogo-build).
const products = await productosPublicados();

const currentPath = Astro.url.pathname;

const isActive = (href: string) =>
  currentPath === href || (href !== '/' && currentPath.startsWith(href));

const col = (slug: string) => {
  const c = collections.find((x) => x.slug === slug)!;
  return { href: `/plantas?c=${c.slug}`, label: c.name };
};

// Columnas del mega menu de Plantas (solo colecciones con datos reales).
const megaColumns = [
  {
    title: 'Colecciones populares',
    links: [
      ...['mas-vendidas', 'recien', 'pet-friendly', 'interior', 'exterior', 'faciles'].map(col),
      { href: '/plantas', label: 'Todas las plantas' },
    ],
  },
  {
    title: 'Por luz y disponibilidad',
    links: ['poca-luz', 'jardin', 'ultimas'].map(col),
  },
  {
    title: 'Tipo de planta',
    links: [
      ...['rosales', 'palmas', 'crotos', 'suculentas', 'hierbas'].map(col),
      { href: '/plantas/florales', label: 'Florales' },
    ],
  },
  {
    title: 'Más',
    links: [
      { href: '/colecciones', label: 'Todas las colecciones' },
      { href: '/guia', label: 'Guías de cuidado' },
    ],
  },
];

const serviciosLinks = [
  { href: '/servicios/paisajismo', label: 'Diseño de jardines' },
  { href: '/servicios/mantenimiento', label: 'Mantenimiento' },
  { href: '/servicios/proyectos', label: 'Proyectos comerciales' },
];

const eventosLinks = [
  { href: '/eventos/bodas', label: 'Bodas y eventos sociales' },
  { href: '/eventos/ferias', label: 'Ferias y activaciones' },
  { href: '/eventos/alquiler', label: 'Alquiler de plantas' },
];

const VIVERO_URL = 'https://viverorose.com/';

// Colecciones sugeridas cuando el carrito esta vacio (todas existen).
const emptyCartCollections = ['mas-vendidas', 'interior', 'jardin', 'faciles'].map(col);

// Niveles del menu movil (drill-down como el menu de celular de la
// referencia: raiz → submenu con encabezado de regreso subrayado).
const menuColecciones = [
  ...['mas-vendidas', 'recien', 'pet-friendly', 'interior', 'exterior', 'faciles', 'poca-luz', 'jardin', 'ultimas'].map(col),
];
// Indice ligero del buscador en vivo del navbar: nombre, ruta, precio y
// foto (o emoji) por producto, mas las colecciones por nombre. Se sirve como
// JSON embebido para que las sugerencias salgan sin pedir nada al servidor.
const indiceBusqueda = {
  productos: products.map((p) => ({
    n: p.name,
    c: p.scientificName || '',
    u: `/plantas/${p.category}/${p.slug}`,
    // Precio vigente (la oferta si esta activa); s=1 marca "Proximamente"
    // (sin precio real en Odoo) para no sugerir "Desde $0.00".
    p: precioVigente(p),
    s: esComprable(p) ? 0 : 1,
    i: p.image ?? null,
    e: p.emoji,
  })),
  colecciones: collections.map((c) => ({ n: c.name, s: c.slug })),
};

const menuTipos = [
  ...['rosales', 'palmas', 'crotos', 'suculentas', 'hierbas'].map(col),
  { href: '/plantas/florales', label: 'Florales' },
];
---

<div class="announce">
  <a href="/plantas">Entrega en la ciudad de Panamá en 24–48 h · Asesoría por WhatsApp</a>
</div>

<header class="site-header">
  <div class="container top-row">
    <a href="/" class="brand">
      <span class="brand-name">PLANTAS PANAMÁ</span>
      <span class="brand-byline">{SITE.byline}</span>
    </a>

    <form class="search search--desktop" action="/plantas" method="get" role="search" data-search-form>
      <input
        type="search"
        name="q"
        placeholder="Buscar plantas…"
        aria-label="Buscar plantas"
        autocomplete="off"
        data-search-input
      />
      <button type="submit" aria-label="Buscar"><Icon name="search" size={16} /></button>
      <!-- Sugerencias en vivo (productos y colecciones) bajo el buscador. -->
      <div class="search-drop" data-search-drop hidden></div>
    </form>
    <script type="application/json" data-search-index set:html={JSON.stringify(indiceBusqueda)} />

    <div class="top-actions">
      <button class="top-action" data-panel-open="account">
        <Icon name="user" size={17} /> Cuenta
      </button>
      <button class="top-action top-action--cart" data-panel-open="cart">
        <Icon name="shopping-bag" size={17} /> Carrito (<span data-cart-count>0</span>)
      </button>
      <a href="/plantas" class="btn btn--green btn--nav">
        <Icon name="leaf" size={15} /> Ir a plantas
      </a>
    </div>

    <div class="mobile-actions">
      <button class="icon-btn" data-toggle="mobile-search" aria-label="Buscar">
        <Icon name="search" size={21} />
      </button>
      <button class="icon-btn" data-panel-open="account" aria-label="Cuenta">
        <Icon name="user" size={21} />
      </button>
      <button class="icon-btn icon-btn--cart" data-panel-open="cart" aria-label="Carrito">
        <Icon name="shopping-bag" size={21} />
        <span class="cart-bubble" data-cart-count>0</span>
      </button>
      <button
        class="icon-btn"
        data-toggle="mobile-menu"
        aria-label="Menú"
        aria-expanded="false"
      >
        <span class="when-closed"><Icon name="menu" size={23} /></span>
        <span class="when-open"><Icon name="x" size={23} /></span>
      </button>
    </div>
  </div>

  <div class="mobile-search" data-region="mobile-search" hidden>
    <form class="search" action="/plantas" method="get" role="search" data-search-form>
      <input
        type="search"
        name="q"
        placeholder="Buscar plantas, macetas…"
        aria-label="Buscar plantas"
        autocomplete="off"
        data-search-input
      />
      <button type="submit" aria-label="Buscar"><Icon name="search" size={17} /></button>
      <div class="search-drop" data-search-drop hidden></div>
    </form>
  </div>

  <nav class="mobile-menu" data-region="mobile-menu" aria-label="Navegación móvil" hidden>
    <!-- Nivel raiz: tarjeta con miniaturas arriba y filas simples abajo,
         como el menu de celular de la referencia. -->
    <div class="mobile-card" data-menu-panel="root">
      <button class="mobile-item" data-menu-goto="plantas">
        <!-- FOTO PENDIENTE: miniatura menu "Plantas" — cuadrada, 96×96 px -->
        <span class="mobile-thumb" aria-hidden="true">🪴</span>
        <span class="mobile-label">Plantas</span>
        <Icon name="chevron-right" size={18} class="mobile-chev" />
      </button>
      <button class="mobile-item" data-menu-goto="colecciones">
        <!-- FOTO PENDIENTE: miniatura menu "Colecciones" — cuadrada, 96×96 px -->
        <span class="mobile-thumb" aria-hidden="true">🌿</span>
        <span class="mobile-label">Colecciones</span>
        <Icon name="chevron-right" size={18} class="mobile-chev" />
      </button>
      <button class="mobile-item" data-menu-goto="eventos">
        <!-- FOTO PENDIENTE: miniatura menu "Eventos" — cuadrada, 96×96 px -->
        <span class="mobile-thumb" aria-hidden="true">🌺</span>
        <span class="mobile-label">Eventos</span>
        <Icon name="chevron-right" size={18} class="mobile-chev" />
      </button>
      <button class="mobile-item" data-menu-goto="servicios">
        <span class="mobile-label">Servicios</span>
        <Icon name="chevron-right" size={18} class="mobile-chev" />
      </button>
      <button class="mobile-item" data-panel-open="orders">
        <span class="mobile-label">Pedidos</span>
        <Icon name="chevron-right" size={18} class="mobile-chev" />
      </button>
      <a href={VIVERO_URL} target="_blank" rel="noopener" class="mobile-item">
        <span class="mobile-label">Nuestro Vivero</span>
        <Icon name="chevron-right" size={18} class="mobile-chev" />
      </a>
      <a href="/mayorista" class="mobile-item">
        <span class="mobile-label">Mayorista</span>
        <Icon name="chevron-right" size={18} class="mobile-chev" />
      </a>
      <a href="/contacto" class="mobile-item">
        <span class="mobile-label">Contacto</span>
        <Icon name="chevron-right" size={18} class="mobile-chev" />
      </a>
    </div>

    <!-- Nivel: Plantas -->
    <div class="mobile-card" data-menu-panel="plantas" hidden>
      <button class="mobile-back" data-menu-back>
        <Icon name="chevron-left" size={18} />
        <span>Plantas</span>
      </button>
      <a href="/plantas" class="mobile-item">
        <span class="mobile-label">Ver todas</span>
        <Icon name="chevron-right" size={18} class="mobile-chev" />
      </a>
      <button class="mobile-item" data-menu-goto="colecciones">
        <span class="mobile-label">Colecciones populares</span>
        <Icon name="chevron-right" size={18} class="mobile-chev" />
      </button>
      <button class="mobile-item" data-menu-goto="tipos">
        <span class="mobile-label">Tipo de planta</span>
        <Icon name="chevron-right" size={18} class="mobile-chev" />
      </button>
      <a href="/quiz" class="mobile-item">
        <span class="mobile-label">Quiz</span>
        <Icon name="chevron-right" size={18} class="mobile-chev" />
      </a>
    </div>

    <!-- Nivel: Colecciones populares -->
    <div class="mobile-card" data-menu-panel="colecciones" hidden>
      <button class="mobile-back" data-menu-back>
        <Icon name="chevron-left" size={18} />
        <span>Colecciones populares</span>
      </button>
      {menuColecciones.map((l) => (
        <a href={l.href} class="mobile-item">
          <span class="mobile-label">{l.label}</span>
          <Icon name="chevron-right" size={18} class="mobile-chev" />
        </a>
      ))}
      <a href="/colecciones" class="mobile-item">
        <span class="mobile-label">Todas las colecciones</span>
        <Icon name="chevron-right" size={18} class="mobile-chev" />
      </a>
    </div>

    <!-- Nivel: Tipo de planta -->
    <div class="mobile-card" data-menu-panel="tipos" hidden>
      <button class="mobile-back" data-menu-back>
        <Icon name="chevron-left" size={18} />
        <span>Tipo de planta</span>
      </button>
      {menuTipos.map((l) => (
        <a href={l.href} class="mobile-item">
          <span class="mobile-label">{l.label}</span>
          <Icon name="chevron-right" size={18} class="mobile-chev" />
        </a>
      ))}
    </div>

    <!-- Nivel: Eventos -->
    <div class="mobile-card" data-menu-panel="eventos" hidden>
      <button class="mobile-back" data-menu-back>
        <Icon name="chevron-left" size={18} />
        <span>Eventos</span>
      </button>
      <a href="/eventos" class="mobile-item">
        <span class="mobile-label">Ver todo</span>
        <Icon name="chevron-right" size={18} class="mobile-chev" />
      </a>
      {eventosLinks.map((l) => (
        <a href={l.href} class="mobile-item">
          <span class="mobile-label">{l.label}</span>
          <Icon name="chevron-right" size={18} class="mobile-chev" />
        </a>
      ))}
    </div>

    <!-- Nivel: Servicios -->
    <div class="mobile-card" data-menu-panel="servicios" hidden>
      <button class="mobile-back" data-menu-back>
        <Icon name="chevron-left" size={18} />
        <span>Servicios</span>
      </button>
      <a href="/servicios" class="mobile-item">
        <span class="mobile-label">Ver todo</span>
        <Icon name="chevron-right" size={18} class="mobile-chev" />
      </a>
      {serviciosLinks.map((l) => (
        <a href={l.href} class="mobile-item">
          <span class="mobile-label">{l.label}</span>
          <Icon name="chevron-right" size={18} class="mobile-chev" />
        </a>
      ))}
    </div>
  </nav>

  <nav class="nav-row" aria-label="Navegación principal">
    <div class="container nav-inner">
      <a href="/" class:list={['nav-link', { active: currentPath === '/' }]}>Inicio</a>

      <div class="has-menu has-menu--wide">
        <a href="/plantas" class:list={['nav-link', { active: isActive('/plantas') }]}>
          Plantas <Icon name="chevron-down" size={13} />
        </a>
        <div class="mega" role="menu">
          <div class="container mega-grid">
            {megaColumns.map((column) => (
              <div class="mega-col">
                <p class="mega-title">{column.title}</p>
                {column.links.map((l) => (
                  <a href={l.href}>{l.label}</a>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>

      <a href="/colecciones" class:list={['nav-link', { active: isActive('/colecciones') }]}>Colecciones</a>
      <button class="nav-link nav-link--btn" data-panel-open="orders">Pedidos</button>
      <a href={VIVERO_URL} target="_blank" rel="noopener" class="nav-link">Nuestro Vivero</a>

      <div class="has-menu">
        <a href="/servicios" class:list={['nav-link', { active: isActive('/servicios') }]}>
          Servicios <Icon name="chevron-down" size={13} />
        </a>
        <div class="drop" role="menu">
          <p class="drop-title">Jardines, mantenimiento y obra</p>
          <p class="drop-text">
            Diseñamos, sembramos y mantenemos áreas verdes en toda la ciudad de Panamá, con material
            de nuestro vivero.
          </p>
          <div class="drop-links">
            {serviciosLinks.map((l) => <a href={l.href}>{l.label}</a>)}
          </div>
          <div class="drop-foot">
            <span>Visita y cotización sin costo</span>
            <a
              href={whatsappLink('Hola, quiero cotizar un servicio de paisajismo o mantenimiento.')}
              target="_blank"
              rel="noopener">Cotizar por WhatsApp →</a
            >
          </div>
        </div>
      </div>

      <div class="has-menu">
        <a href="/eventos" class:list={['nav-link', { active: isActive('/eventos') }]}>
          Eventos <Icon name="chevron-down" size={13} />
        </a>
        <div class="drop" role="menu">
          <p class="drop-title">Decoración con plantas para eventos</p>
          <p class="drop-text">
            Alquilamos y montamos plantas para bodas, ferias y activaciones. Entrega, montaje y
            retiro incluidos.
          </p>
          <div class="drop-links">
            {eventosLinks.map((l) => <a href={l.href}>{l.label}</a>)}
          </div>
          <div class="drop-foot">
            <span>Reserva con 2 semanas de anticipación</span>
            <a
              href={whatsappLink('Hola, quiero cotizar plantas para un evento.')}
              target="_blank"
              rel="noopener">Cotizar por WhatsApp →</a
            >
          </div>
        </div>
      </div>

      <a href="/mayorista" class:list={['nav-link', { active: isActive('/mayorista') }]}>Mayorista</a>
      <a href="/contacto" class:list={['nav-link', { active: isActive('/contacto') }]}>Contacto</a>
    </div>
  </nav>
</header>

<!-- Panel lateral: carrito -->
<div class="panel" data-panel="cart" hidden>
  <div class="panel-backdrop" data-panel-close></div>
  <aside class="panel-sheet" role="dialog" aria-label="Tu carrito">
    <div class="panel-head">
      <span class="panel-title">Tu carrito</span>
      <button class="panel-close" data-panel-close>Cerrar <Icon name="x" size={16} /></button>
    </div>
    <div class="panel-body">
      <div data-cart-empty>
        <p class="empty-note">Tu carrito está vacío.</p>
        <a href="/plantas" class="panel-cta">Seguir comprando</a>
        <p class="empty-kicker">Colecciones populares</p>
        <div class="empty-grid">
          {
            emptyCartCollections.map((c) => (
              <a href={c.href} class="empty-tile">
                <!-- FOTO PENDIENTE: coleccion — 2:1 aprox, 360×240 px -->
                <span class="empty-photo" aria-hidden="true" />
                <span>{c.label}</span>
              </a>
            ))
          }
        </div>
      </div>
      <div data-cart-lines></div>
    </div>
    <div class="panel-foot" data-cart-foot hidden>
      <!-- Progreso hacia el envio gratis (regla en src/lib/envio.ts). -->
      <div class="envio-promo" data-panel-envio hidden>
        <p class="envio-promo-texto" data-panel-envio-texto></p>
        <div class="envio-promo-barra" role="presentation">
          <span class="envio-promo-avance" data-panel-envio-avance></span>
        </div>
      </div>
      <div class="subtotal-row">
        <span>Subtotal</span>
        <span class="subtotal" data-cart-subtotal>$0.00</span>
      </div>
      <a href="/checkout" class="panel-cta">Ir a pagar</a>
      <a href="/carrito" class="panel-link">Ver el carrito completo</a>
      <p class="panel-note">Impuestos y envío se calculan al pagar.</p>
    </div>
  </aside>
</div>

<!-- Panel lateral: cuenta (v1 sin sesiones; se muestra el estado "sin sesion"
     del diseno y el inicio de sesion queda deshabilitado hasta que exista). -->
<div class="panel" data-panel="account" hidden>
  <div class="panel-backdrop" data-panel-close></div>
  <aside class="panel-sheet" role="dialog" aria-label="Mi cuenta">
    <div class="panel-head">
      <span class="panel-brandtitle">MI CUENTA</span>
      <button class="panel-close panel-close--round" data-panel-close aria-label="Cerrar">
        <Icon name="x" size={15} />
      </button>
    </div>
    <div class="panel-body">
      <div class="account-tab" data-account-tab="forYou">
        <div class="cuenta-estado" data-cuenta-anon>
          <p class="account-headline">Sigue tus pedidos y compra más rápido</p>
          <a href="/cuenta/entrar" class="account-signin account-signin--link">Iniciar sesión</a>
          <a href="/cuenta/registro" class="account-alt">Crear cuenta</a>
        </div>
        <div class="cuenta-estado" data-cuenta-user hidden>
          <p class="account-headline">Hola, <span data-cuenta-nombre></span></p>
          <a href="/cuenta" class="account-signin account-signin--link">Ver mis pedidos</a>
          <button class="account-alt account-alt--btn" data-cuenta-salir>Cerrar sesión</button>
        </div>
        <div class="account-chips">
          <a href="/plantas?c=mas-vendidas">Más vendidas</a>
          <a href="/plantas">Todas las plantas</a>
        </div>
        <p class="account-sub">Favoritos</p>
        <div class="account-card account-card--lista" data-favoritos>
          Toca el corazón de una planta para guardarla aquí
        </div>
        <p class="account-sub">Vistas recientemente</p>
        <div class="account-card account-card--lista" data-vistos>Sin artículos vistos</div>
        <div class="account-links">
          <a href="/mayorista">Compras al mayor</a>
          <span class="account-links-sep" aria-hidden="true">·</span>
          <a href={whatsappLink('Hola, tengo una consulta sobre mi cuenta.')} target="_blank" rel="noopener">Contáctanos</a>
        </div>
      </div>
      <div class="account-tab" data-account-tab="orders" hidden>
        <p class="account-headline">Consulta tus pedidos y el estado de la entrega</p>
        <div class="account-card account-card--left" data-cuenta-orders-nota>
          Inicia sesión para ver todos tus pedidos, o consulta uno con su número.
        </div>
        <a href="/cuenta/entrar" class="panel-cta" data-cuenta-orders-cta>Iniciar sesión</a>
        <a href="/pedido" class="panel-link">Consultar con número de pedido</a>
      </div>
      <div class="account-tab" data-account-tab="profile" hidden>
        <p class="account-headline">Perfil</p>
        <div class="account-card" data-cuenta-perfil>Inicia sesión para ver tus datos</div>
        <p class="account-sub">Todos tus favoritos</p>
        <div class="account-card account-card--lista" data-favoritos-todos>
          Toca el corazón de una planta para guardarla aquí
        </div>
        <p class="account-sub">Compras anteriores</p>
        <div class="account-card account-card--left" data-compras-lista>
          Inicia sesión para ver tus compras anteriores.
        </div>
      </div>
    </div>
    <div class="account-tabs">
      <button class="account-tabbtn active" data-account-goto="forYou">Para ti</button>
      <button class="account-tabbtn" data-account-goto="orders">Pedidos</button>
      <button class="account-tabbtn" data-account-goto="profile">Perfil</button>
    </div>
  </aside>
</div>

<!-- Panel lateral: pedidos. La lista sale del servidor con la sesion
     (/api/account/orders): asi se ven los mismos pedidos desde cualquier
     dispositivo. Sin sesion queda la nota con el camino del numero. -->
<div class="panel" data-panel="orders" hidden>
  <div class="panel-backdrop" data-panel-close></div>
  <aside class="panel-sheet" role="dialog" aria-label="Tus pedidos">
    <div class="panel-head">
      <span class="panel-title">Tus pedidos</span>
      <button class="panel-close" data-panel-close>Cerrar <Icon name="x" size={16} /></button>
    </div>
    <div class="panel-body">
      <div class="account-card account-card--left" data-pedidos-lista>
        Inicia sesión para ver tus pedidos aquí, o consulta el estado de tu entrega con el número
        de pedido que te enviamos por WhatsApp.
      </div>
      <div class="orders-legend">
        <p class="orders-legend-title">Qué significa cada color</p>
        <div><span class="dot" style="background:#15662f"></span>Confirmado, con fecha de salida del vivero</div>
        <div><span class="dot" style="background:#d97706"></span>Salió a tiempo y viene en camino</div>
        <div><span class="dot" style="background:#16a34a"></span>Recibido</div>
        <div><span class="dot" style="background:#b91c1c"></span>Atrasado: no salió en la fecha prevista</div>
      </div>
    </div>
    <div class="panel-foot">
      <a href="/pedido" class="panel-cta">Ver todos los pedidos</a>
      <a
        href={whatsappLink('Hola, quiero información sobre mi pedido.')}
        class="panel-link"
        target="_blank"
        rel="noopener">Preguntar por un pedido</a
      >
    </div>
  </aside>
</div>

<script>
  import { cartCount, cartTotal, getCart, removeFromCart, setQty } from '../lib/cart';
  import { ENVIO_GRATIS_DESDE, faltaParaEnvioGratis } from '../lib/envio';
  import { getFavoritos, getVistos } from '../lib/preferencias';
  import type { ProductoGuardado } from '../lib/preferencias';

  // ─── Buscador en vivo del navbar ───────────────────────────────────────
  // Filtra el indice embebido mientras se escribe: hasta 5 productos con su
  // miniatura y precio, colecciones que coincidan y el enlace a todos los
  // resultados. Escape o un clic fuera lo cierran. Aplica igual al buscador
  // de escritorio y al de celular (cada form trae su propio panel).
  const buscadorIndice = document.querySelector('[data-search-index]');

  if (buscadorIndice) {
    interface ProductoIndice { n: string; c: string; u: string; p: number; s: number; i: string | null; e: string }
    interface ColeccionIndice { n: string; s: string }
    const { productos, colecciones } = JSON.parse(buscadorIndice.textContent!) as {
      productos: ProductoIndice[];
      colecciones: ColeccionIndice[];
    };

    const normalizar = (s: string) =>
      s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

    const escapar = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    function renderBusqueda(input: HTMLInputElement, drop: HTMLElement) {
      const consulta = normalizar(input.value.trim());
      if (consulta.length < 2) {
        drop.hidden = true;
        return;
      }

      const coincideProducto = productos.filter(
        (p) => normalizar(p.n).includes(consulta) || normalizar(p.c).includes(consulta),
      );
      const coincideColeccion = colecciones.filter((c) => normalizar(c.n).includes(consulta));

      if (!coincideProducto.length && !coincideColeccion.length) {
        drop.innerHTML = `<p class="drop-empty">Sin resultados para “${escapar(input.value.trim())}”</p>`;
        drop.hidden = false;
        return;
      }

      let html = '';
      if (coincideProducto.length) {
        html += '<p class="drop-title">Productos</p>';
        html += coincideProducto
          .slice(0, 5)
          .map((p) => {
            const visual = p.i
              ? `<span class="drop-thumb" style="background-image: url('${p.i}')"></span>`
              : `<span class="drop-thumb drop-thumb--emoji">${p.e}</span>`;
            const nombreCientifico = p.c ? `<span class="drop-sci">${escapar(p.c)}</span>` : '';
            const precio = p.s ? 'Próximamente' : `Desde $${p.p.toFixed(2)}`;
            return `<a class="drop-row" href="${p.u}">${visual}<span class="drop-copy"><span class="drop-name">${escapar(p.n)}</span>${nombreCientifico}<span class="drop-price">${precio}</span></span></a>`;
          })
          .join('');
        if (coincideProducto.length > 5) {
          html += `<a class="drop-all" href="/plantas?q=${encodeURIComponent(input.value.trim())}">Ver los ${coincideProducto.length} resultados →</a>`;
        }
      }
      if (coincideColeccion.length) {
        html += '<p class="drop-title">Colecciones</p>';
        html += coincideColeccion
          .slice(0, 4)
          .map((c) => `<a class="drop-row drop-row--col" href="/plantas?c=${c.s}">${escapar(c.n)}</a>`)
          .join('');
      }

      drop.innerHTML = html;
      drop.hidden = false;
    }

    const buscadores = Array.from(document.querySelectorAll<HTMLFormElement>('[data-search-form]'));
    buscadores.forEach((form) => {
      const input = form.querySelector<HTMLInputElement>('[data-search-input]');
      const drop = form.querySelector<HTMLElement>('[data-search-drop]');
      if (!input || !drop) return;
      const pintar = () => renderBusqueda(input, drop);
      input.addEventListener('input', pintar);
      input.addEventListener('focus', pintar);
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') drop.hidden = true;
      });
    });
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('[data-search-form]')) {
        document.querySelectorAll<HTMLElement>('[data-search-drop]').forEach((d) => (d.hidden = true));
      }
    });
  }

  const CATEGORY_LABELS: Record<string, string> = {
    interior: 'Planta de interior',
    exterior: 'Planta de exterior',
    florales: 'Floral',
  };

  const money = (n: number) => `$${n.toFixed(2)}`;

  function refreshCount() {
    document.querySelectorAll('[data-cart-count]').forEach((el) => {
      el.textContent = String(cartCount());
    });
  }

  function renderCartPanel() {
    const linesEl = document.querySelector<HTMLElement>('[data-cart-lines]');
    const emptyEl = document.querySelector<HTMLElement>('[data-cart-empty]');
    const footEl = document.querySelector<HTMLElement>('[data-cart-foot]');
    const subtotalEl = document.querySelector<HTMLElement>('[data-cart-subtotal]');
    if (!linesEl || !emptyEl || !footEl) return;

    const items = getCart();
    emptyEl.hidden = items.length > 0;
    footEl.hidden = items.length === 0;
    const subtotal = cartTotal();
    if (subtotalEl) subtotalEl.textContent = money(subtotal);

    // Anuncio del envio gratis: mismo progreso que en /carrito.
    const promoBox = document.querySelector<HTMLElement>('[data-panel-envio]');
    const promoTexto = document.querySelector<HTMLElement>('[data-panel-envio-texto]');
    const promoAvance = document.querySelector<HTMLElement>('[data-panel-envio-avance]');
    if (promoBox && promoTexto && promoAvance) {
      if (ENVIO_GRATIS_DESDE === null || items.length === 0) {
        promoBox.hidden = true;
      } else {
        promoBox.hidden = false;
        const falta = faltaParaEnvioGratis(subtotal);
        promoBox.classList.toggle('envio-promo--ganado', falta === 0);
        promoTexto.textContent =
          falta === 0
            ? '🎉 Tu pedido tiene envío gratis'
            : `Te faltan ${money(falta)} para el envío gratis`;
        promoAvance.style.width = `${Math.min(100, (subtotal / ENVIO_GRATIS_DESDE) * 100)}%`;
      }
    }

    linesEl.replaceChildren(
      ...items.map((item) => {
        const row = document.createElement('div');
        row.className = 'panel-line';
        // Con foto real se muestra la foto; sin foto queda el emoji.
        const thumb = item.image
          ? `<div class="cart-thumb" aria-hidden="true" style="background-image: url('${item.image}'); background-size: cover; background-position: center;"></div>`
          : `<div class="cart-thumb" aria-hidden="true">${item.emoji}</div>`;
        row.innerHTML = `
          ${thumb}
          <div class="cart-info">
            <div class="cart-name"></div>
            <div class="cart-variant"></div>
            <div class="cart-controls">
              <div class="cart-stepper">
                <button type="button" data-dec aria-label="Quitar uno">–</button>
                <span class="cart-qty">${item.qty}</span>
                <button type="button" data-inc aria-label="Agregar uno">+</button>
              </div>
              <button type="button" class="cart-remove" data-remove>Eliminar</button>
            </div>
          </div>
          <div class="cart-total">${money(item.price * item.qty)}</div>`;
        row.querySelector('.cart-name')!.textContent = item.name;
        row.querySelector('.cart-variant')!.textContent =
          CATEGORY_LABELS[item.category] ?? item.category;
        row.querySelector('[data-dec]')!.addEventListener('click', () => setQty(item.sku, item.qty - 1));
        row.querySelector('[data-inc]')!.addEventListener('click', () => setQty(item.sku, item.qty + 1));
        row.querySelector('[data-remove]')!.addEventListener('click', () => removeFromCart(item.sku));
        return row;
      }),
    );
  }

  refreshCount();
  renderCartPanel();
  document.addEventListener('cart:updated', () => {
    refreshCount();
    renderCartPanel();
  });

  // Al agregar un producto se abre el panel del carrito (comportamiento de
  // la tienda de referencia): la confirmacion es ver el articulo adentro.
  document.addEventListener('cart:added', () => openPanel('cart'));

  // Al marcar el corazon se abre el panel de cuenta, donde vive la lista de
  // favoritos: misma confirmacion que el carrito. Quitar un favorito no lo
  // abre (el evento solo se emite al agregar).
  document.addEventListener('favoritos:added', () => openPanel('account'));

  // Listas del panel de cuenta: vistos recientemente y favoritos (localStorage).
  // `max` recorta la lista; si quedan mas, `verMas` agrega el enlace que lleva
  // a la pestana Perfil, donde viven todos los favoritos.
  function pintarListaCuenta(
    el: HTMLElement | null,
    productos: ProductoGuardado[],
    vacio: string,
    opciones: { max?: number; verMas?: boolean } = {},
  ) {
    if (!el) return;
    if (!productos.length) {
      el.classList.remove('account-card--llena');
      el.textContent = vacio;
      return;
    }
    const total = productos.length;
    if (opciones.max) productos = productos.slice(0, opciones.max);
    el.classList.add('account-card--llena');
    el.innerHTML = productos
      .map((p) => {
        const thumb = p.image
          ? `<span class="account-thumb" style="background-image: url('${p.image}')"></span>`
          : `<span class="account-thumb account-thumb--emoji">${p.emoji}</span>`;
        return `<a class="account-item" href="/plantas/${p.category}/${p.slug}">${thumb}<span class="account-item-copy"><span class="account-item-name"></span><span class="account-item-price">Desde ${money(p.price)}</span></span></a>`;
      })
      .join('');
    // El nombre se asigna como texto (viene de localStorage, no del build).
    el.querySelectorAll('.account-item-name').forEach((n, i) => {
      n.textContent = productos[i].name;
    });
    if (opciones.verMas && total > productos.length) {
      const mas = document.createElement('button');
      mas.className = 'panel-link panel-link--btn';
      mas.textContent = `Ver los ${total} favoritos`;
      mas.addEventListener('click', () =>
        document.querySelector<HTMLElement>('[data-account-goto="profile"]')?.click(),
      );
      el.appendChild(mas);
    }
  }

  function pintarListasCuenta() {
    // "Para ti": favoritos primero (hasta 6 y el resto en Perfil), despues
    // las ultimas 3 vistas.
    pintarListaCuenta(
      document.querySelector('[data-favoritos]'),
      getFavoritos(),
      'Toca el corazón de una planta para guardarla aquí',
      { max: 6, verMas: true },
    );
    pintarListaCuenta(
      document.querySelector('[data-vistos]'),
      getVistos(),
      'Sin artículos vistos',
      { max: 3 },
    );
    // Perfil: todos los favoritos, sin tope.
    pintarListaCuenta(
      document.querySelector('[data-favoritos-todos]'),
      getFavoritos(),
      'Toca el corazón de una planta para guardarla aquí',
    );
  }

  document.addEventListener('favoritos:updated', pintarListasCuenta);

  // Panel de cuenta: estado real de sesion. Se consulta una sola vez, la
  // primera vez que se abre el panel; sin sesion (401) queda el estado
  // anonimo que ya esta pintado.
  let cuentaConsultada = false;

  async function pintarPanelCuenta() {
    if (cuentaConsultada) return;
    cuentaConsultada = true;
    try {
      const res = await fetch('/api/auth/me');
      if (!res.ok) return;
      const yo = (await res.json()) as { nombre?: string; email?: string };
      document.querySelectorAll<HTMLElement>('[data-cuenta-anon]').forEach((el) => (el.hidden = true));
      const user = document.querySelector<HTMLElement>('[data-cuenta-user]');
      if (user) user.hidden = false;
      const nombre = document.querySelector('[data-cuenta-nombre]');
      if (nombre) nombre.textContent = yo.nombre ?? '';
      const cta = document.querySelector<HTMLAnchorElement>('[data-cuenta-orders-cta]');
      if (cta) {
        cta.href = '/cuenta';
        cta.textContent = 'Ver mis pedidos';
      }
      const nota = document.querySelector<HTMLElement>('[data-cuenta-orders-nota]');
      if (nota) nota.textContent = 'Tus pedidos están en tu cuenta; también puedes consultar uno con su número.';
      const perfil = document.querySelector<HTMLElement>('[data-cuenta-perfil]');
      if (perfil) perfil.textContent = yo.email ?? '';
    } catch {
      // sin red: se queda el estado anonimo
    }
  }

  // ─── Panel "Tus pedidos": la lista del servidor, no del navegador ──────
  // Con sesion (cookie httpOnly via /api/auth/me) se pintan los pedidos de
  // /api/account/orders con el color de la leyenda; sin sesion queda la
  // nota estatica. Se consulta al abrir el panel, una vez por visita.
  const COLOR_ESTADO: Record<string, string> = {
    Recibido: '#15662f',
    Preparando: '#15662f',
    'En camino': '#d97706',
    Entregado: '#16a34a',
  };
  let pedidosConsultados = false;

  async function pintarPanelPedidos() {
    if (pedidosConsultados) return;
    pedidosConsultados = true;
    const lista = document.querySelector<HTMLElement>('[data-pedidos-lista]');
    if (!lista) return;
    try {
      const sesion = await fetch('/api/auth/me');
      if (!sesion.ok) return; // sin sesion: queda la nota estatica
      const res = await fetch('/api/account/orders');
      if (!res.ok) return;
      const { pedidos } = (await res.json()) as {
        pedidos: {
          numero: string;
          fecha: string;
          total_centavos: number;
          estado: string | null;
          retraso: boolean;
        }[];
      };
      if (!pedidos.length) {
        lista.textContent = 'Todavía no tienes pedidos. Cuando compres, los verás aquí.';
        return;
      }
      lista.classList.add('orders-lista');
      lista.textContent = '';
      for (const pedido of pedidos.slice(0, 5)) {
        const fila = document.createElement('a');
        fila.className = 'orders-item';
        fila.href = `/pedido?n=${encodeURIComponent(pedido.numero)}`;
        const color = pedido.retraso ? '#b91c1c' : COLOR_ESTADO[pedido.estado ?? ''];
        const punto = color ? `<span class="dot" style="background:${color}"></span>` : '';
        const fecha = new Date(pedido.fecha).toLocaleDateString('es-PA', {
          day: 'numeric',
          month: 'short',
        });
        fila.innerHTML =
          `<span class="orders-item-numero">${punto}${pedido.numero}</span>` +
          `<span class="orders-item-meta">${fecha} · $${(pedido.total_centavos / 100).toFixed(2)}` +
          `${pedido.estado ? ` · ${pedido.estado}` : ''}${pedido.retraso ? ' · con retraso' : ''}</span>`;
        lista.appendChild(fila);
      }
      if (pedidos.length > 5) {
        const mas = document.createElement('a');
        mas.className = 'panel-link';
        mas.href = '/cuenta';
        mas.textContent = `Ver los ${pedidos.length} pedidos en tu cuenta`;
        lista.appendChild(mas);
      }
    } catch {
      // sin red u Odoo caido: queda lo que alcanzo a pintarse
    }
  }

  // Perfil: compras anteriores (los pedidos de la cuenta, del servidor).
  // Se consultan la primera vez que se abre la pestana; sin sesion queda la
  // nota de iniciar sesion.
  let comprasConsultadas = false;

  async function pintarComprasPerfil() {
    if (comprasConsultadas) return;
    comprasConsultadas = true;
    const lista = document.querySelector<HTMLElement>('[data-compras-lista]');
    if (!lista) return;
    try {
      const sesion = await fetch('/api/auth/me');
      if (!sesion.ok) return; // sin sesion: queda la nota estatica
      const res = await fetch('/api/account/orders');
      if (!res.ok) return;
      const { pedidos } = (await res.json()) as {
        pedidos: {
          numero: string;
          fecha: string;
          total_centavos: number;
          estado: string | null;
          retraso: boolean;
        }[];
      };
      if (!pedidos.length) {
        lista.textContent = 'Todavía no tienes compras. Cuando compres, las verás aquí.';
        return;
      }
      lista.classList.add('orders-lista');
      lista.textContent = '';
      for (const pedido of pedidos.slice(0, 10)) {
        const fila = document.createElement('a');
        fila.className = 'orders-item';
        fila.href = `/pedido?n=${encodeURIComponent(pedido.numero)}`;
        const fecha = new Date(pedido.fecha).toLocaleDateString('es-PA', {
          day: 'numeric',
          month: 'short',
          year: 'numeric',
        });
        fila.innerHTML =
          `<span class="orders-item-numero">${pedido.numero}</span>` +
          `<span class="orders-item-meta">${fecha} · $${(pedido.total_centavos / 100).toFixed(2)}` +
          `${pedido.estado ? ` · ${pedido.estado}` : ''}</span>`;
        lista.appendChild(fila);
      }
      if (pedidos.length > 10) {
        const mas = document.createElement('a');
        mas.className = 'panel-link';
        mas.href = '/cuenta';
        mas.textContent = `Ver las ${pedidos.length} compras en tu cuenta`;
        lista.appendChild(mas);
      }
    } catch {
      // sin red u Odoo caido: queda lo que alcanzo a pintarse
    }
  }

  document.querySelector('[data-cuenta-salir]')?.addEventListener('click', async () => {
    try {
      await fetch('/api/auth/logout', { method: 'POST' });
    } catch {
      // la cookie ya se borro en el servidor o no hay red; recargar igual
    }
    window.location.reload();
  });

  // Paneles laterales (carrito, cuenta, pedidos). La hoja entra y sale
  // deslizandose: hidden se quita antes de animar la entrada y se repone
  // cuando la transicion de salida termina (con un tope por si no dispara).
  let cierrePendiente: number | undefined;

  function openPanel(name: string) {
    window.clearTimeout(cierrePendiente);
    document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => {
      const abre = p.dataset.panel === name;
      p.classList.toggle('panel--abierto', abre);
      if (abre && p.hidden) {
        p.hidden = false;
        p.classList.remove('panel--abierto');
        // Doble rAF: el navegador pinta el estado inicial (fuera de pantalla)
        // antes de agregar la clase, para que la transicion corra.
        requestAnimationFrame(() =>
          requestAnimationFrame(() => p.classList.add('panel--abierto')),
        );
      } else if (!abre) {
        p.hidden = true;
      }
    });
    document.body.style.overflow = 'hidden';
    if (name === 'account') {
      pintarPanelCuenta();
      pintarListasCuenta();
    }
    if (name === 'orders') pintarPanelPedidos();
  }

  function closePanels() {
    window.clearTimeout(cierrePendiente);
    const esconder = () => {
      // Si el usuario reabrio un panel mientras este terminaba de cerrarse,
      // el transitionend pendiente no debe esconderlo.
      if (document.querySelector('.panel--abierto')) return;
      document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = true));
    };
    const abierto = document.querySelector<HTMLElement>('.panel--abierto');
    if (abierto) {
      const hoja = abierto.querySelector<HTMLElement>('.panel-sheet');
      abierto.classList.remove('panel--abierto');
      hoja?.addEventListener(
        'transitionend',
        (ev) => {
          // Solo la transicion de la hoja (no una burbujeada de un hijo).
          if (ev.target === hoja) esconder();
        },
        { once: true },
      );
      cierrePendiente = window.setTimeout(esconder, 400);
    } else {
      esconder();
    }
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLElement>('[data-panel-open]').forEach((btn) => {
    btn.addEventListener('click', () => openPanel(btn.dataset.panelOpen!));
  });
  document.querySelectorAll<HTMLElement>('[data-panel-close]').forEach((btn) => {
    btn.addEventListener('click', closePanels);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closePanels();
  });

  // Pestanas del panel de cuenta.
  document.querySelectorAll<HTMLElement>('[data-account-goto]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.accountGoto;
      document.querySelectorAll<HTMLElement>('[data-account-tab]').forEach((tab) => {
        tab.hidden = tab.dataset.accountTab !== target;
      });
      if (target === 'profile') pintarComprasPerfil();
      document
        .querySelectorAll('[data-account-goto]')
        .forEach((b) => b.classList.toggle('active', b === btn));
    });
  });

  // Alternadores del movil (buscador y menu).
  document.querySelectorAll<HTMLElement>('[data-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const name = btn.dataset.toggle!;
      const region = document.querySelector<HTMLElement>(`[data-region="${name}"]`);
      if (!region) return;
      const willOpen = region.hidden;
      // Buscador y menu movil son excluyentes entre si.
      if (name === 'mobile-menu' || name === 'mobile-search') {
        document
          .querySelectorAll<HTMLElement>('[data-region="mobile-menu"], [data-region="mobile-search"]')
          .forEach((r) => (r.hidden = true));
        document
          .querySelectorAll('[data-toggle="mobile-menu"], [data-toggle="mobile-search"]')
          .forEach((b) => { b.classList.remove('open'); b.setAttribute('aria-expanded', 'false'); });
      }
      region.hidden = !willOpen;
      btn.classList.toggle('open', willOpen);
      btn.setAttribute('aria-expanded', String(willOpen));
      // Al abrir o cerrar el menu se vuelve al nivel raiz del drill-down.
      if (name === 'mobile-menu') showMenuPanel('root');
    });
  });

  // Drill-down del menu movil: cada nivel es una tarjeta; el encabezado de
  // regreso vuelve al nivel desde el que se entro (pila de navegacion).
  const menuStack: string[] = [];

  function currentMenuPanel(): string {
    const visible = document.querySelector<HTMLElement>('[data-menu-panel]:not([hidden])');
    return visible?.dataset.menuPanel ?? 'root';
  }

  function showMenuPanel(name: string) {
    document.querySelectorAll<HTMLElement>('[data-menu-panel]').forEach((p) => {
      p.hidden = p.dataset.menuPanel !== name;
    });
    if (name === 'root') menuStack.length = 0;
  }

  document.querySelectorAll<HTMLElement>('[data-menu-goto]').forEach((btn) => {
    btn.addEventListener('click', () => {
      menuStack.push(currentMenuPanel());
      showMenuPanel(btn.dataset.menuGoto!);
    });
  });

  document.querySelectorAll<HTMLElement>('[data-menu-back]').forEach((btn) => {
    btn.addEventListener('click', () => {
      showMenuPanel(menuStack.pop() ?? 'root');
    });
  });
</script>

<style>
  .announce {
    background: var(--card-dark);
    text-align: center;
    padding: 9.2px 18.4px;
    font-size: 13px;
    letter-spacing: 0.02em;
  }

  .announce a { color: #eef5f0; text-decoration: underline; }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(238, 245, 240, 0.97);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .top-row {
    display: grid;
    grid-template-columns: 1fr minmax(0, auto) 1fr;
    align-items: center;
    gap: 22px;
    padding-top: 22px;
    padding-bottom: 22px;
  }

  .brand { display: block; color: var(--ink); }
  .brand:hover { text-decoration: none; color: var(--ink); }

  .brand-name {
    display: block;
    font-size: 27px;
    letter-spacing: 0.14em;
    line-height: 1;
  }

  .brand-byline {
    display: block;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-top: 5px;
  }

  .search {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #ffffff;
    width: 100%;
    max-width: 420px;
    margin: 0 auto;
  }

  /* Panel de sugerencias del buscador en vivo. */
  .search-drop {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    z-index: 60;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: 0 18px 44px rgba(27, 42, 31, 0.18);
    padding: 0.55rem;
    max-height: 70vh;
    overflow-y: auto;
  }

  .search-drop[hidden] { display: none; }

  .search-drop :global(.drop-title) {
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0.55rem 0 0.3rem;
    padding: 0 0.55rem;
  }

  .search-drop :global(.drop-row) {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.45rem 0.55rem;
    border-radius: 10px;
    color: var(--ink);
    font-size: 0.9rem;
  }

  .search-drop :global(.drop-row:hover) {
    background: var(--green-tint);
    text-decoration: none;
    color: var(--ink);
  }

  .search-drop :global(.drop-thumb) {
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 10px;
    background-size: cover;
    background-position: center;
    background-color: var(--surface-2);
    outline: 1px solid rgba(27, 42, 31, 0.1);
  }

  .search-drop :global(.drop-thumb--emoji) {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
  }

  .search-drop :global(.drop-copy) { display: flex; flex-direction: column; gap: 1px; }
  .search-drop :global(.drop-name) { font-weight: 600; }
  .search-drop :global(.drop-sci) { font-size: 0.75rem; font-style: italic; color: var(--ink-faint); }
  .search-drop :global(.drop-price) { font-size: 0.8rem; color: var(--green-deep); font-weight: 600; }

  .search-drop :global(.drop-all) {
    display: block;
    padding: 0.5rem 0.55rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--green-deep);
  }

  .search-drop :global(.drop-empty) {
    margin: 0;
    padding: 0.7rem 0.55rem;
    font-size: 0.88rem;
    color: var(--ink-faint);
  }

  .search input {
    flex: 1;
    min-width: 0;
    min-height: 42px;
    padding: 6px 8px 6px 18px;
    font-size: 14px;
    background: transparent;
    border: 0;
    outline: none;
    border-radius: 999px;
  }

  .search input:focus { outline: none; }

  .search button {
    width: 40px;
    height: 40px;
    flex: none;
    margin-right: 4px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 0;
    color: var(--green);
    cursor: pointer;
  }

  .search button:hover { background: rgba(22, 163, 74, 0.12); }

  .top-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 13.8px 18.4px;
  }

  .top-action {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--ink);
    background: transparent;
    border: 0;
    font-family: var(--font-ui);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    padding: 0;
    white-space: nowrap;
  }

  .top-action--cart {
    font-size: 14px;
    letter-spacing: normal;
    text-transform: none;
  }

  .btn--nav {
    padding: 11px 20px;
    font-size: 13px;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* Fila de navegacion */
  .nav-row {
    position: relative;
    border-top: 1px solid var(--line);
  }

  /* Letra y separacion fluidas (clamp con vw): al achicar la ventana o subir
     el zoom la fila se aprieta en vez de partirse en dos lineas, como el
     navbar de Jomashop. El wrap queda solo como ultimo recurso. */
  .nav-inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4.6px clamp(9px, 1.8vw, 27.6px);
    font-size: clamp(9.5px, 0.85vw + 1px, 12px);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (max-width: 1200px) {
    .nav-inner { letter-spacing: 0.09em; }
  }

  @media (max-width: 940px) {
    .nav-inner { letter-spacing: 0.06em; }
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 14px 0;
    color: var(--ink);
    border-bottom: 2px solid transparent;
  }

  .nav-link:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }

  .nav-link.active {
    color: var(--green);
    border-bottom-color: var(--green);
    text-decoration: none;
  }

  .nav-link--btn {
    background: transparent;
    border-top: 0;
    border-left: 0;
    border-right: 0;
    font-family: var(--font-ui);
    /* Hereda tamano y tracking de .nav-inner: un boton no los hereda solo,
       y con valores fijos "Pedidos" quedaba mas grande que el resto y
       empujaba la fila a dos lineas. */
    font-size: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }

  .has-menu { position: relative; display: flex; align-items: center; }
  .has-menu--wide { position: static; }

  /* Mega menu de Plantas (ancho completo) */
  .mega {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 40;
    background: var(--bg);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 12px 32px rgba(27, 42, 31, 0.14);
  }

  .has-menu:hover .mega,
  .has-menu:focus-within .mega { display: block; }

  .mega-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 36.8px;
    padding-top: 36.8px;
    padding-bottom: 36.8px;
    text-transform: none;
    letter-spacing: 0;
    white-space: normal;
  }

  .mega-col {
    display: flex;
    flex-direction: column;
    gap: 9.2px;
  }

  .mega-title {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.01em;
    margin: 0;
    padding-bottom: 9.2px;
    border-bottom: 1px solid var(--line);
  }

  .mega-col a { font-size: 14px; color: var(--ink); }

  /* Desplegables de Servicios y Eventos */
  .drop {
    display: none;
    position: absolute;
    left: 0;
    top: 100%;
    z-index: 45;
    width: 300px;
    box-sizing: border-box;
    background: #ffffff;
    border: 1px solid var(--line);
    box-shadow: 0 12px 28px rgba(27, 42, 31, 0.16);
    padding: 15px;
    flex-direction: column;
    gap: 11px;
    text-transform: none;
    letter-spacing: 0;
    white-space: normal;
  }

  .has-menu:hover .drop,
  .has-menu:focus-within .drop { display: flex; }

  .drop-title { font-size: 15px; font-weight: 600; margin: 0; }

  .drop-text {
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
    color: rgba(27, 42, 31, 0.72);
  }

  .drop-links {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-top: 1px solid rgba(27, 42, 31, 0.14);
    padding-top: 9px;
  }

  .drop-links a {
    font-size: 14px;
    color: var(--ink);
    padding: 8px 9px;
  }

  .drop-links a:hover { background: var(--bg); text-decoration: none; }

  .drop-foot {
    border-top: 1px solid rgba(27, 42, 31, 0.14);
    padding-top: 11px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    font-size: 12px;
    color: rgba(27, 42, 31, 0.7);
  }

  .drop-foot a { font-size: 13px; font-weight: 600; }

  /* Acciones e iconos del movil */
  .mobile-actions { display: none; align-items: center; flex: none; }

  .icon-btn {
    position: relative;
    width: 40px;
    height: 40px;
    border: 0;
    background: transparent;
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .cart-bubble {
    position: absolute;
    top: 4px;
    right: 2px;
    min-width: 17px;
    height: 17px;
    border-radius: 999px;
    background: var(--green);
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
  }

  .when-open { display: none; }
  .open .when-open { display: inline-flex; }
  .open .when-closed { display: none; }

  .mobile-search { padding: 0 18px 15px; }
  .mobile-search .search { max-width: none; }
  .mobile-search[hidden] { display: none; }

  /* Menu movil: panel que flota sobre el contenido (el hero queda visible
     debajo), como el menu de celular de la referencia. */
  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 60;
    border-top: 1px solid var(--line);
    background: var(--bg);
    padding: 15px 15px 22px;
    box-shadow: 0 24px 48px rgba(27, 42, 31, 0.28);
    max-height: 78vh;
    overflow-y: auto;
  }

  .mobile-menu[hidden] { display: none; }

  [data-menu-panel][hidden] { display: none; }

  .mobile-card {
    background: #f8fbf9;
    border: 1px solid rgba(27, 42, 31, 0.12);
    border-radius: 14px;
    overflow: hidden;
  }

  .mobile-item {
    width: 100%;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 13px 15px;
    color: var(--ink);
    background: transparent;
    border: 0;
    font-family: var(--font-ui);
    font-size: 17px;
    text-align: left;
    cursor: pointer;
    text-decoration: none;
  }

  .mobile-item + .mobile-item,
  .mobile-back + .mobile-item { border-top: 1px solid rgba(27, 42, 31, 0.1); }

  .mobile-item:hover { background: var(--bg); text-decoration: none; color: var(--ink); }

  /* Encabezado de regreso de un submenu: "‹ Nivel" subrayado. */
  .mobile-back {
    width: 100%;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 15px;
    color: var(--ink);
    background: transparent;
    border: 0;
    font-family: var(--font-ui);
    font-size: 17px;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
  }

  .mobile-back span { text-decoration: underline; text-underline-offset: 4px; }
  .mobile-back:hover { background: var(--bg); }

  .mobile-thumb {
    width: 48px;
    height: 48px;
    flex: none;
    border-radius: 8px;
    overflow: hidden;
    background: #dce9df;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
  }

  .mobile-label { flex: 1; min-width: 0; }
  .mobile-chev { color: rgba(27, 42, 31, 0.45); flex: none; }

  /* Paneles laterales. El script agrega .panel--abierto un cuadro despues de
     quitar hidden (entrada) y lo retira antes de volver a poner hidden
     (salida), esperando el transitionend de la hoja. */
  .panel { position: fixed; inset: 0; z-index: 80; }
  .panel[hidden] { display: none; }

  .panel-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(27, 42, 31, 0.45);
    opacity: 0;
    transition: opacity 240ms ease;
  }

  .panel-sheet {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(420px, 92vw);
    background: var(--bg);
    box-shadow: -8px 0 32px rgba(27, 42, 31, 0.22);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    /* Salida: mas corta que la entrada, el sistema responde rapido. */
    transition: transform 260ms var(--ease-drawer);
  }

  .panel--abierto .panel-backdrop { opacity: 1; }

  .panel--abierto .panel-sheet {
    transform: translateX(0);
    transition-duration: 420ms;
  }

  @media (prefers-reduced-motion: reduce) {
    /* Menos movimiento, no cero: la hoja solo se funde, sin desplazarse. */
    .panel-sheet {
      transform: none;
      opacity: 0;
      transition: opacity 160ms ease;
    }
    .panel--abierto .panel-sheet { opacity: 1; transition-duration: 160ms; }
  }

  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 18.4px 22px;
    border-bottom: 1px solid var(--line);
  }

  .panel-title { font-size: 17px; font-weight: 600; }
  .panel-brandtitle { font-size: 19px; letter-spacing: 0.1em; }

  .panel-close {
    display: flex;
    align-items: center;
    gap: 7px;
    background: transparent;
    border: 0;
    font-family: var(--font-ui);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
    cursor: pointer;
  }

  .panel-close--round {
    width: 32px;
    height: 32px;
    justify-content: center;
    gap: 0;
    border-radius: 50%;
    border: 1px solid rgba(27, 42, 31, 0.2);
    background: #ffffff;
  }

  .panel-body {
    flex: 1;
    overflow-y: auto;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 18.4px;
  }

  .panel-foot {
    border-top: 1px solid var(--line);
    background: #ffffff;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .panel-foot[hidden] { display: none; }

  .panel-cta {
    display: block;
    text-align: center;
    font-weight: 600;
    font-size: 16px;
    padding: 15px;
    border-radius: 999px;
    background: var(--green-deep);
    color: #ffffff;
  }

  .panel-cta:hover { background: #11512a; color: #ffffff; text-decoration: none; }

  .panel-cta { transition: background 150ms ease, transform 160ms var(--ease-out); }
  .panel-cta:active { transform: scale(0.97); }

  @media (prefers-reduced-motion: reduce) {
    .panel-cta:active { transform: none; }
  }

  .panel-link { text-align: center; font-size: 14px; color: var(--ink); }
  /* Variante para <button> (el "Ver más" de favoritos): mismo aspecto de enlace. */
  .panel-link--btn { background: none; border: none; cursor: pointer; padding: 8px 0 0; text-decoration: underline; width: 100%; font-family: inherit; }

  .panel-note {
    font-size: 12px;
    color: rgba(27, 42, 31, 0.6);
    text-align: center;
    margin: 0;
  }

  .subtotal-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 15px;
  }

  /* Progreso hacia el envio gratis (mismo anuncio que /carrito). */
  .envio-promo {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .envio-promo-texto {
    font-size: 13px;
    font-weight: 600;
    color: rgba(27, 42, 31, 0.7);
    margin: 0;
  }

  .envio-promo--ganado .envio-promo-texto { color: var(--green-deep); }

  .envio-promo-barra {
    height: 6px;
    border-radius: 999px;
    background: rgba(27, 42, 31, 0.12);
    overflow: hidden;
  }

  .envio-promo-avance {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--green-deep);
    transition: width 320ms var(--ease-out);
  }

  .subtotal { font-size: 22px; font-weight: 600; font-variant-numeric: tabular-nums; }

  /* Carrito: estado vacio */
  [data-cart-empty][hidden] { display: none; }
  .empty-note { margin: 0; text-align: center; font-size: 15px; color: rgba(27, 42, 31, 0.7); }
  [data-cart-empty] .panel-cta { margin-top: 18.4px; }

  .empty-kicker {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-align: center;
    margin: 27.6px 0 0;
  }

  .empty-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 13.8px;
    margin-top: 18.4px;
  }

  .empty-tile {
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 7px;
    font-size: 13px;
    text-align: center;
  }

  .empty-photo {
    display: block;
    height: 120px;
    border-radius: 12px;
    background: #dce9df;
  }

  /* Carrito: lineas. El nombre panel-line es propio del panel: la pagina
     /carrito tiene su propia .cart-line y compartir el nombre hacia que este
     CSS global (que sale en un chunk comun) pisara la grilla de esa pagina. */
  :global(.panel-line) {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) auto;
    gap: 13.8px;
    align-items: start;
  }

  :global(.panel-line + .panel-line) { margin-top: 18.4px; }

  :global(.cart-thumb) {
    width: 72px;
    height: 72px;
    border-radius: 10px;
    overflow: hidden;
    background: #dce9df;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
  }

  :global(.cart-info) { min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  :global(.cart-name) { font-size: 15px; font-weight: 600; }
  :global(.cart-variant) { font-size: 13px; color: rgba(27, 42, 31, 0.6); }
  :global(.cart-controls) { display: flex; align-items: center; gap: 11px; margin-top: 5px; }

  :global(.cart-stepper) {
    display: flex;
    align-items: center;
    border: 1px solid rgba(27, 42, 31, 0.2);
    border-radius: 999px;
    overflow: hidden;
    background: #ffffff;
  }

  :global(.cart-stepper button) {
    width: 32px;
    height: 32px;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-size: 16px;
    cursor: pointer;
  }

  :global(.cart-qty) {
    min-width: 24px;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  :global(.cart-remove) {
    border: 0;
    background: transparent;
    font-size: 12px;
    color: rgba(27, 42, 31, 0.6);
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
  }

  :global(.cart-total) { font-size: 15px; font-weight: 600; font-variant-numeric: tabular-nums; }

  /* Panel de cuenta */
  .account-tab { display: flex; flex-direction: column; gap: 13.8px; }
  .account-tab[hidden] { display: none; }

  .account-headline { font-size: 21px; font-weight: 600; line-height: 1.25; margin: 0; }

  .account-input {
    min-height: 48px;
    padding: 11px 15px;
    font-size: 15px;
    border: 1px solid rgba(27, 42, 31, 0.2);
    border-radius: 10px;
    background: #ffffff;
    color: var(--ink);
  }

  .account-check {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 400;
    color: rgba(27, 42, 31, 0.75);
    margin: 0;
  }

  .account-check input { width: 17px; height: 17px; accent-color: var(--green-deep); }

  .account-signin {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 15px;
    padding: 14px;
    border-radius: 10px;
    border: 1px solid var(--green-deep);
    background: var(--green-deep);
    color: #ffffff;
  }

  .cuenta-estado { display: flex; flex-direction: column; gap: 13.8px; }
  .cuenta-estado[hidden] { display: none; }

  .account-signin--link {
    display: block;
    text-align: center;
    text-decoration: none;
  }

  .account-signin--link:hover {
    background: #11512a;
    color: #ffffff;
    text-decoration: none;
  }

  /* Accion secundaria del panel (crear cuenta / cerrar sesion). */
  .account-alt {
    display: block;
    text-align: center;
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--ink);
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .account-chips { display: flex; gap: 9.2px; flex-wrap: wrap; }

  .account-chips a {
    font-size: 13px;
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid rgba(27, 42, 31, 0.2);
    background: #ffffff;
    color: var(--ink);
  }

  .account-sub { font-size: 15px; font-weight: 600; margin: 9.2px 0 0; }

  .account-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 22px;
    text-align: center;
    font-size: 14px;
    color: rgba(27, 42, 31, 0.6);
  }

  .account-card--left { text-align: left; color: rgba(27, 42, 31, 0.7); }

  /* Listas de vistos/favoritos: cuando hay productos, la tarjeta pasa de
     nota centrada a lista alineada a la izquierda. */
  .account-card--llena {
    text-align: left;
    padding: 9px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .account-card :global(.account-item) {
    display: flex;
