---
// Gotas que resbalan sobre la foto del hero (contacto): canvas 2D con
// requestAnimationFrame, sin librerias. La foto ya trae gotas fotograficas,
// asi que esto NO desenfoca ni refracta nada: solo unas pocas gotas blancas
// semitransparentes que caen despacio, como agua sobre el vidrio.
//
// El canvas cubre a su padre (que debe ser position: relative) y no captura
// clics. Se apaga solo con prefers-reduced-motion, en pantallas de menos de
// 768px y mientras la pestana esta oculta.
interface Props {
  /** cuantas gotas vivas a la vez */
  densidad?: number;
  /** opacidad base de las gotas (0.10–0.22) */
  opacidad?: number;
  /** multiplicador de velocidad de caida */
  velocidad?: number;
}

const { densidad = 14, opacidad = 0.18, velocidad = 1 } = Astro.props;
---

<canvas
  class="gotas-hero"
  data-gotas-hero
  data-densidad={densidad}
  data-opacidad={opacidad}
  data-velocidad={velocidad}
  aria-hidden="true"></canvas>

<style>
  .gotas-hero {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    /* debajo del texto y los enlaces del hero (que van despues en el DOM
       con position relative) y encima de la foto y el oscurecido. */
    z-index: 1;
  }
</style>

<script>
  interface Gota {
    x: number;
    y: number;
    r: number;
    vy: number;
    vx: number;
  }

  interface Miga {
    x: number;
    y: number;
    r: number;
    vida: number;
  }

  const MAX_MIGAS = 60;

  function iniciar(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    const padre = canvas.parentElement;
    if (!ctx || !padre) return;

    // Apagado total: sin dibujar ni un frame.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const densidad = Number(canvas.dataset.densidad ?? 14) || 14;
    const opacidadBase = Number(canvas.dataset.opacidad ?? 0.18) || 0.18;
    const velocidad = Number(canvas.dataset.velocidad ?? 1) || 1;

    let ancho = 0;
    let alto = 0;
    let rafId = 0;
    let timerResize: number | undefined;

    const gotas: Gota[] = [];
    const migas: Miga[] = [];

    const nuevaGota = (desdeArriba: boolean): Gota => {
      const r = 2 + Math.random() * 4;
      return {
        x: Math.random() * ancho,
        y: desdeArriba ? -r * 2 : Math.random() * alto,
        r,
        // velocidad proporcional al radio, con deriva horizontal leve
        vy: (0.3 + r * 0.16) * velocidad,
        vx: (Math.random() - 0.5) * 0.3,
      };
    };

    const ajustar = () => {
      const dpr = window.devicePixelRatio || 1;
      ancho = padre.clientWidth;
      alto = padre.clientHeight;
      canvas.width = Math.round(ancho * dpr);
      canvas.height = Math.round(alto * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    // Elipse blanca + punto de brillo arriba a la izquierda. Sin blur ni
    // sombras: agua sobre vidrio, sutil.
    const pintarGota = (x: number, y: number, r: number, alfa: number) => {
      ctx.beginPath();
      ctx.ellipse(x, y, r * 0.82, r, 0, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(255, 255, 255, ${alfa})`;
      ctx.fill();
      ctx.beginPath();
      ctx.arc(x - r * 0.3, y - r * 0.35, Math.max(0.6, r * 0.25), 0, Math.PI * 2);
      ctx.fillStyle = `rgba(255, 255, 255, ${Math.min(0.45, alfa + 0.16)})`;
      ctx.fill();
    };

    const cuadro = () => {
      rafId = 0;
      // El elemento se desmonto: soltar todo.
      if (!canvas.isConnected) {
        limpiar();
        return;
      }

      ctx.clearRect(0, 0, ancho, alto);

      for (const g of gotas) {
        g.y += g.vy;
        g.x += g.vx;
        // Las grandes dejan un rastro corto de gotitas quietas que se van.
        if (g.r >= 4.5 && Math.random() < 0.1 && migas.length < MAX_MIGAS) {
          migas.push({ x: g.x, y: g.y - g.r, r: 0.7 + Math.random() * 0.9, vida: 1 });
        }
        if (g.y - g.r > alto) Object.assign(g, nuevaGota(true));
        const alfa = Math.min(0.22, Math.max(0.1, opacidadBase * (0.55 + g.r / 9)));
        pintarGota(g.x, g.y, g.r, alfa);
      }

      for (let i = migas.length - 1; i >= 0; i--) {
        const m = migas[i];
        m.vida -= 0.012;
        if (m.vida <= 0) {
          migas.splice(i, 1);
          continue;
        }
        pintarGota(m.x, m.y, m.r, 0.12 * m.vida);
      }

      rafId = requestAnimationFrame(cuadro);
    };

    const corriendo = () => rafId !== 0;

    const arrancarSiTocaDibujar = () => {
      if (!corriendo() && !document.hidden && window.innerWidth >= 768) {
        rafId = requestAnimationFrame(cuadro);
      }
    };

    const pausar = () => {
      if (rafId) cancelAnimationFrame(rafId);
      rafId = 0;
    };

    const alRedimensionar = () => {
      window.clearTimeout(timerResize);
      timerResize = window.setTimeout(() => {
        if (window.innerWidth < 768) {
          pausar();
          ctx.clearRect(0, 0, ancho, alto);
          return;
        }
        ajustar();
        arrancarSiTocaDibujar();
      }, 150);
    };

    const alCambiarVisibilidad = () => {
      if (document.hidden) pausar();
      else arrancarSiTocaDibujar();
    };

    const limpiar = () => {
      pausar();
      window.clearTimeout(timerResize);
      window.removeEventListener('resize', alRedimensionar);
      document.removeEventListener('visibilitychange', alCambiarVisibilidad);
    };

    window.addEventListener('resize', alRedimensionar);
    document.addEventListener('visibilitychange', alCambiarVisibilidad);

    ajustar();
    for (let i = 0; i < densidad; i++) gotas.push(nuevaGota(false));
    arrancarSiTocaDibujar();
  }

  document
    .querySelectorAll<HTMLCanvasElement>('canvas[data-gotas-hero]')
    .forEach(iniciar);
</script>
