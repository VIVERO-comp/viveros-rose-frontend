---
import { whatsappLink } from '../lib/site';

interface Props {
  message?: string;
}

const { message = 'Hola, vengo de plantaspanama.com y tengo una consulta.' } = Astro.props;
---

<a
  href={whatsappLink(message)}
  class="wa-float"
  target="_blank"
  rel="noopener"
  aria-label="Escribenos por WhatsApp"
>
  <svg viewBox="0 0 32 32" width="28" height="28" fill="currentColor" aria-hidden="true">
    <path d="M16 3C9.4 3 4 8.3 4 14.9c0 2.6.8 5 2.3 7L4.2 28l6.3-2c2 1.1 4.2 1.7 6.5 1.7 6.6 0 12-5.3 12-11.9S22.6 3 16 3zm0 21.8c-2 0-4-.5-5.7-1.6l-.4-.2-3.7 1.2 1.2-3.6-.3-.4c-1.2-1.7-1.9-3.8-1.9-6 0-5.5 4.8-10 10.8-10s10.8 4.5 10.8 10-4.8 10.6-10.8 10.6zm5.9-7.5c-.3-.2-1.9-1-2.2-1.1-.3-.1-.5-.2-.7.2-.2.3-.8 1.1-1 1.3-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.3.3-.6.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.1 1.1-1.1 2.7s1.2 3.1 1.3 3.3c.2.2 2.3 3.6 5.6 5 .8.3 1.4.5 1.9.7.8.2 1.5.2 2.1.1.6-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5l-.9-.5z" />
  </svg>
</a>

<style>
  .wa-float {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--whatsapp);
    color: #fff;
    box-shadow: 0 4px 16px rgba(31, 168, 85, 0.4);
    transition: transform 0.15s ease;
  }

  .wa-float:hover {
    transform: scale(1.06);
    text-decoration: none;
  }
</style>
