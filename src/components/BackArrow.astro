---
// Flecha de retorno flotante de las paginas sin navbar (Servicios,
// Mayoristas, Eventos, Contacto). Con `href` va a esa ruta fija (p. ej. las
// mini paginas de servicios vuelven a /servicios); sin `href`, vuelve a la
// pagina anterior si se llego desde el propio sitio o al inicio si no.
import Icon from './Icon.astro';

interface Props {
  href?: string;
}

const { href } = Astro.props;
---

{
  href ? (
    <a href={href} class="back-arrow" aria-label="Volver">
      <Icon name="arrow-left" size={20} />
    </a>
  ) : (
    <button class="back-arrow" data-back-arrow aria-label="Volver">
      <Icon name="arrow-left" size={20} />
    </button>
  )
}

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-back-arrow]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const from = document.referrer;
      if (from && new URL(from).origin === window.location.origin && from !== window.location.href) {
        history.back();
      } else {
        window.location.href = '/';
      }
    });
  });
</script>

<style>
  .back-arrow {
    position: fixed;
    top: 22px;
    left: 22px;
    z-index: 70;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 0;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 10px rgba(27, 42, 31, 0.18);
  }

  .back-arrow:hover { background: #ffffff; color: var(--ink); }
</style>
