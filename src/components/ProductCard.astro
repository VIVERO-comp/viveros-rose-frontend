---
// Tarjeta de producto sin caja (referencia Jomashop): la foto sobre fondo
// gris claro ES la tarjeta, y el texto va directo sobre el fondo de la
// pagina — nombre en gris, precio en negrita debajo. El boton circular de
// agregar sigue sobre la foto. El StockBadge se conserva tal cual (el stock
// proxy lo actualiza en el cliente via data-sku).
import type { Product } from '../data/products';
import { compareAtPrice, esComprable, formatPrice, precioVigente } from '../data/products';
import Icon from './Icon.astro';
import StockBadge from './StockBadge.astro';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const url = `/plantas/${product.category}/${product.slug}`;
const outOfStock = product.available <= 0;

// Estado inicial de precios (el de build, con los precios reales que inyecta
// catalogo-build); el stock proxy lo refresca en el navegador con la misma
// regla (precioVista de lib/stock.ts) via el evento stock-actualizado.
const vigente = precioVigente(product);
const regularTachado = compareAtPrice(product);
const comprable = esComprable(product);
const descuentoPct = regularTachado ? Math.round(100 * (1 - vigente / regularTachado)) : null;

// "Mas vendida" usa la misma regla que la coleccion mas-vendidas.
const esMasVendida = product.available >= 40;

---

<article class="product-tile">
  <a href={url} class="tile-link">
    <!-- Foto del producto con la segunda foto en hover (opacity 0→1 en 0.4s,
         como el handoff). El emoji queda SIEMPRE pintado debajo de la foto:
         es lo que se ve si el producto no tiene fotos o si Cloudinary no
         responde (la capa de foto queda transparente y el emoji asoma). -->
    <div
      class="tile-photo"
      data-medidas={product.image ? undefined : 'Foto 4:5 · 640×800'}
      aria-hidden="true"
    >
      {product.emoji}
      {product.image && (
        <>
          <div class="tile-photo-img" style={`background-image: url('${product.image}');`} />
          {product.imageHover && (
            <div
              class="tile-photo-img tile-photo-hover"
              style={`background-image: url('${product.imageHover}');`}
            />
          )}
        </>
      )}
      <div class="tile-flags">
        <span
          class="tile-flag tile-flag--offer"
          data-offer-flag
          data-sku={product.sku}
          hidden={!comprable || descuentoPct === null}
        >
          {descuentoPct !== null ? `-${descuentoPct}%` : ''}
        </span>
        {esMasVendida && <span class="tile-flag">Más vendida</span>}
      </div>
    </div>
    <div class="tile-info">
      <h3>{product.name}</h3>
      <!-- Los tres estados del precio se renderizan siempre y el proxy los
           alterna en vivo: "Proximamente" (sin precio real en Odoo), precio
           vigente y regular tachado (solo con oferta valida). -->
      <p class="price" data-price-line data-sku={product.sku}>
        <span class="price-soon" data-price-soon hidden={comprable}>Próximamente</span>
        <span data-price-current hidden={!comprable}>Desde {formatPrice(vigente)}</span>
        <s class="compare" data-price-compare hidden={!comprable || !regularTachado}>
          {regularTachado ? formatPrice(regularTachado) : ''}
        </s>
      </p>
      {product.scientificName && <p class="scientific">{product.scientificName}</p>}
      <div class="tile-bottom">
        <StockBadge sku={product.sku} available={product.available} />
      </div>
    </div>
  </a>
  <!-- El boton se renderiza siempre y se muestra u oculta con el stock REAL
       del proxy (evento stock-actualizado) Y con el precio: sin precio real
       en Odoo ("Proximamente") no se puede agregar. El estado de build solo
       decide el estado inicial. -->
  <button
    class="tile-add"
    aria-label={`Agregar ${product.name} al carrito`}
    hidden={outOfStock || !comprable}
    data-tile-add
    data-sku={product.sku}
    data-name={product.name}
    data-price={vigente}
    data-slug={product.slug}
    data-category={product.category}
    data-emoji={product.emoji}
    data-image={product.image}
  >
    <Icon name="plus" size={16} />
  </button>
  <button
    class="tile-fav"
    aria-label={`Guardar ${product.name} en favoritos`}
    data-tile-fav
    data-sku={product.sku}
    data-name={product.name}
    data-price={vigente}
    data-slug={product.slug}
    data-category={product.category}
    data-emoji={product.emoji}
    data-image={product.image}
  >
    <Icon name="heart" size={15} />
  </button>
</article>

<script>
  // Agregar al carrito desde la tarjeta (delegado: hay muchas tarjetas por
  // pagina y este script se incluye una sola vez).
  import { addToCart } from '../lib/cart';
  import { esFavorito, toggleFavorito } from '../lib/preferencias';
  import { precioVista, type StockItem } from '../lib/stock';

  // Sin formatPrice de data/products: importarlo aqui meteria el catalogo
  // entero al bundle del cliente.
  const fmt = (n: number) => `$${n.toFixed(2)}`;

  // La tarjeta sigue el stock Y los precios reales que reporta StockBadge,
  // la misma fuente que pinta el badge. Cuando precioVista devuelve null
  // (fallback del proxy sin precio) se deja lo que pinto el build.
  document.addEventListener('stock-actualizado', (event) => {
    const items = (event as CustomEvent<{ items: StockItem[] }>).detail.items;
    const bySku = new Map(items.map((i) => [i.sku, i]));

    document.querySelectorAll<HTMLElement>('[data-price-line][data-sku]').forEach((line) => {
      const item = bySku.get(line.dataset.sku!);
      const pv = item && precioVista(item);
      if (!pv) return;
      const soon = line.querySelector<HTMLElement>('[data-price-soon]')!;
      const current = line.querySelector<HTMLElement>('[data-price-current]')!;
      const compare = line.querySelector<HTMLElement>('[data-price-compare]')!;
      soon.hidden = pv.comprable;
      current.hidden = !pv.comprable;
      current.textContent = `Desde ${fmt(pv.vigente)}`;
      compare.hidden = !pv.comprable || pv.regular === null;
      if (pv.regular !== null) compare.textContent = fmt(pv.regular);
    });

    document.querySelectorAll<HTMLElement>('[data-offer-flag][data-sku]').forEach((flag) => {
      const item = bySku.get(flag.dataset.sku!);
      const pv = item && precioVista(item);
      if (!pv) return;
      const conDescuento = pv.comprable && pv.descuentoPct !== null;
      flag.hidden = !conDescuento;
      if (conDescuento) flag.textContent = `-${pv.descuentoPct}%`;
    });

    document.querySelectorAll<HTMLButtonElement>('[data-tile-add][data-sku]').forEach((btn) => {
      const item = bySku.get(btn.dataset.sku!);
      if (!item) return;
      const pv = precioVista(item);
      // Sin dato de precio manda solo el stock (como antes de las ofertas).
      btn.hidden = item.available <= 0 || (pv !== null && !pv.comprable);
      if (pv?.comprable) btn.dataset.price = String(pv.vigente);
    });

    document.querySelectorAll<HTMLButtonElement>('[data-tile-fav][data-sku]').forEach((btn) => {
      const item = bySku.get(btn.dataset.sku!);
      const pv = item && precioVista(item);
      if (pv?.comprable) btn.dataset.price = String(pv.vigente);
    });
  });

  document.addEventListener('click', (event) => {
    const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-tile-add]');
    if (!btn) return;
    event.preventDefault();
    const d = btn.dataset;
    addToCart({
      sku: d.sku!,
      name: d.name!,
      price: Number(d.price),
      slug: d.slug!,
      category: d.category!,
      emoji: d.emoji!,
      image: d.image || undefined,
    });
    btn.classList.add('added');
    setTimeout(() => btn.classList.remove('added'), 1600);
  });

  // Corazon de favoritos: estado inicial desde localStorage y alternado con
  // clic (tambien delegado). El panel de cuenta lista los guardados.
  document.querySelectorAll<HTMLButtonElement>('[data-tile-fav][data-sku]').forEach((btn) => {
    btn.classList.toggle('activo', esFavorito(btn.dataset.sku!));
  });

  document.addEventListener('click', (event) => {
    const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-tile-fav]');
    if (!btn) return;
    event.preventDefault();
    const d = btn.dataset;
    const activo = toggleFavorito({
      sku: d.sku!,
      name: d.name!,
      price: Number(d.price),
      slug: d.slug!,
      category: d.category!,
      emoji: d.emoji!,
      image: d.image || undefined,
    });
    btn.classList.toggle('activo', activo);
  });
</script>

<style>
  /* Sin caja: la tarjeta es transparente y la foto redondeada hace de
     superficie. El hover vive en la foto (crossfade) y en el nombre
     (subrayado), ya no en un borde. */
  .product-tile {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    background: transparent;
  }

  .tile-link {
    display: flex;
    flex-direction: column;
    flex: 1;
    color: var(--ink);
    text-decoration: none;
  }

  .tile-link:hover { text-decoration: none; color: var(--ink); }
  .tile-link:hover h3 { text-decoration: underline; }

  .tile-photo {
    position: relative;
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3.5rem;
    background: var(--surface-2);
    border-radius: var(--radius);
    overflow: hidden;
    outline: 1px solid var(--line);
  }

  /* Etiquetas sobre la foto ("-25%" y "Más vendida"), apiladas en columna
     para que puedan convivir sin taparse. */
  .tile-flags {
    position: absolute;
    left: 10px;
    top: 10px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .tile-flag {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--green-deep);
    background: rgba(255, 255, 255, 0.92);
    padding: 4px 10px;
    border-radius: 999px;
  }

  /* Descuento invertido (fondo verde) para distinguirse de "Más vendida". */
  .tile-flag--offer {
    color: #ffffff;
    background: var(--green-deep);
  }

  .tile-flag--offer[hidden] {
    display: none;
  }

  .tile-photo-img {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }

  .tile-photo-hover {
    opacity: 0;
    /* Crossfade corto: el hover se ve decenas de veces por sesion. */
    transition: opacity 280ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .product-tile:hover .tile-photo-hover { opacity: 1; }
  }

  /* La pastilla de medidas solo aparece en tarjetas que aun no tienen foto. */
  .tile-photo[data-medidas]::after {
    content: attr(data-medidas);
    position: absolute;
    left: 50%;
    top: 12px;
    transform: translateX(-50%);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(27, 42, 31, 0.55);
    background: rgba(238, 245, 240, 0.85);
    padding: 2px 8px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .tile-info {
    position: relative;
    padding: 11px 2px 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    flex: 1;
  }

  /* Estado de stock: texto de 10px sin relleno, en tinta sobre blanco. */
  .tile-info :global(.badge) {
    padding: 0;
    background: transparent;
    font-size: 10px;
    letter-spacing: 0.12em;
  }

  .tile-info :global(.badge--in-stock) { color: var(--green-deep); }
  .tile-info :global(.badge--low) { color: #b07908; }
  .tile-info :global(.badge--out) { color: var(--ink-faint); }

  /* Nombre con altura reservada para DOS lineas (y elipsis si necesita mas):
     ocupe una o dos, todas las tarjetas de la fila miden lo mismo. */
  /* Nombre en gris con peso medio: deja de competir con el precio, que
     ahora es lo mas oscuro de la tarjeta. Un paso mas oscuro que --ink-soft
     (0.65) para que siga leyendose como texto principal. */
  h3 {
    font-size: 15px;
    font-weight: 500;
    line-height: 1.25;
    margin: 0;
    color: rgba(27, 42, 31, 0.82);
    max-width: 100%;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.5em;
  }

  .scientific {
    font-size: 12px;
    font-style: italic;
    color: var(--ink-faint);
    margin: 0;
  }

  /* Badge de stock + precio anclados al fondo de la tarjeta, para que queden
     a la misma altura en toda la fila aunque falte el nombre cientifico. */
  .tile-bottom {
    margin-top: auto;
    padding-top: 4px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  .price {
    font-size: 15px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    margin: 0;
  }

  /* Regular tachado junto al precio de oferta. */
  .price .compare {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-faint);
    margin-left: 4px;
  }

  /* Sin precio real en Odoo: "Próximamente" en lugar del precio, con el
     mismo cuerpo para que la fila de tarjetas no baile. */
  .price .price-soon {
    font-weight: 600;
    color: var(--ink-faint);
  }

  .price [hidden] {
    display: none;
  }

  .tile-add {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 0;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .tile-add:hover { background: #ffffff; }

  /* Presion: el boton se encoge un instante y confirma el toque. */
  .tile-add,
  .tile-fav {
    transition: background 150ms ease, color 150ms ease, transform 160ms var(--ease-out);
  }

  .tile-add:active,
  .tile-fav:active { transform: scale(0.94); }

  @media (prefers-reduced-motion: reduce) {
    .tile-add:active,
    .tile-fav:active { transform: none; }
  }

  .tile-add.added {
    background: var(--green);
    color: #ffffff;
  }

  /* Corazon de favoritos, debajo del boton de agregar. */
  .tile-fav {
    position: absolute;
    top: 52px;
    right: 10px;
    z-index: 2;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 0;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .tile-fav:hover { background: #ffffff; }

  /* Producto agotado: el boton de agregar esta oculto, asi que el corazon
     sube a ocupar su lugar (el proxy de stock alterna [hidden] en vivo). */
  .tile-add[hidden] + .tile-fav { top: 10px; }

  .tile-fav.activo {
    color: var(--green-deep);
  }

  .tile-fav.activo :global(svg) { fill: currentColor; }

  /* Movil: la misma tarjeta sin caja de la base, solo con tamanos menores
     de texto, foto y botones. */
  @media (max-width: 768px) {
    .tile-photo {
      font-size: 2.6rem;
    }

    .tile-photo::after { display: none; }

    .tile-info {
      padding: 10px 2px 0;
      gap: 3px;
    }

    h3 { font-size: 14px; }
    .scientific { font-size: 11px; }
    .price { font-size: 13px; margin: 1px 0 0; }

    .tile-add {
      width: 32px;
      height: 32px;
      top: 8px;
      right: 8px;
      box-shadow: 0 2px 8px rgba(27, 42, 31, 0.18);
    }

    .tile-fav {
      width: 32px;
      height: 32px;
      top: 46px;
      right: 8px;
      box-shadow: 0 2px 8px rgba(27, 42, 31, 0.18);
    }

    .tile-add[hidden] + .tile-fav { top: 8px; }
  }
</style>
