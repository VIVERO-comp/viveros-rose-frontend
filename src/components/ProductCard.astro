---
// Tarjeta de producto estilo tienda (referencia Lively Root): tarjeta clara
// con la foto arriba, nombre y precio "Desde $" debajo, y el boton circular
// para agregar al carrito sobre la foto. El StockBadge se conserva tal cual
// (el stock proxy lo actualiza en el cliente via data-sku).
import type { Product } from '../data/products';
import { formatPrice } from '../data/products';
import Icon from './Icon.astro';
import StockBadge from './StockBadge.astro';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const url = `/plantas/${product.category}/${product.slug}`;
const outOfStock = product.available <= 0;

// "Mas vendida" usa la misma regla que la coleccion mas-vendidas.
const esMasVendida = product.available >= 40;

---

<article class="product-tile">
  <a href={url} class="tile-link">
    <!-- Foto del producto con la segunda foto en hover (opacity 0→1 en 0.4s,
         como el handoff). Si el producto aun no tiene foto, queda el emoji. -->
    <div
      class="tile-photo"
      data-medidas={product.image ? undefined : 'Foto 4:5 · 640×800'}
      aria-hidden="true"
    >
      {product.image ? (
        <>
          <div class="tile-photo-img" style={`background-image: url('${product.image}');`} />
          {product.imageHover && (
            <div
              class="tile-photo-img tile-photo-hover"
              style={`background-image: url('${product.imageHover}');`}
            />
          )}
        </>
      ) : (
        product.emoji
      )}
      {esMasVendida && <span class="tile-flag">Más vendida</span>}
    </div>
    <div class="tile-info">
      <h3>{product.name}</h3>
      {product.scientificName && <p class="scientific">{product.scientificName}</p>}
      <div class="tile-bottom">
        <StockBadge sku={product.sku} available={product.available} />
        <p class="price">Desde {formatPrice(product.price)}</p>
      </div>
    </div>
  </a>
  <!-- El boton se renderiza siempre y se muestra u oculta con el stock REAL
       del proxy (evento stock-actualizado); el estado de build (available
       estatico, siempre 0) solo decide el estado inicial. -->
  <button
    class="tile-add"
    aria-label={`Agregar ${product.name} al carrito`}
    hidden={outOfStock}
    data-tile-add
    data-sku={product.sku}
    data-name={product.name}
    data-price={product.price}
    data-slug={product.slug}
    data-category={product.category}
    data-emoji={product.emoji}
    data-image={product.image}
  >
    <Icon name="plus" size={16} />
  </button>
  <button
    class="tile-fav"
    aria-label={`Guardar ${product.name} en favoritos`}
    data-tile-fav
    data-sku={product.sku}
    data-name={product.name}
    data-price={product.price}
    data-slug={product.slug}
    data-category={product.category}
    data-emoji={product.emoji}
    data-image={product.image}
  >
    <Icon name="heart" size={15} />
  </button>
</article>

<script>
  // Agregar al carrito desde la tarjeta (delegado: hay muchas tarjetas por
  // pagina y este script se incluye una sola vez).
  import { addToCart } from '../lib/cart';
  import { esFavorito, toggleFavorito } from '../lib/preferencias';
  import type { StockItem } from '../lib/stock';

  // El boton de agregar sigue el stock real que reporta StockBadge, la misma
  // fuente que pinta el badge de la tarjeta.
  document.addEventListener('stock-actualizado', (event) => {
    const items = (event as CustomEvent<{ items: StockItem[] }>).detail.items;
    const bySku = new Map(items.map((i) => [i.sku, i.available]));
    document.querySelectorAll<HTMLButtonElement>('[data-tile-add][data-sku]').forEach((btn) => {
      const available = bySku.get(btn.dataset.sku!);
      if (available !== undefined) btn.hidden = available <= 0;
    });
  });

  document.addEventListener('click', (event) => {
    const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-tile-add]');
    if (!btn) return;
    event.preventDefault();
    const d = btn.dataset;
    addToCart({
      sku: d.sku!,
      name: d.name!,
      price: Number(d.price),
      slug: d.slug!,
      category: d.category!,
      emoji: d.emoji!,
      image: d.image || undefined,
    });
    btn.classList.add('added');
    setTimeout(() => btn.classList.remove('added'), 1600);
  });

  // Corazon de favoritos: estado inicial desde localStorage y alternado con
  // clic (tambien delegado). El panel de cuenta lista los guardados.
  document.querySelectorAll<HTMLButtonElement>('[data-tile-fav][data-sku]').forEach((btn) => {
    btn.classList.toggle('activo', esFavorito(btn.dataset.sku!));
  });

  document.addEventListener('click', (event) => {
    const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-tile-fav]');
    if (!btn) return;
    event.preventDefault();
    const d = btn.dataset;
    const activo = toggleFavorito({
      sku: d.sku!,
      name: d.name!,
      price: Number(d.price),
      slug: d.slug!,
      category: d.category!,
      emoji: d.emoji!,
      image: d.image || undefined,
    });
    btn.classList.toggle('activo', activo);
  });
</script>

<style>
  .product-tile {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    overflow: hidden;
    outline: 1px solid var(--line);
    background: #ffffff;
  }

  .product-tile { transition: outline-color 150ms ease; }

  /* Hover solo con puntero fino: en tactil el tap dispararia estados
     "pegados" de hover que no se quitan. */
  @media (hover: hover) and (pointer: fine) {
    .product-tile:hover { outline-color: var(--green); }
  }

  .tile-link {
    display: flex;
    flex-direction: column;
    flex: 1;
    color: var(--ink);
    text-decoration: none;
  }

  .tile-link:hover { text-decoration: none; color: var(--ink); }
  .tile-link:hover h3 { text-decoration: underline; }

  .tile-photo {
    position: relative;
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3.5rem;
    background: var(--surface-2);
  }

  /* Etiqueta "Más vendida" sobre la foto, como la referencia. */
  .tile-flag {
    position: absolute;
    left: 10px;
    top: 10px;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--green-deep);
    background: rgba(255, 255, 255, 0.92);
    padding: 4px 10px;
    border-radius: 999px;
  }

  .tile-photo-img {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }

  .tile-photo-hover {
    opacity: 0;
    /* Crossfade corto: el hover se ve decenas de veces por sesion. */
    transition: opacity 280ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .product-tile:hover .tile-photo-hover { opacity: 1; }
  }

  /* La pastilla de medidas solo aparece en tarjetas que aun no tienen foto. */
  .tile-photo[data-medidas]::after {
    content: attr(data-medidas);
    position: absolute;
    left: 50%;
    top: 12px;
    transform: translateX(-50%);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(27, 42, 31, 0.55);
    background: rgba(238, 245, 240, 0.85);
    padding: 2px 8px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .tile-info {
    position: relative;
    padding: 13.8px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    flex: 1;
  }

  /* Estado de stock: texto de 10px sin relleno, en tinta sobre blanco. */
  .tile-info :global(.badge) {
    padding: 0;
    background: transparent;
    font-size: 10px;
    letter-spacing: 0.12em;
  }

  .tile-info :global(.badge--in-stock) { color: var(--green-deep); }
  .tile-info :global(.badge--low) { color: #b07908; }
  .tile-info :global(.badge--out) { color: var(--ink-faint); }

  /* Nombre con altura reservada para DOS lineas (y elipsis si necesita mas):
     ocupe una o dos, todas las tarjetas de la fila miden lo mismo. */
  h3 {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.25;
    margin: 0;
    color: var(--ink);
    max-width: 100%;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.5em;
  }

  .scientific {
    font-size: 12px;
    font-style: italic;
    color: var(--ink-faint);
    margin: 0;
  }

  /* Badge de stock + precio anclados al fondo de la tarjeta, para que queden
     a la misma altura en toda la fila aunque falte el nombre cientifico. */
  .tile-bottom {
    margin-top: auto;
    padding-top: 4px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  .price {
    font-size: 15px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    margin: 0;
  }

  .tile-add {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 0;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .tile-add:hover { background: #ffffff; }

  /* Presion: el boton se encoge un instante y confirma el toque. */
  .tile-add,
  .tile-fav {
    transition: background 150ms ease, color 150ms ease, transform 160ms var(--ease-out);
  }

  .tile-add:active,
  .tile-fav:active { transform: scale(0.94); }

  @media (prefers-reduced-motion: reduce) {
    .tile-add:active,
    .tile-fav:active { transform: none; }
  }

  .tile-add.added {
    background: var(--green);
    color: #ffffff;
  }

  /* Corazon de favoritos, debajo del boton de agregar. */
  .tile-fav {
    position: absolute;
    top: 52px;
    right: 10px;
    z-index: 2;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 0;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .tile-fav:hover { background: #ffffff; }

  .tile-fav.activo {
    color: var(--green-deep);
  }

  .tile-fav.activo :global(svg) { fill: currentColor; }

  /* Movil: tarjeta como la referencia de celular — foto arriba con esquinas
     redondeadas y la info debajo, en texto oscuro sobre el fondo de la pagina
     (ya no superpuesta sobre la foto con degradado). */
  @media (max-width: 768px) {
    .product-tile {
      aspect-ratio: auto;
      border-radius: 0;
      overflow: visible;
      outline: none;
      background: transparent;
    }

    /* Sigue siendo columna a toda altura: asi el bloque badge+precio queda
       anclado abajo tambien en la grilla de 2 columnas del movil. */
    .tile-link {
      position: static;
      height: 100%;
      color: var(--ink);
    }

    .tile-link:hover { color: var(--ink); }

    .tile-photo {
      position: relative;
      inset: auto;
      aspect-ratio: 4 / 5;
      border-radius: var(--radius);
      overflow: hidden;
      outline: 1px solid var(--line);
      font-size: 2.6rem;
    }

    .tile-photo::after { display: none; }
    .tile-overlay { display: none; }

    .tile-info {
      padding: 10px 2px 0;
      gap: 3px;
    }

    h3 { font-size: 14px; color: var(--ink); }
    .scientific { font-size: 11px; color: var(--ink-soft); }
    .price { font-size: 13px; color: var(--ink); margin: 1px 0 0; }

    /* El estado de stock baja al final de la info (como las etiquetas "Pet
       Friendly" de la referencia) y recupera sus colores sobre fondo claro. */
    .tile-info :global(.badge) { order: 4; margin-top: 3px; }
    .tile-info :global(.badge--in-stock) { color: var(--green-deep); }
    .tile-info :global(.badge--low) { color: var(--amber-note); }
    .tile-info :global(.badge--out) { color: var(--ink-faint); }

    .tile-add {
      width: 32px;
      height: 32px;
      top: 8px;
      right: 8px;
      box-shadow: 0 2px 8px rgba(27, 42, 31, 0.18);
    }

    .tile-fav {
      width: 32px;
      height: 32px;
      top: 46px;
      right: 8px;
      box-shadow: 0 2px 8px rgba(27, 42, 31, 0.18);
    }
  }
</style>
